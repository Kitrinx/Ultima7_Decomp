Routine ResurrectSpell_i accepts a0 #locals(9) #uses(~DirFromAvatar_i, ~IsMagicOK_i) {
    if (event = _Action) {
        v0 = ~GetTarget();
        v1 = ~Item_getType(v0);
        v2 = ~GetCoord(v0);
        v3 = ~DirFromAvatar_i(v0);
        Kernel_resetRef(v0);
        Kernel_resetRef(item);
        if (~Item_getType(v0) in << 400, 414, 778 >>) {
            v4 = ~GetQuality(v0);
            v5 = ~GetQuantity(v1, v0);
            if ((v4 = 0) and (v5 = 0)) {
                v6 = 0;
            } else {
                v6 = ~Resurrect_i(v0);
            }
        } else {
            v6 = 0;
        }
        Item_bark("@In Mani Corp@", item);
        if (~IsMagicOK_i() and v6) {
            v7 = 1;
            v8 = ~PostAction(<< _aFACE_i, v3, _aSFX_i, 64, _aKNEEL_FRAME_i, _aSTAND_FRAME_i, _aUP_FRAME_i >>, item);
            SetMusic(0, 15);
            createSprite(65535, 0, 0, 0, v2::2, v2::1, 17);
            createSprite(65535, 0, 0, 0, (v2::2 - 2), (v2::1 - 2), 13);
        } else {
            v7 = 1;
            v8 = ~PostAction(<< _aFACE_i, v3, _aKNEEL_FRAME_i, _aSTAND_FRAME_i, _aUP_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
}
