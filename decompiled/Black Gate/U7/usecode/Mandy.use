Routine Mandy accepts a0 #locals(15) #uses(~LordOrLady, ~IsNPCNear, ~AskYesNo, MandySellsFood_i, ~IsInInv, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Mandy);
        v0 = ~GetTime();
        v1 = ~GetWorkType(~NPCToItem_i(_Mandy));
        v2 = ~LordOrLady();
        TurnOn(<< "name", "job", "bye" >>);
        if (v1 = 23) {
            TurnOn(<< "food", "drink", "room", "buy" >>);
        }
        if not $MetMandy {
            [You see a woman in her fifties who might have been a pirate wench in her earlier years. Though she is coarse, she has a certain motherly quality.];
            $MetMandy = true;
        } else {
            ["Hello, again," Mandy says.];
        }
        converse {
            key ("name") {
                ["I am Mandy."];
                TurnOff("name");
            }
            key ("job") {
                ["I run the Fallen Virgin Inn and Tavern. We are open for breakfast, dinner, and late night hours.];
                if (v1 = 23) {
                    ["If thou dost want food or drink, or perhaps a room, please say so."];
                    v3 = ~IsNPCNear(_Dupre);
                    if v3 {
                        [Mandy looks at Dupre and says, "Don't I know thee?"*];
                        SetSpeaker(0, _Dupre);
                        ["Yes, milady. I was here a few months ago."*];
                        SetSpeaker(0, _Mandy);
                        ["I remember! Thou art working for Brommer's Britannian travel guides! Thou art a pub critic!"*];
                        SetSpeaker(0, _Dupre);
                        ["That is right, milady."*];
                        SetSpeaker(0, _Mandy);
                        ["Welcome back! Please try anything on the menu. It is all still very good."*];
                        SetSpeaker(0, _Dupre);
                        ["I thank thee, milady."*];
                        CloseSpeaker(_Dupre);
                        SetSpeaker(0, _Mandy);
                        v4 = ~IsNPCNear(_Iolo);
                        if v4 {
                            SetSpeaker(0, _Iolo);
                            ["Thou art a swine, Dupre."*];
                            CloseSpeaker(_Iolo);
                        }
                        SetSpeaker(0, _Mandy);
                    }
                    TurnOn(<< "food", "drink", "room", "buy" >>);
                } else {
                    ["Please come to the Tavern then and I will be happy to serve thee."];
                }
                TurnOn("Fallen Virgin");
            }
            key ("food") {
                ["We serve a good plate of slop, if I do say so myself! That Silverleaf is something. Thou shouldst try that."];
                TurnOff("food");
                TurnOn("Silverleaf");
            }
            key ("drink") {
                ["I can offer thee wine and ale."];
                TurnOff("drink");
            }
            key ("room") {
                ["Our rooms are 10 gold per person. The only one available now is the southwest room. The other two already have occupants. Dost thou want one?"];
                if ~AskYesNo() {
                    v5 = ~GetParty();
                    v6 = 0;
                    Foreach v9 in v5 {
                        v6 = (v6 + 1);
                    }
                    v10 = (v6 * 10);
                    v11 = ~CountItem(_All, _All, _Gold_Coin, _Party);
                    if (v11 >= v10) {
                        v12 = ~GiveToParty_i(true, _All, 255, _Key, 1);
                        if not v12 {
                            ["Look there now. Thou hast too many bundles to take the room key!"];
                        } else {
                            ["Here is the room key. It is good only until thou dost leave the inn."];
                            v13 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, v10);
                        }
                    } else {
                        ["It doth seem that thou art a trifle short, <v2>."];
                    }
                } else {
                    ["All right. Some other time."];
                }
                TurnOff("room");
            }
            key ("buy") {
                MandySellsFood_i();
            }
            key ("Silverleaf") {
                ["Best bloody swill thou wilt eat on the face of the earth!"];
                TurnOff("Silverleaf");
            }
            key ("Fallen Virgin") {
                ["Yes, I have run this tavern and inn since my wenching days." Mandy laughs. "I was quite a beauty back then, but thou canst not tell it now. I know everyone in town and they all know me. If thou dost need to know something about anyone, let me know."];
                TurnOff("Fallen Virgin");
                if $MetDanag {
                    TurnOn("Danag");
                }
                if flag(687) {
                    TurnOn("Blacktooth");
                }
                if $MetMole {
                    TurnOn("Mole");
                }
                if flag(690) {
                    TurnOn("Budo");
                }
                if $MetGlenno {
                    TurnOn("Glenno");
                }
                if flag(682) {
                    TurnOn("Wench");
                }
                if flag(684) {
                    TurnOn("Martine");
                }
                if flag(685) {
                    TurnOn("Roberto");
                }
                if $MetLucky {
                    TurnOn("Lucky");
                }
                if $MetGordy {
                    TurnOn("Gordy");
                }
                if $MetSintag {
                    TurnOn("Sintag");
                }
                if $MetSmithy {
                    TurnOn("Smithy");
                }
                if (flag(309) or flag(260)) {
                    TurnOn("Hook");
                }
            }
            key ("Danag") {
                ["He helps out at that Fellowship place. He is always interim branch leader for some reason. The real leader, a fellow named Abraham, is never here. Danag is all right. Kind of gullible."];
                TurnOff("Danag");
            }
            key ("Blacktooth") {
                ["He is a former pirate and rogue, and he can be fairly mean. If he does not warm up to thee immediately, he may not at all. But once he does, thou wilt learn he is quite a sensitive man."];
                TurnOff("Blacktooth");
            }
            key ("Mole") {
                ["I was a wench with Mole's gang of pirates back in... well, it seems a century ago. Mole was rough and tough and a trouble-maker. Until he joined The Fellowship. That changed him into...," Mandy shrugs. "I know not, a middle-aged former pirate or some such."];
                TurnOff("Mole");
            }
            key ("Budo") {
                ["His family has been on Buccaneer's Den for generations. Comes on a trifle too strong with the barking of wares, if thou dost ask me."];
                TurnOff("Budo");
            }
            key ("Glenno") {
                ["He makes me laugh. He is a dear. Thou wouldst not find a more pleasant, and eager-to-please, man on the island. He is a surprisingly good person." Mandy pauses then adds, "For a pimp."];
                TurnOff("Glenno");
            }
            key ("Wench") {
                ["She is a very private person. Works at The Baths. I hear she won some kind of competition -- that is why she is fortunate to be there. I understand Glenno pays them well over there."];
                TurnOff("Wench");
            }
            key ("Martine") {
                ["She is a very private person. Works at The Baths. I have not spoken three words to her in my life."];
                TurnOff("Martine");
            }
            key ("Roberto") {
                ["He is a very private person, but, oh, is he an attractive man, I must say! He works at The Baths. I will admit I am one of his clients. He doth truly clean my dishes, if thou dost know what I mean."];
                TurnOff("Roberto");
            }
            key ("Lucky") {
                ["He is a former rogue, I can tell thee that! And to think he makes a living now by teaching others to be the same!" Mandy shrugs. "To each their own."];
                TurnOff("Lucky");
            }
            key ("Gordy") {
                ["I do not know him that well, although he seems to be a sincere man. He runs the House of Games like a ship. He is a former pirate as well. Must have been a captain."];
                TurnOff("Gordy");
            }
            key ("Smithy") {
                ["He was another pirate. I know he works at the House of Games. I suppose he is the man in charge of the actual games. I do not know him well."];
                TurnOff("Smithy");
            }
            key ("Sintag") {
                ["Brrrr! He is a scary man. Thou canst tell that he has killed. He is the guard at the House of Games. Thou dost not want to be caught cheating by him!"];
                TurnOff("Sintag");
            }
            key ("Hook") {
                v14 = ~IsInInv(1, 65177, _Prism_981, 1, _Party);
                if v14 {
                    [You feel your Cube vibrate, but somehow you know that Mandy would have told you the truth without it.];
                }
                [Mandy whispers to you. "I know who thou dost mean. He lives somewhere on the island, but I am not sure where. He rarely comes in to the tavern, but I have seen him on occasion."];
                ["He scares me to death."];
                TurnOff("Hook");
                TurnOn("scares");
            }
            key ("scares") {
                ["Well, he is a killer. Some think he is the one responsible for the murder that happened last year."];
                TurnOff("scares");
                TurnOn(<< "killer", "murder" >>);
            }
            key ("killer") {
                ["This man they call Hook has the way of the killer about him. Thou canst see it in his eyes. I would be extremely careful if I were to run afoul of him."];
                TurnOff("killer");
            }
            key ("murder") {
                ["There was a thief named Duncan who had stolen funds from the House of Games and The Baths. I believe he may have broken into the Fellowship Hall as well. Anyway, he was arrested. But one morning, when the guard brought the man his breakfast, he was gone! Everyone thought he had escaped until his body was found in the house where old Blacktooth lives. This was before Blacktooth lived there."];
                TurnOff("murder");
                TurnOn("body");
            }
            key ("body") {
                ["It was mutilated -- his arms and legs had been cut off, and he had literally lost his head! To this day, no one knows who did it. But when Hook is around, people talk behind his back. He is certainly capable of doing it!"];
                TurnOff("body");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["Nice talking with thee. I shall see thee later, I hope."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Mandy);
    }
}

Usable MandySellsFood_i #locals(14) #uses(~LordOrLady, ~AskOrdList, ~PriceString_i, ~AskYesNo, ~SellItem_i) {
    v0 = ~LordOrLady();
    PushKeys();
    v1 = true;
    v2 = << "nothing", "mutton", "bread", "flounder", "Silverleaf", "wine", "ale" >>;
    v3 = << 0, 377, 377, 377, 377, 616, 616 >>;
    v4 = << 65177, 8, 1, 13, 31, 5, 3 >>;
    v5 = << 0, 6, 5, 5, 50, 5, 5 >>;
    v6 = "";
    v7 = 0;
    v8 = << "", " for one portion", " for one loaf", " for one portion", " for one portion", " per bottle", " per bottle" >>;
    v9 = 1;
    ["What suits thy fancy?"];
    While v1 {
        v10 = ~AskOrdList(v2);
        if (v10 = 1) {
            ["Mmmm. Thou wilt love it."];
            v1 = false;
        } else {
            if (v10 = 5) && flag(299) {
                ["I have no more left, <v0>. Silverleaf trees are no longer being cut down and my supply has diminished."];
            }
            v11 = ~PriceString_i(v8::v10, v5::v10, v7, v2::v10, v6);
            v12 = 0;
            ["^<v11> Too rich for thy blood?"];
            v13 = ~AskYesNo();
            if not v13 {
                if (v3::v10 = 377) {
                    ["How many wouldst thou like?"];
                    v12 = ~SellItem_i(true, 1, 20, v5::v10, v9, v4::v10, v3::v10);
                } else {
                    v12 = ~SellItem_i(true, 1, 0, v5::v10, v9, v4::v10, v3::v10);
                }
            }
            if (v12 = 1) {
                ["Done!"];
            } else {
                if (v12 = 2) {
                    ["Thou cannot possibly carry that much!"];
                } else {
                    if (v12 = 3) {
                        ["Thou dost not have enough gold for that!"];
                    } else {
                    }
                }
            }
            ["Wouldst thou like something else?"];
            v1 = ~AskYesNo();
        }
    }
    PopKeys();
}
