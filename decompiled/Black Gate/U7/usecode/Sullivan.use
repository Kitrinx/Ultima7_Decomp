Routine Sullivan accepts a0 #locals(8) #uses(~LordOrLady, ~AvatarName, ~IsNPCNear, ~AskList, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Sullivan);
        v0 = ~LordOrLady();
        v1 = ~AvatarName();
        v2 = ~IsNPCNear(_Anton);
        v3 = ~IsNPCNear(_Grod);
        v4 = false;
        TurnOn(<< "name", "job", "Fellowship", "bye" >>);
        if flag(738) {
            ["'Twas very kind of thee to release me from my cell. I shall now return to my former life. Good day!"*];
            terminate;
        } else {
            v5 = ~NPCToItem_i(_Sullivan);
            SetWorkType(_Wait, v5);
        }
        if not flag(706) {
            [The man in the prison greets you with a rather large smile.];
        } else {
            ["Why, hello, <v0>. In what way could I help thee this fine day?"];
        }
        converse {
            key ("name") {
                ["I am Sullivan, <v0>," he says pleasantly. "Who wouldst thou be?"*];
                v6 = "the Avatar";
                v7 = ~AskList(<< v1, v6, v0 >>);
                if (v7 = v1) {
                    ["Pleased to meet thee, <v1>." He moves his hand to shake yours but is prevented by the bars.~~"Ah, well, sorry, <v0>. Consider thyself well shaken."];
                }
                if (v7 = v0) {
                    ["Of course, <v0>. I understand." He smiles.];
                }
                if (v7 = v6) {
                    ["Oh, I see. Oops..." He shrugs.];
                    TurnOn("Oops");
                }
            }
            key ("job") {
                ["Well, in all honesty, <v0>, I have no job. Although, for a time, I was a thieving scoundrel."];
                TurnOn("scoundrel");
            }
            key ("Fellowship") {
                ["'Tis truly a fantastic group of people, <v0>. We spread guidance and prosperity to the people who reside in our fair land. Of course, at the moment, my fellow members are a bit... displeased with me."];
                if v2 {
                    [*];
                    SetSpeaker(0, _Anton);
                    ["That's a bit of an understatement!"*];
                    CloseSpeaker(_Anton);
                    SetSpeaker(0, _Sullivan);
                }
                TurnOff("Fellowship");
                TurnOn(<< "guidance", "prosperity", "displeased" >>);
            }
            key ("guidance") {
                ["The Fellowship teaches people to follow their leaders like sheep. Canst thou think of better guidance?"];
                TurnOff("guidance");
            }
            key ("prosperity") {
                ["When a member behaves properly and follows directions and so forth, he -- or she -- can hear the `inner voice' that teaches one how to win at the games. 'Tis the very reason I joined!" he grins broadly.~~"However, I have yet to hear the voice."];
                TurnOff("prosperity");
            }
            key ("displeased") {
                ["Well, apparently I hadn't striven hard enough to be deserving of the loan I... acquired from the money box upstairs."];
                TurnOff("displeased");
                TurnOn(<< "deserving", "loan" >>);
            }
            key ("deserving") {
                [As best he can, he leans toward you. For perhaps the first time in his entire life, he turns somber. "Actually, deserve is a relative term. I have finally realized -- being on the racks for many hours during the day leaves time for quite a number of realizations -- the true nature of The Fellowship. Batlin and Abraham and Danag, they all are in error.~~When the Guardian makes his appearance here in Britannia, I have no doubt he will simply eliminate everyone, including The Fellowship leaders." His smile returns.~~"That is why I decided to get everything out of The Fellowship and Britannia now, before we are all killed."];
                TurnOff("deserving");
                if not v4 {
                    TurnOn("racks");
                }
            }
            key ("loan") {
                ["Well... I was going to return the money eventually. I just needed it to win more in the games."];
                TurnOff("loan");
            }
            key ("Oops") {
                if v2 {
                    SetSpeaker(0, _Anton);
                    ["What the fool means is that he used to don a costume and pretend to be thee in an attempt to woo goods from the proprietors."*];
                    CloseSpeaker(_Anton);
                    SetSpeaker(0, _Sullivan);
                    ["Quite true, Avatar. The ruse worked far too well. 'Twas a true shame, to be honest. I should not have gotten away with it, and, indeed, am being properly castigated for it now."];
                } else {
                    ["Oh, just that I have been impersonating thee for some time now to take items from shopkeepers without paying for them. Well, -had- been actually. Now I am being properly castigated for it."];
                    if v3 {
                        [*];
                        SetSpeaker(0, _Grod);
                        ["I thank thee."*];
                        CloseSpeaker(_Grod);
                        SetSpeaker(0, _Sullivan);
                        ["Thou art welcome." He nods.*];
                    }
                }
                TurnOff("Oops");
            }
            key ("scoundrel") {
                ["Well, until I was caught, I would go from shop to shop all across Britannia, posing as `the Avatar.' The owners were all too happy to supply me with numerous gifts. Thou truly hast a good life, <v0>."];
                if v2 {
                    [*];
                    SetSpeaker(0, _Anton);
                    ["Ask him about his taxes, <v0>."*];
                    CloseSpeaker(_Anton);
                    SetSpeaker(0, _Sullivan);
                    TurnOn("taxes");
                }
                TurnOn("gifts");
                TurnOff("scoundrel");
            }
            key ("gifts") {
                ["Oh, just anything I asked for -- weapons, armour, provisions, spells. Of course, I had no real use for the spells, but it was nice to acquire them for free, regardless."];
                TurnOff("gifts");
            }
            key ("taxes") {
                [He smiles.~~"The Britannian Tax Council created a tax to raise money for the government. I did not feel like paying them," he shrugs, "so I didn't. And, of course," he says, grinning, "now they often put me on that fine rack."~~He stretches his neck and peers at the wooden slab.~~"Very fine workmanship." He nods. "Indeed, that is by far the best rack I have ever seen!"];
                TurnOff("taxes");
                if not v4 {
                    TurnOn("racks");
                }
            }
            key ("racks") {
                ["Is not that the finest rack thou hast ever seen? Exquisite workmanship, beautiful detail."];
                v4 = true;
                TurnOff("racks");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["Pleasant days, <v0>. See thee soon on the surface world!"*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Sullivan);
    }
}
