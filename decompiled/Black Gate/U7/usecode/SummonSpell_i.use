Routine SummonSpell_i accepts a0 #locals(10) #uses(~IsMagicOK_i, ~ListCount_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        Item_bark("Kal Vas Xen", item);
        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aKNEEL_FRAME_i, _aSTAND_FRAME_i, _aUP_FRAME_i, _aOUT_FRAME_i, _aTHRUST2_FRAME_i, _aSFX_i, 65, _aUSABLE_i, #SummonSpell_i >>, item);
        } else {
            v0 = ~PostAction(<< _aKNEEL_FRAME_i, _aSTAND_FRAME_i, _aUP_FRAME_i, _aOUT_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        v1 = << 528, 504, 337, 533, 154, 501, 505, 883, 274, 514, 354, 661, 706 >>;
        v2 = << 5, 15, 5, 5, 5, 5, 5, 5, 14, 5, 10, 5, 5 >>;
        v3 = << 5, 1, 5, 1, 2, 2, 2, 1, 1, 3, 1, 5, 2 >>;
        v4 = ~ListCount_i(v1);
        do {
            v5 = ~rndRange(v4, 1);
            v6 = ~rndRange(100, 1);
        } while (v2::v5 < v6);
        v7 = v3::v5;
        v8 = (v7 / 2);
        if (v8 < 1) {
            v8 = 1;
        }
        v9 = ~rndRange(v8, 1);
        if (~rndRange(2, 1) = 1) {
            v9 = (65535 * v9);
        }
        v7 = (v7 + v9);
        While v7 {
            v0 = ~Summon_i(true, v1::v5);
            v7 = (v7 - 1);
        }
    }
}
