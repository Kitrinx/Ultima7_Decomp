    v5 = << "", "", "", "a ", "a ", "a ", "a ", "", "a " >>;
    v6 = << 0, 1, 1, 0, 0, 0, 0, 1, 0 >>;
    v7 = << "", " per pair", " per pair", "", "", "", "", " per pair", "" >>;
    v8 = 65177;
    v9 = 1;
    ["What form of protection wouldst thou like to buy?"];
    While v1 {
        v10 = ~AskOrdList(v2);
        if (v10 = 1) {
            ["Very well."];
            v1 = false;
        } else {
            v11 = ~PriceString_i(v7::v10, v4::v10, v6::v10, v2::v10, v5::v10);
            v12 = 0;
