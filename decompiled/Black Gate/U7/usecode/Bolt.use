Routine Bolt accepts a0 #locals(1) #uses(~AvatarName) {
    if (event = _Action) {
        v0 = ~AvatarName();
        if ~IsNPCNear_i(_Iolo) {
            SetSpeaker(0, _Iolo);
            ["<v0> dost thou notice the unique Iolo trademark on these bolts?  They are designed for maximum performance with genuine IOLO crossbows, available at a location near Yew."];
            CloseSpeaker(_Iolo);
        }
    }
}
