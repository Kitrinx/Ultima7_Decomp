Routine SetOrreryEgg_i accepts a0 #locals(2) {
    if (event = _Trigger) {
        if (item = 0) {
            v0 = << 2892, 1420, 0 >>;
        } else {
            v0 = ~GetCoord(item);
        }
        v1 = 0;
        if flag(493) {
            v1 = (v1 + 1);
        }
        if $ORB_FIXED_TIMELORD {
            v1 = (v1 + 1);
        }
        if flag(482) {
            v1 = (v1 + 1);
        }
        if flag(599) {
            v1 = (v1 + 1);
        }
        if flag(481) {
            v1 = (v1 + 1);
        }
        if $TetraGone {
            v1 = (v1 + 1);
        }
        if flag(301) {
            v1 = (v1 + 1);
        }
        if $SphereGone {
            v1 = (v1 + 1);
        }
        if $CubeGone {
            v1 = (v1 + 1);
        }
        SetOrrery_i(v1, v0);
    }
}
