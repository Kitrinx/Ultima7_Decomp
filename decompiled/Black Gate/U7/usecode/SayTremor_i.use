Routine SayTremor_i accepts a0 #locals(0) #uses(MemberSays_i) {
    if (~Item_getType(item) = _Egg) {
        MemberSays_i("@It would seem the nearby island is not at all stable.@");
    }
    if ((~Item_getType(item) = _Avatar_721) or (~Item_getType(item) = _Avatar_989)) {
        MemberSays_i("@All is not right in Britannia. Perhaps Lord British will know the reason behind this tremor.@");
    }
}
