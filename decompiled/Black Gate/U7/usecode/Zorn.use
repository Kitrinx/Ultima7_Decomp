    v2 = << 0, 539, 571, 575, 580, 541, 573, 576, 542 >>;
    v3 = << 0, 80, 100, 50, 20, 150, 300, 120, 60 >>;
    v4 = 65177;
    v5 = << "", "a ", "", "", "", "a ", "", "", "a " >>;
    v6 = << 0, 0, 0, 1, 1, 0, 0, 1, 0 >>;
    v7 = << "", "", "", " for a pair", " for a pair", "", "", " for a pair", "" >>;
    v8 = 1;
    ["What wouldst thou like to buy?"];
    While v0 {
        v9 = ~AskOrdList(v1);
        if (v9 = 1) {
