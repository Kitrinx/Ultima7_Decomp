Routine Sails accepts a0 #locals(5) #uses(MemberSays_i, ~IsPartySeated_i, LaunchShip_i, ~LoadBarge_i, SetSails_i) {
    if (event <> _Action) {
        return;
    }
    if ~InGumpMode_i() {
        closeAllGumps();
    }
    if ~GetBarge_i(item) {
        v0 = ~FindNearby_i(0, 5, _Mast, item);
        v1 = ~FindNearby_i(0, 5, _Sails, item);
        if not (item in v1) {
            v1 = (v1 & item);
        }
        if not ~GetItemFlag_i(_OnMovingBarge_i, _Avatar) {
            v2 = ~GetQuality(item);
            v3 = ~CountItem(_All, v2, _Scroll, _Party);
            if not v3 {
                if (~ListSize_i(~GetParty()) = 1) {
                    MemberSays_i("@The deed for this vessel must first be purchased.@");
                } else {
                    MemberSays_i("@We must purchase the deed for this vessel before we sail her.@");
                }
                return;
            }
            if ~IsPartySeated_i() {
                LaunchShip_i(item);
            } else {
                v4 = ~LoadBarge_i(v0::1);
                SetItemFlag_i(20, item);
            }
        } else {
            ClearItemFlag_i(20, item);
            SetSails_i(0, v1);
            ClearItemFlag_i(_OnMovingBarge_i, item);
            ClearItemFlag_i(_ActiveBarge_i, item);
