        } else {
            if (v14 = 1) {
                v15 = ~CountItem(_All, _All, _Gold_Coin, _Party);
                [You gather your gold and count it, finding that you have <v15> gold altogether.];
                if (v15 < v0) {
                    ["It appears that thou dost not seem to have enough gold to train here. If thou couldst return later after thy pockets are filled..."];
