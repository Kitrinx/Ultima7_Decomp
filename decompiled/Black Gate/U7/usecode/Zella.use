            }
            if (v14 = 2) {
                ["It appears that thou art already as proficient as I! I am afraid that thou cannot be trained further here."];
            } else {
                [You pay <v0> gold.];
                v16 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, v0);
                [Zella begins the session by showing <v3> the proper stance when 'boxing'.~~"'Tis all contingent on balance. Use thy weight to control thy movement. Step lightly. 'Tis almost like a dance." Zella shows <v3> some steps, sparring into the air. <v5> <v6> him and slowly <v7> a feel for the technique. After a while it becomes second nature. The two of <v8> take jabs at each other, and <v3> <v12> proper defensive maneuvers. When the session is over, <v9> <v10> <v9> <v11> a better grip on the concept of 'boxing'.];
                v17 = ~GetStat(_Dex, v2);
                v18 = ~GetStat(_Cbt, v2);
                if (v17 < 30) {
                    DexTrain(1, v2);
                }
                if (v18 < 30) {
