    v2 = 377;
    v3 = << 65177, 8, 9, 10, 11, 12, 13, 14, 15 >>;
    v4 = << 0, 3, 20, 3, 20, 5, 7, 3, 2 >>;
    v5 = "";
    v6 = 0;
    v7 = << "", " for one portion", " for one portion", " for one", " for one slice", " for one", " for one", " for one portion", " for ten portions" >>;
    v8 = << 0, 1, 1, 1, 1, 1, 1, 1, 10 >>;
    ["What wouldst thou like to buy?"];
    While v0 {
        v9 = ~AskOrdList(v1);
        if (v9 = 1) {
            ["Fine."];
            v0 = false;
        } else {
            v10 = ~PriceString_i(v7::v9, v4::v9, v6, v1::v9, v5);
            v11 = 0;
            ["^<v10> Does that sound like a fair price?"];
            v12 = ~AskYesNo();
            if v12 {
                v10 = "How many ";
                if (v8::v9 > 1) {
                    v10 = (v10 + "sets ");
                }
                v10 = (v10 + "wouldst thou like?");
                ["<v10>"];
                v11 = ~SellItem_i(true, 1, 20, v4::v9, v8::v9, v3::v9, v2);
            }
            if (v11 = 1) {
                ["Done!"];
            } else {
                if (v11 = 2) {
                    ["Thou cannot possibly carry that much!"];
                } else {
                    if (v11 = 3) {
                        ["Thou dost not have enough gold for that!"];
                    } else {
                    }
                }
            }
            ["Wouldst thou like something else?"];
            v0 = ~AskYesNo();
        }
    }
    PopKeys();
}
