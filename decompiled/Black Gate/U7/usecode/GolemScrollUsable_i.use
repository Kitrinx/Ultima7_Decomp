        v17 = ~Item_create(_Body_414);
        SetFrame(5, v17);
        v18 = ~PopToMap(v16);
        v19 = ~Item_create(_Scroll);
        v18 = ~SetQuality(244, v19);
        SetFrame(4, v19);
        v18 = ~PopToNPC(v17);
        v20 = ~Item_create(_Small_Rock);
        SetFrame(10, v20);
