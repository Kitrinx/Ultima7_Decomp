Routine Candice accepts a0 #locals(6) #uses(~IsNearEachOther_i, ~IsNPCNear, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Candice);
        v0 = ~GetWorkType(~NPCToItem_i(_Candice));
        v1 = ~IsMedallionOn_i();
        v2 = ~GetTime();
        if (v2 = 7) {
            v3 = ~IsNearEachOther_i(_Batlin, _Candice);
            if v3 {
                [Candice is listening intently to the Fellowship meeting.*];
                terminate;
            } else {
                if $BATLIN_MISSING {
                    ["Hast thou seen Batlin? He has not shown up for the Fellowship meeting!"];
                    goto label_9;
                } else {
                    ["Oh! I must not stop to speak with thee! I am late for a Fellowship meeting!"*];
                    terminate;
                }
            }
        }
        label_9:
        TurnOn(<< "name", "job", "bye" >>);
        if not $MET_CANDICE {
            [This is a bright woman who looks much younger than she actually is.];
            ["Well! Thy reputation precedes thee! The Avatar in person! Word has spread that thou wert in Britain!"];
            $MET_CANDICE = true;
        } else {
            if (v2 = 0) {
                v4 = ~IsNPCNear(_Patterson);
                if v4 {
                    [Candice looks guilty about something. She gives you a little wave, but says nothing. She looks at Patterson, hoping that he will do the talking.*];
                    terminate;
                } else {
                    ["Yes, Avatar?" Candice says.];
                }
            } else {
                ["Yes, Avatar?" Candice says.];
            }
        }
        converse {
            key ("name") {
                ["My name is Candice," she says brightly. "I must say I am honored to meet the Avatar!" She curtsies.];
                TurnOff("name");
            }
            key ("job") {
                ["I am the curator of the Royal Museum.];
                if (v0 = 7) {
                    ["Feel free to ask about any of the exhibits.];
                } else {
                    ["I hope to see thee there when the museum is open.];
                }
                ["I spend the rest of my time working with The Fellowship."];
                TurnOn(<< "Royal Museum", "exhibits", "Fellowship" >>);
            }
            key ("Royal Museum") {
                ["It has been in Britain for many, many years. It contains historical artifacts, as well as works of art."];
                TurnOff("Royal Museum");
                TurnOn(<< "artifacts", "works of art" >>);
            }
            key ("exhibits") {
                if (v0 = 7) {
                    ["We have just opened a special section in which thou might be interested -- an exhibit of 'Avatar artifacts'!"];
                    TurnOn("Avatar artifacts");
                } else {
                    ["Come to the museum when it is open!"];
                }
                TurnOff("exhibits");
            }
            key ("artifacts") {
                ["There are relics from early Britannia and even from the Three Ages of Darkness -- back when Britannia was known as Sosaria."];
                TurnOff("artifacts");
            }
            key ("Avatar artifacts") {
                ["Well, thou surely must recognize them. They are supposed to be authentic! Things like the Silver Horn and the eight stones. I understand the stones were used for teleportation, and if mages were not so sick in the head these days, they could cast a 'Recall' spell on them to teleport to specific places around Britannia. I believe if one casts a 'Mark' spell on one, thou canst re-assign the teleportation location! But I suppose none of that works anymore."];
                v5 = ~IsNPCNear(_Iolo);
                if v5 {
                    SetSpeaker(0, _Iolo);
                    [Iolo whispers to you, "Er, Avatar, thou dost know that I do not condone stealing. But, er, I do believe these stones may be useful to us. Perhaps we should come back later when the museum is closed, if thou dost know what I mean? After all, these items technically belong to thee!"];
                    CloseSpeaker(_Iolo);
                    SetSpeaker(0, _Candice);
                }
                TurnOff("Avatar artifacts");
            }
            key ("works of art") {
                ["Britannia is proud of the artists who donate their works to the museum. Thou wilt see pieces all over the country by Britannian artists Watson, Richard Fox, Randi Frank, Glen Johnson, and Denis Loubet."];
                TurnOff("works of art");
            }
            key ("Fellowship") {
                if not v1 {
                    ["We meet every evening at the Hall. Thou must come and visit!];
                } else {
                    ["Thou must know all about it by now! I hope to see thee at an evening meeting!];
                }
                ["The Fellowship has given me a great purpose in life. I have made new friends, and have even found love!" She giggles. "Ooops! I gave away my secret! I must not speak of it. Do forget I said that, please?"];
                TurnOff("Fellowship");
                TurnOn(<< "purpose", "secret" >>);
            }
            key ("purpose") {
                ["I want to attain a higher level of acceptance in The Fellowship. I want to hear the 'voice'. That is mine one true goal."];
                TurnOff("purpose");
                TurnOn("voice");
            }
            key ("voice") {
                ["Dost thou not know? The longer one is a member of The Fellowship, the greater the chances that one will hear the 'voice'. Supposedly, it is a man's voice that thou wilt hear -- perhaps in thy dreams, perhaps while thou art concentrating on something else -- it is a voice that tells thee things, suggests things. I do not know, really. I have not heard it yet, so I am only speaking of what I have heard from others more fortunate than I."];
                TurnOff("voice");
                $HEARD_ABOUT_VOICE = true;
            }
            key ("secret") {
                ["What secret? I do -not- have a secret! It was a slip of the tongue. I cannot really speak to anyone about it. Why, if word got out that the Mayor and I... I mean, uhm, -may- I... er, ask thee to forget that I said anything?"~~Candice turns beet red and turns away.*];
                $HEARD_ABOUT_PATTERSONS_AFFAIR = true;
                terminate;
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["Good day, Avatar."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Candice);
    }
}
