Routine HealSpell_i accepts a0 #locals(6) #uses(~DirFromAvatar_i, ~IsMagicOK_i) {
    if (event = _Action) {
        v0 = ~GetTarget();
        v1 = ~DirFromAvatar_i(v0);
        Kernel_resetRef(item);
        Item_bark("@Mani@", item);
        if (~IsMagicOK_i() and ~Item_isNpc(v0)) {
            v2 = ~PostAction(<< _aFACE_i, v1, _aKNEEL_FRAME_i, _aSFX_i, 64, _aSTAND_FRAME_i, _aEXTEND1_FRAME_i, _aRAISE1_FRAME_i, _aTHRUST1_FRAME_i >>, item);
            v2 = ~PostInFuture(5, << _aNO_HALT_i, _aUSABLE_i, #HealSpell_i >>, v0);
        } else {
            v2 = ~PostAction(<< _aFACE_i, v1, _aKNEEL_FRAME_i, _aSTAND_FRAME_i, _aEXTEND1_FRAME_i, _aRAISE1_FRAME_i, _aTHRUST1_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        v3 = ~GetNPCStat_i(_Str, item);
        v4 = ~GetNPCStat_i(_Hits, item);
        if (v4 <= v3) {
            v5 = ((v3 - v4) / 2);
            v2 = ~ChangeNPCStat_i(v5, _Hits, item);
        }
    }
}
