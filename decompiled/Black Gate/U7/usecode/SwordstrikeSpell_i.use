Routine SwordstrikeSpell_i accepts a0 #locals(4) #uses(~DirFromAvatar_i, ~IsMagicOK_i) {
    if ((event = _Action) or (event = _Combat)) {
        Kernel_resetRef(item);
        v0 = ~GetTarget();
        v1 = ~DirFromAvatar_i(v0);
        Item_bark("@In Jux Por Ylem@", item);
        if ~IsMagicOK_i() {
            v2 = ~SetAttack_i(_Swordstrike, v0, item);
            v3 = ~PostAction(<< _aFACE_i, v1, _aSFX_i, 65, _aRAISE1_FRAME_i, _aSTAND_FRAME_i, _aUP_FRAME_i, _aSTAND_FRAME_i, _aTHRUST1_FRAME_i, _aTHRUST2_FRAME_i, _aATTACK_i, _aSTAND_FRAME_i >>, item);
        } else {
            v3 = ~PostAction(<< _aFACE_i, v1, _aRAISE1_FRAME_i, _aSTAND_FRAME_i, _aUP_FRAME_i, _aSTAND_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
}
