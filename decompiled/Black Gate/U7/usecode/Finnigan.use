Routine Finnigan accepts a0 #locals(15) #uses(~LordOrLady, ~AvatarName, ~IsNPCNear, ~AskYesNo, ~AskList, StartInvestigation_i, AskStablesSearch_i, AskInvestigationReport_i, ~AskMapQuiz_i, GivePartyExp_i, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Finnigan);
        v0 = ~LordOrLady();
        v1 = ~AvatarName();
        v2 = ~IsNPCNear(_Spark);
        v3 = ~AvatarSex();
        if (($TRINSIC_INVESTIGATION = true) and ($SPARK_KEY_TOPIC = false)) {
            ["Hast thou properly searched the stables?"];
            if ~AskYesNo() {
                ["What didst thou find?"];
                ClearKeys();
                v4 = << "nothing", "a bucket", "a body" >>;
                if $FOUND_BUCKET_KEY {
                    v4 = (v4 & "a key");
                }
                v5 = ~AskList(v4);
                if (v5 = "a key") {
                    if not v2 {
                        ["Hmmm, a key. Perhaps if thou dost ask Christopher's son about it, he may know what it is for."];
                    } else {
                        ["Ask Spark about it. He may know something."];
                    }
                    $SPARK_KEY_TOPIC = true;
                    goto label_40;
                }
                if (v5 = "a body") {
                    ["I know that! What ELSE didst thou find? Thou shouldst look again, Avatar!"*];
                    terminate;
                }
                if (v5 = "a bucket") {
                    ["Yes, obviously it is filled with poor Christopher's own blood. But surely there was something else that might point us in the direction of the killer or killers - thou shouldst look again, Avatar."*];
                    terminate;
                }
                if (v5 = "nothing") {
                    ["Thou shouldst look again, 'Avatar'!"*];
                    terminate;
                }
            } else {
                ["Well, do so, then come speak with me!"*];
                terminate;
            }
        }
        if $REFUSED_MURDER_INVESTIGATION {
            ["Hmmm. Hast thou reconsidered mine offer to investigate the murder?"];
            if ~AskYesNo() {
                ["Splendid. Then thou must really be the Avatar after all!"];
                $REFUSED_MURDER_INVESTIGATION = false;
                StartInvestigation_i();
                goto label_40;
            } else {
                ["Then leave our people to work it out for themselves."*];
                CloseSpeaker(_Finnigan);
                v6 = ~IsNPCNear(_Iolo);
                if v6 {
                    SetSpeaker(0, _Iolo);
                    ["Avatar! I am ashamed of thee! Thou shouldst reconsider!"*];
                    CloseSpeaker(_Iolo);
                }
                terminate;
            }
        }
        if not $MetFinnigan {
            Kernel_resetRef(item);
            SetWorkType(_Loiter, ~NPCToItem_i(_Finnigan));
            [You see a middle-aged nobleman.];
            $MetFinnigan = true;
            v6 = ~IsNPCNear(_Iolo);
            if v6 {
                ["Iolo! Who is this stranger?"*];
                SetSpeaker(0, _Iolo);
                ["Why, this is the Avatar!" Iolo proudly proclaims. "Canst thou believe it? May I introduce thee? This is Finnigan, the Town Mayor. And this is <v1>, the Avatar!];
                if v3 {
                    ["I simply cannot believe she is here!"*];
                } else {
                    ["I simply cannot believe he is here!"*];
                }
                SetSpeaker(0, _Finnigan);
                [The Mayor looks you up and down, not sure if he believes Iolo or not. He looks at Iolo skeptically.];
                SetSpeaker(0, _Iolo);
                ["I swear to thee, it is the Avatar!"];
                CloseSpeaker(_Iolo);
                SetSpeaker(0, _Finnigan);
            } else {
                ["I have heard that thou art the Avatar. I am not certain that I believe it.];
            }
            [The mayor looks at you again as if he were studying every pore on your face. Finally, he smiles.];
            ["Welcome, Avatar."];
            [But just as suddenly, Finnigan's face becomes stern.];
            ["A horrible murder has occurred. If thou art truly the Avatar, perhaps thou canst help us solve it. I would feel better if thou takest this matter into thine hands. Thou shalt be handsomely rewarded if thou dost discover the name of the killer. Dost thou accept?"];
            v5 = ~AskYesNo();
            if v5 {
                v7 = ~IsNPCNear(_Petre);
                if v7 {
                    ["Petre here knows something about all of this."*];
                    SetSpeaker(0, _Petre);
                    [The peasant interjects. "I discovered poor Christopher and the Gargoyle Inamo early this morning."*];
                    CloseSpeaker(_Petre);
                } else {
                    SetSpeaker(0, _Finnigan);
                    ["Petre, the stables caretaker, discovered poor Christopher and Inamo early this morning."];
                }
                SetSpeaker(0, _Finnigan);
                [The Mayor continues. "Hast thou searched the stables?"];
                AskStablesSearch_i();
            } else {
                ["Well, thou could not be the real Avatar then!"*];
                $REFUSED_MURDER_INVESTIGATION = true;
                terminate;
            }
        } else {
            ["Yes, Avatar?" Finnigan asks.];
        }
        label_40:
        TurnOn(<< "name", "job", "murder", "bye" >>);
        if $FINNIGAN_STABLES_CHECKED {
            TurnOn("report");
        }
        if $FOUND_MEDALLION {
            TurnOn(<< "Fellowship", "Klog" >>);
        }
        if ($PASSWORD_ATTEMPTED and not $SEARCHED_STABLES) {
            TurnOn("password");
        }
        if ($AskedForPassword and not $GotPassword) {
            TurnOn("Pay me now, please");
        }
        converse {
            key ("name") {
                ["My name is Finnigan."];
                TurnOff("name");
            }
            key ("job") {
                ["I am the Mayor of Trinsic and have been since I arrived here three years ago."];
                TurnOn("Trinsic");
            }
            key ("Trinsic") {
                if v3 {
                    v8 = "by one who claimed she was the Avatar.";
                } else {
                    v8 = "by one who claimed he was the Avatar.";
                }
                ["Trinsic was once the city of Honor. I suppose it still is. Our Rune of Honor was taken many years ago <v8> I believe it now resides in the Royal Museum in Britain, yet the empty pedestal still remains in the center of town. I feel this is symbolic of the town itself. It is rather empty -- of people, of life, and of honor. 'Tis sad, really."];
                ["Then there is this murder, of course. We have temporarily closed the gates of the city and require a password to get in or out."];
                TurnOff("Trinsic");
                TurnOn("password");
            }
            key ("Pay me now, please") {
                ["Of course, <v1>. Here is thy gold."];
                v9 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, 100);
                if not v9 {
                    ["Oh, I am sorry, <v1>. Thou still cannot carry this amount. Thou must return to me later."];
                } else {
                    ["Here thou art."];
                    $AskedForPassword = false;
                    $GotPassword = true;
                }
                TurnOff("Pay me now, please");
            }
            key ("murder") {
                if not $SEARCHED_STABLES {
                    ["A crime like this has never happened in Trinsic before. I cannot believe this happened to Christopher and Inamo. Please -- explore the town! I would appreciate it if thou wouldst bring me a report on thy progress. Be sure to ask everyone in town about the murder. After speaking with Christopher's son, thou mightest next want to speak with Gilberto, the guard on watch at the dock last night."];
                    [The mayor hesitates, then leans in to speak quietly.];
                    ["Actually, I have seen something like this before. It was about four years ago, in Britain."];
                    TurnOn(<< "Gilberto", "Christopher", "Inamo", "Britain", "report" >>);
                    $FINNIGAN_STABLES_CHECKED = true;
                    TurnOff("murder");
                } else {
                    ["I hope thou art progressing on the murder investigation."];
                }
            }
            key ("Britain") {
                ["'Twas before I came to Trinsic. There was a murder with strikingly similar aspects. A body was found mutilated exactly like poor Christopher. It appeared to be a ritualistic killing. I would wager that whoever was responsible for that murder is the culprit behind this one."];
                TurnOff("Britain");
            }
            key ("son") {
                ["Christopher's son is called Spark. Their house is in the northwest area of town."];
                TurnOff("son");
            }
            key ("Gilberto") {
                ["He was struck from behind early this morning and was knocked senseless. Johnson, the morning watch, found him unconscious. He is recuperating at Chantu the Healer's house on the west side of town."];
                TurnOff("Gilberto");
                TurnOn(<< "Johnson", "Chantu" >>);
            }
            key ("Chantu") {
                ["He is our town healer. He hath been here for years. Nice fellow."];
                TurnOff("Chantu");
            }
            key ("report") {
                if $GotPassword {
                    ["I am satisfied with thy report. Please carry on thine investigation, Avatar."];
                } else {
                    if not $FINNIGAN_EXTRA {
                        ["Art thou ready to answer some questions concerning the investigation?"];
                        v10 = ~AskYesNo();
                        if v10 {
                            $FINNIGAN_EXTRA = true;
                            AskInvestigationReport_i();
                        } else {
                            ["Oh. Well, carry on with thine investigation."];
                        }
                    } else {
                        ["Shall we continue thy report?"];
                        v11 = ~AskYesNo();
                        if v11 {
                            AskInvestigationReport_i();
                        } else {
                            ["Oh. Well, carry on with thine investigation."];
                        }
                    }
                }
                TurnOff("report");
            }
            key ("Fellowship") {
                ["Why, they are an extremely helpful group. Their branch office is just east of mine. Very optimistic group of people."];
                TurnOff("Fellowship");
            }
            key ("Klog") {
                ["He is the Fellowship branch leader. Kind man."];
                TurnOff("Klog");
            }
            key ("Johnson") {
                ["He is probably at the dock right now."];
                TurnOff("Johnson");
            }
            key ("Christopher") {
                ["Christopher was the local blacksmith. He lives, or rather -lived-, with his son in the northwest part of town. The blacksmith's shop is in the southwest corner. Christopher was not a rich man by any means -- he barely kept himself and his son alive. But he certainly enjoyed his work."];
                TurnOff("Christopher");
                TurnOn("son");
            }
            key ("Inamo") {
                ["The Gargoyle Inamo slept in the stables, as I understand it. I believe he emigrated here from Terfin a few months ago. It seems that he was merely a chance victim of someone intent on violence."];
                TurnOff("Inamo");
            }
            key ("password") {
                if ($GotPassword and not $SEARCHED_STABLES) {
                    ["Oh, dost thou want the password now?"];
                    if ~AskYesNo() {
                        if ~AskMapQuiz_i() {
                            ["Excellent! I have no doubts now that thou art the one true Avatar!"];
                            ["Oh-- I almost forgot! The password to leave or enter the town is `Blackbird'!"*];
                            $SEARCHED_STABLES = true;
                            GivePartyExp_i(100);
                            terminate;
                        } else {
                            ["Hmmm. I am afraid that I still have my doubts about thou being the Avatar. My public duty disallows me to give thee the password. I am sorry."];
                            terminate;
                        }
                    } else {
                        [The Mayor shrugs and looks at you as if you were mad.*];
                        terminate;
                    }
                } else {
                    ["I will give thee the password when thou hast given me a report on the progress of thine investigation."];
                    TurnOn("report");
                    $PASSWORD_ATTEMPTED = true;
                }
                TurnOff("password");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        [The Mayor nods his head at you and goes on about his business.*];
    }
    if (event = _Bark) {
        v12 = ~GetWorkType(~NPCToItem_i(_Finnigan));
        v13 = ~rndRange(4, 1);
        if (v12 = 11) {
            if (v13 = 1) {
                v14 = "@What a day...@";
            }
            if (v13 = 2) {
                v14 = "@Another day, another gold coin...@";
            }
            if (v13 = 3) {
                v14 = "@I shall search the area here...@";
            }
            if (v13 = 4) {
                v14 = "@I am too old for this...@";
            }
            Item_bark(v14, _Finnigan);
        } else {
            BarkAboutWork_i(_Finnigan);
        }
    }
}

Usable StartInvestigation_i #locals(1) #uses(~IsNPCNear, AskStablesSearch_i) {
    SetSpeaker(0, _Finnigan);
    v0 = ~IsNPCNear(_Petre);
    if v0 {
        ["Petre here knows something about all of this."*];
        SetSpeaker(0, _Petre);
        [The peasant interjects. "I discovered poor Christopher and the Gargoyle Inamo early this morning."*];
        CloseSpeaker(_Petre);
    } else {
        SetSpeaker(0, _Finnigan);
        ["Petre the stables caretaker discovered poor Christopher and Inamo early this morning."];
    }
    SetSpeaker(0, _Finnigan);
    [The Mayor continues. "Hast thou searched the stables?"];
    AskStablesSearch_i();
}

Usable AskInvestigationReport_i #locals(6) #uses(~LordOrLady, ~AskList, ~AskYesNo, ~AskMapQuiz_i, GivePartyExp_i) {
    v0 = ~LordOrLady();
    ClearKeys();
    if not flag(94) {
        ["Very well. What was Christopher's occupation?"];
        v1 = ~AskList(<< "tailor", "blacksmith", "provisioner", "barkeep" >>);
        if (v1 = "blacksmith") {
            flag(94) = true;
        } else {
            ["That is not right. Thou shouldst do some more work."*];
            terminate;
        }
    }
    if not flag(95) {
        ClearKeys();
        ["What didst thou find at the murder site?"];
        v1 = ~AskList(<< "nothing", "a body", "a key", "a bucket" >>);
        if (v1 = "a key") {
            flag(95) = true;
        }
        if (v1 = "a body") {
            ["I know that! What ELSE didst thou find? Thou shouldst look again, Avatar!"*];
            terminate;
        }
        if (v1 = "a bucket") {
            ["Yes, obviously it is filled with poor Christopher's own blood. But surely there was something else that might point us in the direction of the killer or killers - thou shouldst look again, Avatar."*];
            terminate;
        }
        if (v1 = "nothing") {
            ["Thou shouldst look again, 'Avatar'!"*];
            terminate;
        }
    }
    if not flag(96) {
        ClearKeys();
        ["What did the key open?"];
        v1 = ~AskList(<< "a book", "a door", "a trap door", "a chest" >>);
        if (v1 = "a chest") {
            flag(96) = true;
        } else {
            ["I do not think that is correct."*];
            terminate;
        }
    }
    if not flag(97) {
        ClearKeys();
        ["What didst thou find in the chest?"];
        v1 = ~AskList(<< "gold", "a medallion", "a scroll", "none of these", "all of these" >>);
        if (v1 = "all of these") {
            ClearKeys();
            ["Dost thou have a suspect?"];
            if ~AskYesNo() {
                flag(97) = true;
            } else {
                ["Well, continue to gather information until thou dost have one."*];
                terminate;
            }
        }
        if ((v1 = "gold") or ((v1 = "a medallion") or (v1 = "a scroll"))) {
            ["Hmmm. I cannot believe that was all. Perhaps thou shouldst search again."*];
            terminate;
        }
        if (v1 = "none of these") {
            ["I do not believe thou hast searched properly."*];
            terminate;
        }
    }
    if not flag(98) {
        ClearKeys();
        ["What dost this villain look like?"];
        v2 = << "I don't know", "scar", "pegleg", "eyepatch" >>;
        if $FOUND_SCROLL {
            v2 = (v2 & "hook");
        }
        v3 = ~AskList(v2);
        if (v3 = "hook") {
            flag(98) = true;
        } else {
            ["That is not satisfactory. Thou must needs continue thy search, Avatar."*];
            terminate;
        }
    }
    if not flag(99) {
        ClearKeys();
        ["Hmmm. Any leads on finding this villain?"];
        v2 = << "I don't know", "Could be anywhere", "No one saw him" >>;
        if $LEARNED_ABOUT_CROWN_JEWEL {
            v2 = (v2 & "Crown Jewel");
        }
        v4 = ~AskList(v2);
        if (v4 = "Crown Jewel") {
            flag(99) = true;
            [The Mayor is pleased.~~"It seems that thou art pursuing thine investigation with genuine fervor. Methinks thou shouldst go to Britain and see if thou canst find this Man with a Hook."];
            if not $GotPassword {
                ["Here is half of thy reward money. Thou wilt receive the rest when thou dost prove that the killer hath been brought to justice!"];
                v5 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, 100);
                if not v5 {
                    ["Thou dost not have enough companions to carry thy reward! Thou must return to me later, and I will give thee thy gold."];
                    $AskedForPassword = true;
                } else {
                    [The Mayor hands you 100 gold coins.];
                    $GotPassword = true;
                    $AskedForPassword = false;
                }
            }
            ["Dost thou need the password?"];
            $PASSWORD_ATTEMPTED = true;
            if ~AskYesNo() {
                if ~AskMapQuiz_i() {
                    ["Excellent! I have no doubt now that thou art the one true Avatar!"];
                    ["Oh-- I almost forgot! The password to leave or enter the town is `Blackbird'!"*];
                    $SEARCHED_STABLES = true;
                    GivePartyExp_i(100);
                    terminate;
                } else {
                    ["Hmmm. I am afraid that I still have my doubts about thou being the Avatar. My public duty disallows me to give thee the password. I am sorry."];
                    terminate;
                }
            } else {
                ["All right then. Thou dost know that thou must have the password to leave or enter our town? I ask again -- dost thou wish to know the password?"];
                if ~AskYesNo() {
                    if ~AskMapQuiz_i() {
                        ["Excellent! I have no doubt now that thou art the one true Avatar!"];
                        ["Oh-- I almost forgot! The password to leave or enter the town is `Blackbird'!"*];
                        $SEARCHED_STABLES = true;
                        GivePartyExp_i(100);
                        terminate;
                    } else {
                        ["Hmmm. I am afraid that I still have my doubts about thou being the Avatar. My public duty disallows me to give thee the password. I am sorry."];
                        terminate;
                    }
                } else {
                    ["All right, <v0>. I thank thee for all thine help."*];
                    terminate;
                }
            }
        } else {
            ["Hmmm. Methinks thou shouldst continue the investigation. Be sure to talk with Gilberto and Johnson. Question them closely."*];
            terminate;
        }
    }
}

Usable AskStablesSearch_i #locals(2) #uses(~AskYesNo, ~AskList) {
    if ~AskYesNo() {
        ["What didst thou find?"];
        ClearKeys();
        v0 = << "nothing", "a bucket", "a body" >>;
        if $FOUND_BUCKET_KEY {
            v0 = (v0 & "a key");
        }
        v1 = ~AskList(v0);
        if (v1 = "a key") {
            ["Hmmm, a key. Perhaps if thou dost ask Christopher's son about it, he may know what it is for."];
            $SPARK_KEY_TOPIC = true;
        }
        if (v1 = "a body") {
            ["I know that! What -else- didst thou find? Thou shouldst look again, Avatar!"*];
            $TRINSIC_INVESTIGATION = true;
            terminate;
        }
        if (v1 = "a bucket") {
            ["Yes, obviously it is filled with poor Christopher's own blood. But surely there was something else that might point us in the direction of the killer or killers - thou shouldst look again, Avatar."*];
            $TRINSIC_INVESTIGATION = true;
            terminate;
        }
        if (v1 = "nothing") {
            ["Thou shouldst look again, `Avatar'!"*];
            $TRINSIC_INVESTIGATION = true;
            terminate;
        }
    } else {
        ["Then I suggest that thou lookest inside and talkest to me again."*];
        $TRINSIC_INVESTIGATION = true;
        terminate;
    }
}

Function ~AskMapQuiz_i #locals(31) {
    v0 = << 0, 0, 0 >>;
    v1 = << 1, 2, 3 >>;
    v2 = false;
    if (not flag(42) and (not flag(43) and (not flag(44) and (not flag(45) and (not flag(46) and (not flag(47) and (not flag(48) and not flag(49)))))))) {
        Foreach v5 in v1 {
            loop {
                v6 = ~rndRange(8, 1);
            } while (v6 in v0) {
                continue;
                goto label_7;
            }
            v0::v5 = v6;
            label_7:
        }
        Foreach v5 in v1 {
            if (v0::v5 = 1) {
                flag(42) = true;
            }
        }
        Foreach v5 in v1 {
            if (v0::v5 = 2) {
                flag(43) = true;
            }
        }
        Foreach v5 in v1 {
            if (v0::v5 = 3) {
                flag(44) = true;
            }
        }
        Foreach v5 in v1 {
            if (v0::v5 = 4) {
                flag(45) = true;
            }
        }
        Foreach v5 in v1 {
            if (v0::v5 = 5) {
                flag(46) = true;
            }
        }
        Foreach v5 in v1 {
            if (v0::v5 = 6) {
                flag(47) = true;
            }
        }
        Foreach v5 in v1 {
            if (v0::v5 = 7) {
                flag(48) = true;
            }
        }
        Foreach v5 in v1 {
            if (v0::v5 = 8) {
                flag(49) = true;
            }
        }
    } else {
        Foreach v5 in v1 {
            if (flag(42) and not (1 in v0)) {
                v0::v5 = 1;
            }
            if (flag(43) and not (2 in v0)) {
                v0::v5 = 2;
            }
            if (flag(44) and not (3 in v0)) {
                v0::v5 = 3;
            }
            if (flag(45) and not (4 in v0)) {
                v0::v5 = 4;
            }
            if (flag(46) and not (5 in v0)) {
                v0::v5 = 5;
            }
            if (flag(47) and not (6 in v0)) {
                v0::v5 = 6;
            }
            if (flag(48) and not (7 in v0)) {
                v0::v5 = 7;
            }
            if (flag(49) and not (8 in v0)) {
                v0::v5 = 8;
            }
        }
    }
    v25 = << "What is the latitude of the northern-most point of the island Spektran?", "What longitude runs through the center of the island Buccaneer's Den?", "What longitude runs through the center of the island Terfin?", "What latitude runs through the center of Dagger Isle?", "What latitude runs through the center of Skara Brae?", "What latitude runs through the center of the Deep Forest?", "What latitude runs through the center of Buccaneer's Den?", "What longitude runs through the center of Skara Brae?" >>;
    v26 = << 120, 60, 120, 0, 30, 60, 60, 60 >>;
    ["Before I give thee the password, I must admit I have had my doubts about thou truly being the Avatar. I must ask thee to indulge me in order to satisfy my somewhat suspicious nature. I shall ask thee a few questions regarding the geography of Britannia. Please answer with the number of the longitude or latitude from thy cloth map. Remember-- longitude refers to the lines that run north-south. They are determined by the numbers at the bottom of the map. Latitude refers to the lines that run east-west. They are determined by the numbers on the left side of thy map. If these questions are answered correctly, then I will cast aside all my doubts."];
    Foreach v5 in v1 {
        v29 = v25::v0::v5;
        ["<v29>"];
        v30 = ~AskBarInput(0, 5, 210, 0);
        if not (v30 = v26::v0::v5) {
            v2 = true;
        }
    }
    if v2 {
        return false;
    } else {
        return true;
    }
}
