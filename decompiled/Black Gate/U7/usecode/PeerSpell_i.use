Routine PeerSpell_i accepts a0 #locals(1) #uses(~IsMagicOK_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        Item_bark("@Vas Wis@", item);
        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aSFX_i, 67, _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aUSABLE_i, #PeerSpell_i >>, item);
        } else {
            v0 = ~PostAction(<< _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        v0 = ~ShowMap_i();
    }
}
