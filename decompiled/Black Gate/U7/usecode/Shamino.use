Routine Shamino accepts a0 #locals(12) #uses(~AvatarName, ~IsNPCNear, ~AskList, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Shamino);
        v0 = ~AvatarSex();
        v1 = ~GetParty();
        v2 = ~NPCToItem_i(_Shamino);
        v3 = ~AvatarName();
        TurnOn(<< "name", "job", "bye" >>);
        if flag(748) {
            if (~GetClock(11) < 1) {
                ["I am sorry, I do not join thieves."];
                terminate;
            } else {
                ["All right, I suppose thou hast learned thy lesson. I shall rejoin."];
                JoinParty(_Shamino);
                flag(748) = false;
                terminate;
            }
        }
        if flag(109) {
            TurnOn("Amber");
        }
        if flag(110) {
            TurnOn("settle down");
        }
        if (v2 in v1) {
            TurnOn("leave");
        }
        if not (v2 in v1) {
            TurnOn("join");
        }
        if not $MetShamino {
            [Your old friend Shamino stands before you and you marvel that he has finally progressed into what some might call 'middle age'.];
            $MetShamino = true;
        } else {
            ["Yes, <v3>?" Shamino asks.];
        }
        converse {
            key ("name") {
                [Your friend looks at you like you have lost your head. "'Tis Shamino. -Sha-mi-no-."];
                TurnOff("name");
            }
            key ("job") {
                ["I should hope 'twould be adventuring with thee! I am weary of loitering about Britain. There is much we could be accomplishing! Where hast thou been, anyway?"];
                if not flag(213) {
                    ["But please tell me what brings thee here!"];
                    TurnOn("murder in Trinsic");
                }
                TurnOn(<< "Britain", "accomplishing" >>);
            }
            key ("accomplishing") {
                ["Well, I do not know if thou art aware, but we are having many problems with magic in general, and with the Moongates."];
                TurnOff("accomplishing");
                TurnOn(<< "magic", "Moongates" >>);
            }
            key ("Britain") {
                ["Yes, I have been in Britain as of late, attempting to find work. Thou dost know that adventuring comes around too infrequently. One must find -other- diversions. Which reminds me... I have thy pocketwatch."];
                TurnOff("Britain");
                TurnOn(<< "diversions", "pocketwatch" >>);
            }
            key ("pocketwatch") {
                if not flag(217) {
                    ["Thou didst leave it when thou didst last visit Britannia. Here\x09it is."];
                    v4 = ~GiveToParty_i(false, _All, _All, _Pocketwatch, 1);
                    if v4 {
                        [Shamino hands you the pocketwatch.];
                        flag(217) = true;
                    } else {
                        ["Oops. Thine hands are too full to take it. Ask me about it later."];
                    }
                } else {
                    ["I already gave thee the pocketwatch, <v3>. I hope thou didst not lose it again!"];
                }
                TurnOff("pocketwatch");
            }
            key ("diversions") {
                ["The usual. I do not see our old friends often, and Lord British rarely finds work for me. I certainly have no time\x09for wenching or drinking -- I have grown up a bit."*];
                TurnOff("diversions");
                v5 = ~IsNPCNear(_Iolo);
                if v5 {
                    SetSpeaker(0, _Iolo);
                    ["Ahem, I have heard something about an actress, no?"*];
                    CloseSpeaker(_Iolo);
                    SetSpeaker(0, _Shamino);
                    ["What dost thou know of it?"*];
                    SetSpeaker(0, _Iolo);
                    ["<v3>, ask him about 'Amber'."*];
                    CloseSpeaker(_Iolo);
                    SetSpeaker(0, _Shamino);
                    ["Thou art a swine, Iolo."];
                    TurnOn(<< "Amber", "friends", "Lord British" >>);
                }
            }
            key ("Lord British") {
                if not $MET_LORD_BRITISH {
                    ["I suggest that thou proceed immediately to see him!"*];
                    terminate;
                } else {
                    ["I am glad I do not look as aged as -he- does!"];
                }
                TurnOff("Lord British");
            }
            key ("friends") {
                ["Thou dost mean Iolo and Dupre, I presume?"];
                TurnOff("friends");
                TurnOn(<< "Iolo", "Dupre" >>);
            }
            key ("Iolo") {
                v5 = ~IsNPCNear(_Iolo);
                if v5 {
                    ["Dost thou mean that miserable excuse for an archer?"*];
                    SetSpeaker(0, _Iolo);
                    ["Watch what thou dost say, scoundrel!"*];
                    CloseSpeaker(_Iolo);
                    SetSpeaker(0, _Shamino);
                    ["Yes, that's Iolo!"];
                } else {
                    ["Surely he is around somewhere. Where didst thou last leave him?"];
                }
                TurnOff("Iolo");
            }
            key ("Dupre") {
                v6 = ~IsNPCNear(_Dupre);
                if v6 {
                    ["Dost thou mean that incorrigible wencher and drunkard?"*];
                    SetSpeaker(0, _Dupre);
                    ["Do not forget that my mere thumb can squash in thy face like a marshmallow."*];
                    SetSpeaker(0, _Shamino);
                    ["Yes, that's Dupre!"*];
                    SetSpeaker(0, _Dupre);
                    ["That's -Sir- Dupre to thee!"*];
                    SetSpeaker(0, _Shamino);
                    ["Sir Dupuke? Didst thou say Sir Dupuke?"*];
                    SetSpeaker(0, _Dupre);
                    ["Du-pre-!"*];
                    SetSpeaker(0, _Shamino);
                    ["Pardon -me-, Sir Dupuke!"*];
                    SetSpeaker(0, _Dupre);
                    ["I'm not going to listen to this anymore."*];
                    CloseSpeaker(_Dupre);
                    SetSpeaker(0, _Shamino);
                } else {
                    if not $MetDupre {
                        ["I believe he is in Jhelom."];
                    } else {
                        ["He must be around somewhere!"];
                    }
                }
                TurnOff("Dupre");
            }
            key ("join") {
                v7 = 0;
                v1 = ~GetParty();
                Foreach v10 in v1 {
                    v7 = (v7 + 1);
                }
                if (v7 < 8) {
                    [Shamino looks relieved. "I am -so- glad thou didst ask me that." He gathers his gear and prepares to follow you.];
                    JoinParty(_Shamino);
                } else {
                    ["Hmmm. I do not like big crowds. I shall wait until thy group is smaller before joining."];
                }
                TurnOn("leave");
                TurnOff("join");
            }
            key ("leave") {
                ["Hmmm. Dost thou merely want me to wait here or dost thou want me to go home?"];
                ClearKeys();
                v11 = ~AskList(<< "wait here", "go home" >>);
                if (v11 = "wait here") {
                    ["Very well. I shall await thy return."*];
                    LeaveParty(_Shamino);
                    SetWorkType(_Wait, ~NPCToItem_i(_Shamino));
                    terminate;
                } else {
                    ["I really hate to, but if thou dost insist." Shamino\x09grudgingly gathers his belongings.*];
                    LeaveParty(_Shamino);
                    SetWorkType(_Loiter, ~NPCToItem_i(_Shamino));
                    terminate;
                }
            }
            key ("murder in Trinsic") {
                [Shamino listens as you tell him the story. "I would be honored to join and help thee in investigating this matter."];
                flag(213) = true;
                TurnOff("murder in Trinsic");
            }
            key ("Moongates") {
                if not $SphereGone {
                    ["I am confounded by their inability to function properly."];
                } else {
                    ["'Tis a pity that thou art marooned here."];
                }
                TurnOff("Moongates");
            }
            key ("magic") {
                if not $TetraGone {
                    if not flag(108) {
                        ["Magic all over Britannia seems to be disturbed. Say, dost thou remember Nicodemus in the great forest? He has gone mad and is terribly silly. Perhaps we should visit him."];
                        flag(108) = true;
                    } else {
                        ["It does not work well. I do not understand it."];
                    }
                } else {
                    ["It will probably work extremely well now, <v3>."];
                }
                TurnOff("magic");
            }
            key ("Amber") {
                [You see a light shine in Shamino's eyes as you mention her name. He is obviously smitten.~~"She is an actress I know."];
                TurnOff("Amber");
                flag(107) = true;
            }
            key ("settle down") {
                ["That woman! She cannot understand that I must have mine adventuring! I cannot settle down. -Yet-! Soon maybe."~~Shamino looks concerned. "I have grown up. A bit."];
                TurnOff("settle down");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        [Shamino bows slightly.*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Shamino);
    }
}
