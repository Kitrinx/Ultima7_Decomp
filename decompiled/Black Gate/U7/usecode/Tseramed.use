                        }
                    } else {
                        ["Very well, <v1>."];
                    }
                }
            }
            key ("join") {
                TurnOff("join");
                if (v7 < 8) {
                    JoinParty(_Tseramed);
                    ["I would be honored, <v1>."];
                    TurnOn("Fellowship");
                } else {
                    ["'Twould appear, <v1>, that thou already hast more than enough travelling companions."];
                }
