                } else {
                    ["A malformed flying horror. Thou wouldst not want to meet one."];
                }
            }
            key ("slime") {
                v14 = true;
                ["A dangerous organism is the greenish slime. Acidic to touch, it will hurl pseudopods at its prey from three paces.];
                ["Never sleeping, it has no mind and is composed in the main of\x09poisonous substances. It engulfs and devours hapless animals voraciously."];
                if v23 {
                    ["Attack it with flame! Slime has no defense against it."];
                }
            }
            key ("foxes") {
                v15 = true;
                if ~FindNearby_i(0, 10, _Fox, v4) {
                    v29 = "  See how lustrous is the coat of that fox.";
                }
                ["Cunning is the fox, and shy of humans. We shall never belong to the forest as they do.<v29>"];
            }
            key ("bees") {
                v17 = true;
                if v26 {
                    ["Bees such as these may be tamed with my special arrows!"];
                    TurnOn("arrows");
                } else {
                    ["Such bees as thou hast never seen! Large as a wolf they are, with wings stretching over a span in length.];
                    [A creature stung by them will pass into a deep, death-like sleep."];
                    if not (v4 in v2) {
                        ["I have hunted them on many occasions, for I use their poison on my arrows. And I like their honey. Perhaps together we might journey into the cave for some?"];
                        TurnOn(<< "join", "arrows" >>);
                    }
                }
            }
            key ("arrows") {
                TurnOff("arrows");
                ["I fashion my arrows from the stingers of giant bees. With them one may put a foe to sleep."];
                v34 = "";
                v35 = 0;
                if flag(339) {
                    v35 = ~CountItem(_All, _All, _Bee_Stinger, _Party);
                    if (v35 > 6) {
                        v35 = 6;
                    }
                    v36 = ~CountItem(_All, _All, _Tseramed_Arrow, _Party);
                    if ((v4 in v2) and ((v36 < 6) and (v35 > 0))) {
                        v34 = "Shall I fashion these stingers into arrows?";
                    }
                } else {
                    v34 = "If thou wouldst like, I would be happy to give thee a dozen of my special arrows. Art thou interested?";
                    v35 = 12;
                }
                if (v34 <> "") {
                    append v34;
                    append "";
                    say;
                    if ~AskYesNo() {
                        v37 = ~GiveToParty_i(false, _All, _All, _Tseramed_Arrow, v35);
                        if v37 {
                            v38 = "";
                            if (v35 > 1) {
                                v38 = "s";
                            }
                            ["Use them with care, for even a scratch may put one to sleep!" he says, handing you <v35> arrow<v38>.];
                            if flag(339) {
                                v31 = ~TakeFromParty_i(true, _All, _All, _Bee_Stinger, v35);
                            }
