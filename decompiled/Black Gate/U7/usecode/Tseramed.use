            key ("leave") {
                v39 = true;
                ["Dost thou want me to wait here or should I go home?"];
                ClearKeys();
                v40 = ~AskList(<< "wait here", "go home" >>);
                if (v40 = "wait here") {
                    ["Very well! I shall wait for thee!"*];
                    LeaveParty(_Tseramed);
                    SetWorkType(_Wait, ~NPCToItem_i(_Tseramed));
                    terminate;
                } else {
                    ["Very well, <v1>. Fare thee well."*];
                    LeaveParty(_Tseramed);
                    SetWorkType(_Loiter, ~NPCToItem_i(_Tseramed));
                    terminate;
                }
            }
            v41 = false;
            key ("hermits") {
                v41 = true;
            }
            if ((v12 and v11) and not v18) {
                ["Speaking of caves and mountains, there are some who dwell near, or perhaps in, the cave of bees. They are hermits."];
                v41 = true;
                v18 = true;
                TurnOn("bees");
            }
            if v41 {
                TurnOff("hermits");
                if not flag(338) {
                    ["One day I glimpsed a man and a woman deep within the cave as I was hunting. Since then I have seen them twice. I believe they are former citizens of Yew, though I do not know how they live in harmony with the bees."];
                    if v27 {
                        ["These are the people I saw!"];
                    }
                    flag(338) = true;
                    TurnOn("bees");
                } else {
                    if v27 {
                        ["These people are the hermits I spoke of before."];
                    } else {
                        ["Perhaps those hermits are still living in the cave."];
                    }
                }
                v18 = true;
            }
            if ((v14 and v15) and not v16) {
                ["This puts me in mind of a story. Wouldst thou like to hear it?"];
                if ~AskYesNo() {
                    ["One day while walking along the edge of the swamp I happened upon a strange sight. A fox was held at bay on a small hillock in the midst of the swamp, and all about the hillock writhed green slime.];
                    [Slowly the slime crept up toward the fox, when suddenly the fox trotted directly across the surface of the ooze!];
                    [Unharmed, the fox dashed off into the wood, leaving the slime writhing behind. By this I guess that the victims of slime are those caught sleeping, or unaware."];
                } else {
                    ["Perhaps another time."];
                }
                v16 = true;
            }
            if v14 {
                TurnOff("slime");
            }
            if v15 {
                TurnOff("foxes");
            }
            if v17 {
                TurnOff("bees");
            }
            if v12 {
                TurnOff("caves");
                TurnOff("secret places");
                TurnOff("death");
            }
            if v11 {
                TurnOff("mountains");
            }
            if v13 {
                TurnOff("forest");
            }
            if (flag(353) and ((v4 in v2) and not flag(354))) {
                TseramedAsksCombatStyle_i(v2);
                flag(354) = true;
            }
            if (v4 in v2) {
                TurnOff("join");
            }
            key ("bye") {
                if ((v4 in v2) or v39) {
                    v22 = true;
                }
                if (flag(29) and not v22) {
                    if not flag(353) {
                        ["Thy pardon, <v1>, but thy visage brings to my mind a statue that I once saw.  'Twas a likeness of the ancient hero known as the Avatar.];
                        [Art thou not that same honorable soul?"];
                        if ~AskYesNo() {
                            v42 = "That sculptor did thee justice.";
                            if (~AvatarSex() = 1) {
                                v42 = "Thou art more fair by far than any likeness in stone could portray.";
                            }
                            ["Noble hero, it is an honor to make thine aquaintance. <v42>"];
                            flag(353) = true;
                        } else {
                            ["I must be mistaken. Farewell."];
                            break;
                        }
                    } else {
                        ["^<v1>, if it pleases thee, I would be honored to travel with thee. I have skill in arms, and I can offer my knowledge and wood craft to thee..."];
                        TurnOn("join");
                        v22 = true;
                    }
                } else {
                    ["'Til next time, <v1>."*];
                    break;
                }
            }
        }
        clear_answers;
    }
    if (event = _Bark) {
        terminate;
    }
}

Function ~RandomInsult_i accepts a0 #locals(2) {
    v1 = << "viper", "deceiver", "wretch", "scoundrel", "snake", "toad", "coward" >>;
    v2 = v0;
    While (v2 = v0) {
        v2 = v1::~rndRange(~ListSize_i(v1), 1);
    }
    return v2;
}

Routine TseramedAccuses_i accepts a0, a1 #locals(8) #uses(~RandomInsult_i, ~AskYesNo) {
    PushKeys();
    v2 = false;
    v3 = true;
    v4 = ~RandomInsult_i("");
    ["<v0>! Thou <v4>!"];
    v5 = << "blood", "head", "life" >>;
    v6 = v5::~rndRange(~ListSize_i(v5), 1);
    ["Shall I have my apology, or thy <v6>?"];
    v7 = "Forgive me";
    v8 = "Suffer my wrath";
    TurnOn(<< v7, v8 >>);
    converse {
        key (v7) {
            v4 = ~RandomInsult_i("");
            ["Forgive thee! What might I forgive in one such as thee, <v4>?"];
            TurnOff(v8);
            TurnOff(v7);
            TurnOn(<< "My lie", "My deed", "My crime" >>);
        }
        key (v8) {
            break;
        }
        key ("My lie") {
            TurnOff(<< "My lie", "My deed", "My crime" >>);
            ["Of what lie speakest thou? Art thou not <v0>?"];
            if ~AskYesNo() {
                break;
            }
            v4 = ~RandomInsult_i("");
            ["Perhaps thou art not <v0>, for I have never seen the <v4>. Confess now thy true identity!"];
            TurnOn(v1);
            if not flag(353) {
                TurnOn("Avatar");
            }
        }
        key ("My deed") {
            ["Speak not of thy deed! Such deeds must deeds receive to equal their merit."];
            break;
        }
        key ("My crime") {
            ["Crime most foul, most horrible!"];
            v3 = false;
            break;
        }
        key ("Avatar") {
            TurnOff("Avatar");
            ["I doubt but thou deceivest me further. If true, thou dost shame the title. Admit now thy true name!"];
            v2 = true;
            flag(353) = true;
        }
        key (v1) {
            v4 = ~RandomInsult_i("");
            ["<v1>! Perhaps honesty shall lift thee above the <v4> <v0>..."];
            v2 = true;
            break;
        }
    }
    clear_answers;
    if not v2 {
        v4 = ~RandomInsult_i("");
        v9 = ~RandomInsult_i(v4);
        if v3 {
            ["^<v4>! ^<v9>! Thy soul shall wail in the catacombs of the netherworld!"];
            SetWorkType(_Combat_0, _Tseramed);
            Npc_setAlignment(_Evil, _Tseramed);
        } else {
            ["^<v4>! Fly from this place at once! I shall provide escort for thee with my bow. Return at thy peril, <v9>."];
            SetWorkType(_Hound, _Tseramed);
            Npc_setAlignment(_Neutral, _Tseramed);
        }
    } else {
        ["I shall not take this deception lightly."];
        flag(29) = true;
        Npc_setAlignment(_Neutral, _Tseramed);
    }
    terminate;
}

Routine TseramedAsksCombatStyle_i accepts a0 #locals(8) {
    PushKeys();
    v1 = false;
    v2 = false;
    TurnOn(<< "enchantment", "valor in arms", "bye" >>);
    ["Tell me something, if thou please. Many years have passed since I first learned my woodcraft. Such craft includes skill in arms, and I must know... Does the Avatar prefer mystical enchantment to overcome enemies, or physical strength and valor in arms?"];
    v3 = false;
    converse {
        key ("enchantment") {
            ["I have suspected it! No skill have I in such deep matters, but perchance our speech might turn to enchantment when our quest is complete."];
            $TSERAMED_THINKS_MAGE = true;
            goto label_29;
        }
        key ("valor in arms") {
            ["I have often suspected it! I am honored to travel with thee. I shall watch thee diligently, for surely thou art the greatest fighter who ever lived."];
            ["When our quest is complete we shall regale each other with our exploits. Tell me, dost thou prefer hand to hand combat or ranged weaponry?"];
            TurnOff(<< "enchantment", "valor in arms" >>);
            TurnOn(<< "hand to hand", "ranged weaponry" >>);
            $TSERAMED_THINKS_MAGE = false;
            v1 = false;
        }
        key ("hand to hand") {
            TurnOff("hand to hand");
            v4 = "and thou seemest man enough for such close work";
            if (~AvatarSex() = 1) {
                v4 = "especially in women. The women of Britannia seldom have them";
                v2 = true;
            }
            ["Such weapons require strength and daring! I admire such qualities, <v4>."];
            ["But my preferences run to the bow. An ancient weapon, and elegant, a fine bow of Yew may bring down game sooner than a sword."];
            v3 = true;
        }
        key ("ranged weaponry") {
            TurnOff("ranged weaponry");
            ["Such is also my choice. Few are my peers in the art of archery. A keen eye and steady hand are required, and that is rare in the men of this day. Even rarer in women. Sad, that the women of Britannia should be innocent of such art!"];
            v2 = true;
            v3 = true;
        }
        if v2 {
            v2 = false;
            v5 = false;
            Foreach v8 in v0 {
                if (~GetNPCStat_i(_Sex, v8) = 1) {
                    v5 = true;
                    goto label_28;
                }
            }
            if v5 {
                SetSpeaker(0, v8);
                ["Take care with thy words, master woodsman."];
                SetSpeaker(0, _Tseramed);
                ["I do not mean this gracious company! Surely thou art among the elite of Britannia and a rare figure of a woman."];
                SetSpeaker(0, v8);
                ["Thy speech does me service. Alas! Too few are the women who learn skill in arms."];
                CloseSpeaker(v8);
            }
        }
        if v3 {
            goto label_29;
        }
        key ("bye") {
            if not v1 {
                ["Please, Avatar, I simply must know."];
            } else {
                terminate;
            }
            v1 = true;
        }
    }
    label_28:
    clear_answers;
    label_29:
    PopKeys();
}

Routine TseramedGreetsInParty_i accepts a0, a1 #locals(1) {
    v2 = "thee";
    if (v0 > 2) {
        v2 = "the party";
    }
    if flag(349) {
        ["^<v1>, I have weighed thine actions against thy former conduct. Now that I am travelling with <v2>...];
        [I forgive thy misrepresentation at our first meeting."];
        flag(349) = false;
    }
    if (~rndRange(3, 1) = 1) {
        ["I enjoy travelling with <v2>."];
    }
    if ~GetItemFlag_i(_Invisible, ~NPCToItem_i(_Avatar)) {
        ["Avatar! 'Tis strange to converse yet not see the speaker. Invisibility is queer magic."];
    }
    ["How may I assist <v2>, <v1>?"];
    TurnOn(<< "bees", "leave" >>);
}

