    v5 = ~PostInFuture(v1, << _aFRAME, 0 >>, v0);
    LeaveParty(_Forsythe);
    SetWorkType(_Wait, _Forsythe);
    v6 = << 65389, 65393, 65394, 65392, 65396, 65390, 65391 >>;
    Foreach v9 in v6 {
        RemoveNPC_i(v9);
    }
    flag(419) = true;
    terminate;
}
