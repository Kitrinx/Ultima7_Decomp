Routine Inforlem accepts a0 #locals(2) #uses(InforlemSellsWeapons_i, ~AskYesNo, InforlemTrainsCombat_i, InforlemTrainsMagic_i, GargBarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Inforlem);
        v0 = false;
        v1 = ~GetTime();
        TurnOn(<< "name", "job", "bye" >>);
        if not $MetInforlem {
            [The gargoyle has a pleasant expression on his face.];
            $MetInforlem = true;
        } else {
            ["To be pleased at your return, human," says Inforlem.];
        }
        converse {
            key ("name") {
                ["To be known as Inforlem."];
                TurnOff("name");
                TurnOn("Inforlem");
            }
            key ("Inforlem") {
                ["To mean `make strong one.'"];
                TurnOff("Inforlem");
            }
            key ("job") {
                ["To train others in Terfin to be strong and powerful. To sell some weapons, also."];
                TurnOn(<< "train", "others", "Terfin", "buy" >>);
                if (flag(580) and not v0) {
                    TurnOn("conflicts");
                }
            }
            key ("buy") {
                if ((v1 = 3) or ((v1 = 4) or (v1 = 5))) {
                    InforlemSellsWeapons_i();
                } else {
                    ["To sell during shop hours. To ask you to come back to me at that time, please."];
                }
            }
            key ("train") {
                if ((v1 = 3) or ((v1 = 4) or (v1 = 5))) {
                    ["To be a better warrior or mage?"];
                    TurnOn(<< "warrior", "mage" >>);
                } else {
                    ["To train during training hours. To ask you to come back to me at that time, please."];
                }
            }
            key ("warrior") {
                ["To charge 50 gold for each training session. To be all right?"];
                if ~AskYesNo() {
                    InforlemTrainsCombat_i(50, << 0, 1, 4 >>);
                } else {
                    ["To apologize, but I must charge that amount!"];
                }
            }
            key ("mage") {
                ["To charge 50 gold for each training session. To be acceptable?"];
                if ~AskYesNo() {
                    InforlemTrainsMagic_i(50, << 6, 2 >>);
                } else {
                    ["To apologize, but I must charge that amount!"];
                }
            }
            key ("conflicts") {
                ["To know of the conflicts between the altars and the Fellowship, but to have no information. To suggest you see Quan, The Fellowship leader here and ask him."];
                v0 = true;
                flag(572) = true;
                TurnOff("conflicts");
            }
            key ("Terfin") {
                ["To see there are troubles here, but to be unaware of the causes and solutions."];
                TurnOff("Terfin");
            }
            key ("others") {
                ["To tell you Forbrak knows much about Terfin and its residents, and," he says, "about its conflicts."];
                TurnOff("others");
                TurnOn("Forbrak");
                if not v0 {
                    TurnOn("conflicts");
                }
            }
            key ("Forbrak") {
                ["To be the tavernkeeper."];
                TurnOff("Forbrak");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["To expect to see you again, human."*];
    }
    if (event = _Bark) {
        GargBarkAboutWork_i(_Inforlem);
    }
}

