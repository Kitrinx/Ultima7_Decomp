Routine TeleportBatlin_i accepts a0 #locals(2) #uses(CallLightning_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        v0 = ~PostAction(<< _aFACE_i, byte(48), _aKNEEL_FRAME_i, _aWAIT_i, 1, _aBARK_i, "@Kal Ort Por@", _aSTAND_FRAME_i, _aUP_FRAME_i, _aOUT_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #TeleportBatlin_i >>, item);
    }
    if (event = _Posted_i) {
