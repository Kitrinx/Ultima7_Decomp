Routine Foranamo accepts a0 #locals(15) #uses(~AvatarName, ~LordOrLady, ~AskList, ~IsNPCNear) {
    if (event = _Action) {
        SetSpeaker(0, _Foranamo);
        v0 = ~NPCToItem_i(_Foranamo);
        v1 = ~NPCToItem_i(_Anmanivas);
        v2 = ~AvatarName();
        v3 = ~LordOrLady();
        v4 = "the Avatar";
        v5 = ~Npc_getAlignment(v1);
        if (v5 = 1) {
            [The gargoyle's anger is so great that he resists the spell.*];
            Npc_setAlignment(_Evil, v0);
            Npc_setAlignment(_Evil, v1);
            terminate;
        } else {
            v6 = ~GetWorkType(v0);
            if (v6 = 16) {
                TurnOn(<< "name", "job", "bye" >>);
                [The gargoyle is obviously displeased with the intrusion of your presence.];
                converse {
                    key ("name") {
                        ["To have no desire to tell you. To demand to know who you are!"];
                        TurnOff("name");
                        v7 = ~AskList(<< v2, v4, v3 >>);
                        if (v7 = v4) {
                            v8 = 0;
                            v9 = ~GetParty();
                            Foreach v12 in v9 {
                                v8 = (v8 + 1);
                            }
                            if (v8 = 1) {
                                v13 = "human";
                            } else {
                                v13 = "humans";
                            }
                            [The gargoyle growls as he turns to look at you. He stands, ];
                            v14 = ~IsNPCNear(_Anmanivas);
                            if v14 {
                                [setting a hand on the shoulder of the gargoyle next to him.*];
                                SetSpeaker(0, _Anmanivas);
                                [The other gargoyle also stands. Anger flashes across his face as he points a finger at you.~~ "To be the cause for our unhappiness, <v13>!"*];
                                CloseSpeaker(_Anmanivas);
                                SetSpeaker(0, _Foranamo);
                            }
                            ["To be the reason for our poverty. To die, <v13>, to die!"*];
                            SetWorkType(_Combat_0, v0);
                            SetWorkType(_Combat_0, v1);
                            Npc_setAlignment(_Evil, v1);
                            Npc_setAlignment(_Evil, v0);
                            terminate;
                        } else {
                            ["To tell you to go away!"*];
                            terminate;
                        }
                    }
                    key ("job") {
                        ["To have none!" He glares fiercly at you."];
                        TurnOff("job");
                    }
                    key ("bye") {
                        [He grunts his dismissal.*];
                        terminate;
                    }
                }
                clear_answers;
            } else {
                [The gargoyle stops only long enough to give you a menacing stare.*];
                terminate;
            }
        }
    }
    if (event = _Bark) {
        terminate;
    }
}
