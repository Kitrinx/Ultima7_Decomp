Routine Martine accepts a0 #locals(11) #uses(~AvatarName, ~AskYesNo, ~AskList) {
    if (event = _Bark) {
        terminate;
    }
    SetSpeaker(0, _Martine);
    v0 = ~GetTime();
    v1 = ~GetWorkType(~NPCToItem_i(_Martine));
    v2 = ~AvatarName();
    v3 = "Avatar";
    v4 = ~AvatarSex();
    if flag(666) {
        v5 = v2;
    }
    if flag(667) {
        v5 = v3;
    }
    if not (v1 = 7) {
        [The woman looks up in surprise and says, "I am not working at the moment and I ask thee to respect my privacy. If thou dost wish to speak with me, come to The Baths in the late evening hours."*];
        terminate;
    }
    TurnOn(<< "name", "job", "bye" >>);
    v6 = ~GetClock(4);
    v7 = ~GetClock(3);
    v8 = ~GetClock(2);
    if ((flag(669) and (v6 < 2)) or ((flag(670) and (v7 < 2)) or (flag(668) and (v8 < 2)))) {
        [This attractive woman looks at you with surprise and says, "Honey, thou just enjoyed thyself, didst thou not? Please come back when thou art rested."*];
        terminate;
    } else {
        if not flag(684) {
            [You see a beautiful young woman with a tropical air.];
            if not v4 {
                ["Hello, handsome!];
            } else {
                ["Hello, dear. Art thou sure thou dost not want to speak with Roberto?"];
                if ~AskYesNo() {
                    ["All right, honey. Whatever heats thy blood..."];
                } else {
                    ["Then thou had best speak with him! He is probably more to thy liking."*];
                    terminate;
                }
            }
            ["What is thy name?"];
            v9 = ~AskList(<< v2, v3 >>);
            if (v9 = v2) {
                if not v4 {
                    ["How art thou, <v2>? I am so happy to meet thee!"];
                } else {
                    ["Hello, <v2>."];
                }
                v5 = v2;
                flag(666) = true;
            }
            if (v9 = v3) {
                ["Oh please! Not another Avatar!"];
                if not v4 {
                    [Martine takes a deep breath, then smiles.];
                    ["Well, honey, it does not matter who thou art. We shalt have a good time anyway."];
                }
                flag(667) = true;
                v5 = v3;
            }
            flag(684) = true;
        } else {
            ["Hello again, <v5>," Martine says.];
        }
    }
    converse {
        key ("name") {
            ["The name I use here is Martine. Thou dost understand..." She winks at you.];
            TurnOff("name");
        }
        key ("job") {
            if not v4 {
                ["Honey, my job is to make thee happy.];
            } else {
                ["My dear, my job is to serve thee.];
            }
            ["'Tis important that thou art comfortable whilst visiting The Baths."];
            TurnOn(<< "The Baths", "comfortable" >>);
        }
        key ("The Baths") {
            ["'Tis a fabulous place to work. I absolutely love it. I would not work anywhere else. I have more gold than I could possibly spend."];
            if not v4 {
                [Martine blows a kiss at you. "I meet many kinds of interesting people, too!"];
            }
            TurnOff("The Baths");
        }
        key ("comfortable") {
            ["Thou dost have many choices. We could take a swim in our spring pools. Or I could perform a massage on thee. Or we could simply talk.~~"But if thou dost want to really get to know me better, we should visit the Community Room..."];
            TurnOff("comfortable");
            TurnOn(<< "swim", "massage", "talk", "Community Room" >>);
        }
        key ("Community Room") {
            ["Thou dost want to join me in the Community Room?"];
            if ~AskYesNo() {
                [Martine leads you into a private room.~~"It really is not a Community Room at all. We shall be all alone!"~~ A while later, after the woman has shown you more tricks than a crooked street mage, you emerge from the Community Room a much happier Avatar.];
                flag(668) = true;
                SetClock(2);
                v10 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, 50);
            } else {
                ["That's all right, honey."];
            }
            TurnOff("Community Room");
        }
        key ("swim") {
            [Martine helps you with your clothing and leads you into the warm spring water. It feels fabulous, and you would love to go to sleep; but you know you have a quest to finish. After a while, Martine helps you out of the water and you dress.];
            TurnOff("swim");
        }
        key ("massage") {
            [Martine helps you with your clothing and leads you to a comfortable table. You lie on your stomach and the woman expertly kneads and rubs your aching muscles, slowly sending you into a state of oblivion. After a while, Martine helps you up and you dress.];
            TurnOff("massage");
        }
        key ("talk") {
            [Martine smiles. "That is just fine with me, honey. I would wager thou hast many stories to tell about adventuring, yes? Say! Hast thou been in the secret passages in the mountains? Didst thou know they are all connected? I know that there is a secret door that leads right into the back of this building!" She whispers, "I believe the entrance is through the House of Games."~~You and Martine speak of a number of other subjects until you realize you have spent too much time in the spa. There is a quest to finish!];
            TurnOff("talk");
        }
        key ("bye") {
            break;
        }
    }
    clear_answers;
    ["I hope to see thee again soon, honey!"];
    if not v4 {
        [Martine blows you a kiss.*];
    } else {
        [Martine waves goodbye.*];
    }
}
