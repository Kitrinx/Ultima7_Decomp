Routine Brownie accepts a0 #locals(10) #uses(~LordOrLady, ~AskYesNo, BrownieBuysPumpkins_i, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Brownie);
        v0 = ~LordOrLady();
        v1 = ~IsMedallionOn_i();
        TurnOn(<< "name", "job", "bye" >>);
        if flag(206) {
            TurnOn("pumpkins");
        }
        if not $MetBrownie {
            [You see a farmer who, despite showing considerable wear from hard work, appears energetic, cheerful and friendly.];
            $MetBrownie = true;
        } else {
            ["Hello again, <v0>," Brownie greets you.];
        }
        converse {
            key ("name") {
                ["I am Brownie."];
                TurnOff("name");
            }
            key ("job") {
                ["Well, I ran for the office of Mayor of Britain once, but I lost. Now I am back doing what I have been doing since I was a boy. Working the farm."];
                TurnOn(<< "Mayor", "farm" >>);
            }
            key ("Mayor") {
                ["Patterson won the election. He spent a lot of money on his campaign. Most of it to buy votes. But I am not bitter. I was just not meant to be Mayor."];
                TurnOff("Mayor");
                TurnOn(<< "Patterson", "election" >>);
            }
            key ("Patterson") {
                ["Patterson courted the support of The Fellowship. They forced a vote from all their members. Once word spread, my support drained away. No one wants to be on the losing side." Brownie sighs.];
                TurnOff("Patterson");
                TurnOn(<< "Fellowship", "losing" >>);
            }
            key ("election") {
                ["I do not really have any wish to succeed in politics. It just made me ill seeing all of the people with riches mistreat all of the people who are poor, and then have to listen to them talk about how the class system has been abolished."];
                TurnOff("election");
            }
            key ("Fellowship") {
                if v1 {
                    [Brownie gestures toward your medallion. "Frankly, I do not know what thou seest in that group."];
                } else {
                    ["If thou art not with The Fellowship thou art against them. I think they saw me as a potential enemy that had to be stopped."];
                }
                TurnOff("Fellowship");
            }
            key ("losing") {
                ["Of course, I could have won the election if I had wanted to. I had information about Patterson that would have ruined any chances of him winning."];
                TurnOff("losing");
                TurnOn("information");
            }
            key ("information") {
                ["I could have revealed a secret about Patterson but if I did it would have hurt someone close to him very much. I did not want to be mayor that badly."];
                TurnOff("information");
                TurnOn("secret");
            }
            key ("secret") {
                ["Patterson does little to hide his secret. If thou dost keep an eye on him thou wilt surely learn of it sooner or later."];
                TurnOff("secret");
            }
            key ("farm") {
                ["I feel more at home on the farm growing vegetables. There is another farmer named Mack who works a farm near Britain as well. He raises chickens."];
                TurnOff("farm");
                TurnOn(<< "vegetables", "Mack" >>);
            }
            key ("Mack") {
                ["I like him. He even voted for me. But to tell thee the truth about Mack, he is a lunatic."];
                TurnOff("Mack");
            }
            key ("vegetables") {
                ["I raise pumpkins. But I am in a bind at the moment and need some help."];
                TurnOff("vegetables");
                TurnOn(<< "bind", "help" >>);
            }
            key ("bind") {
                ["I strained my back the other day lifting heavy pumpkins. I cannot so much as lift a small one today! And I need help with the harvest of pumpkins so that I can get them to the market."];
                TurnOff("bind");
            }
            key ("help") {
                ["There are piles of pumpkins at the north end of the field. I need them brought down near my farmhouse. If thou wilt help me by bringing the pumpkins to me, I will gladly pay thee for thy work. How does one gold coin for every pumpkin carried sound?"];
                v2 = ~AskYesNo();
                if v2 {
                    ["How nice! A helper! Please, feel free to start work at any time!"];
                    flag(206) = true;
                    v3 = ~GetAllInRegion(20);
                    v4 = ~GetAllInRegion(_Stone_Floor);
                    Foreach v7 in v3 {
                        SetItemFlag_i(_OkayToTake_i, v7);
                    }
                    Foreach v7 in v4 {
                        SetItemFlag_i(_OkayToTake_i, v7);
                    }
                } else {
                    ["Perhaps some other time, then."];
                }
                TurnOff("help");
            }
            key ("pumpkins") {
                if flag(206) {
                    BrownieBuysPumpkins_i();
                } else {
                    ["Thou shouldst simply go to the north end of the field and bring back as many pumpkins as thou can carry!"];
                }
                TurnOff("pumpkins");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["Good day, <v0>."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Brownie);
    }
}

Usable BrownieBuysPumpkins_i #locals(9) #uses(~AskYesNo) {
    PushKeys();
    v0 = 1;
    v1 = 1;
    ["Excellent! Hast thou brought some pumpkins for me?"];
    v2 = ~AskYesNo();
    if v2 {
        ["Very good! Let me see how many thou dost have..."];
        v3 = ~CountItem(20, _All, _Food_Item, _Party);
        v4 = ~CountItem(21, _All, _Food_Item, _Party);
        v5 = (v3 + v4);
        if (v5 = 0) {
            ["But thou dost not have a single one in thy possession! Thou art as looney as Mack!"*];
            terminate;
        } else {
            v6 = ((v5 / v1) * v0);
            ["Lovely! <v5>! That means I owe thee <v6> gold. Here thou art! I shall take the pumpkins from thee now!"];
            v7 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, v6);
            if v7 {
                v8 = ~TakeFromParty_i(true, 20, _All, _Food_Item, v3);
                v8 = ~TakeFromParty_i(true, 21, _All, _Food_Item, v4);
                ["Come back and work for me at any time!"*];
                terminate;
            } else {
                ["If thou wouldst travel in a lighter fashion, thou wouldst have hands to take my gold!"];
            }
        }
    } else {
        ["No? What hast thou been doing in my field? Thou art as worthless as most of the workers one finds!"];
    }
    PopKeys();
}
