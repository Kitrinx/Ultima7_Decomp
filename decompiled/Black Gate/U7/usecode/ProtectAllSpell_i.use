Routine ProtectAllSpell_i accepts a0 #locals(6) #uses(~IsMagicOK_i) {
    if (event = _Action) {
        Item_bark("@Vas Uus Sanct@", item);
        if ~IsMagicOK_i() {
            Kernel_resetRef(item);
            v0 = ~PostAction(<< _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #ProtectAllSpell_i >>, item);
        } else {
            v0 = ~PostAction(<< _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        Sfx(109);
        v1 = ~GetCoord(item);
        createSprite(65535, 0, 0, 0, (v1::2 - 2), (v1::1 - 2), 7);
        v2 = ~GetParty();
        v2 = (v2 & 65180);
        Foreach v5 in v2 {
            SetItemFlag_i(_Protected, v5);
        }
    }
}
