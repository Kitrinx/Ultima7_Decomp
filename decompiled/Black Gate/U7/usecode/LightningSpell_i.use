        v0 = ~GetTarget();
        Kernel_resetRef(item);
        v1 = ~DirFromAvatar_i(v0);
        Item_bark("@Ort Grav@", item);
        if ~IsMagicOK_i() {
            v2 = ~SetAttack_i(_Lightning_807, v0, item);
            v2 = ~PostAction(<< _aFACE_i, v1, _aRAISE1_FRAME_i, _aUP_FRAME_i, _aSFX_i, 65, _aOUT_FRAME_i, _aTHRUST2_FRAME_i, _aTHRUST2_FRAME_i, _aATTACK_i, _aSTAND_FRAME_i >>, item);
        } else {
