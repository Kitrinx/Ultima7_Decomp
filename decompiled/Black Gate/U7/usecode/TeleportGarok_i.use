Routine TeleportGarok_i accepts a0 #locals(2) {
    if (event = _Action) {
        v0 = ~GetCoord(_Garok);
        createSprite(65535, 0, 0, 0, v0::2, v0::1, 7);
        v1 = ~PostAction(<< _aNO_HALT_i, _aCONTINUE_i, _aUP_FRAME_i, _aOUT_FRAME_i, _aTHRUST2_FRAME_i >>, item);
        v1 = ~PostInFuture(4, << _aNO_HALT_i, _aUSABLE_i, #TeleportGarok_i >>, item);
    }
    if (event = _Posted_i) {
        RemoveNPC_i(~NPCToItem_i(_Garok));
    }
}
