Routine Owen accepts a0 #locals(18) #uses(~LordOrLady, ~IsNearEachOther_i, ~AskYesNo, DescribeFellowship_i, ExplainPhilosophy_i, GivePartyExp_i, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Owen);
        v0 = ~GetTime();
        v1 = ~GetWorkType(~NPCToItem_i(_Owen));
        v2 = ~LordOrLady();
        v3 = false;
        v4 = ~IsMedallionOn_i();
        v0 = ~GetTime();
        if (v0 = 7) && not (v1 = 15) {
            v5 = ~IsNearEachOther_i(_Elynor, _Owen);
            if v5 {
                [Owen will not interrupt his participation in The Fellowship meeting to talk with you.*];
                terminate;
            } else {
                ["I am late for The Fellowship Meeting! I cannot speak with thee now!"*];
                terminate;
            }
        }
        v2 = ~LordOrLady();
        TurnOn(<< "name", "job", "bye" >>);
        if $LEARNED_ABOUT_CROWN_JEWEL && flag(291) {
            TurnOn(<< "Crown Jewel", "Hook" >>);
            v3 = true;
        }
        if flag(251) {
            TurnOn("ship");
        }
        if $COMPLETED_OWENS_QUEST {
            TurnOn("statue is cancelled");
        }
        if not $MetOwen {
            [You see a young man dressed in an expensive tunic. He is very serious.];
            $MetOwen = true;
            SetWorkType(_Loiter, ~NPCToItem_i(_Owen));
        } else {
            [Owen looks at you and sniffs. "It would appear thou dost wish to speak with me again."];
        }
        converse {
            key ("name") {
                ["My name, <v2>, is Owen. It is a name I suspect thou shalt be hearing more of in the future."];
                flag(291) = true;
                TurnOff("name");
            }
            key ("statue is cancelled", "job") {
                if $LEARNED_ABOUT_MINOC_MURDER {
                    if not $COMPLETED_OWENS_QUEST {
                        [He looks you in the eye and speaks without the slightest trace of modesty. "I am," he says, "the greatest shipwright in the history of Minoc. I am the greatest shipwright who has ever lived!"];
                        TurnOn(<< "greatest", "Minoc", "buy" >>);
                        if $LEARNED_ABOUT_CROWN_JEWEL && not v3 {
                            TurnOn(<< "Crown Jewel", "Hook" >>);
                        }
                    } else {
                        ["After years of breaking my back trying to make something of this ungrateful little town, I'm giving up. I swear I will never build another ship as long as I live. That will teach them! No matter how they may beg or plead, I will not do it."];
                        TurnOn("ungrateful");
                    }
                    TurnOff("statue is cancelled");
                } else {
                    ["Well, I shall certainly forgive thy poor manners for I know how privileged thou must feel for meeting me, but thou must know that two people have just been discovered in the sawmill, having been murdered!"];
                    $LEARNED_ABOUT_MINOC_MURDER = true;
                    TurnOn("murders");
                }
            }
            key ("greatest") {
                ["And dost thou know how I became that way? I shall tell thee! I started to hear a voice in mine head! Oh, I know that thou shalt think me mad..."];
                TurnOff("greatest");
                TurnOn(<< "mad", "voices" >>);
            }
            key ("voices") {
                ["These were not the voices of anyone I have ever known. But still these voices had a profound effect on me..."];
                TurnOff("voices");
            }
            key ("mad") {
                ["After searching for a meaning to this voice - which proved difficult, for how dost thou tell someone, especially a stranger, that thou art hearing a voice in thine head - I came across The Fellowship. They taught me what the voice was."];
                TurnOff("mad");
                TurnOn(<< "voice", "Fellowship" >>);
            }
            key ("voice") {
                ["This was the voice of reason within mine own mind which sought to guide my life in its proper direction. The Fellowship taught me how to trust this voice and heed what it says. And thou canst see the results in mine own life! I have mastered my craft and advanced the techniques of ship-building through the methods I have devised."];
                TurnOff("voice");
                TurnOn("methods");
            }
            key ("buy") {
                if (v1 = 7) {
                    if not $COMPLETED_OWENS_QUEST {
                        [Owen looks at you and suddenly seems flustered. "Uh, I have no ships for sale presently. I have been working on a few improvements. But if thou wouldst, thou couldst commission me to build one for thee. A deed to one of the ships I build costs 1000 gold coins. Dost thou wish to buy one?"];
                        v6 = ~AskYesNo();
                        if v6 {
                            v7 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, 1000);
                            if v7 {
                                flag(251) = true;
                                ["'Tis money well spent, thou shalt see! I shall begin work immediately. I will be building based upon some of my more recent designs. I shall give thee thy ship's deed in advance"];
                                v8 = ~GiveToParty_i(false, 2, 16, _Scroll, 1);
                                if v8 {
                                    ["It will be called the Excellencia."];
                                } else {
                                    ["I would give thee thy deed but thou art carrying too much."];
                                    v9 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, 1000);
                                    if v9 {
                                        ["Take thy gold back! I cannot in good conscious keep it!"];
                                    } else {
                                        ["I would give thee thy gold back but I seem to have misplaced it."];
                                    }
                                }
                            } else {
                                ["I am dreadfully sorry," he sniffs, "but thou dost not have enough gold."];
                            }
                        } else {
                            ["Art thou certain? Thou shalt find no better ships in all of Britannia! Very well, then!"];
                        }
                    }
                    ["Wouldst thou perhaps be interested in purchasing a fine sextant? I have one which I would be willing to part with for a fine bargain. The price is 150 gold. Art thou interested?"];
                    if ~AskYesNo() {
                        ["Excellent! I knew that thou wouldst appreciate owning the sextant of Owen the shipwright. Thou art a fine person, able to discern those quality items which are worth a bit of extra coin."];
                        v10 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, 150);
                        if not v10 {
                            ["Thou knave! To get mine hopes up so, only to cruelly dash them. Thou dost not possess enough gold to buy my treasure. If thou dost return with more coinage, PERHAPS I will allow thee to bid on it again."];
                        } else {
                            v11 = ~GiveToParty_i(true, _All, _All, _Sextant, 1);
                            if not v11 {
                                ["Thou dost not have enough strength to add my treasure to thy pack. Thou must dispose of some of thy worthless dross to make room for this beauty. I will await thy return to purchase the sextant at this fine, low price."];
                                v12 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, 150);
                            }
                        }
                    } else {
                        ["Hmph. Well, let it be known that thou didst pass up the chance to buy the sextant of the famous Owen the shipwright, and thou shalt be known for the knave and simpleton that thou art."];
                    }
                } else {
                    ["Mine establishment is presently closed. I do not wish to discuss business at this time."];
                }
                TurnOff("buy");
            }
            key ("methods") {
                ["I have even written a book describing the advances I have made in the methods of ship-building. It is very advanced but I have tried to write it so that it is accessible to the layman. Wouldst thou be interested in purchasing a copy?"];
                v13 = ~AskYesNo();
                if v13 {
                    ["Yes, of course thou wouldst."];
                    v14 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, 30);
                    if v14 {
                        v15 = ~GiveToParty_i(false, _All, 59, _Book, 1);
                        if v15 {
                            ["Here it is."];
                        } else {
                            ["Thou art carrying too much to take thy book."];
                            v16 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, 30);
                            if v16 {
                                ["I shall return thy money."];
                            } else {
                                ["I wouldst give thee back thy gold but thou cannot take it."];
                            }
                        }
                    } else {
                        ["Thou dost not have enough money!"];
                    }
                } else {
                    ["Hmph! I suppose that it would be beyond thy comprehension, anyway."];
                }
                TurnOff("methods");
            }
            key ("ship") {
                if not $COMPLETED_OWENS_QUEST {
                    ["I can well understand thine impatience but I have just begun work on it. It shall be ready when I am finished with it. Now, until such time, I would appreciate it if thou wouldst not waste my valuable time."*];
                    terminate;
                } else {
                    if not flag(252) {
                        ["I cannot build thee a ship as I suspect we both know."];
                        if flag(251) {
                            ["Nor can I take thy money for one. Here, I shall return it to thee."];
                            v17 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, 1000);
                            if v17 {
                                flag(252) = true;
                            } else {
                                ["Oh, my, thou art too encumbered to take back thy 1000 gold coins! Come back when thine hands are less full!"];
                            }
                        }
                    } else {
                        ["I cannot help thee with that."];
                    }
                }
                TurnOff("ship");
            }
            key ("Minoc") {
                ["Despite all this business with murders, I must confess that I love it here. This is the place where I was born. They love me. They are going to be building a monument here in mine honor. I suppose I have been worthy of it, but still I can't help but be flattered."];
                TurnOn(<< "murders", "monument" >>);
                TurnOff("Minoc");
            }
            key ("ungrateful") {
                ["Apparently, building the greatest ships to ever set sail in history and all that that has done for Minoc are no longer enough! No! Thanks to that pompous idiot of a mayor I am denied the rightful tribute of which I have proven myself more than worthy. Design flaws, bah! How many ships has Mayor Burnside built in his miserable little life?!"];
                TurnOn("there were deaths");
                TurnOff("ungrateful");
            }
            key ("murders") {
                if not flag(290) {
                    ["That is right. The sawmill is located southeast of town. Almost everyone in town is down there. Thou shouldst probably go down there if thou dost want to find out more. I abhor violence."];
                } else {
                    [He shakes his head slowly. "They are going to be unveiling my monument sometime in the near future. Dost thou think that talk of these events will keep people away from the ceremony? That would be a tragedy!"];
                }
                TurnOff("murders");
            }
            key ("there were deaths") {
                [You tell him about the many innocent civilians who lost their lives on the ship he built. Owen shakes his head slowly. "I do not know. I have no idea how it could have happened. It is difficult to conceive of the pain such great loss of life brings into this world. But I did my best when I built those ships. I did not want those men to die. Thou must believe me."];
                [Owen appears distressed. "The tribute to me is now no more than a tombstone."];
                TurnOff("there were deaths");
                TurnOn("tribute");
            }
            key ("Fellowship") {
                if not $COMPLETED_OWENS_QUEST {
                    DescribeFellowship_i();
                    ["The changes it has made in my personal life have helped me tremendously."];
                    TurnOn("personal life");
                } else {
                    ["Thou canst ask Elynor all about it unless she is not speaking to thee either. Perhaps the details of thy personal life will amuse her more than do mine."];
                    TurnOn("personal life");
                }
                TurnOff("Fellowship");
            }
            key ("philosophy") {
                ExplainPhilosophy_i();
                TurnOff("philosophy");
            }
            key ("personal life") {
                if not $COMPLETED_OWENS_QUEST {
                    ["My friend, there was a time when I thought that my life was at its end. I felt as though I had been swallowed into a cold, deep hole of darkness."];
                    TurnOn("darkness");
                }
                TurnOff("personal life");
            }
            key ("darkness") {
                if not $COMPLETED_OWENS_QUEST {
                    ["My very soul felt as though it had sunk into a place into which no light could enter... Soon after I discovered The Fellowship. The difference that it made in my life was miraculous."];
                } else {
                    ["I have been having a difficult time lately trying to speak to Elynor. It seems that she has no time for me. Back when I was making preparations for the monument she was always stopping by and willing to have words with me."];
                }
                TurnOff("darkness");
            }
            key ("monument") {
                ["Oh, thou canst ask anyone in town about it. They all know."];
                TurnOff("monument");
            }
            key ("tribute") {
                ["I know! My work will stand as my monument! My name will endure long after any statue has worn away to dust! People will remember -me-, I promise thee that!"];
                [And, with a dramatic flourish, Owen produces a dagger. Before you can stop him, he plunges it into his chest. He coughs loudly as blood spurts from his mouth, soaking his fine linen tunic in wine-red guilt. After a moment, it is all over. Owen, the greatest shipwright who ever lived, is dead.*];
                KillNPC_i(~NPCToItem_i(_Owen));
                GivePartyExp_i(100);
                terminate;
            }
            key ("Crown Jewel") {
                if not flag(249) {
                    ["The Crown Jewel was in town and left early this morning. It was scheduled to sail for Paws."];
                    flag(249) = true;
                } else {
                    ["I have heard nothing more of the Crown Jewel since we last spoke of it, <v2>."];
                }
                TurnOff("Crown Jewel");
            }
            key ("Hook") {
                if not flag(250) {
                    ["I saw a man with a hook for a hand wandering around town last night."];
                    flag(250) = true;
                } else {
                    ["I have heard nothing more of this man Hook since we last spoke of him, <v2>."];
                }
                TurnOff("Hook");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        if not $COMPLETED_OWENS_QUEST {
            ["Tired of benefitting from my presence? Very well. I shall see thee again, I hope!"*];
        } else {
            ["Be on thy way, then. Time is fleeting, as is fame."*];
        }
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Owen);
    }
}
