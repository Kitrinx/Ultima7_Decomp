Routine Tory accepts a0 #locals(9) #uses(~AvatarName, ~LordOrLady, ~AskYesNo, ~IsInInv, GivePartyExp_i, ~IsNPCNear, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Tory);
        v0 = ~AvatarName();
        v1 = ~LordOrLady();
        v2 = false;
        TurnOn(<< "name", "job", "bye" >>);
        if not $MET_LADY_TORY {
            [The woman smiles at you compassionately.];
            $MET_LADY_TORY = true;
        } else {
            [Tory smiles and reaches out to you. "Hello, <v0>. I sense thou art troubled."];
        }
        if ($STARTED_HOLD_INVESTIGATION and not $FINISHED_HOLD_INVESTIGATION) {
            TurnOn("statue");
        }
        if ($HEARD_ABOUT_RIKY and not $RESCUED_RIKY) {
            TurnOn("Riky");
        }
        converse {
            key ("name") {
                ["I am Lady Tory, <v1>."];
                if not $HEARD_ABOUT_RIKY {
                    ["Mother of Riky," she says, sobbing.];
                    TurnOn("Riky");
                }
                TurnOff("name");
            }
            key ("job") {
                ["My job is to provide counsel for Lord John-Paul and anyone else in need of guidance here at the Hold."];
                TurnOn(<< "Lord John-Paul", "Hold" >>);
            }
            key ("Riky") {
                if $HEARD_ABOUT_RIKY {
                    ["Hast thou found my child?"];
                    v3 = ~AskYesNo();
                    if v3 {
                        v4 = ~IsInInv(2, 65177, _Baby, 1, _Party);
                        if v4 {
                            GivePartyExp_i(100);
                            ["I cannot begin to express my gratitude, <v1>. Thank thee ever so much!"~She begins sobbing for joy. "Pl-please set him back gently in the cradle."];
                            $RESCUED_RIKY = true;
                        } else {
                            v5 = ~IsInInv(65177, 65177, _Baby, 1, _Party);
                            if v5 {
                                ["Why, that's not my little Riky, <v1>. Thou hast someone else's child. Oh, where could my boy have been taken?" she says, crying.];
                            } else {
                                ["But, I see no child with thee. Thine humor is quite dark. Please return when thou art carrying my baby boy!"*];
                                terminate;
                            }
                        }
                    } else {
                        ["Please, I beseech thee, continue thine hunt!"];
                    }
                } else {
                    $HEARD_ABOUT_RIKY = true;
                    ["My poor baby boy. He -- he was taken one night by cruel harpies who wanted a child for their own. I -- I know not where they have taken him, but I have heard some of the knights mention that a group of the vile women-birds cluster around the shrine of Honor. But, they have not yet been able to defeat them." She sniffs. "But thou <v1>, thou wilt help me get my child back. Oh, please, wilt thou?"];
                    v6 = ~AskYesNo();
                    if v6 {
                        ["I cannot thank thee enough for helping me!" She appears to have cheered up greatly.];
                    } else {
                        ["Thou art a no more than a coward. Get thee gone, coward!"];
                        $RESCUED_RIKY = true;
                    }
                }
                TurnOff("Riky");
            }
            key ("statue") {
                ["Hmm," she appears thoughtful, "when the incident was brought up to everyone here at the hold, I remember Sir Jordan becoming a bit nervous. Perhaps thou shouldst speak with him."];
                TurnOff("statue");
            }
            key ("Hold") {
                ["I sense that thou wishest to know about the residents here at Serpent's Hold. Is this correct?"];
                v7 = ~AskYesNo();
                if not v7 {
                    ["Very well. Come to me if thou changest thy mind."];
                } else {
                    ["As counselor for the Hold, I can tell thee about many people. Hast thou met the healer or the provisioner? And, as a warrior thyself, thou mayest wish to visit the trainer and the armourer."];
                    if not v2 {
                        TurnOn("Lord John-Paul");
                    }
                    TurnOn(<< "healer", "armourer", "trainer", "provisioner" >>);
                }
                TurnOff("Hold");
            }
            key ("Lord John-Paul") {
                ["He is an extraordinary leader. Everyone looks up to him. Thou hast only to ask his captain."];
                TurnOff("Lord John-Paul");
                TurnOn("captain");
                v2 = true;
            }
            key ("healer") {
                ["Lady Leigh is very skilled as a healer. I have yet to see her lose a patient."];
                TurnOff("healer");
            }
            key ("armourer") {
                ["Hmmm. Well, Sir Richter has changed much recently -- ever since he joined The Fellowship. He seems a little less compassionate."];
                TurnOn("Fellowship");
                TurnOff("armourer");
            }
            key ("tavernkeeper") {
                ["Sir Denton is the most astute man I have ever met. He is the only one I cannot sense. And I have never seen him remove his armour...." She shrugs.];
                TurnOff("tavernkeeper");
            }
            key ("trainer") {
                ["I know Menion least of all. He is very quiet, spending most of his spare time weaponsmithing. The tavernkeeper may know more about him."];
                TurnOn("tavernkeeper");
                TurnOff("trainer");
            }
            key ("provisioner") {
                ["Her name is Lady Jehanne. She is the Lady of Sir Pendaran," she says with a gleam in her eye.];
                TurnOn("Sir Pendaran");
                TurnOff("provisioner");
            }
            key ("captain") {
                ["The Captain of the guard, Sir Horffe, is a gargoyle. He was found by two humans who raised him to be a valiant knight. He is a very dedicated warrior, and rarely leaves Lord John-Paul's side."];
                if $MET_SIR_HORFFE {
                    TurnOn("Gargish accent");
                }
                TurnOff("captain");
            }
            key ("Gargish accent") {
                ["Despite his human upbringing, Horffe has struggled to maintain his Gargish identity. By speaking in the same manner as his brethren, he feels he can better hold on to his background."];
                TurnOff("Gargish accent");
            }
            key ("Sir Pendaran") {
                ["He is a brave and hearty fighter, and," she smiles, "he is also a bit on the attractive side."];
                TurnOff("Sir Pendaran");
            }
            key ("Fellowship") {
                ["The Fellowship does not have a branch here, but two of our knights are members: Sir Richter and Sir Pendaran. I know they are interested in having Sir Jordan join as well."];
                TurnOff("Fellowship");
                TurnOn("Sir Jordan");
            }
            key ("Sir Jordan") {
                ["He is a wonder. Despite his blindness, he fights with amazing deftness. In fact, he also enjoys toying with mechanical items, and his loss of eyesight does not seem to affect that, either.~~"However, I sense in him a very recent change, remarkably like that in Sir Richter. He would be an interesting one to speak with. Thou mayest find him at Iolo's South."*];
                v8 = ~IsNPCNear(_Iolo);
                if v8 {
                    SetSpeaker(0, _Iolo);
                    [Iolo smiles proudly.~~"My shop has, er, grown a bit since thou wert here last, <v0>."];
                    CloseSpeaker(_Iolo);
                    SetSpeaker(0, _Tory);
                }
                TurnOff("Sir Jordan");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["I sense thou hast pressing engagements elsewhere. I bid thee farewell."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Tory);
    }
}
