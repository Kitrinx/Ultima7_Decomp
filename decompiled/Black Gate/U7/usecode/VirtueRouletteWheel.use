                BarkIfNear_i(<< "@Place your bets.@", "@Round she goes!@" >>, _Smithy);
            }
            SetWorkType(_Hound, _Smithy);
            v2 = ~FindNearby_i(0, 7, _Virtue_Roulette_Table, item);
