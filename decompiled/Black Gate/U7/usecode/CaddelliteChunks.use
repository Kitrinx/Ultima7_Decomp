Routine CaddelliteChunks accepts a0 #locals(0) {
    if (event = _Action) && ~IsNPCNear_i(_Spark) {
        SetSpeaker(0, _Spark);
        ["Thou dost need a blacksmith to do that. I wager my dad could do it... I mean, could have... if he were still alive..."];
        CloseSpeaker(_Spark);
    }
}
