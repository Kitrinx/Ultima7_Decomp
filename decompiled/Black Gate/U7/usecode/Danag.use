Routine Danag accepts a0 #locals(3) #uses(~IsInInv, GivePartyExp_i, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Danag);
        v0 = ~GetTime();
        v1 = ~IsMedallionOn_i();
        v2 = ~IsInInv(1, 65177, _Prism_981, 1, _Party);
        if (v0 = 7) {
            [Danag nods his head at you. "I do not mean to be impolite, but I am concentrating on the games. I wish to win a bundle tonight!"];
            [He rubs his hand with glee.*];
            terminate;
        }
        TurnOn(<< "name", "job", "bye" >>);
        if (flag(260) or flag(309)) {
            TurnOn("Hook");
        }
        if flag(612) {
            TurnOn("Elizabeth and Abraham");
        }
        if not $MetDanag {
            [You see a jovial man with a wide smile. It is obvious he is enjoying his life.];
            if v1 {
                [He notices your medallion.];
                ["Fellow member! How art thee! I hope thy journey to Buccaneer's Den was not too troublesome! Welcome to our island!"];
            }
            if v2 {
                [The Cube vibrates.];
                ["And I recognize thee as the Avatar! I know that thou art condemned to die!"];
                [Danag smiles as if he had just said that you had been invited to dine with the king.];
            }
            $MetDanag = true;
        } else {
            ["Hello, there!" Danag says.];
        }
        converse {
            key ("name") {
                ["I am Danag, my friend." The man overdoes a majestic bow.];
                TurnOff("name");
            }
            key ("job") {
                ["I am interim Fellowship Branch leader here on Buccaneer's Den. Our regular leader, Abraham, is away on Fellowship business at the moment."];
                TurnOn(<< "Fellowship", "Abraham" >>);
            }
            key ("Fellowship") {
                ["The Fellowship has been present on Buccaneer's Den for a long time. This is one of the oldest branches in Britannia, second only to the headquarters in Britain. Thou mayest wonder why an island of such ill-repute would attract The Fellowship."];
                TurnOff("Fellowship");
                TurnOn("wonder");
            }
            key ("wonder") {
                ["The founders of The Fellowship felt that the people who inhabit this island would benefit the most from our organization.];
                if v2 {
                    ["Especially since we would help them build an empire of sin and gluttony out of Buccaneer's Den."];
                    [You notice the Cube has been vibrating while Danag was speaking.];
                } else {
                    ["Amidst all of the sin, the debauchery, the piracy, the gambling, the drunkenness -- The Fellowship has made its stand and recruited members to follow our principles. Buccaneer's Den has changed as a result."];
                }
                TurnOff("wonder");
                TurnOn("Buccaneer's Den");
            }
            key ("Buccaneer's Den") {
                ["Long ago it was merely a hideout for pirates, scavengers, and rogues. Look around.];
                if v2 {
                    ["Now it is the center of corruption in all of Britannia. The pirates are all controlled by The Fellowship."];
                    [The Cube continues to vibrate.];
                } else {
                    ["Now Buccaneer's Den is an island paradise. It has its own commerce. It pays taxes to Lord British. The pirates here are now businessmen. They have made something of their lives.];
                }
                ["As a result, The Baths and The House of Games are two of the most profitable establishments in the country."];
                TurnOff("Buccaneer's Den");
                TurnOn(<< "The Baths", "House of Games" >>);
            }
            key ("The Baths") {
                if v2 {
                    ["It is, of course, a place where one may experience the pleasures of the flesh. All of the profits go to The Fellowship.];
                } else {
                    ["It is a purely innocent business which caters to the weary who are in need of relaxation. One may receive physical and mental cleansing there.];
                }
                ["It is truly a jewel in the crown that is Britannia."];
                TurnOff("The Baths");
            }
            key ("House of Games") {
                if v2 {
                    ["Why, it is a gambling parlor! The Fellowship certainly takes in a bundle from that place!"];
                } else {
                    ["It is an outfit which challenges the mind and its ability for assessing strategy in life. Exercising this aspect of one's brain is important for one's self-esteem and well-being."];
                }
                TurnOff("House of Games");
            }
            key ("Abraham") {
                ["Abraham is one of the members of the inner circle of The Fellowship. He and his colleague Elizabeth travel the country periodically, usually distributing or collecting the organization's funds and doing business at the other branches."];
                if v2 {
                    [The Cube vibrates.];
                    ["Uhm... er... he is also a coordinator for executions and he cheats at cards."];
                }
                TurnOff("Abraham");
                TurnOn("Elizabeth");
            }
            key ("Elizabeth") {
                ["Elizabeth is an extremely intelligent woman who acts as Director of Special Projects. She usually works with Batlin in Britain, but she spends most of her time travelling from branch to branch."];
                if v2 {
                    [As the Cube vibrates, Danag adds, "She is, uhm... also a royal she-bitch and will murder thee at a moment's notice."];
                }
                TurnOff("Elizabeth");
                TurnOn("Special Projects");
            }
            key ("Special Projects") {
                ["They might be anything from building a shelter for poor peasants to creating a new branch in a town without the benefit of a Fellowship Hall."];
                if v2 {
                    [As the Cube vibrates, Danag proudly adds, "Our current Special Project is building the Black Gate for The Guardian. It is located at the Isle of the Avatar in our secret underground complex!"];
                    TurnOn(<< "Black Gate", "complex" >>);
                }
                TurnOff("Special Projects");
            }
            key ("Black Gate") {
                [Danag's eyes widen with excitement. "It is the gateway for our coming Lord and Master! He will be coming through in virtually a few hours!"];
                TurnOff("Black Gate");
            }
            key ("complex") {
                ["It is inside a dungeon within the Shrine of the Codex. A barrier keeps out unwanted visitors. A special key opens the barrier, and only a few select people have one."];
                TurnOff("complex");
                TurnOn("key");
            }
            key ("key") {
                ["I do not own one. The only people that do are Elizabeth and Abraham, Batlin, and Hook himself. Hook probably keeps his key in his abode."];
                TurnOff("key");
            }
            key ("Hook") {
                if v2 {
                    [The Cube vibrates.];
                    ["Man with a Hook? That's his name! 'Hook'! He lives here on the island! In fact, his quarters are in the secret catacombs behind the House of Games! Thou canst reach it by asking Sintag the guard about Hook. Of course, thou dost know that Hook is The Fellowship's chief executioner... along with his assistant, the gargoyle Forskis."];
                    TurnOn(<< "executioner", "Forskis" >>);
                    GivePartyExp_i(100);
                } else {
                    ["A pirate with a hook for a hand? No... I do not believe I know him. There are many pirates on this island. Many of them are missing appendages, too!"];
                }
                TurnOff("Hook");
            }
            key ("Elizabeth and Abraham") {
                ["They usually travel together. They just arrived from our Meditation Retreat near Serpent's Hold and I believe they are somewhere on the island. Abraham told me I must keep working as interim branch leader until his return."];
                flag(680) = true;
                if v2 {
                    [The Cube vibrates.];
                    ["Actually, I believe they are on their way to the Isle of the Avatar to take care of our new Special Project."];
                }
                TurnOff("Elizabeth and Abraham");
            }
            key ("executioner") {
                ["That's right. Hook does all the dirty work for The Fellowship. He was trained by Master De Snel in Jhelom. De Snel trained all the previous executioners as well. In fact, De Snel himself was The Fellowship's first executioner!"];
                TurnOff("executioner");
            }
            key ("Forskis") {
                ["I understand the gargoyle's name means 'henchman' in Gargish. He's a tough wingless gargoyle who helps Hook out. I believe he resides in the catacombs with Hook."];
                TurnOff("Forskis");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["Farewell!"*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Danag);
    }
}
