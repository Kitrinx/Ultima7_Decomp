#	U7.EXE, Ultima VII: The Black Gate
#
#	Borland C++ 2.0 with its MAKE, and Turbo Assembler 2.51.  Run MAKE in
#	this directory, the build directory: __FILE__ names the source
#	directories beside it as ..\common, ..\inter and so on.
#
#		make			compiler in C:\BORLANDC
#		make -DBC=C:\BC20	compiler elsewhere
#
#	Each list of objects shares one set of options, which its name spells:
#	MAIN_OGPd is -O -G -P -d in this directory; b0 is -b-, vi0 is -vi-.

.autodepend

!if !$d(BC)
BC = C:\BORLANDC
!endif

CC = $(BC)\bcc +U7.CFG
AS = tasm

all: U7.CFG U7.EXE

# Options every C module shares; the compiler's own headers come last.
U7.CFG: MAKEFILE
	copy &&|
-c -mm -y
-I.;combat;dos;mem;overlay;palette;schedule;video;xmm;..\common;..\include;..\inter;..\sound;..\sound\drv;..\zevent;$(BC)\include
| U7.CFG

# The build directory.

MAIN_OGP = action.obj actitem.obj actmove.obj actqueue.obj actutil.obj \
	appts.obj bltshape.obj bodies.obj bogus.obj camera.obj collide.obj \
	death.obj debug.obj eggspawn.obj endstats.obj equip.obj explode.obj \
	flexvoo.obj frameflg.obj getpick.obj gtimer.obj gumps.obj initwp.obj \
	itable.obj itemcmd.obj legalmov.obj lunch.obj main.obj mainctrl.obj \
