# Origin's overlay manager, linked ahead of OVERLAY.LIB in place of its OVRMAN.
RUNTIME_ASM = overlay.obj
$(RUNTIME_ASM):
	$(AS) /mx ..\runtime\$&.asm

all_runtime: $(RUNTIME_ASM)

# MAKE limits the length of a rule line, so U7.EXE depends on one list per
# directory.
U7.EXE: all_main all_combat all_dos all_mem all_overlay all_palette \
	all_schedule all_video all_xmm all_common all_inter all_zevent all_sound \
	all_drv all_runtime U7.LNK
	$(BC)\tlink /m /s /c /d /L$(BC)\lib @U7.LNK
