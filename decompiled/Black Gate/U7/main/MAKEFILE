# __FILE__ gives these their bare names, so they compile in their own directory.
XMM_OWN_OG = freexmm.obj xmmhand.obj
$(XMM_OWN_OG):
	cd xmm
	$(BC)\bcc -c -mm -y -I..;..\mem;$(BC)\include -n.. -O -G $&.c
	cd ..

XMM_OGP = shapehgt.obj shapewid.obj
$(XMM_OGP):
