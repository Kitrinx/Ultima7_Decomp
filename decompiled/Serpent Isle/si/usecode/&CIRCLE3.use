Routine ChillSpell_i accepts a0 #locals(4) #uses(~IsMagicOK_i, ~NPCLevel_i, ~GimmePathEgg) {
    if (event = _Converse) {
        Item_bark("@Rel Frio Mani@", item);
        if ~IsMagicOK_i() {
            Kernel_resetRef(item);
            v0 = ~PostAction(<< _aNO_HALT_i, _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #ChillSpell_i >>, item);
