            v0 = ~PostAction(<< _aNO_HALT_i, _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Action) {
        Sfx(90);
        v1 = ~NPCLevel_i(_Avatar);
        v2 = (2000 + (v1 * 200));
        CreateSpriteOn_i(65533, 0, 0, 0, 65534, 65534, 7, item);
        $chill_active = true;
        v3 = ~GimmePathEgg(2, 7);
        v0 = ~PostInFuture(v2, << _aNO_HALT_i, _aFINISH_i, _aUSABLE_i, #EndChill_i >>, v3);
    }
}

