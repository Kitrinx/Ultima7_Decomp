Routine Dart_Board accepts a0 #locals(1) #uses(Bark_i) {
    v0 = ~GetFrame(item);
    if (v0 = 0) {
        SetFrame(1, item);
        Sfx(12);
        Bark_i(3, "@Take care!@", _Dupre);
    }
    if (v0 = 1) {
        SetFrame(2, item);
        Sfx(12);
        Bark_i(3, "@Squawk!@", _Ale);
        Bark_i(1, "@'Twas a wild throw.@", _Shamino);
    }
    if (v0 = 2) {
        SetFrame(3, item);
        Bark_i(3, "@Excellent shot!@", _Iolo);
        Sfx(12);
    }
    if (v0 = 3) {
        SetFrame(0, item);
        Bark_i(0, "@Another game?@", _Avatar);
    }
}
