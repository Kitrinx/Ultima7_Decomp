    v2 = false;
    v3 = false;
    if (~WhereAmI_i() = 13) {
        v3 = true;
    }
    if $AVATAR_IS_KNIGHT {
        v1 = "knight";
    }
    v4 = ~AvatarSex();
    v5 = ~LordOrLady();
    v6 = false;
    v7 = false;
    v8 = false;
    if (event = _NearDeath) {
        v9 = ~PostAction(<< _aUSABLE_i, #Paladin >>, item);
    }
    if ((event = _Converse) and (~GetWorkType(_Krayg) <> _Stand)) {
        Item_bark("@Hello, sir.@", _Avatar);
        PartyFaces_i(65468);
        if v0 {
            Bark_i(2, "@Hello.@", _Krayg);
            SetWorkType(_Stand, _Krayg);
            FaceAvatar_i(65468);
            v9 = ~PostInFuture(7, << _aNO_HALT_i, _aUSABLE_i, #Krayg >>, _Krayg);
        } else {
            Bark_i(2, "@Hello.@", _Krayg);
            SetWorkType(_Talk, _Krayg);
        }
    }
    if (event = _Action) {
        event = 9;
    }
    if (event = _Talking) {
        Npc_schedule(_Krayg);
        ClearBark_i(_Krayg);
        if (~GetWorkType(_Krayg) = _TendShop) {
            v0 = true;
        }
        SetSpeaker0_i(0, _Krayg);
        SayBanquetTime_i();
        v10 = ~GetItemFlag_i(_Met, _Krayg);
        if not v10 {
            if v0 {
                ["Hello, <v1>. I am Krayg the Provisioner. If thou needest any goods, I can provide them at a fair price."];
            } else {
                ["Hello, <v1>. How can I help thee?"];
            }
            SetItemFlag_i(_Met, _Krayg);
        } else {
            if $AVATAR_IS_KNIGHT {
                ["Hello again, <v1>."];
            } else {
                ["Hello, <v1>."];
            }
        }
        if $AVATAR_IS_KNIGHT {
            TurnOn("duties");
        }
        if (not v3 or $templaraccuseskrayg) {
            TurnOn("walks in the woods");
        }
        if $templaraccuseskrayg {
            TurnOn("Luther");
        }
        if ($foundsimonbottle or ($askkraygruins or ($askkraygslippers or $askkraygrock))) {
            TurnOn("information");
        }
        TurnOn(<< "Knights", "supplies", "bye" >>);
        converse {
            key ("information") {
                TurnOff("information");
                ["Someone hath sent thee to me, eh? Well, I shall try to be of help to thee. What dost thou inquire about?"];
                PushKeys();
                if ($askkraygrock and not $knowpumice) {
                    TurnOn("pumice");
                }
                if ($askkraygslippers and not $knowslippers) {
                    TurnOn("slippers");
                }
                if $askkraygruins {
                    TurnOn("ruins");
                }
                if ($foundsimonbottle and (~GetWorkType(_Simon) <> _Wait)) {
                    TurnOn("brown bottle");
                }
                TurnOn("change subject");
            }
            key ("brown bottle") {
                TurnOff("brown bottle");
                if ~IsInInv(9, 65177, _Bottles, 1, _Party) {
                    ["See! I told everyone that I could not be the traitor!"];
                    ["I am not even a drinking man. But Luther is known to imbibe to excess..."];
                    ["This bottle must be his! Luther is the traitor!"];
                } else {
                    ["A bottle in the woods? And thou dost think that I dropped it?"];
                    v9 = ~AvatarName();
                    ["Thou art wrong, <v9>! Ask anyone -- they will tell thee that I am not a drinking man."];
                    ["'Tis due to mine injuries. Milk is all that I can tolerate. Boiled milk."];
                    Bark_i(0, "@Leave me alone...@", _Krayg);
                    terminate;
                }
            }
            key ("duties") {
                TurnOff("duties");
                ["I run the supplies shop in Monitor, The Tools of the Trade. 'Tis not a glorious duty, but I cannot wield a sword comfortably because of my condition."];
                PushKeys();
                TurnOn(<< "condition", "change subject" >>);
            }
            key ("condition") {
                TurnOff("condition");
                ["If thou dost look closely, thou canst see that mine arm is bent unnaturally at the elbow. I was wounded as a lad, in my very first battle -- the Goblins surprised us, and it was a heated battle... I was not able to obtain healing in time. Thus I was left unfit for combat."];
                PopKeys();
            }
            key ("Luther") {
                TurnOff("Luther");
                ["So thou art a comrade of that brute Luther, eh? I know that he is no friend of mine. He is suspicious of me for no other reason than that I happen to like to take walks in the woods!"];
                ["He is merely following his leader, Caladin -- they all think the Wolves are their enemies!"];
                if not v2 {
                    TurnOn("walks in the woods");
                }
            }
            key ("supplies") {
                if v0 {
                    ["I sell many things that a warrior would require while travelling outside the city. I also buy a few goods that I need. Dost thou wish to buy or sell?"];
                    v11 = ~AskList(<< "nothing", "buy", "sell" >>);
                    if (v11 = "buy") {
                        KraygSellsProvisions_i();
                        TurnOn("buy");
                    }
                    if (v11 = "sell") {
                        ["I buy a few leather items, <v1>..."];
                        ["But my prices are set, I'm afraid."];
                        KraygBuysLeather_i();
                        TurnOn("sell");
                    }
                    if (v11 = "nothing") {
                        ["Perhaps another time, <v1>."];
                    }
                } else {
                    ["I sell supplies when I am open, <v1>!"];
                }
            }
            key ("buy") {
                KraygSellsProvisions_i();
            }
            key ("sell") {
                KraygBuysLeather_i();
            }
            key ("Knights") {
                TurnOff("Knights");
                if v3 {
                    ["We are all Knights in this town."];
                } else {
                    ["In the City of Monitor, everyone is a Knight."];
                }
                if $AVATAR_IS_KNIGHT {
                    ["I myself belong to the Command of the Wolf."];
                    PushKeys();
                    TurnOn("Commands");
                    if not v6 {
                        TurnOn("Wolf");
                    }
                    TurnOn(<< "Bear", "Leopard", "change subject" >>);
                } else {
                    if v3 {
                        ["I must tell thee, stranger, that if thou art not a Knight, thou art nothing in this town. If thou canst not master the Test of the Knights, then it would be best for thee to move on."];
                    } else {
                        ["In Monitor, one is either a Knight, or one is nothing at all. Unless thou art thinking of taking the Test of the Knights, thou mightest want to avoid the City of Monitor."];
                    }
                    $knowknightstest = true;
                }
            }
            key ("Commands") {
                TurnOff("Commands");
                ["Thou dost not know about the Commands? All Monitorians belong to one of three Commands: the Bears, the Wolves, or the Leopards."];
                $knowcommands = true;
            }
            key ("Wolf") {
                ["It is hard to be a Knight who doth not fight well. I am useless on the battlefield, but by being Provisioner I can at least earn my keep! The Wolves have treated me well. Now if I were a Bear... well, all they can think of is Prowess."];
                TurnOff("Wolf");
                v6 = true;
            }
            key ("Bear") {
                TurnOff("Bear");
                v7 = true;
                ["They are brutes! All they can think of are their incessant duels. The Bears fight only for glory -- but what about the Goblins? What about bandits on the road? Caladin and his Knights are too concerned with winning glory to worry about the true battles which face us."];
                PushKeys();
                TurnOn(<< "Caladin", "duels", "nothing more" >>);
            }
            key ("Leopard") {
                TurnOff("Leopard");
                if ($marstenarrested = true) {
                    if ($marstendead = false) {
                        ["That fool Marsten is a blight upon all that the Commands stood for... I believe he hath ruined the reputation of the Leopard Command for good."];
                    } else {
                        ["Well, that foolish leader of the Leopards is now dead. I wonder who will replace him?"];
                    }
                } else {
                    ["The Leopards are not as bad as everyone says they are. They keep the Bears from ruining us! Lord Marsten hath ruled well here, and he is a Leopard. He hath no favorites among the Commands."];
                }
            }
            key ("Caladin") {
                TurnOff("Caladin");
                ["Caladin is not a bad sort, but his mind is mired in the past. All he sees is Prowess. Can he not see that we Monitorians must stop duelling amongst ourselves, and instead turn our attention outward? Caladin thinks that the Wolves hate the Bears, but the truth is that he cannot abide the plans of our leader, Brendann."];
            }
            key ("duels") {
                TurnOff("duels");
                ["They waste too many hours at the List Fields, fighting any who will challenge them."];
                if $AVATAR_IS_KNIGHT {
                    ["Luther is the worst! Thou didst hear him! He doth accuse me of being a traitor."];
                } else {
                    ["Luther is the worst!"];
                }
            }
            key ("walks in the woods") {
                TurnOff("walks in the woods");
                if v2 {
                    ["Oh, let us not discuss this again..."];
                } else {
                    PushKeys();
                    v2 = true;
                    if $templaraccuseskrayg {
                        ["It pains me that simply because I have this natural tendency, others would viciously gossip that I was conspiring with our enemy. I seldom venture far while I am alone and I take exceeding care, thou canst well believe me."];
                        TurnOn("conspiring");
                    }
                    ["I take long walks. Well, what is wrong with that, I ask thee? I especially like to visit sites of battles, looking for antique weaponry or armour.\x09I collect them. I collect many things."];
                    if not v8 {
                        TurnOn(<< "battle sites" >>);
                    }
                    TurnOn("change subject");
                    if (not $templaraccuseskrayg and v8) {
                        PopKeys();
                    }
                }
            }
            key ("nothing more", "change subject") {
                ["Very well..."];
                PopKeys();
            }
            key ("ruins", "battle sites") {
                v8 = true;
                TurnOff("battle sites");
                TurnOff("ruins");
                ["There must have been a great war here, in the days when the Daemons ruled the Serpent Isle. My walks have taken me deep into the most tangled woods, where I have found many mysteries -- ruins built of strange stone, artifacts made of brass, sometimes a skull or shattered weapon... and always, the Sign of the Serpent."];
                TurnOn("Sign of the Serpent");
            }
            key ("Sign of the Serpent") {
                TurnOff("Sign of the Serpent");
                ["Hast thou not wondered why our land is known as the Serpent Isle? Everywhere our ancestors went, they found the Sign of the Serpent -- in carvings, statuettes, throughout the many ancient ruins. Monitor itself was built on the site of an ancient ruin from the times of the Serpent."];
            }
            key ("Goblins") {
                TurnOff("Goblins");
                ["They are an infestation! We have fought them since the moment our ancestors set foot on this island. We must destroy them if we are ever to be safe, but we cannot do this unless the Bears and Leopards are willing to listen to Brendann. We must track them to their village lair and slay them. And if a traitor doth exist, then we are doomed from the start..."];
            }
            key ("conspiring") {
                TurnOff("conspiring");
                ["Dost thou accuse me? I am an innocent man, and soon I shall present evidence of that fact! I have reasons of mine own to believe that someone among us is selling our secrets to the Goblins."];
                PushKeys();
                TurnOn(<< "reasons of mine own", "evidence", "nothing more" >>);
            }
            key ("reasons of mine own") {
                TurnOff("reasons of mine own");
                ["There is someone else who takes long walks in the woods. I have never seen him clearly. He is very clever, and always dashes away into the forest before I can identify him."];
                v12 = ~PartyUtters(false, 0, "@But was he Goblin or Man?@", 65535);
                if (v12 <> 65180) {
                    CloseSpeaker1_i();
                    SetSpeakerSlot_i(0);
                    ["He was not Goblin! They never travel in the woods except in war parties. Yet there was something in his gait that was not entirely Man-like, either."];
                } else {
                    ["He could not have been Goblin, for they never walk in the woods alone. Therefore... I think he must have been the Monitorian traitor!"];
                }
            }
            key ("evidence") {
                TurnOff("evidence");
                ["Listen to this -- if there is a traitor, he must meet with the Goblins somewhere. I know of a place where the Goblins often gather. Perhaps I can find evidence there of who the traitor is. But of late, there have been too many Goblin patrols near the rendezvous. I have been unable to reach the place undetected."];
                TurnOn(<< "patrols", "rendezvous" >>);
            }
            key ("patrols") {
                TurnOff("patrols");
                ["The Goblins have been thick in the woods north of Knight's Test for weeks now. They have been emboldened ever since they overran the guardtower west of Fawn. That is where they slew Astrid, the bastards!"];
            }
            key ("rendezvous") {
                TurnOff("rendezvous");
                ["The place is easy to find, for the Goblins are attracted to the ancient ruins of this Isle. In the midst of the great cypress woods north of Knight's Test, look for a strange black obelisk. This is the gathering place of the Goblin war parties, before they strike south."];
                $KNOWS_GOBLINS_HIDEOUT = true;
            }
            key ("pumice") {
                TurnOff("pumice");
                ["I recognize thy description! Such rocks doth come from the depths of the earth, where lava flows free and deadly gasses abound. Standarr the Blacksmith hath been to places such as these, on his Quests of Courage -- thou mightest acquire more information from him."];
                $knowpumice = true;
                $askstandarrfurnace = true;
            }
            key ("slippers") {
                TurnOff("slippers");
                ["The nearest place where decorative footwear like that would be worn is Sleeping Bull. Certainly, no one in Monitor would be caught dead wearing them!"];
            }
            key ("bye") {
                CloseSpeaker0_i();
                Bark_i(0, "@Must go now!@", _Avatar);
                Bark_i(2, "@Walk in Courage!@", _Krayg);
                break;
            }
        }
        clear_answers;
    }
    if (event = _Bark) {
        v13 = ~rndRange(5, 1);
        if v0 {
            if (v13 = 1) {
                v14 = "@Supplies?@";
            }
            if (v13 = 2) {
                v14 = "@Leather boots?@";
            }
            if (v13 = 3) {
                v14 = "@Finest goods here!@";
            }
            if (v13 = 4) {
                v14 = "@Best goods in Monitor!@";
            }
            if (v13 = 5) {
                v14 = "@Bedroll?@";
            }
