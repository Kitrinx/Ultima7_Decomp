Routine Krayg accepts a0 #locals(15) #uses(~LordOrLady, ~WhereAmI_i, PartyFaces_i, Bark_i, FaceAvatar_i, SayBanquetTime_i, ~IsInInv, ~AvatarName, ~AskList, KraygSellsProvisions_i, KraygBuysLeather_i, ~PartyUtters, BarkAboutWork_i) {
    v0 = false;
    if (~GetWorkType(_Krayg) = _TendShop) {
