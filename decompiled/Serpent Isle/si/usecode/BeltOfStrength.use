Routine BeltOfStrength accepts a0 #locals(9) #uses(GivePartyExp_i) {
    if ((event = _Equip) or (event = _Unequip)) {
        v0 = ~Item_getContainer(item);
        While ((v0 <> 0) and not ~Item_isNpc(v0)) {
            v0 = ~Item_getContainer(v0);
        }
        if (v0 = 0) {
            FlashMouse_i(0);
            return;
        }
    }
    if (event = _Equip) && ~Npc_getEquip(11, ~Item_getContainer(item)) {
        if not $EXPERIENCE_FROM_BELT_OF_STRENGTH {
            GivePartyExp_i(1000);
            $EXPERIENCE_FROM_BELT_OF_STRENGTH = true;
        }
        if not $WEARING_BELT_OF_STRENGTH {
            v1 = ~GetNPCStat_i(_Str, v0);
            v2 = (30 - v1);
            if (v2 > 10) {
                v2 = 10;
            }
            v3 = ~SetQuality(v2, item);
            v4 = ~ChangeNPCStat_i(v2, _Str, v0);
            if v4 {
                $WEARING_BELT_OF_STRENGTH = true;
            }
        }
    }
    if (event = _Unequip) && $WEARING_BELT_OF_STRENGTH {
        v5 = ~GetQuality(item);
        v6 = (65535 * v5);
        v4 = ~ChangeNPCStat_i(v6, _Str, v0);
        if v4 {
            $WEARING_BELT_OF_STRENGTH = false;
            v1 = ~GetNPCStat_i(_Str, v0);
            v7 = ~GetNPCStat_i(_Hits, v0);
            if (v7 > v1) {
                v8 = (v1 - v7);
                v4 = ~ChangeNPCStat_i(v8, _Hits, v0);
            }
        }
    }
}
