Routine Rabindrinath accepts a0 #locals(8) #uses(~LordOrLady, ~AvatarName, ~IsInInv, Bark_i, PartyFaces_i, RabindrinathCasts_i, RabindrinathTeleports_i) {
    v0 = ~LordOrLady();
    v1 = ~AvatarSex();
    v2 = ~AvatarName();
