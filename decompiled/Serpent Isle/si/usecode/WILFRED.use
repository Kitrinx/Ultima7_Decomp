                SetItemFlag_i(_Met, _Wilfred);
                TurnOn("Sleeping Bull");
            }
            key ("Sleeping Bull") {
                TurnOff("Sleeping Bull");
                ["Well, if thou art so rude to ask..."];
                v11 = ~PartyUtters(false, 0, "@Thou art the rude one!@", 1);
                SetSpeakerSlot_i(0);
                ["Devra and Angus, proprietors of the inn, are my parents. I was born here."];
            }
            key ("duties") {
                TurnOff("duties");
                ["As thou canst see... I am a Knight of Monitor."];
                ["I am currently seeking the murderer of my father."];
                TurnOn("murderer");
