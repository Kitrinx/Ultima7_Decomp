            key ("Templar") {
                TurnOff("Templar");
                ["Templar is a Knight of the Bear Command, and my friend."];
                ["Although his friendship with Flessar was unusual, in that they were from different Commands, it was inevitable that young Flessar would look to one of Monitor's best swordsmen for guidance."];
                ["Alas, Templar's skill could not help young Flessar on the dueling field."];
            }
            key ("Wolves") {
                TurnOff("Wolves");
                ["Argus is... or was... a member of the Wolf Command."];
                ["It doth not take much more than a glance at their commander to see what a worthless Command they are."];
