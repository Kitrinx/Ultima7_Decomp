                        $wilfredjoined = true;
                    } else {
                        ["Very well. Perhaps I shall journey to Monitor and see what hath transpired there."];
                    }
                } else {
                    ["Thou hast more than enough companions to protect thee!"];
                    ["Look for me in Monitor when thou dost truly need mine excellent skills. Perhaps I will aid thee then.];
                }
            }
        } else {
            if (v9 = false) {
                if ($gottattoo = true) {
                    ["Ah, I see that thou art a Knight of Monitor!"];
                    ["Although I do not know thee, I am certain that thou knowest me!"];
                } else {
                    ["I do not recall having met thee before..."];
                    ["But I am certain that thou hast heard of me!"];
