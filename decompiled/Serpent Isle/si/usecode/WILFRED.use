}

Usable WilfredReturnsBelongings_i #locals(1) #uses(~AskYesNo, ~ReturnBelongings_i) {
    if ~GetContents(_All, _All, _All, _Wilfred) {
        ["I still have some of thy worthless belongings. If thou wantest them, thou hadst best take them now."];
        ["Dost thou want such items returned?"];
        if ~AskYesNo() {
            ["Here they are."];
            $WILFRED_HAS_BELONGINGS = false;
            v0 = ~ReturnBelongings_i(65491);
            if (v0::1 <> 0) {
                ["Thy companions will have to carry some of these useless things."];
            }
            if (v0::2 > 0) {
                v0 = v0::2;
                if (v0 > 1) {
                    ["Since thou canst not carry these remaining <v0> items, they will go on the floor."];
                } else {
                    ["Since thou dost not have enough room for this last item, it will go on the floor."];
                }
            }
        } else {
            $WILFRED_HAS_BELONGINGS = true;
            ["If that is what thou wantest, so be it."];
        }
    }
}

