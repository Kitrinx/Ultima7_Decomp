        }
        if ($BANES_RELEASED = true) {
            if $wilfredjoined {
                if ~GetItemFlag_i(_InParty_i, _Wilfred) {
                    ["I am ready to aid thee. Thou couldst have chosen no better companion than myself!"];
                } else {
                    ["Why dost thou trouble me now? Canst thou not see that I am very busy..."];
                    TurnOn("join");
                }
            } else {
                ["Well met, Avatar!"];
                ["Hath vengeance been exacted upon Batlin for his evil deeds?"];
                if (~AskYesNo() = true) {
                    ["Marvelous! The world will be a better place!"];
                    if ($gottattoo = true) {
                        ["Thou art truly worthy of thy Knighthood!"];
                    } else {
                        ["Thou art worthy of Knighthood!"];
                    }
                } else {
                    ["Then I must continue to seek him."];
                    Bark_i(0, "@Batlin must die!@", _Wilfred);
                    SetWorkType(_Shy, _Wilfred);
                    terminate;
                }
