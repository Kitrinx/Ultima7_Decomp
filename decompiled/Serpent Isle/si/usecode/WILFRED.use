        Npc_schedule(_Wilfred);
        ClearBark_i(_Wilfred);
        SetSpeaker0_i(0, _Wilfred);
        if ~GetItemFlag_i(_InParty_i, _Wilfred) {
            SetWorkType(_FollowAvt, _Wilfred);
            TurnOn("leave");
        } else {
