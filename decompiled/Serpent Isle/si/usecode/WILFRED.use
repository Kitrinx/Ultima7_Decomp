Routine Wilfred accepts a0 #locals(12) #uses(~LordOrLady, ~AvatarName, ~WhereAmI_i, ~IsNPCNear, WilfredReturnsBelongings_i, Bark_i, SetWorkTypeAt_i, PartyFaces_i, ~AskYesNo, ~AskList, ~PartyUtters, WilfredTrains_i) {
    v0 = ~LordOrLady();
