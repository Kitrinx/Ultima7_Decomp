                TurnOff("traitor");
                ["This is all so confusing. Lord Brendann is certain that there must be a traitor, and the Wolves are united behind him."];
                ["Yet I have also heard that there is certainly no traitor, and that we should not indulge in hysteria..."];
                v3 = ~PartyUtters(false, 0, "@Who told thee this, madam?@", 1);
                if (v3 <> 65180) {
                    SetSpeakerSlot_i(0);
                    ["Um... no single person, actually. I have merely heard it said in conversation. In a tavern, one hears everything."];
                }
            }
