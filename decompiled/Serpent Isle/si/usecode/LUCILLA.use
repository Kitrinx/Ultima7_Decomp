    }
    if (event = _Talking) {
        Npc_schedule(_Lucilla);
        ClearBark_i(_Lucilla);
        SetSpeaker0_i(0, _Lucilla);
        if ($lucillainvited and (~GetWorkType(_Lucilla) = _Sleep)) {
            ["Oh, darling! Let us meet in my bedroom..."];
            Bark_i(0, "@I am so sleepy...@", _Lucilla);
            Npc_schedule(_Lucilla);
            terminate;
        }
        if not ~GetItemFlag_i(_Met, _Lucilla) {
            if not ~AvatarSex() {
                ["Forgive my boldness, but I must say that thou hast a fine build, milord! Surely, thou hast overcome many foes with the powerful thrust of thy weapon..."];
            } else {
                ["What can I do for thee, dear?"];
            }
            if ~IsNPCNear_i(_Spektor) {
                SayIfNear_i("@I do hope that I am not interrupting...@", 65459);
                SetSpeakerSlot_i(0);
            }
            ["My name is Lucilla. Is there anything I can do for thee? Anything at all?"];
            SetItemFlag_i(_Met, _Lucilla);
