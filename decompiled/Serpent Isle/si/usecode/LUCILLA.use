                TurnOff("brown bottle");
                if ~IsInInv(9, 65177, _Bottles, 1, _Party) {
                    ["'Tis a very dirty bottle. Thou didst find this in the woods?"];
                    ["Ah! 'Tis one of Simon's ale bottles. I order them specially for him, as only he can stand the taste."];
                    ["Fawnish ale -- phew! A horrible brew."];
                    $knowsimonbottle = true;
                } else {
                    ["If thou couldst bring me the bottle, I am sure that I could identify it. We supply ale and spirits for the entire town from the pub where I work."];
                    ["If the bottle is of an uncommon type, then perhaps that would be a clue."];
                }
            }
            key ("name") {
                TurnOff("name");
                ["My name is Lucilla."];
                SetItemFlag_i(_Met, _Lucilla);
            }
            key ("duties") {
                TurnOff("duties");
                ["I run the Slashing Sword, the best pub in Monitor. Thou mightest think that cooking is not a very Knightly activity, but I assure thee, feeding the warriors in this town is indeed a Quest of Courage!"];
                if (~GetWorkType(_Lucilla) = _Waiter) {
                    ["If thou dost want anything to eat or drink, thou hast merely to say so, <v1>."];
                } else {
                    ["Please come by the pub sometime."];
                }
                if not $AVATAR_IS_KNIGHT {
                    ["And I would love to chat further, but I do not speak with strangers. My standards are very high, and thou art not a Knight of Monitor."];
                    Bark_i(0, "@Not a Knight!@", _Lucilla);
                    terminate;
                } else {
                    TurnOn(<< "The Slashing Sword", "cooking", "Quest of Courage" >>);
                }
            }
            key ("buy") {
                if (~GetWorkType(_Lucilla) = _Waiter) {
                    ["What wouldst thou like, <v1>?"];
                    v4 = ~AskList(<< "food", "drink" >>);
                    if (v4 = "food") {
                        LucillaSellsFood_i();
                    }
                    if (v4 = "drink") {
                        LucillaSellsDrink_i();
                    }
                } else {
                    ["If thou wouldst return when we are open, perhaps I could serve thee food or drink..."];
                    TurnOff("buy");
                }
            }
            key ("The Slashing Sword") {
                TurnOff("The Slashing Sword");
                ["'Tis a pub that hath been handed down generation to generation, originating with my great-grandfather. Although 'tis a wonderful place to have a meal, most of the men in the town come by to court me!"];
                if not ~AvatarSex() {
                    ["I enjoy all the attention..."];
                    TurnOn("court");
                }
                TurnOn(<< "great-grandfather", "men" >>);
            }
            key ("great-grandfather") {
                TurnOff("great-grandfather");
                ["He was not only the founder of the pub, but he was a Champion Knight of Monitor! He wore the Helm of Monitor for several years, before he was bested in a tournament."];
                TurnOn(<< "Champion Knight", "tournament" >>);
            }
            key ("Champion Knight") {
                TurnOff("Champion Knight");
                ["I can hardly speak of the Champion Knight without remembering Astrid's foul death at the hands of the Goblins."];
                if $gothelmofmonitor {
                    ["I am so glad that thou hast recaptured the Helm of Monitor. Thou dost make a fine Champion Knight in thine own right."];
                } else {
                    ["I fear that there is none worthy to fill her shoes as Champion Knight!"];
                    TurnOn("worthy");
                    if not ~AvatarSex() {
                        ["Except, perhaps, thyself? I must believe that thou hast had thy share of conquests in thy time..."];
                    }
                }
            }
            key ("worthy") {
                TurnOff("worthy");
                ["Monitor is not the town it once was. Our ancestors founded a settlement built on the Principle of Courage."];
                ["But today, greed and glory have corrupted our Knights. Monitor needs a champion that is not only a leader on the battlefield, but someone who can stir their hearts and lead them back to what it means to be a Knight."];
                if not $gothelmofmonitor {
                    ["I wish a new Champion Knight would arise, one who can not only retrieve the Helm of Monitor, but also right the wrongs in this town!"];
                }
                if not ~AvatarSex() {
                    ["Could that person be thee? I would like it to be so."];
                } else {
                    v3 = ~PartyUtters(false, 0, "@Perhaps this is a quest for the Avatar?@", 1);
                    if (v3 <> 65180) {
                        SetSpeakerSlot_i(0);
                    }
                }
            }
            key ("tournament") {
                TurnOff("tournament");
                ["All the Knights think about is fighting! And who do they fight? The Goblins? No! They prefer to spar with one another at the List Field!"];
                ["Luther is the worst. Oh, how I hate him!"];
                TurnOn("Luther");
            }
            key ("Luther") {
                TurnOff("Luther");
                ["What a buffoon! He thinks every woman in this town wants him, but I find him repulsive!"];
                ["To prove his prowess, he torments the weakest Knights and challenges them to meet him on the List Field."];
                ["And when they lose -- which they must, since Luther is such a powerful brute -- he gloats over them."];
                if not $HAS_DUPRE_SHIELD {
                    ["They say that that new shield of his doth have special powers, so that now he is truly invincible!"];
                    ["Well, I say if it is magical, then force him to not use it! Monitorians do not use magic weapons or armour..."];
                    ["But no one can tell Luther anything."];
                    $askluthermagicshield = true;
                }
                $lucillasaidrepellant = true;
            }
            key ("men") {
                TurnOff("men");
                if ~AvatarSex() {
                    ["Dost thou not know that men are scum? Yet we cannot leave them alone..."];
                    ["Wouldst thou like to know more about the men of Monitor?"];
                    if ~AskYesNo() {
                        ["Avoid Brendann -- he sees women as trophies, to be won and then set on a shelf. He is shallow and insincere."];
                        ["Templar is very attractive, I think. But Caladin is a brute, and Luther is a clod!"];
                    } else {
                        ["'Tis just as well -- there are no great lovers in this place!"];
                    }
                } else {
                    ["Why is it that a woman must have a man? I have looked and looked, and I have not yet found the one for me."];
                    ["He must be tough, yet gentle with his woman. Brave, but afraid to disappoint his mate. He must be devious enough to win many battles, yet fair enough to consider me as his equal..."];
                }
            }
            key ("Andral") {
                TurnOff("Andral");
                ["For a time we were quite close. I still have great respect for his talents, but in truth he always put me second to his work. I suppose I enjoy being the center of attention too much."];
            }
            key ("court") {
                TurnOff("court");
                ["Dost thou find me beautiful? I admit I love the attention! But I have never found the right man for me..."];
                if not ~AvatarSex() {
                    ["But I sense that thou art somehow different, milord."];
                    if $spektorandlucillacaught {
                        ["Listen, Spektor and I truly have nothing together. Honestly, 'tis nothing."];
                    }
                    ["Wouldst thou like to meet later?"];
                    $lucillakissed = true;
                    if ~AskYesNo() {
                        label_103:
                        ["Then meet me at the pub after we have closed, in the wee hours before dawn. 'Tis the only time I can be alone with thee since I work so late."];
                        ["I cannot wait."];
                        $lucillainvited = true;
                    } else {
                        ["Oh. Be that way, then. There are plenty of others who are interested in me!"];
                    }
                }
            }
            key ("cooking") {
                TurnOff("cooking");
                ["If I do say so myself, I am a master of cooking poultry. Or as they say..."];
                if not ~AvatarSex() {
                    ["Breasts and thighs, breasts and thighs. And which dost thou prefer, milord? But do not answer yet..."];
                } else {
                    ["If I cannot succeed in the bedroom, I might as well try in the kitchen! Homely women make good cooks, they say..."];
                }
            }
            key ("Quest of Courage") {
                TurnOff("Quest of Courage");
                ["Thou knowest -- the quests to prove that thou art fit to bear thy Knighthood..."];
                if $gothelmofmonitor {
                    ["Like when thou didst retrieve the Helm of Monitor from that vile Pomdirgun."];
                } else {
                    ["Surely, a fine young warrior like thyself dost plan to partake in the Quest to retrieve the Helm of Monitor?"];
                    if ~AskYesNo() {
                        ["If only we could learn the secret of their hidden camp! But it remains a mystery..."];
                    } else {
                        ["Too dangerous for a coward like thyself? And I thought better of thee..."];
                    }
                }
            }
            key ("interrupting") {
                TurnOff("interrupting");
                ["Surely, thou dost know Spektor the Financier?"];
                SetSpeaker1_i(0, _Spektor);
                ["I must be going. Pressing town business, that sort of thing."];
                SetSpeakerSlot_i(0);
                ["And it is so seldom that we are able to talk! Be sure to give my greetings to Lord Marsten."];
                SetSpeakerSlot_i(1);
                ["I shall!"];
                $spektorandlucillacaught = true;
                Bark_i(0, "@Farewell!@", _Lucilla);
                Bark_i(2, "@Anon!@", _Spektor);
                PathfindNPC_i(true, #Spektor, _Spektor, _Path_Success, << 1051, 2642, 0 >>, _Spektor);
                terminate;
            }
            key ("rendezvous") {
                TurnOff("rendezvous");
                if not $lucillainvited {
                    ["Hast thou changed thy mind about meeting?"];
                    if ~AskYesNo() {
                        goto label_103;
                    } else {
                        ["Suit thyself."];
                    }
                } else {
                    ["The time is not right. I cannot see thee now. Another time, my love..."];
                    Bark_i(0, "@Not now!@", _Lucilla);
                    terminate;
                }
            }
            key ("Spektor") {
                TurnOff("Spektor");
                if not $spektorarrested {
                    ["Very well, I shall bare my soul to thee."];
                    if $spektorandlucillacaught {
                        ["I suspected that thou knewest when thou didst catch Spektor and I together that time. But we could not fool thee..."];
                    }
                    ["Spektor and I were lovers. Canst thou believe it? Yet there was something appealing about that man..."];
                    ["Despite my conscience, I have kept his guilty secret for these many months. It casts filth upon my soul. I am ashamed."];
                    TurnOn(<< "lovers", "secret" >>);
                } else {
                    ["Now that Spektor hath been arrested for his crimes, I wonder what I shall do with this key that he gave to me for safekeeping. Perhaps I shall give it to thee. Since thou hast determined all of what hath been happening, perhaps thou wilt be able to put it to good use."];
                    if not $HAVE_SPEKTOR_KEY {
                        v0 = ~GiveItemsOrDrop_i(true, false, 5, 98, 641, 1, _Avatar);
                        $HAVE_SPEKTOR_KEY = true;
                    }
                }
            }
            key ("lovers") {
                TurnOff("lovers");
                ["This is so embarrassing. To think that I could have had any man in this town, and yet I gave mine heart to... Spektor!"];
                ["A Knight who had scarce drawn his sword in many moons..."];
            }
            key ("secret") {
                TurnOff("secret");
                ["Spektor played a key part in Lord Marsten's plan to destroy the Bears and Wolves, so that the Leopards could rule Monitor!"];
                ["They had a secret cache of money and weapons hidden somewhere in the mountains west of town."];
                ["I do not know what else they hid there, but Spektor said that they had the power to someday rule all of Serpent Isle!"];
            }
            key ("lost ring") {
                TurnOff("lost ring");
                ["A ring so pretty must be intended for a loved one. Perhaps a ring of marriage or engagement."];
            }
            key ("banquet stew") {
                TurnOff("banquet stew");
                if ~TakeFromParty_i(false, 3, _All, _Mage_Food, 3) {
                    ["Very good! Now that I have the meat, thy stew will be ready for the banquet. Thy banquet will be held at the Knight's Banquet Hall. It is located south of the Pub. Thou shalt find it on Banquet Hall Road."];
                    $gavemeat = true;
                } else {
                    ["Now that thou hast completed the Knight's Test, thou must now bring me the meat for thy banquet stew."];
                }
            }
            key ("bye") {
                Bark_i(0, "@Must be going...@", _Avatar);
                if not ~AvatarSex() {
                    Bark_i(2, "@Goodbye, lover.@", _Lucilla);
                } else {
                    Bark_i(2, "@Goodbye, milady.@", _Lucilla);
                }
                break;
            }
        }
        clear_answers;
    }
}

