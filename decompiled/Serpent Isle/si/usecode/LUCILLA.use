        }
        if ($foundsimonbottle and (~GetWorkType(_Simon) <> _Wait)) {
            TurnOn("brown bottle");
        }
        if ($AVATAR_IS_KNIGHT and not (~GetItemFlag_i(_Dead, _Simon) and not ($marstenarrested and not $spektorarrested))) {
            TurnOn("traitor");
        }
        TurnOn(<< "name", "buy", "bye" >>);
        converse {
