Routine Lucilla accepts a0 #locals(5) #uses(LucillaBegsRelease_i, ~LordOrLady, FaceAvatar_i, Bark_i, ~GimmePathEgg, PartyFaces_i, SayIfNear_i, ~IsNPCNear, ~PartyUtters, ~IsInInv, ~AskList, LucillaSellsFood_i, LucillaSellsDrink_i, ~AskYesNo, ~GiveItemsOrDrop_i) {
