Routine Byrin accepts a0 #locals(11) #uses(~LordOrLady, ~AvatarName, ~WhereAmI_i, ~IsNPCNear, PartyFaces_i, Bark_i, ~AskOrdList, SingSong_i, ~AskYesNo) {
    v0 = ~LordOrLady();
    v1 = ~AvatarSex();
    v2 = ~AvatarName();
    v3 = ~GetItemFlag_i(_Met, _Byrin);
    v4 = ~WhereAmI_i();
    v5 = ~IsNPCNear(_Iolo);
    v6 = ~IsNPCNear(_Dupre);
    v7 = ~IsNPCNear(_Shamino);
    if (event = _Converse) {
        Item_bark("@Hail, minstrel!@", _Avatar);
        PartyFaces_i(65497);
        Bark_i(5, (("@Greetings, " + v0) + "!@"), _Byrin);
        SetWorkType(_Talk, _Byrin);
    }
    if (event = _Talking) {
        Npc_schedule(_Byrin);
        ClearBark_i(_Byrin);
        SetSpeaker0_i(0, _Byrin);
        if (v4 = 31) {
            if (v3 = true) {
                ["I had wondered when I would encounter thee here, Avatar. Thou wouldst like some answers, no doubt." *"Or perhaps I could sing thee a song to ease thy way."];
            } else {
                ["Welcome, fellow dreamer! I am Byrin, a gleeman by trade." *"Thou dost look perplexed. I'll warrant that thou wouldst like some answers. Or perhaps I could sing thee a song to ease thy way."];
                SetItemFlag_i(_Met, _Byrin);
            }
            TurnOn(<< "answers", "song", "bye" >>);
        } else {
            if (v3 = false) {
                if ($gottattoo = true) {
                    if (v1 = true) {
                        ["Ah, welcome to the Sleeping Bull, noble lady! I am Byrin, a gleeman... or minstrel, if thou wilt. I know several tales or tunes that might stir thy brave heart."];
                    } else {
                        ["Welcome to the Sleeping Bull, brave pikeman! I am Byrin, a gleeman... or minstrel, if thou wilt. I know many tales and tunes of valor and adventure."];
                    }
                } else {
                    ["Thou art welcome to the Sleeping Bull, fellow traveller! I am Byrin, a wandering gleeman... or minstrel, if thou wilt. I know many tales and tunes to help pass the evenings."];
                }
                SetItemFlag_i(_Met, _Byrin);
            } else {
                ["<v2>! What a pleasure to see thee here... I knew that thou couldst not stay long away from my tales and tunes!"];
            }
            TurnOn(<< "tales", "tunes", "bye" >>);
        }
        converse {
            key ("answers") {
                ["Thou mayest find that the answers only give rise to more questions. But I shall do my best to help thee." *"First thou must know that thou dost walk in the land of dreamers. There are only two ways to enter or exit here."];
                TurnOff("answers");
                TurnOn("two ways");
            }
            key ("two ways") {
                ["The first way to enter this realm is from the safety of thy bed... In thy nightly slumber." *"The second way to enter here is far more perilous... By falling prey to the enchantments in Gorlab Swamp."];
                TurnOff("two ways");
                TurnOn("Gorlab Swamp");
            }
            key ("Gorlab Swamp") {
                ["Long ago -- even before the serpent people made this land their home -- a sorcerer named Rabindrinath swore to destroy the peaceful town of Gorlab. But the town healer, Siranush, opposed him and the evil spell went awry." *"The inhabitants of the town were not destroyed, but trapped within the realm of dreams... Along with the mad sorceror... And any who dare enter the environs of Gorlab."];
                TurnOff("Gorlab Swamp");
                TurnOn(<< "Rabindrinath", "Siranush" >>);
            }
            key ("Rabindrinath") {
                ["Rabindrinath hath struggled mightily against Siranush across the span of time. Each of his attacks have been repelled... Much to his displeasure."];
                TurnOff("Rabindrinath");
                TurnOn("displeasure");
            }
            key ("displeasure") {
                ["Rabindrinath vents his anger by troubling the dreams of those who venture here."];
                TurnOff("displeasure");
            }
            key ("Siranush") {
                ["Siranush is a strong-willed woman who hath repelled all of Rabindrinath's attacks on her people. She is no sorcerer, and I fear that her strength will one day fail her." *"If Siranush is vanquished, I am sure that Rabindrinath will turn his evil intent on the wandering dreamers. Without Siranush's guidance, those who enter here might never leave."];
                TurnOff("Siranush");
                TurnOn("leave");
            }
            key ("leave") {
                ["As I said before, there are two ways to enter the land of dreamers. If thou didst come here from the comfort of thy bed, thou canst simply awaken and thou wilt return to the land of waking men." *"But, if thou didst come here through the enchantments in the Swamp, thou must die here to return to thy body."];
                TurnOff("leave");
                TurnOn("die");
            }
            key ("die") {
                ["By die, I do not mean that thou must cease living. I mean that thy perceived life here must end..." *"Thy death here returns thee to thy body. So long as Siranush prevails and thy body lives, thou canst return to the world of waking men." *"But if Siranush should fall, or thy body die... Thou shalt remain trapped here for all time."];
                TurnOff("die");
            }
            key ("song") {
                ["I know many songs..." ~"Dost thou wish to hear one I have already sung?" ~"Or dost thou wish to hear a new song?"];
                v8 = << >>;
                if (~AskOrdList(<< "old song", "new song" >>) = 1) {
                    if ($sangbeatrix = true) {
                        v8 = (v8 & 1);
                    }
                    if ($sangsunrise = true) {
                        v8 = (v8 & 2);
                    }
                    if ($sanggwani = true) {
                        v8 = (v8 & 3);
                    }
                    if ($sangforestmaster = true) {
                        v8 = (v8 & 4);
                    }
                    if ($sanggorlab = true) {
                        v8 = (v8 & 5);
                    }
                    if ($sangwhitedragon = true) {
                        v8 = (v8 & 6);
                    }
                } else {
                    if ($sangbeatrix = false) {
                        v8 = (v8 & 1);
                    }
                    if ($sangsunrise = false) {
                        v8 = (v8 & 2);
                    }
                    if ($sanggwani = false) {
                        v8 = (v8 & 3);
                    }
                    if ($sangforestmaster = false) {
                        v8 = (v8 & 4);
                    }
                    if ($sanggorlab = false) {
                        v8 = (v8 & 5);
                    }
                    if ($sangwhitedragon = false) {
                        v8 = (v8 & 6);
                    }
                }
                if (v8 = << >>) {
                    ["I'm sorry... Thou hast heard all of my songs."];
                } else {
                    v9 = ~Random(~ListSize_i(v8));
                    v10 = v8::v9;
                    SingSong_i(v10);
                }
            }
            key ("tales") {
                ["For those with an adventurous spirit, I can tell thee of the northern savages."];
                ["For those who wish to hear of a lost civilization, I can tell thee of the people who left the ruins on this continent."];
                ["For those who would hear a tale of bitter bravery, I can tell thee of the lost king."];
                TurnOff("tales");
                TurnOn(<< "northern savages", "lost culture", "lost king" >>);
            }
            key ("northern savages") {
                ["Once thou dost leave the warm lands of Man, thou dost come into the realm of the northern savages. These creatures have faces that strongly resemble that of a normal man, but they are covered head to foot in a shaggy fur pelt."];
                ["Some say that these creatures are some lost tribe of Man that hath adapted to the cold." ~"Still others claim that the savages are a mage-created race that guards some great, mystical secret."];
                ["None can say if they are intelligent." ~"They build no structures and speak no recognizable language."];
                if ($sanggwani = false) {
                    ["There is also a song about the northern savages." ~"Wouldst thou care to hear it?"];
                    if (~AskYesNo() = true) {
                        ["All right, then..."];
                        SingSong_i(3);
                    } else {
                        ["Perhaps some other time, then."];
                    }
                }
                TurnOff("northern savages");
            }
            key ("lost culture") {
                ["Long ago, before any of the cities thou knowest today were built, there was a race of Man who worshipped three great elemental serpents. Some followed one of fire. Others followed one of ice. And still others followed one of earth."];
                ["As only the serpent of earth could withstand both the fire and the ice of the other serpents, it possessed the most power. The fire and ice serpents were violently opposed to each other, but were held in check by the serpent of earth."];
                ["Then the serpent of earth lost power. The fire and ice serpents warred for supremacy. When the battle ended, it mattered not which serpent had won... for the land was destroyed and all the worshippers lay dead."];
                TurnOff("lost culture");
            }
            key ("lost king") {
                ["To the north of here stand two castles, seemingly left empty by the ravages of time. But neither is truly empty, for they both hold the ghosts of trust betrayed."];
                ["In one majestic castle a lady waits for her faithless lover who pledged his love and never returned. In the other, a father and ruler, driven mad for the loss of daughter and erstwhile friend, took his people beyond the cares of time."];
                ["All the trapped souls await the return of the one whose desertion forever changed the land he had sworn to protect. All wait for the return of the lost king... and revenge!"];
                if (v7 = true) {
                    SetSpeaker1_i(0, _Shamino);
                    ["Wait! What art thou talking about? It seems... But no! It could not be!" *"Hast thou any more to tell of this \@lost king\@? Dost thou know his name?"];
                    SetSpeakerSlot_i(0);
                    ["Few in truth have ventured within that castle, lord. They fear the wrath of she who dwells there..." *"And none have ever returned from the other castle. But the name that is given for the lost king is... Lord Shamino."];
                    CloseSpeaker1_i();
                }
                if (v6 = true) {
                    SetSpeaker1_i(0, _Dupre);
                    ["It can't be!"];
                    CloseSpeaker1_i();
                    SetSpeakerSlot_i(0);
                }
                if (v5 = true) {
                    SetSpeaker1_i(0, _Iolo);
                    ["There must be some mistake!"];
                    CloseSpeaker1_i();
                    SetSpeakerSlot_i(0);
                }
                if ($sangbeatrix = false) {
                    ["There is a song about the lady." ~"Wouldst thou care to hear it?"];
                    if (~AskYesNo() = true) {
                        ["It is a sad ballad indeed..."];
                        SingSong_i(1);
                    } else {
                        ["Another time, then."];
                    }
                }
                if ($sangwhitedragon = false) {
                    ["There is a song about the other castle, as well." ~"Wouldst thou care to hear it?"];
                    if (~AskYesNo() = true) {
                        ["Prepare thyselves..."];
                        SingSong_i(6);
                    } else {
                        ["Another time, then."];
                    }
                }
                TurnOff("lost king");
            }
            key ("tunes") {
                if ($gottattoo = true) {
                    if (v1 = true) {
                        ["For thee, brave lady, I would sing of dreams, or perhaps of tragedy. Of course, although I sing to entertain others, I hope for some small token of appreciation... if possible. Singing is thirsty business."];
                        TurnOn(<< "dreams", "tragedy" >>);
                    } else {
                        ["For thee, noble sir, I would sing a heart-rending ballad, or perhaps long-lost lore. Of course, although I sing to entertain others, I hope for some small token of appreciation... if possible. Singing is thirsty business."];
                        TurnOn(<< "ballad", "lore" >>);
                    }
                } else {
                    ["I sense that thou dost like adventure. For thee I would sing of strange beings and strange places. Of course, although I sing to entertain others, I hope for some small token of appreciation... if possible. Singing is thirsty business."];
                    TurnOn(<< "strange beings", "strange places" >>);
                }
                TurnOff("tunes");
            }
            key ("dreams") {
                if ($sanggorlab = true) {
                    ["I believe that thou hast already heard that one." ~"Wouldst thou like to hear it again?"];
                    if (~AskYesNo() = true) {
                        ["My pleasure..."];
                        SingSong_i(5);
                    } else {
                        ["Perhaps I could find another song for thee..."];
                        TurnOn("song");
                    }
                } else {
                    ["I hope thou dost enjoy it..."];
                    SingSong_i(5);
                }
                TurnOff("dreams");
            }
            key ("tragedy") {
                if ($sangwhitedragon = true) {
                    ["I seem to remember singing this for thee before..." ~"Wouldst thou like to hear it again?"];
                    if (~AskYesNo() = true) {
                        ["One more time then..."];
                        SingSong_i(6);
                    } else {
                        ["Perhaps I could find another song for thee..."];
                        TurnOn("song");
                    }
                } else {
                    ["Relax and be at ease..."];
                    SingSong_i(6);
                }
                TurnOff("tragedy");
            }
            key ("ballad") {
                if ($sangbeatrix = true) {
                    ["I am sure that thou hast already..." ~"Wouldst thou like to hear it again?"];
                    if (~AskYesNo() = true) {
                        ["As thou wishest..."];
                        SingSong_i(1);
                    } else {
                        ["Perhaps I could find another song for thee..."];
                        TurnOn("song");
                    }
                } else {
                    ["I believe I remember it..."];
                    SingSong_i(1);
                }
                TurnOff("ballad");
            }
            key ("lore") {
                if ($sangsunrise = true) {
                    ["I fear that thou dost already know this one..." ~"Wouldst thou like to hear it again?"];
                    if (~AskYesNo() = true) {
                        ["Thou canst sing along if thou wishest..."];
                        SingSong_i(2);
                    } else {
                        ["Perhaps I could find another song for thee..."];
                        TurnOn("song");
                    }
                } else {
                    ["I think this be the right key..."];
                    SingSong_i(2);
                }
                TurnOff("lore");
            }
            key ("strange beings") {
                if ($sanggwani = true) {
                    ["I have done this one for thee before..." "~Wouldst thou like to hear it again?"];
                    if (~AskYesNo() = true) {
                        ["Very well..."];
                        SingSong_i(3);
                    } else {
                        ["Perhaps I could find another song for thee..."];
                        TurnOn("song");
                    }
                } else {
                    ["Thou wilt like the tempo on this one..."];
                    SingSong_i(3);
                }
                TurnOff("strange beings");
            }
            key ("strange places") {
                if ($sangforestmaster = true) {
                    ["Thou knowest this one..." "~Wouldst thou like to hear it again?"];
                    if (~AskYesNo() = true) {
                        ["I am cheered that thou dost like it..."];
                        SingSong_i(4);
                    } else {
                        ["Perhaps I could find another song for thee..."];
                        TurnOn("song");
                    }
                } else {
                    ["Listen carefully..."];
                    SingSong_i(4);
                }
                TurnOff("strange places");
            }
            key ("bye") {
                CloseSpeaker0_i();
                Bark_i(0, "@Farewell, gleeman!@", _Avatar);
                Bark_i(5, "@May thy path be smooth!@", _Byrin);
                break;
            }
        }
        clear_answers;
    }
}
