                    ["I am afraid that I have forgotten. Thou must understand, I have been dead a very long time."];
                    ["Death whispers most sweetly, but my soul is not allowed to respond. I do not desire to persist in this life."];
                    if (~Random(6) > 3) {
                        label_60:
