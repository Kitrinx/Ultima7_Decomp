Routine Shamino accepts a0 #locals(14) #uses(~LordOrLady, ~AvatarName, DeclareWinner_i, NowSettleDownBoys, ~WhereAmI_i, ~GetStat, SetStat, ~GiveItemsOrDrop_i, PartyFaces_i, Bark_i, SetGotFlags_i, UnfreezeAvatar_i, ~GimmePathEgg, ShaminoReturnsBelongings_i, SayIfNear_i, ChooseMeetingPlace_i) {
