                v9 = ~GiveItemsOrDrop_i(true, 0, 6, 205, 797, 1, _Avatar);
                v9 = ~GiveItemsOrDrop_i(true, 0, 0, 16, 715, 1, _Avatar);
                $HAVE_CHILL_SPELL = true;
