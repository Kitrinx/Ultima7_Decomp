Usable RestoreCompanions_i #locals(6) #uses(~NearbyBodies_i, RestoreCompanion_i) {
    v0 = ~NearbyBodies_i();
    Foreach v3 in v0 {
        if (v3 <> ~NPCToItem_i(_Avatar)) {
            v4 = ~BodyToNPC_i(v3);
