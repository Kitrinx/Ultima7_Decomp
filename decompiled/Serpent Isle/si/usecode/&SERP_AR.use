            v1 = ~PostAction(<< _aNO_HALT_i, _aBARK_i, "@Die, you cursed fiends!@", _aUP_FRAME_i, _aOUT_FRAME_i, _aTHRUST2_FRAME_i >>, _Avatar);
            Bark_i(2, "@I despise you all!@", ~NPCToItem_i(_Avatar));
