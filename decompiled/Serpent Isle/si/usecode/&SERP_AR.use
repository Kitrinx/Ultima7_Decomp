Routine serp_artifact accepts a0 #locals(12) #uses(Bark_i) {
    if (event = _Converse) {
        v0 = ~GetFrame(item);
        if (v0 = 22) {
            SetFrame(23, item);
            Sfx(39);
            Bark_i(4, "@Pretty@", _Avatar);
            CreateSpriteOn_i(65535, 0, 0, 0, 0, 0, 12, item);
            v1 = ~PostAction(<< _aNO_HALT_i, _aWAIT_i, 20, _aFRAME, 21 >>, item);
            terminate;
        }
    }
    if (event = _Equip) {
        v0 = ~GetFrame(item);
        if (v0 = 10) {
            closeAllGumps();
            v2 = ~FindNearby_i(0, 30, _Skeleton, item);
            v3 = ~FindNearby_i(176, 15, _Egg_Type, item);
            Foreach v6 in v3 {
                Item_destroy(v6);
