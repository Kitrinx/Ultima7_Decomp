                            DucioMakesWormGem_i(event);
                            terminate;
                        } else {
                            ["Thou must bring me three Worm Hearts -- no less!"];
                            TurnOn("Worm Hearts");
                        }
                    } else {
                        ["But first, thou must bring me the Hearts of three Ice Worms."];
                        TurnOn("Worm Hearts");
                    }
                } else {
                    ["I will make thee a Worm Gem if thou wilt come to my shop when I am there..."];
                }
