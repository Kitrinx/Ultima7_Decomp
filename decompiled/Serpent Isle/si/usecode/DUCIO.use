            }
            key ("magic") {
                TurnOff("magic");
                ["Torrissio doth not ask about my work. I do not ask about his."];
                ["All I know is that his spells are old. Not anything created by these Mages."];
                ["Thou wishest to ask more, ask Torrissio... If he will speak with thee."];
                TurnOn("old");
            }
            key ("old") {
                TurnOff("old");
                ["Very old. Maybe as old as the Serpent ruins, maybe not. I'm not a Mage."];
                TurnOn("Serpent Ruins");
            }
            key ("Serpent Ruins") {
                TurnOff("Serpent Ruins");
                ["What dost thou think I am, a teacher like Fedabiblio?!"];
                ["If thou wishest a history lesson, go to him like any novice. If thou wishest the work of a Master Artisan, stay."];
                ["I do not have time for such questions!"];
                TurnOn(<< "Fedabiblio", "novice" >>);
            }
            key ("Fedabiblio") {
                TurnOff("Fedabiblio");
                ["Fedabiblio teaches the young mages. He keeps the library of magic. He knows the history. Speak to him, do not bother me!"];
            }
            key ("novice") {
                TurnOff("novice");
                ["If thou seekest knowledge, thou art a novice. One who seeks to be taught. I am a Master. I do not teach. I do not need teaching. I am not a novice."];
            }
            key ("deal") {
                TurnOff("deal");
                ["Art thou a Master?"];
                ["No. Then do not ask what deal I give to others. Bad manners."];
            }
            key ("anything") {
                TurnOff("anything");
                ["If the Mages can speak plain enough to explain what they need, I can make it."];
                ["Magical apparatus. Swords. Whatever. I can make it. They enchant it. 'Tis fair."];
                TurnOn(<< "Magical apparatus", "Swords" >>);
            }
            key ("Magical apparatus") {
                TurnOff("Magical apparatus");
                ["I make all the apparatus for the Mages. All different. Every Mage wants something a little different than the next."];
                ["I can tell thee who a piece belongs to just by looking at it. I remember everything I've made."];
                ["Dost thou have something thou wishest me to look at?"];
                if (~AskYesNo() = true) {
                    goto label_60;
                } else {
                    ["Fine."];
                }
            }
            key ("apparatus") {
                label_60:
                TurnOff("apparatus");
                if v5 {
                    if ~IsInInv(1, 65177, _Al_App_1, 1, _Party) {
                        ["Hmmmm. This is a piece of lab apparatus that the mages use. In fact, this one was one of my first masterpieces. I thought it had been destroyed."];
                        ["I might ask how thou didst come by this. But I won't. I do not want to know. Vasculio hath been dead for years..."];
                        v7 = true;
                        TurnOn("Vasculio");
                    } else {
                        ["Thou hast no such object! Do not waste my time, for I am a busy man..."];
                        Bark_i(0, "@Must work...@", _Ducio);
                        SetWorkType(_Shy, _Ducio);
                        terminate;
                    }
                } else {
                    ["If thou wouldst bring the object to my shop, I would be glad to examine it there. I do not have my tools with me now."];
                }
            }
            key ("Vasculio") {
                TurnOff("Vasculio");
                ["Not good, that one. Sought to reach beyond life and rule death. Not good."];
                ["The Council killed him years ago. I thought they had destroyed all his equipment after they found the grave empty... But mayhaps Ensorcio took it."];
                TurnOn(<< "grave empty", "Ensorcio" >>);
            }
            key ("grave empty") {
                TurnOff("grave empty");
                ["They say he rose from the dead. They think he is looking for revenge."];
                ["I think the Council secretly decided to burn him. No one can bring back the dead from ashes."];
            }
            key ("Ensorcio") {
                TurnOff("Ensorcio");
                ["Ensorcio was Vasculio's apprentice. Too much like his Master, that one."];
                ["Exiled now. Hear he spends his time drinking away his sorrows on another island."];
            }
            key ("Swords") {
                TurnOff("Swords");
                ["Do not have much call for them. Not magic ones anyway. But I have made a few."];
                ["Unless it is a special order, mine automaton makes it. For something non-magic, talk to Topo. If it's magic, talk to me."];
            }
            key ("Topo") {
                TurnOff("Topo");
                ["Mine apprentice. Scrawny boy. Large ambitions. Big mouth."];
                ["But he doth work hard... when I yell at him. Shows promise."];
                ["Tends to be a bit lazy, though. Must teach him better. Make certain he learns as much as he thinks he knows."];
            }
            key ("business") {
                TurnOff("business");
                ["What dost thou need? To buy? To look? To talk?"];
                v8 = ~AskList(<< "buy", "look", "talk" >>);
