Routine Ducio accepts a0 #locals(9) #uses(~LordOrLady, ~AvatarName, DucioMakesWormGem_i, PartyFaces_i, Bark_i, ~AskYesNo, ~IsInInv, ~AskList, DucioSellsProvisions_i, MessengerBringsScroll_i) {
    v0 = ~LordOrLady();
    v1 = ~AvatarSex();
    v2 = ~AvatarName();
    v3 = ~GetTime();
    v4 = false;
    v5 = ~FindNearby_i(0, 30, _Firepit, _Ducio);
    if ((v3 > 1) or (v3 < 6)) {
        v3 = "day";
    } else {
        v3 = "evening";
    }
    if (event = _Pathfind1) {
        DucioMakesWormGem_i(event);
    }
    if (event = _Converse) {
        Item_bark("@Hello!@", _Avatar);
        PartyFaces_i(65521);
        Bark_i(2, (("@Good " + v3) + ".@"), _Ducio);
        SetWorkType(_Talk, _Ducio);
    }
    if (event = _Talking) {
        Npc_schedule(_Ducio);
        ClearBark_i(_Ducio);
        SetSpeaker0_i(0, _Ducio);
        v6 = ~GetItemFlag_i(_Met, _Ducio);
        if (v6 = false) {
            ["I am Ducio, the Master Artisan."];
            SetItemFlag_i(_Met, _Ducio);
            TurnOn("Master Artisan");
        } else {
            if $BANES_RELEASED {
                ["Thou art alive! Thou hast survived the holocaust! So many are dead..."];
                TurnOn("holocaust");
            } else {
                ["Welcome back..."];
                TurnOn("Master Artisan");
            }
        }
        if v5 {
            ["What is thy business?"];
            TurnOn("business");
        } else {
            ["How may I be of use to thee?"];
        }
        if ($gotdaemonswordback and not flag(206)) {
            TurnOn("Daemon Sword");
        }
        if ($ducioknowslab and not $knowlabitem) {
            TurnOn("apparatus");
        }
        if ($knowwormgem = true) {
            TurnOn("Worm Gem");
        }
        if ($ducioknowsring and not $knowengagementring) {
            TurnOn("lost ring");
        }
        if (flag(234) and not ~GetItemFlag_i(_Dead, _Rotoluncia)) {
            TurnOn("kidnap");
        }
