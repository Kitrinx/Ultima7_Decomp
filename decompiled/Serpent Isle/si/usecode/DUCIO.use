            key ("automatons") {
                TurnOff("automatons");
                ["One that bakes. One that sews. One that smiths. All from Torrissio. They work hard... do not talk back like Topo."];
                TurnOn("Torrissio");
            }
            key ("Torrissio") {
                TurnOff("Torrissio");
                ["Torrissio is an Adept. He makes automaton guards and servants. He does good work... almost like a Master Artisan. But he needs magic to make everything work."];
