                    if ~GetItemFlag_i(_Dead, _Gustacio) {
                        ["Thou must seek out a Mage to aid thee, if there are any left among the living..."];
                        ["If Gustacio's flux analyzer had not been stolen, I would have sent thee to his lab. It was the only thing that might have helped thee."];
                    } else {
                        ["Thou mightest check with Gustacio. He might be able to help thee. I have heard that he is working on something called the flux analyzer. It might be of aid to thee."];
                        $senttogustacio = true;
                    }
                } else {
                    ["If thou wouldst bring me the sword, I could examine it for thee."];
                }
            }
            key ("Worm Gem") {
                TurnOff("Worm Gem");
                if v5 {
                    ["What a strange request... Yes, I can make thee a Worm Gem, if thou dost desire."];
                    TurnOn("strange request");
                    if ~IsInInv(10, 65177, _Reagents, 1, _Party) {
                        if ~IsInInv(10, 65177, _Reagents, 3, _Party) {
