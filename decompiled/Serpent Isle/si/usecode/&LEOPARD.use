Routine Leopard accepts a0 #locals(0) {
    if (event = _NearDeath) {
        if (~GetNPCID_i(item) = 15) {
            ClearItemFlag_i(_Tournament, item);
        }
        if (~GetNPCID_i(item) = 16) {
            ClearItemFlag_i(_Tournament, item);
        }
        if (~GetNPCID_i(item) = 17) {
            ClearItemFlag_i(_Tournament, item);
        }
        if (~GetNPCID_i(item) = 18) {
            ClearItemFlag_i(_Tournament, item);
        }
    }
}
