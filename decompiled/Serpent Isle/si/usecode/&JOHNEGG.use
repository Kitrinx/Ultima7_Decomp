Routine Nightmare accepts a0 #locals(1) #uses(RemoveAll_i) {
    if (event = _Talking) {
        SetSpeaker0_i(0, 65240);
        ["Avatar! How good it is to see thee! How long hath it been since we last met?"];
        SetSpeaker1_i(0, _Avatar);
        ["Ahhhh... Errrr... Well...."];
        CloseSpeaker1_i();
        SetSpeaker0_i(0, 65240);
        ["Do not tell me that thou dost not recognize me? Come now, Avatar, it hath not been that long."];
        SetSpeaker1_i(0, _Avatar);
        ["Welll... Maybe..."];
        CloseSpeaker1_i();
        SetSpeaker0_i(0, 65240);
        ["It is I! Smith the Horse! Only the finest steed in all of Britannia."* "Oh, I suppose thou wouldst not recognize me such as I am. This is the appearance I take here at the Realm of Dreams."* "Ah, this is the life. Mine own keep, as much hay as I could want, no insects to bother me... Who could ask for more?" *"Where are my wits! Avatar, I have something important to tell thee. But what was it?"];
        ["Oh, yes! Avatar, thou must take Rudyom's wand to the Isle of the Avatar!"* "There thou wilt find a monolith made of blackrock that Batlin is using to create a gateway to bring the Guardian into our world!"* "The future of Britannia doth lie in thine hands, Avatar!"];
        SetSpeaker1_i(0, _Avatar);
        ["Ahh, Smith, the Guardian hath been stopped. Everything is safe."];
        CloseSpeaker1_i();
        SetSpeaker0_i(0, 65240);
        ["Oh..." *"I feel like I have made a mule of myself. Never mind..." *"Now I remember! Thou hast left Britannia and hast journeyed to the Serpent Isle in search of Batlin!" *"Poor Iolo, he must be distraught to have found that Gwenno left on that voyage with that fiend. I hope that thou wilt find her before that evil man doth do something to her. She, at least, hath always been kind to me." *"Wait! Avatar, I do have some information thou canst use!" *"Batlin and his band of hired swords are waiting for thee at..." *"Yummie! Here comes someone with more hay..."];
        CloseSpeaker0_i();
        v0 = ~GetCoord(item);
        createSprite(65535, 0, 0, 0, v0::2, v0::1, 21);
        Item_destroy(item);
        Sfx(76);
    }
    if (event = _Action) {
        ClearItemFlag_i(_DontMove_i, _Avatar);
        ClearItemFlag_i(_Tournament, item);
        v0 = ~GetCoord(item);
        createSprite(65535, 0, 0, 0, (v0::2 - 1), (v0::1 - 1), 4);
        createSprite(3, 2, 0, 0, (v0::2 - 1), (v0::1 - 1), 17);
        createSprite(65535, 0, 0, 0, (v0::2 - 2), (v0::1 - 2), 17);
        Sfx(42);
        LightningBolt();
        RemoveAll_i(item);
    }
}

