Routine Flindo accepts a0 #locals(11) #uses(~LordOrLady, ~AvatarName, ~WhereAmI_i, PartyFaces_i, Bark_i, ~GimmePathEgg, MessengerBringsScroll_i) {
    v0 = ~LordOrLady();
    v1 = ~AvatarSex();
    v2 = ~AvatarName();
    v3 = ~GetWorkType(_Flindo);
    v4 = ~WhereAmI_i();
    if (event = _Bark) && (v3 = 29) {
        v5 = ~FindNearby_i(16, 2, _Path, _Flindo);
        v6 = ~GetQuality(v5);
        if (v6 = 15) {
            SetWorkType(_Wait, _Flindo);
            v7 = ~PostAction(<< _aNO_HALT_i, _aGO_S, _aGO_S, _aGO_S >>, item);
            v8 = ~GetNPCID_i(_Hawk);
            v8 = (v8 + 1);
            SetNPCID_i(v8, _Hawk);
        }
    }
    if (event = _Converse) {
        Item_bark("@May we speak?@", _Avatar);
        PartyFaces_i(65494);
        Bark_i(2, "@I have little time!@", _Flindo);
        SetWorkType(_Talk, _Flindo);
    }
    if (event = _Talking) {
        Npc_schedule(_Flindo);
        ClearBark_i(_Flindo);
        SetSpeaker0_i(0, _Flindo);
        v9 = ~GetItemFlag_i(_Met, _Flindo);
        if ($BANES_RELEASED = true) {
            ["So, thou art still alive!" ~"I had wondered when thy companion arrived in such a strange state."];
            ["I never thought I would live to see mighty Moonshade humbled, but Shamino hath certainly managed it quite handily."];
            ["I would be careful in the streets here now, <v0>. 'Tis somewhat... unsafe.  Oh, and the... fallen Filbercio is searching for thee."];
            TurnOn(<< "strange state", "fallen Filbercio" >>);
        }
        if (v9 = false) {
            if $hawksailedtomoonshade {
                ["The name is Flindo. I own a provisioning shop here in Moonshade and have many important connections here."];
            } else {
                ["The name is Flindo. I own a provisioning shop in Moonshade and have many important connections there."];
            }
            SetItemFlag_i(_Met, _Flindo);
        } else {
            ["Returned again?"];
        }
        if (v4 = 9) {
            ["So, art thou another stranded victim of Hawk and his childish fear of storms? Or art thou here to investigate the curious disappearance of Mistress Devra's good husband?"];
            TurnOn(<< "Hawk", "storms", "curious disappearance", "connections" >>);
        } else {
            ["I understand now why Hawk did not wish to sail the open seas. I do not know how thou wilt leave this island... Unless the tales are true."];
            ["I hope that thou dost like our fine city of Moonshade."];
            ["If thou wouldst like to know about any place within the city, come to me."];
            TurnOn(<< "tales", "Moonshade", "any place", "connections" >>);
        }
        if (flag(303) and not $filberciobanquet) {
            TurnOn("thy promise");
        }
        TurnOn(<< "bye" >>);
        converse {
            key ("strange state") {
                TurnOff("strange state");
                ["He now calls himself Shamino the Anarch."];
                ["By his command up may become down, and in may become out. And woe to anyone who disagrees. He hath totally unravelled the strictures... 'Tis a magical madhouse out there!"];
            }
            key ("fallen Filbercio") {
                TurnOff("fallen Filbercio");
                ["When Shamino the Anarch took over, he cast Filbercio out of the Palace and made him a beggar."];
                ["Needless to say, this did not sit well with the MageLord. Filbercio would speak with thee... Perhaps thou canst, having been Shamino's companion, find a way to overcome his powers."];
                ["Look for Filbercio in the streets, <v0>. Shamino the Anarch hath decreed that none may take Filbercio in or aid him in any way."];
            }
            key ("Hawk") {
                TurnOff("Hawk");
                ["That bag of wind! Calls himself a sailor... Ha!"];
                ["Now, I am asking thee... What manner of Captain would strand me and poor, dumb Kane -- paying passengers, mind thee -- here in this little backwater inn because of some... storm?"];
                ["So I went to the Pikemen..."];
                TurnOn(<< "Kane", "Pikemen" >>);
            }
            key ("Kane") {
                TurnOff("Kane");
                ["Look for a young lad talking to a parrot. That will be him."];
                ["Witless lad doth not have enough sense to steer clear of Ensorcio. Comes asking if Ensorcio was a mage, and would Ensorcio help him and Ale find his lost brother!"];
                ["Kane doth not have the sense of a cat!"];
                TurnOn(<< "Ensorcio", "Ale" >>);
            }
            key ("Ensorcio") {
                TurnOff("Ensorcio");
                ["Now there is one to avoid, if ever there was one!"];
                ["The mages wondered when Vasculio took Ensorcio as an apprentice. Temper like that, 'tis not good in a mage. And when thou considerest Vasculio's interests... Well, 'tis enough to make a body worry."];
                ["And then with what happened about that Adept's daughter... No one was surprised when the Council of Mages stepped in and exiled Ensorcio -- except maybe Ensorcio himself!"];
                TurnOn(<< "Vasculio", "Adept's daughter" >>);
            }
            key ("Vasculio") {
                TurnOff("Vasculio");
                ["Do not tell me that thou hast not heard that legend!"];
                ["I was not around for any of this, mind thee. I wasn't even born yet... Ensorcio isn't as young as he appears, being a mage and all. But my father talked about it enough -- it happened when he was a mere boy."];
                TurnOn("legend");
            }
            key ("legend") {
                TurnOff("legend");
                ["Well, years ago, there was experimenting aplenty amongst the mages. There were not nearly as many restrictions as there are now."];
                ["Vasculio specialized in death magic. Not like Mortegro, mind thee. No, Vasculio did not want to speak with the dead... He wanted to cause death."];
                ["And he was none too particular if it was a quick death or not. Anyway, soon his 'research' even upset the Council of Mages."];
                ["When the Council went to deliver Vasculio an ultimatum, they found him in deeds so horrible that it was determined that he was no longer human."];
                ["They put him to death... but his tomb was broken open and empty before a week had passed. And they say that, somehow, he still lives to practice his dark arts."];
                TurnOn(<< "restrictions", "Mortegro" >>);
            }
            key ("restrictions") {
                TurnOff("restrictions");
                ["Well, now, there are quite a number of them. And I only know a few... not being a mage."];
                ["Let's see... certain creatures cannot be summoned within the confines of the city. This would come to light after some damn fool mage summons a dragon that burns half the city!"];
                ["Only mages approved of by the Council of Mages may sell death spells. And the Council must be notified of all research and experiments."];
                ["There. 'Tis all I can remember. If thou desirest to know more, thou shouldst speak to a mage."];
            }
            key ("Mortegro") {
                TurnOff("Mortegro");
                ["Mortegro is fine. A bit flighty at times, but all mages are if thou dost ask me."];
                ["Mortegro's true specialty is speaking with the dead."];
            }
            key ("Adept's daughter") {
                TurnOff("Adept's daughter");
                ["Oh, thou wouldst do well not to ask too closely about who she is, <v0>! Mages are very protective of their privacy AND their pride."];
                ["Suffice it to say that Ensorcio took a fancy to the girl and, when she would not give him the time of day, used his magic to... persuade... her to see him."];
                ["I was surprised the Council punished him with simple exile. I would have thought he would have gone to the Mountains of Freedom for his crime!"];
                TurnOn("Mountains of Freedom");
            }
            key ("Mountains of Freedom") {
                TurnOff("Mountains of Freedom");
                ["Speak that name quietly, <v0>. And hope that thou never hast reason to learn too much about it."];
                ["Long ago, those mountains were full of ore and many spent their lives mining it. But most of the veins were empty when they uncovered the Stoneheart..."];
                TurnOn("Stoneheart");
            }
            key ("Stoneheart") {
                TurnOff("Stoneheart");
                ["Hsst! Never repeat that word in public, <v0>! Or thou wilt find a personal view of the Mountains of Freedom!"];
                ["Stoneheart can be used to create another mineral, a strange reagent that magnifies magical power, especially death spells. And it is very dangerous."];
                ["Anyway, after that was found there, the mines were sealed. Until Filbercio became MageLord, that is."];
                TurnOn(<< "Filbercio", "MageLord" >>);
            }
            key ("Filbercio") {
                TurnOff("Filbercio");
                ["Filbercio is an ambitious man, <v0>. He is also a man of many... passions, shall we say."];
                ["Not all in Moonshade were happy when he became MageLord. And Filbercio would have it that he is a popular ruler. And he would enjoy the powers of his office without fearing rivals."];
                ["So Filbercio filled the mines with all manner of magical traps, and made it a prison for his enemies. 'Tis said that if thou canst escape from the depths of stone, thou art free and vindicated of any charges against thee."];
                ["But, as of yet, none have proven themselves innocent... If thou takest my meaning."];
            }
            key ("MageLord") {
                TurnOff("MageLord");
                ["The MageLord must be an Adept, and rules all Moonshade."];
                ["Although the MageLord's power is great, it is held in check by the other members of the Council of Mages."];
                ["Being that mages are, by nature, egotistical, the Council of Mages is only open to other Adepts. The peers of the MageLord. Their presence on the Council is meant to keep the MageLord from becoming too tyrannical."];
            }
            key ("Ale") {
                TurnOff("Ale");
                ["Ale is what Kane calls that parrot of his..."];
                ["And it certainly shows a great enthusiasm for the brew, to be sure. Not usual for a bird, mind thee, but a trick most likely taught to it by some sailor before the lad found it."];
            }
            key ("Pikemen") {
                TurnOff("Pikemen");
                if ($gottattoo = true) {
                    ["Everyone knows that the Pikemen guard the roads and towns, <v0>."];
                    ["They are noted for their honesty. I thought perhaps they could 'persuade' Hawk to abandon his ploy for more money and sail for Moonshade as he should."];
                    ["I made an appropriately large 'donation' to their coffers. But I did not expect them to waylay Hawk to rot in some jail cell!"];
                    ["I suppose that is what comes of not knowing the difference between Leopards, Bears and Wolves..."];
                } else {
                    ["I thought perhaps the Pikemen could... disturb Hawk enough to abandon his ploy for more money. I thought that if they made his life difficult enough here, Hawk would sail for Moonshade -- as he should have in the first place!"];
                    ["I paid them well enough! But I did not expect them to waylay Hawk to rot in some jail cell!"];
                    ["I suppose that is what comes of not knowing the difference between Leopards, Bears and Wolves..."];
                }
                flag(461) = true;
                TurnOn(<< "Leopards", "Bears", "Wolves" >>);
            }
            key ("Leopards") {
                TurnOff("Leopards");
                if ($gottattoo = true) {
                    ["I know what any non-Monitorian knows, <v0>."];
                    ["The Leopards are one of the three Commands of Monitor. They control the tower nearest Monitor itself. I know that they share the rule of Monitor."];
                } else {
                    ["I know what any non-Monitorian knows..."];
                    ["The Leopards are one of the three Commands of Monitor. They control the tower nearest Monitor itself."];
                    ["I have also heard that, like all cats, they are a sneaky, conniving lot."];
                }
            }
            key ("Bears") {
                TurnOff("Bears");
                if ($gottattoo = true) {
                    ["I know little about them, <v0>."];
                    ["The Bears are one of the three Commands of Monitor. They control the tower near Fawn, where their natural aggressiveness can be put to use against the goblins."];
                } else {
                    ["I know little about them..."];
                    ["The Bears are one of the three Commands of Monitor. They control the tower near Fawn, where their natural aggressiveness can be put to use against the goblins."];
                    ["I have also heard, from a Fawn merchant, that many Fawn citizens would rather face the goblins than the Bears."];
                }
            }
            key ("Wolves") {
                TurnOff("Wolves");
                if ($gottattoo = true) {
                    ["Not being from Monitor, I am afraid I am woefully uninformed, <v0>."];
                    ["The Wolves are one of the three Commands of Monitor. They control the tower near here, er... Sleeping Bull. Wolves are regarded as the friendliest of all the Commands..."];
                } else {
                    ["Not being from Monitor, I am afraid I am woefully uninformed..."];
                    ["The Wolves are one of the three Commands of Monitor. They control the tower near here, er... Sleeping Bull. Wolves are said to be little more than trained dogs..."];
                }
            }
            key ("storms") {
                TurnOff("storms");
                ["I find it hard to believe that a man such as Hawk, with a ship such as the Arabella, would fear any storm -- magical or otherwise."];
                ["I have heard of too many odd events connected to these storms to discount their unusual nature. But all such tales speak of danger on land..."];
                ["I think Hawk's reluctance to sail lies more at the bottom of an empty mug and an empty coffer..."];
                TurnOn("Arabella");
            }
            key ("Arabella") {
                TurnOff("Arabella");
                ["The Arabella is a fine ship... Good lines and fast-running before a stiff breeze."];
                ["And I have heard that Hawk had some sort of enchantment laid on her so that she can not be sailed without him on board. But that could merely be more of his idle boasts."];
            }
            key ("curious disappearance") {
                TurnOff("curious disappearance");
                ["It occurred immediately after I arrived here..."];
                ["I recall that one morning Mistress Devra was beside herself with worry because Angus was nowhere to be found."];
                ["I told her not to worry herself too much, as sometimes a man will feel too constricted at home and need to wander for a bit. But she would not be dissuaded and sent for Argus."];
                TurnOn(<< "Devra", "Angus", "Argus" >>);
            }
            key ("Devra") {
                TurnOff("Devra");
                ["Mistress Devra is a sweet-natured lady. Too good-hearted to be an innkeeper sometimes."];
                ["I had recently begun making the trips with my father when Donal hired her to do the cooking. That was before she married Angus."];
                ["Poor woman, first Theron and then her husband..."];
                TurnOn(<< "Donal", "Theron" >>);
            }
            key ("Donal") {
                TurnOff("Donal");
                ["Donal was Angus' father. He was a good, hard-working man."];
                ["'Twas a good thing Donal was not anything like his father, Silverpate, or I doubt that Mistress Devra would ever have given Angus a second look."];
                ["'Tis hard to think that Angus disappeared exactly like his grandfather did..."];
                TurnOn("Silverpate");
            }
            key ("Silverpate") {
                TurnOff("Silverpate");
                ["Why, Silverpate is the one who built this inn!"];
                ["Everyone said Silverpate was a pirate who grew too old for the sea and went searching for a way to become respectable. He used part of his treasure to construct this place..."];
                ["There are rumors in Moonshade that he hired a mage for some reason, but I have never been able to confirm it. They say that he was a very suspicious man..."];
                ["Anyhow, Silverpate disappeared when Donal was still a young man. Everyone thinks the treasure is still hidden here somewhere."];
                TurnOn(<< "treasure", "disappeared" >>);
            }
            key ("treasure") {
                TurnOff("treasure");
                ["Do not ask me! Silverpate was a pirate... Who knows what such a man would have hidden?"];
                ["Personally, I think that if there were any treasure, it hath long since been found. And if none hath been found, then there never was any hidden treasure!"];
            }
            key ("disappeared") {
                TurnOff("disappeared");
                ["Thou shouldst ask Mistress Devra about that. All I know is that one day no one could find Silverpate, and he was never found."];
                ["Donal took over the inn and nothing more untoward happened until Theron disappeared."];
            }
            key ("Theron") {
                TurnOff("Theron");
                ["Theron was a worker here. Mistress Devra took him in and gave him work and a place to stay. He was not very bright..."];
                ["Like I said, sometimes Mistress Devra is too kind for her own good. Anyway, Theron was caught in one of those storms and no one hath been able to find him since."];
            }
            key ("Angus") {
                TurnOff("Angus");
                ["Angus was a big man. I cannot see how any harm could befall him without alerting the whole inn."];
                ["I think perhaps he took a notion to leave and go adventuring. He had a strange sense of humor and a powerful temper..."];
                ["Who knows? Mayhaps he became angry at Mistress Devra and walked away."];
            }
            key ("Argus") {
                TurnOff("Argus");
                ["Argus is Mistress Devra's oldest son, <v0>."];
                ["He inherited more than a little bit of his father's temper, and always dreamed of being a fighter. 'Twas no surprise when he travelled to Monitor to become a Pikeman."];
                ["Not all good came of it, however. He found himself some trouble down there, so I have heard. And there hath been bad blood between him and Wilfred ever since he left here."];
                TurnOn(<< "trouble", "Wilfred" >>);
            }
            key ("trouble") {
                TurnOff("trouble");
                ["If thou dost not want to answer to Argus' steel, <v0>, thou shouldst not mention this to him."];
                ["Seems that Argus' temper found him a duel with a boy from another Command. Argus killed the boy, apparently without giving him any quarter. Sad business for a fighter."];
            }
            key ("Wilfred") {
                TurnOff("Wilfred");
                ["Wilfred is Argus' younger brother..."];
                ["After Argus left, Angus raised Wilfred very strictly. So Wilfred holds Argus in no great esteem."];
                ["Wilfred was always a willful, snobbish sort of child. In mine own opinion, he needed to have his head knocked a time or two to deflate that ego of his. Angus was stricken when Wilfred left to become a knight."];
            }
            key ("connections") {
                TurnOff("connections");
                ["Although I am not a mage, I am an influential man in Moonshade because my shop provides the staples of life to that secluded island! Why, I even know the MageLord's mistress."];
                if flag(303) {
                    if $filberciobanquet {
                        ["As thou dost well know, seeing that I did obtain thee an audience with the MageLord. Who else could have done such a thing?"];
                    } else {
                        ["And I shall obtain for thee an audience with the MageLord, have no fear! I am as good as my promise."];
                    }
                } else {
                    if $hawksailedtomoonshade {
                        ["In fact, this is what I shall do for thee! Since thou didst make it possible for Hawk to sail us here, I shall repay thee --"];
                        ["I shall arrange for thee to meet with the MageLord himself. This is quite an honor, <v2>. This will take time, but I can arrange this."];
                        flag(303) = true;
                    } else {
                        ["If we ever leave this forsaken inn, <v0>, perhaps I can obtain thee an audience with the MageLord himself. He trusts me implicitly. Ask me again when we arrive."];
                    }
                }
                ["And thou mayest find that some of the mages are very reclusive and will not speak to thee without proper introduction."];
                TurnOn("mistress");
            }
            key ("mistress") {
                TurnOff("mistress");
                ["Oh, yes! Filbercio is quite a lady's man. And what woman would not jump at the opportunity to win the MageLord's favor?"];
                ["For now, Frigidazzi holds the MageLord's eye. And, from what I have seen, Filbercio seems to have found a way to thaw the charms of that cold mage..."];
                if $hawksailedtomoonshade {
                    ["Though I have heard that Frigidazzi is not always so cool. And I have been told that Filbercio hath not been... faithful... shall we say."];
                    TurnOn(<< "Frigidazzi", "heard", "faithful" >>);
                } else {
                    ["Ask me about it again, if we ever sail to Moonshade. I shall relish telling thee more then. But for now, it only makes me angrier with Hawk for stranding me here!"];
                }
            }
            key ("Frigidazzi") {
                TurnOff("Frigidazzi");
                ["Frigidazzi specializes in cold-related spells. She is a great beauty, but she is rather cold to everyone."];
                ["Perhaps I should not say this, but I think Frigidazzi is using Filbercio to gain status within the ranks of the Adepts."];
                v10 = true;
            }
            key ("heard") {
                TurnOff("heard");
                ["I have heard that Frigidazzi can be quite... warm, to those who catch her fancy. And I am told that she can be very persistent about getting what she wants."];
                ["Although I think it would be foolish to catch her eye as long as Filbercio doth have an interest in her... If thou knowest what I mean."];
            }
            key ("faithful") {
                TurnOff("faithful");
                ["Filbercio hath been trying to coerce Columna into a dalliance for some time. But she will have nothing to do with him."];
                ["As Filbercio doth not take being rebuffed lightly, he hired Stefano to steal something of Columna's from Torrissio, to use as blackmail. So the MageLord may prevail in this intended infidelity -- if Frigidazzi doth not discover him."];
                ["Of course, this is not the MageLord's only indiscretion... As I have this story from Julia, who found out from Filbercio, during a night of... ahem... stolen passion."];
                TurnOn(<< "Columna", "Stefano", "Torrissio", "Julia" >>);
            }
            key ("Columna") {
                TurnOff("Columna");
                ["There is not too much to say about Columna. She is one of Moonshade's most reclusive mages. I think that is what makes her so attractive to Filbercio. She seems unattainable."];
                ["Why she insists on dallying with that scum Torrissio, I will never know. She would do better with the MageLord... any way thou dost look at it."];
            }
            key ("Stefano") {
                TurnOff("Stefano");
                ["Stefano is a thief of some skill, with a bit of magical ability. He tends to live from one disaster to another, though he would like to see himself as a great lord somewhere, someday."];
                ["Stefano would do better practicing his magic... But he would rather be a skilled thief than a novice mage."];
            }
            key ("Torrissio") {
                TurnOff("Torrissio");
                ["I hate even to utter his name... It leaves a bitter taste in the mouth!"];
                ["Torrissio specializes in creating the magical automatons that most mages prefer as their servants. I will grant that he is skilled enough, but he doth have the ethics of a snake!"];
                ["'Tis a good thing Petra escaped from his sickening clutches and has Rocco to protect her."];
                TurnOn(<< "Petra", "Rocco" >>);
            }
            key ("Petra") {
                TurnOff("Petra");
                ["Petra is the automaton at the Blue Boar. Torrissio created her."];
                ["I have only heard a bit of the tale, so thou shouldst go speak to Petra directly to hear the right of it. In short, Torrissio had vile intent for Petra. But she escaped and Rocco took her in and watches over her."];
            }
            key ("Rocco") {
                TurnOff("Rocco");
                ["Rocco is the innkeeper at the Blue Boar."];
                ["Although Rocco can be quite gruff, he is devoted to Petra... If thou askest me, I would say 'tis a perfect match -- Rocco and Petra. He can complain as much as he wants and she still takes care of him."];
            }
            key ("Julia") {
                TurnOff("Julia");
                ["Julia is a Ranger at the Winery. She is a rather handsome woman. Very no-nonsense sort."];
            }
            key ("tales") {
                TurnOff("tales");
                ["As thou mayest imagine, Moonshade hath its share of tall tales and stories. In fact, many of them are started by the mages in question, to enhance their reputations!"];
                ["But, if thou dost listen to the tales, there are ancient passages that connect to the other islands. Or, for that matter, some say that the Mad Mage can teleport anywhere he likes."];
                TurnOn(<< "passages", "Mad Mage" >>);
            }
            key ("passages") {
                TurnOff("passages");
                ["I know nothing other than the fact that they are said to exist, and that they are supposedly fraught with peril."];
                ["Perhaps if thou dost ask Fedabiblio, he could confirm it... Or even tell thee where they are."];
                TurnOn("Fedabiblio");
            }
            key ("Fedabiblio") {
                TurnOff("Fedabiblio");
                ["Fedabiblio is the Magister of Moonshade. It is his duty to test the children throughout the land and bring them to Moonshade for training. Thou mayest find him at the Seminarium."];
                ["It makes my very skin crawl, <v0>, to think of the damage an untutored mage could do..."];
                TurnOn("Seminarium");
            }
            key ("Seminarium") {
                TurnOff("Seminarium");
                ["That is where all the novice mages are taught. Look for the youngsters in the street and thou wilt find it."];
            }
            key ("Mad Mage") {
                TurnOff("Mad Mage");
                ["His name is actually Erstam. But everyone here refers to him as the Mad Mage."];
                ["'Tis a very complex situation, <v0>. Erstam trained all of the Adepts in Moonshade. And, as their master, he is a threat to them because he is still more powerful than they are."];
                ["As I said before, mages are nothing if not prideful. So it is now forbidden for any to visit Erstam... Which, from what I am told is fine with him!"];
                ["If thou wishest to try and contact the Mad Mage, thou canst try speaking with Pothos. I believe that they still maintain a contact of sorts."];
                TurnOn("Pothos");
            }
            key ("Pothos") {
                TurnOff("Pothos");
                ["Pothos is the apothecary. He hath some small magical ability, but not enough to enter the ranks of the Adepts. So he makes his living selling them reagents and potions..."];
                if $filberciobanquet {
                    if $knowturtle {
                        ["He hath been very cheerful as of late..."];
                    } else {
                        ["There are those who believe that Erstam is Pothos' father. But Pothos will never talk about it, so I do not know."];
                        $KNOWS_POTHOS_SECRET = true;
                    }
                }
            }
            key ("Moonshade") {
                TurnOff("Moonshade");
                ["Moonshade, the city of mages! A place where anything thou mayest desire can be thine... If thou dost have enough guilders, and thou canst find a mage with enough skill."];
                TurnOn("guilders");
            }
            key ("guilders") {
                TurnOff("guilders");
                ["Guilders are the coins of Moonshade, <v0>."];
                ["None of the artisans or shopkeepers will deal with thee if thou dost not have guilders. Thou canst exchange thine other coins with Bucia, at my shop."];
            }
            key ("any place") {
                TurnOff("any place");
                ["There are many places that thou wilt want to visit while thou art here."];
                ["Thou mayest find lodgings at the Blue Boar. Thou shouldst see the Winery. And there's the artist's bazaar..."];
                TurnOn(<< "Blue Boar", "Winery", "bazaar" >>);
            }
            key ("Blue Boar") {
                TurnOff("Blue Boar");
                ["The Blue Boar is a tavern here. It provides food and lodging at a reasonable rate... for Moonshade."];
                ["Thou wilt sometimes find some of the less reclusive mages there. Be careful not to offend any of them for they may call thee out to a magical duel!"];
            }
            key ("Winery") {
                TurnOff("Winery");
                ["The Rangers have a magic winepress. It works without need of human assistance. I am sure that thou wilt find it interesting."];
            }
            key ("bazaar") {
                TurnOff("bazaar");
                ["'Tis where many of the artisans can be found... My shop, the Capessi Canton, is located near the Blue Boar Inn. Be sure to stop and say hello to Bucia, who runs the shop for me."];
                TurnOn("Bucia");
            }
            key ("Bucia") {
                TurnOff("Bucia");
                ["Sometimes I cannot understand why I keep her. Each time I enter the shop, there she is -- babbling with someone. Makes me wonder if she doth do any work at all..."];
                ["And sometimes I wonder at her sanity, too. She hath developed some far-fetched notions, certis. Why she would have it that poor young Pothos is connected in some way to the Mad Mage! Canst thou imagine?!"];
            }
            key ("thy promise") {
                TurnOff("thy promise");
                if $rotoscrollone {
                    if flag(304) {
                        ["What? Dost thou not trust my word?"];
                        ["Go about thy business, and the MageLord shall certainly summon thee when he is ready."];
                    } else {
                        flag(304) = true;
                        ["I have good news for thee, my friend! As promised, I have arranged for thee to meet with MageLord Filbercio."];
                        ["In fact, he plans to hold a banquet in thine honor. I am certain thou wilt find his means of summoning thee... very unusual..."];
                        ["Go about thy business, and at the appropriate moment, the MageLord shall summon thee."];
                        $FILBERCIO_BANQUET_WILL_HAPPEN = true;
                        v7 = ~PostInFuture(330, << _aUSABLE_i, #SummonToBanquet_i >>, ~GimmePathEgg(4, 1));
                        v7 = ~PostInFuture(315, << _aUSABLE_i, #SummonToBanquet_i >>, ~GimmePathEgg(3, 1));
                    }
                } else {
                    ["I am working on securing that appointment for thee to meet with the MageLord, but these things take time..."];
                    ["Ask me again tomorrow. I promise thee that I can accomplish this thing, but not instantly, not immediately."];
                }
            }
            key ("bye") {
                CloseSpeaker0_i();
                Bark_i(0, "@Thanks for thine help.@", _Avatar);
                Bark_i(5, "@Whatever...@", _Flindo);
                MessengerBringsScroll_i();
                break;
            }
        }
        clear_answers;
    }
}
