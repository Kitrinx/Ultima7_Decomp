Routine Password accepts a0 #locals(4) #uses(AutomatonUsable_i, Bark_i, ~AskYesNo) {
    if ~GetItemFlag_i(_Zombie, item) {
        AutomatonUsable_i();
        terminate;
    }
    if (event = _Path_Failure) {
        event = 10;
    }
    if (event = _Converse) {
        Bark_i(0, "@Hail, metal servant!@", _Avatar);
        Bark_i(1, "@Halt, stranger!@", item);
        SetWorkType(_Stand, _Password);
        PathfindNPC_i(true, #Password, item, _Pathfind1, << 1894, 636, 0 >>, item);
    }
    if (event = _Pathfind1) {
        SetWorkType(_Patrol, _Password);
        SetFrame(16, _Password);
        v0 = ~PostInFuture(3, << _aNO_HALT_i, _aUSABLE_i, #Password >>, item);
    }
    if (event = _Action) {
        Npc_schedule(item);
        ClearBark_i(_Avatar);
        ClearBark_i(item);
        SetWorkType(_Patrol, _Password);
        v1 = ~GetItemFlag_i(_InParty_i, _Dupre);
        SetSpeaker0_i(0, _Forskis);
        ["I am the guardian of the city of Order. Dost thou wish to enter the great city of Spinebreaker?"];
        v2 = ~AskYesNo();
        if v2 {
            ["I cannot allow thee to enter until thou dost tell me the password. Canst thou tell me what the password is?"];
            v3 = ~AskYesNo();
            if v3 {
                if v1 {
                    SetSpeaker1_i(0, _Dupre);
                    SetSpeakerSlot_i(1);
                    ["But Avatar, surely thou dost not know the password! How canst thou fool this infernal thing?"];
                    SetSpeakerSlot_i(0);
                    CloseSpeaker1_i();
                }
                ["I am waiting to receive the password."];
                TurnOn(<< "I don't know the password.", "try to guess the password" >>);
            } else {
                ["Then thou canst not enter the underground city."];
                terminate;
            }
        } else {
            ["Then thou shouldst not loiter about this place. By the authority of those who once lived and ruled here, I order thee to leave this place immediately."];
            terminate;
        }
        converse {
            key ("I don't know the password.") {
                ["Then thou canst not enter the underground city. By the authority of those who once lived and ruled here, I order thee to leave this place immediately!"];
                terminate;
            }
            key ("try to guess the password") {
                SetSpeaker1_i(0, _Avatar);
                SetSpeakerSlot_i(1);
                [Having no idea what the password actually is, you take a wild guess, saying something that sounds like it might make a proper password.];
                CloseSpeaker1_i();
                SetSpeakerSlot_i(0);
                ["That is not the correct password! Thou art forbidden to enter!"];
                ["Thou shouldst not loiter about here. Thou must leave this place immediately."];
                v1 = ~GetItemFlag_i(_InParty_i, _Dupre);
                if v1 {
                    SetSpeaker1_i(0, _Dupre);
                    SetSpeakerSlot_i(1);
                    ["I take it that was a guess! Ha! I knew thou couldst not know the proper password! I suggest we cease trying to guess the password and find a better way of entering this place. Simply guessing could take forever!"];
                }
                terminate;
            }
        }
        clear_answers;
    }
}
