Routine New_Curtain accepts a0 #locals(2) {
    if (event = _Converse) {
        v0 = ~GetFrame(item);
        if ((v0 modulo 2) = 0) {
            v1 = 1;
        } else {
            v1 = 65535;
        }
        v0 = (v0 + v1);
        SetFrame(v0, item);
    }
}

Routine New_2_Curtain accepts a0 #locals(2) {
    if (event = _Converse) {
        v0 = ~GetFrame(item);
        if ((v0 modulo 2) = 0) {
            v1 = 1;
        } else {
            v1 = 65535;
        }
        v0 = (v0 + v1);
        SetFrame(v0, item);
    }
}
