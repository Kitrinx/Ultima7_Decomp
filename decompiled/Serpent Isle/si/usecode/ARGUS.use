    v8 = 1;
    v9 = 0;
    v10 = 2;
    v11 = ~GetNPCID_i(_Argus);
    While v8 {
        v12 = ~AskList(<< "yes", "no", "haggle" >>);
        if (v12 = "no") {
            return 0;
        } else {
            if (v12 = "yes") {
