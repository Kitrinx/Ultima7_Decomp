        v5 = v14::1;
        label_8:
        v16 = ~Random(3);
        if (v13 < 2) {
            if (v4 < (v0 + ((v1 - v0) / 4))) {
                if (v16 = 1) {
                    ["Do not tell Devra... She will think her son hath gone soft in the head for giving thee a price like this."];
                    if ~IsNPCNear(_Devra) {
                        SetSpeaker1_i(0, _Devra);
                        ["Thou woolly-headed wolf! Thine head is fine. 'Tis thine heart that is soft..."];
                        CloseSpeaker1_i();
                        SetSpeakerSlot_i(0);
                    }
                }
                if (v16 = 2) {
                    ["Thou dost drive a hard bargain, <v2>!"];
                }
                if (v16 = 3) {
                    ["Thou hast a shrewd tongue, <v2>! It hath been some time since I was beaten at this game!"];
                }
            } else {
                if (v4 < (v0 + ((v1 - v0) / 3))) {
                    if (v16 = 1) {
                        ["Our prices are honest here at the Sleeping Bull!"];
                    }
                    if (v16 = 2) {
                        ["Thou hast found me in a generous mood, <v2>! 'Tis not every day I sell goods at these prices!"];
                    }
                    if (v16 = 3) {
                        ["Thou art a shrewd bargainer, <v2>!"];
                    }
                } else {
                    if (v4 < (v0 + ((v1 - v0) / 2))) {
                        if (v16 = 1) {
