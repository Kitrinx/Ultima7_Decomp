Usable SetGotFlags_i #locals(5) #uses(~GiveTeleList_i, ~IsInInv) {
    v0 = ~GiveTeleList_i(1);
    v1 = ~GiveTeleList_i(2);
    v2 = ~GiveTeleList_i(3);
    v3 = 1;
    v4 = (~ListSize_i(v0) + 1);
    While (v3 < v4) {
        if ~IsInInv(v2::v3, v1::v3, v0::v3, 1, _Party) {
            if (v0::v3 = 264) {
                $gotpinecone = true;
            }
            if (v0::v3 = 577) {
                $gotpenguinegg = true;
            }
            if (v0::v3 = 842) {
                $gotstoneheart = true;
            }
            if (v0::v3 = 749) {
                $gotlabitem = true;
            }
            if (v0::v3 = 267) {
                $gotpumice = true;
            }
            if (v0::v3 = 285) {
                $gotgoblinhairbrush = true;
            }
            if (v0::v3 = 887) {
                $gotengagementring = true;
            }
            if (v0::v3 = 677) {
                $gotpinecone = true;
            }
            if (v0::v3 = 244) {
                $gotbearskull = true;
            }
            if (v0::v3 = 729) {
                $gotmonitorshield = true;
            }
            if (v0::v3 = 616) {
                $gotmagicwine = true;
            }
            if (v0::v3 = 914) {
                $goturn = true;
            }
            if (v0::v3 = 587) {
                $gotslippers = true;
            }
            if (v0::v3 = 948) {
                $STORM_FILARI = true;
            }
            if (v0::v3 = 794) {
                $gotbloodyhand = true;
            }
            if (v0::v3 = 1004) {
                $gotfurcap = true;
            }
            if (v0::v3 = 419) {
                $gotbreastplate = true;
            }
        }
        v3 = (v3 + 1);
    }
}
