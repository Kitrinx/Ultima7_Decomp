                        ["Here is the key to thy friend's jail cell. Set him free."];
                        v0 = ~GiveItemsOrDrop_i(true, 0, 5, 104, 641, 1, _Avatar);
                        $BRENDANN_GAVE_JAIL_KEY = true;
                    } else {
                        ["Then he must remain in his cell."];
                    }
                } else {
                    if ~IsInInv(5, 104, _Unique_Key, 1, _Party) {
                        ["I did already give thee the key to thy friend's cell!"];
                    } else {
                        ["Didst thou lose the key I did give thee?"];
                        if ~AskYesNo() {
                            ["Very well. Here then, take this copy. And do not lose this one!"];
                            v0 = ~GiveItemsOrDrop_i(true, 0, 5, 104, 641, 1, _Avatar);
                        } else {
                            ["Good. I would hate for thee to have lost it..."];
                        }
                    }
                }
            }
            key ("bye") {
                Bark_i(0, "@Goodbye@", _Avatar);
                if ~AvatarSex() {
                    if $brendanninvited {
                        Bark_i(2, "@Until tonight!@", _Brendann);
                    } else {
                        Bark_i(2, "@Nice legs...@", _Brendann);
                    }
                } else {
                    Bark_i(2, "@Be cunning!@", _Brendann);
                }
                break;
            }
        }
        clear_answers;
    }
}
