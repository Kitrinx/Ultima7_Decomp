Routine OpenDoorsNear_i accepts a0 #locals(5) #uses(~SwingDoor_i) {
    v1 = ~FindNearby_i(0, 20, _Door_EW, v0);
    Foreach v4 in v1 {
        v5 = ~SwingDoor_i(7, 0, 0, 1, _Door_NS, v4);
    }
}

Routine OpenGateWithWinch_i accepts a0, a1 #locals(14) #uses(~TogglePortcullises_i, ~PartyUtters, LockDoorsNear_i, OpenDoorsNear_i, ~IsNPCNear) {
    v2 = (~GetAllInRegion(_NS_Portcullis) & ~GetAllInRegion(_EW_Portcullis));
    v3 = false;
    Foreach v6 in v2 {
        if (~GetQuality(v6) = ~GetQuality(v1)) {
            v7 = ~TogglePortcullises_i();
            v7 = ~PostAction(<< _aFRAME, 1, _aNEXT_FRAME, _aLOOP_i, 65535, 6 >>, v1);
            v3 = true;
        }
    }
    if not v3 {
        v8 = ~GetQuality(v1);
        if ((v8 >= 200) and (v8 <= 204)) {
            v3 = true;
            v7 = ~PostAction(<< _aFRAME, 1, _aNEXT_FRAME, _aLOOP_i, 65535, 6 >>, v1);
            if (v8 = 200) {
                v9 = ~PostInFuture(10, << _aNO_HALT_i, _aBARK_i, "@Nothing is happening.@" >>, _Avatar);
                v10 = ~PartyUtters(false, 0, 0, 1);
                if (v10 <> 65180) {
                    v9 = ~PostInFuture(15, << _aNO_HALT_i, _aBARK_i, "@Perhaps it requires something.@" >>, v10);
                }
            }
            if (v8 = 201) {
                v9 = ~SetQuality(202, v1);
                SetWeather_i(_Rain);
                v10 = ~PartyUtters(false, 0, 0, 1);
                if (v10 <> 65180) {
                    v9 = ~PostInFuture(10, << _aNO_HALT_i, _aBARK_i, "@The sky doth threaten rain.@" >>, v10);
                }
                v9 = ~PostInFuture(20, << _aNO_HALT_i, _aBARK_i, "@Even as Gustacio said.@" >>, _Avatar);
                LockDoorsNear_i(v1);
            }
            if (v8 = 202) {
                if ($seenredlightning and ($SEEN_YELLOW_LIGHTNING and $SEEN_GREEN_LIGHTNING)) {
                    v11 = ~FindNearby_i(0, 20, _Magic_Orbs, v1);
                    Foreach v14 in v11 {
                        if (~GetFrame(v14) = 2) {
                            v15 = ~GetCoord(v14);
                            createSprite(65535, 0, 0, 0, (v15::2 - 6), (v15::1 - 6), 1);
                            Sfx(41);
                            Item_destroy(v14);
                            flag(227) = true;
                        }
                    }
                    v9 = ~SetQuality(200, v1);
                    v9 = ~PostInFuture(10, << _aNO_HALT_i, _aUSABLE_i, #LightningStrikesAvatar_i >>, _Avatar);
                } else {
                    SetWeather_i(_Clear);
                    v9 = ~SetQuality(201, v1);
                }
                OpenDoorsNear_i(v1);
            }
            if (v8 = 203) {
                v9 = ~SetQuality(204, v1);
                SetWeather_i(_Rain);
                if ~IsNPCNear(_Iolo) {
                    v9 = ~PostInFuture(10, << _aNO_HALT_i, _aBARK_i, "It doth storm again!" >>, _Iolo);
                }
                if ~IsNPCNear(_Shamino) {
                    v9 = ~PostInFuture(20, << _aNO_HALT_i, _aBARK_i, "I should have brought a kite." >>, _Shamino);
                }
                LockDoorsNear_i(v1);
            }
            if (v8 = 204) {
                SetWeather_i(_Clear);
                v9 = ~SetQuality(203, v1);
                OpenDoorsNear_i(v1);
            }
        }
    }
    if (v3 and v0) {
        v7 = ~PostAction(<< _aFACE_i, _West, _aCONTINUE_i, _aBEND_FRAME_i, _aSTAND_FRAME_i, _aLOOP_i, 65534, 4 >>, _Avatar);
    }
}
