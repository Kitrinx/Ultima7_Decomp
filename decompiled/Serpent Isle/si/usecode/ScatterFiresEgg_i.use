    v1 = (15 + ~NPCLevel_i(_Avatar));
    While (v1 <> 0) {
        v1 = (v1 - 1);
        v2 = (v0::1 + ~rndRange(10, 65527));
        v3 = (v0::2 + ~rndRange(15, 65518));
        v4 = v0::3;
        v5 = << v2, v3, 0 >>;
        v6 = ~rndRange(4, 1);
        if ((v6 = 1) or (v6 = 2)) {
            v7 = ~Item_create(_Field_Fire);
        }
        if ((v6 = 3) or (v6 = 4)) {
            v7 = ~Item_create(_Blue_Flame);
        }
        if v7 {
            v8 = ~rndRange(15, 5);
