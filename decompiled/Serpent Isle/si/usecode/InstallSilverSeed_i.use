        v8 = << 16, 21, 11, 11, 4, 29, 10 >>;
        v9 = 0;
        Foreach v12 in v0 {
            v9 = (v9 + 1);
            v13 = ~CreateCreature_i(<< v6::v9, v7::v9, 0 >>, v12);
            if v13 {
                ClearItemFlag_i(_IsTemporary_i, v13);
                Npc_setAlignment(_Neutral, v13);
                SetWorkType(v8::v9, v13);
                SetNPCID_i(0, v13);
