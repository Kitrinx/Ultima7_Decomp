Routine SunriseToothEgg_i accepts a0 #locals(1) #uses(~IsInInv, Bark_i) {
    PrintError_i(<< "WARNING: remove this egg at ", ~GetCoord(item) >>);
    terminate;
    if (event = _Trigger) {
        v0 = ~IsInInv(2, 65177, _Brk_Items, 1, _Party);
        if v0 {
            $gotsunrisetooth = true;
            Item_destroy(item);
        } else {
            v0 = ~IsInInv(1, 65177, _Teeth, 1, _Party);
            if v0 {
                $gotsunrisetooth = true;
                Item_destroy(item);
                Bark_i(3, "@Smell that clean air!@", _Avatar);
            }
        }
    }
}
