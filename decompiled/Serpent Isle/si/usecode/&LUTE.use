Routine Harpsichord_NS accepts a0 #locals(0) {
    if ((event = _Converse) or (event = _Action)) {
        SetMusic(item, 46);
    }
}

Routine NS_Xylophone accepts a0 #locals(0) {
    if ((event = _Converse) or (event = _Action)) {
        SetMusic(item, 45);
    }
}

Routine Lute accepts a0 #locals(0) {
    if ((event = _Converse) or (event = _Action)) {
        SetMusic(item, 48);
    }
}

Routine Panpipes accepts a0 #locals(0) {
    if ((event = _Converse) or (event = _Action)) {
        Sfx(85);
    }
}

Routine Harp accepts a0 #locals(0) {
    if ((event = _Converse) or (event = _Action)) {
        SetMusic(item, 47);
    }
}
