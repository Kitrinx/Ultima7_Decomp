    if (event = _Trigger) {
        PathfindNPC_i(true, #EnterKnightsTest_i, _Avatar, _Pathfind1, << 823, 2241, 0 >>, _Avatar);
        v0 = ~PostAction(<< _aFACE_i, _West >>, _Avatar);
        SetWorkType(_Stand, _Shmed);
        Bark_i(0, "@To the test!@", _Shmed);
        terminate;
    }
    if (event = _Pathfind1) {
        v1 = ~FindNearby_i(0, 10, _Door_EW, _Avatar);
        Foreach v4 in v1 {
            v5 = ~GetCoord(v4);
            Item_destroy(v4);
            Sfx(32);
            v6 = ~CreateItemAt_i(v5, true, 72, 14, _Door_NS);
        }
        Bark_i(0, "@heh, heh...@", _Shmed);
        v6 = ~PostInFuture(3, << _aNO_HALT_i, _aUSABLE_i, #EnterKnightsTest_i >>, item);
        terminate;
    }
    if (event = _Action) {
        PathfindNPC_i(true, #EnterKnightsTest_i, _Avatar, _Pathfind2, << 823, 2234, 0 >>, _Avatar);
    }
    if (event = _Pathfind2) {
        v1 = ~FindNearby_i(0, 10, _Door_NS, _Avatar);
        Foreach v4 in v1 {
            if (~GetQuality(v4) = 72) {
                v5 = ~GetCoord(v4);
                Item_destroy(v4);
                Sfx(31);
                v6 = ~CreateItemAt_i(v5, false, 72, 14, _Door_EW);
            }
            ClearItemFlag_i(_DontMove_i, _Avatar);
            ClearSpeakers_i();
            Bark_i(7, "@I have a bad feeling...@", _Avatar);
        }
        PathfindNPC_i(true, #EnterKnightsTest_i, _Avatar, _Pathfind2, << 823, 2241, 0 >>, _Avatar);
    }
}
