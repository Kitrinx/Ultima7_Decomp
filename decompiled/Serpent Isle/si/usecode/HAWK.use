        converse {
            key ("jail") {
                ["Now if that ain't gratitude for ye!" ~"Here I refused ta risk the Arabella and them passengers ta the terrible fierce weather." *"And one of them goes and calls the Pikemen on me!"];
                TurnOff("jail");
