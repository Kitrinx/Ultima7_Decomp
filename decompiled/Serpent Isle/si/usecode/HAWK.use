        }
        if (v6 = 9) {
            ["I thank ye for releasing me from that cell!" ~"I never expected ta end up in jail over not wantin' ta sail in these blasted storms!" *"If there's anything that I can do for ye, thou shouldst tell me." ~"Cap'n Hawk is a man of his word!"];
            TurnOn(<< "jail", "storms" >>);
