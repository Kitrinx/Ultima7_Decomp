            key ("Kane") {
                ["Seems I heard tell he was a sheepherder or something." ~"Kane wants ta go talk ta some of those fancy wizards over in Moonshade..." *"See if they kin help him find what happened ta his older brother who disappeared a few months ago." ~"Ye can't miss him... He always has a bird with him."];
                TurnOff("Kane");
