                TurnOff("greedy");
            }
            key ("greedy") {
                ["They thought they could make me pay for my release, but I have no money ta speak of..." ~"Then they thought they could convince Flindo ta pay my way out, but either he'd spent all his money bribing them ta rough me up or he wouldn't pay it out of spite!"];
