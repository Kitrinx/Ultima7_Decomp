Routine Turtle1 accepts a0 #locals(3) {
    if ((event = _Action) or (event = _Converse)) {
        v0 = ~FindNearby_i(176, 40, _Barge, _Avatar);
        if not ~IsOnBarge_i() {
            v1 = ~PostInFuture(2, << _aUSABLE_i, #Turtle1, 0 >>, item);
        } else {
            v2 = ~GetCoord(item);
            if (v2 > 2095) {
                v1 = ~PostInFuture(3, << _aGO_W, _aUSABLE_i, #Turtle1, 0 >>, v0);
            }
        }
    }
}

