        Sfx(116);
        CreateSpriteOn_i(65535, 0, 0, 0, 0, 0, 42, item);
    }
    if (v1 = 4) {
        Sfx(116);
        CreateSpriteOn_i(65535, 0, 0, 0, 0, 0, 43, item);
