Routine Magic_plants accepts a0 #locals(7) {
    if (event = _Converse) {
        v0 = ~GetFrame(item);
        if (v0 < 2) {
            v1 = ~GetTarget();
            if not v1 {
                return;
            }
            v2 = ~Item_getType(v1);
            if (v2 = 722) {
                v3 = ~GetQuantity(v2, v1);
                if (v3 > 1) {
                    v4 = ~SetQuantity((v3 - 1), v1);
                } else {
                    Item_destroy(v1);
                }
                v5 = ~Item_create(_Ts_Arrow);
                if v5 {
                    v4 = ~SetQuantity(1, v5);
                    v6 = ~GetCoord(_Avatar);
                    v4 = ~PopToMap(<< (v6::1 + 1), v6::2, v6::3 >>);
                    Item_destroy(item);
                }
            }
        }
    }
}
