        SetSpeaker0_i(0, _Mortegro);
        v11 = ~GetItemFlag_i(_Met, _Mortegro);
        if (($mortegrofreed = true) and not flag(534)) {
            flag(534) = true;
            ["Many thanks, <v2>. Now I shall reward thee, as promised!"];
            ["I shall give thee a scroll, which contains the spell of Shade Summoning. Thou wouldst be wise to copy it to thy spellbook at the first opportunity."];
            ["Here it is."];
            v6 = ~GiveItemsOrDrop_i(true, 0, 0, 38, 715, 1, _Avatar);
        } else {
            if ((v3 = 22) and not $mortegrofreed) {
                if (flag(532) = true) {
                    ["Thou hast returned! Wilt thou release me from this forsaken island?"];
                    if (~AskYesNo() = true) {
