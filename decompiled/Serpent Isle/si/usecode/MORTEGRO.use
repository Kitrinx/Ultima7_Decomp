                terminate;
            }
            key ("leave") {
                TurnOff("leave");
                ["But thou didst promise to bring me home to Moonshade! A promise is a promise, <v0>."];
            }
            key ("Necromage") {
                TurnOff("Necromage");
                ["Yes, that is a special sort of mage who specializes in magics that deal with dead things, as well as with the spirits of the dead themselves."];
                TurnOn(<< "dead things", "spirits of dead" >>);
            }
            key ("dead things") {
                TurnOff("dead things");
                ["Actually, that is rather unpleasant work. A bit discourteous to talk about it in mixed company, if thou dost know what I mean."];
            }
            key ("spirits of dead") {
                TurnOff("spirits of dead");
                ["Yes, as a Necromage I can commune with the spirits of the dead. I learn the secrets of the dead as well as the occasional portent of the future. But these seances are unpredictable in their results."];
                if not flag(306) {
                    flag(306) = true;
                    TurnOn("seance");
                }
            }
            key ("Moonshade") {
                TurnOff("Moonshade");
                ["It is a city of Mages, run by Mages and that is the way we mages like it. We are even governed by our own Council of Mages, chaired by Filbercio, Gustacio and Rotoluncia."];
                TurnOn(<< "Filbercio", "Gustacio", "Rotoluncia" >>);
            }
            key ("Filbercio") {
                TurnOff("Filbercio");
                ["He is the supreme MageLord of the city of Moonshade."];
            }
            key ("Gustacio") {
                TurnOff("Gustacio");
                ["Gustacio and I are engaged in studies of the strange teleport storms that have been afflicting our land."];
            }
            key ("Rotoluncia") {
                TurnOff("Rotoluncia");
                ["She is a powerful mage. Her only real weakness is that she is most unpleasant when she is thwarted in her desires."];
            }
            key ("seance") {
                TurnOff("seance");
                if (~GetWorkType(_Mortegro) = _Lab) {
                    if ((~GetClock(6) < 12) and flag(297)) {
                        ["Speaking with the spirits of the dead doth fatigue me. We must wait another day before I can muster the energies required."];
                    } else {
                        SetClock(6);
                        SetMusic(~GimmePathEgg(1, 5), 56);
                        ["It is time for the seance to begin. I have already prepared all of the elaborate reagents and incantations necessary to open my mind, as a portal through which the spirits of the dead may speak. What thou shalt see are not dreams or hallucinations, but actual ghosts who will join with us in communion. Do not be afraid."];
                        ["I summon you, ghosts! Come join us here and speak with us. Share with us thy visions of this world and the next."];
                        if not flag(297) {
                            SetSpeaker1_i(0, _SmithzHorse);
                            ["I have heard thy call, Mortegro! In life I was Christopher, blacksmith of Trinsic. My time here is short and I wish to have words with the one who is called the Avatar."];
                            ["Avatar, I thank thee for protecting my son and for breaking The Fellowship's evil grip over Britannia. But I also bring thee a warning. Many are the spirits in this realm who await thee, and there is but one thing on their mind -- to have their revenge against thee! There is one thing... that thou must... always... remember..."];
                            CloseSpeaker1_i();
                            SetSpeakerSlot_i(0);
                            ["Oh! I have lost contact with the spirit! Forgive me, but with a contact that intense, the length of time that I can maintain is always shorter."];
                            flag(297) = true;
                        } else {
                            if (~IsNPCNear_i(_Iolo) and not flag(305)) {
                                SetSpeaker1_i(1, _SmithzHorse);
                                ["My darling husband, Iolo, although I am dead I must tell thee that my love for thee shall never die. Always remember me. Farewell."];
                                CloseSpeaker1_i();
                                SetSpeakerSlot_i(0);
                                ["I have lost the contact -- there are strange forces connected with this spirit!"];
                                SetSpeaker1_i(0, _Iolo);
                                ["No! It cannot be true! She cannot be dead! I refuse to believe it!"];
                                v6 = ("@Gwenno!@" & "@Come back to me!@");
                                BarkIfNear_i(v6, _Iolo);
                                Bark_i(5, "@Spirits do not lie.@", _Mortegro);
                                flag(305) = true;
                                terminate;
                            } else {
                                SetSpeaker0_i(0, _Mortegro);
                                ["Once again I call out to the spirit of Edrin, brother of Kane. If thou canst hear me, Edrin, please contact us. Thy brother Kane dost need to know if thou hast perished. Thou hast been missing for so long that even thy brother dost think that he shall never see thee again. If thou canst hear my words, please contact us."];
                                v13 = ~PartyUtters(false, "@There is no reply.@", "@There seems to be no reply.@", 1);
                                SetSpeakerSlot_i(0);
                                ["This is a favorable sign for Kane. It may well mean that his brother is not in the realm of ghosts."];
                            }
                        }
                    }
                } else {
                    if flag(226) {
                        ["Ahem, once I have gotten back to Moonshade I will be glad to oblige thee."];
                    } else {
                        ["I must first prepare the proper materials. Thou shouldst come to my manor after midnight, and we shall then conjure spectres."];
                    }
                }
            }
            key ("trapped") {
                TurnOff("trapped");
                ["Well, I hesitate to admit that an Adept such as myself could be caught in such a manner... But none of my magics have worked to free me from this island."];
                TurnOn("magics");
            }
            key ("magics") {
                TurnOff("magics");
                ["Although I am not an expert in it, I can do simple teleports and fetches. But nothing I have tried has worked. I think, perhaps, that this is a null magic area."];
                TurnOn("null magic area");
            }
            key ("null magic area") {
                TurnOff("null magic area");
                ["There are such areas where magic cannot be used. I think that this... place... may be one of them." *"Or, perhaps, common magic --  if thou wilt -- cannot function here. Whatever the case, I cannot escape by magical means."];
            }
            key ("learn spells") {
                TurnOff("learn spells");
                if (flag(226) and not $mortegrofreed) {
                    ["How can I concentrate on teaching thee spells when I am freezing to death by the moment?"];
                } else {
                    if ($mortegrofreed = true) {
                        ["As thou didst free me, I can offer my spells to thee at a discount. Say, perhaps half the normal price? Yes, that is what I will sell my spells for -- half cost!"];
                        MortegroSellsSpells_i();
                    } else {
                        if $gotspellbook {
                            ["I can teach thee spells... for a fee."];
                            MortegroSellsSpells_i();
                        } else {
                            ["Thou art not a Mage, so teaching thee spells would be a waste of both our times."];
                            ["If thou art serious about mastering magic, perhaps thou shouldst speak with Master Fedabiblio at the Seminarium."];
                            ["But I think thou art too old to learn spell-casting..."];
                        }
                    }
                }
            }
            key ("spell") {
                TurnOff("spell");
                ["Thou canst consider me a Necromancer, although I do not reanimate the dead. Specifically, I seek information from the dead. Thou wouldst no doubt find the Summon Shade spell useful."];
                TurnOn(<< "information", "Summon Shade" >>);
            }
            key ("information") {
                TurnOff("information");
                ["I am usually commissioned by one of the other mages when they are seeking lost information. I, myself, am not conducting any research at the moment. I was working with Gustacio on an experiment when I suddenly found myself here."];
                TurnOn("experiment");
            }
            key ("experiment") {
                TurnOff("experiment");
                ["I allowed Gustacio to convince me to help him with his plan to divert the teleportation storms."];
                ["Perhaps it was not the wisest of things to have done... As I am trapped here and have no idea how to return to Moonshade."];
                ["I believe I exchanged places with an altar of some sort. I am sure it rather surprised old Gustacio when I disappeared. He is no doubt wondering about whatever is now in his work area."];
                TurnOn("altar");
            }
            key ("altar") {
                TurnOff("altar");
                ["Yes, there are marks here on the island that suggest that something was here until recently."];
                ["Given the architecture, this must be one of the old Serpent temples. So I assume that this may have been where the altar once stood."];
            }
            key ("Summon Shade") {
                TurnOff("Summon Shade");
                ["It is quite a handy spell, actually. It allows thee to question the shade of a dead person... As long as thou dost possess some item that the person had valued in life. Of course, it doth have its drawbacks..."];
                TurnOn("drawbacks");
            }
            key ("drawbacks") {
                TurnOff("drawbacks");
                ["If thou dost summon a shade from its resting place without the appropriate item, the shade may well attack thee. And the spell doth use an inordinate amount of reagents... But thou dost learn such interesting things!"];
                TurnOn("reagents");
            }
            key ("reagents") {
                ["It doth require Sulphurous Ash, Blood Moss, Mandrake Root, Nightshade and Spider's Silk. Quite costly, so thou shouldst use this spell sparingly. And remember that thou must have an item belonging to that person to call them forth."];
                TurnOff("reagents");
            }
            key ("bye") {
                if (flag(534) and not ~GetItemFlag_i(_InParty_i, _Mortegro)) {
                    ["Wouldst thou allow me to accompany thee back to Moonshade? I am afraid that I do not know where I am."];
                    if (~ListSize_i(~GetParty_i()) > 4) {
                        v13 = ~PartyUtters(false, 0, "@We do not have room for another to travel with us, Avatar.@", 1);
                        goto label_154;
                    }
                    if (~AskYesNo() = true) {
                        ["I do not believe I could return home without thy guidance... For all that I am an Adept."];
                        JoinParty(_Mortegro);
                        Bark_i(0, "@Thank thee!@", _Mortegro);
                        terminate;
                    } else {
                        label_154:
                        ["Well, perhaps I can find my way home on mine own... I am an Adept, after all."];
                        Bark_i(0, "@What lies this way?@", _Mortegro);
                        SetWorkType(_Wander, _Mortegro);
                        terminate;
                    }
                }
                CloseSpeaker0_i();
                if ((v3 = 22) and not $mortegrofreed) {
                    Bark_i(0, "@Stay calm.@", _Avatar);
                    Bark_i(5, "@Please help me!@", _Mortegro);
                } else {
                    Bark_i(0, "@Thanks for thine help.@", _Avatar);
                    Bark_i(5, (("@Fare thee well, " + v0) + ".@"), _Mortegro);
                }
                if (~WhereAmI_i() = 14) {
                    MessengerBringsScroll_i();
                }
                break;
            }
        }
        clear_answers;
    }
}

