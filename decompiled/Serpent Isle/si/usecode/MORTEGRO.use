                    ["It is some Mage's lab apparatus, <v0>. I regret that I cannot be of help to thee. It is not a design I recognize. Thou shalt have to ask another Mage."];
                } else {
                    ["It sounds like it is some Mage's lab apparatus, <v0>. I regret that I cannot be of help to thee. It is not a design I recognize. Thou shalt have to ask another Mage."];
                }
            }
            key ("slippers") {
                TurnOff("slippers");
                if v4 {
                    ["Those slippers look most comfortable. They must belong in a place of comfort. The most comfortable place I know is the Inn of the Sleeping Bull. Perhaps that is where they are from."];
                } else {
                    ["Perhaps if I could see the slippers I could tell thee more about them..."];
                }
            }
            key ("the bloody hand") {
                TurnOff("the bloody hand");
                if v5 {
                    ["This is obviously the handiwork of a powerful mage. And there is only one who would produce something as vile as this. The Mad Mage! I can say no more of this."];
                } else {
                    ["Art thou absolutely certain that this thing was a living severed hand? I doubt it is so. Perhaps if thou didst have it to show to me..."];
                }
            }
            key ("accuse") {
                TurnOff("accuse");
                ["So! Thou dost suspect me of kidnapping thy friend!"];
                ["Mine interest lies with dead beings, not with living persons. I do not have thy friend, nor do I know who doth have him."];
                ["Thine impudence is beyond belief! Always, 'tis the superstitious and the jealous who persecute the Necromancer..."];
                v12 = ~GetCoord(_Mortegro);
                createSprite(65535, 0, 0, 0, v12::2, v12::1, 26);
