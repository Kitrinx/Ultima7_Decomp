Routine EW_C_Shutter accepts a0 #locals(1) {
    if (event = _Converse) {
        v0 = ~GetFrame(item);
        if (v0 > 3) {
            SetFrame((v0 - 4), item);
        } else {
            SetFrame((v0 + 4), item);
        }
        playSFX(item, 9);
    }
}

Routine NS_C_Shutter accepts a0 #locals(1) {
    if (event = _Converse) {
        v0 = ~GetFrame(item);
        if (v0 > 3) {
            SetFrame((v0 - 4), item);
        } else {
            SetFrame((v0 + 4), item);
        }
        playSFX(item, 9);
    }
}
