        $sangwhitedragon = true;
        if (not (item = ~NPCToItem_i(_Iolo)) and (v1 <> 31)) {
            AskForTip_i();
        }
    }
}

Usable AskForTip_i #locals(6) #uses(~LordOrLady, ~AskList) {
    v0 = ~LordOrLady();
    ["If thou didst enjoy my song, I would appreciate a small contribution to my room and board."];
    v1 = ~AskList(<< "Nothing", "Monetari", "Guilders", "Filari", "Gold Coins" >>);
    if (v1 = "Monetari") {
        v2 = 951;
    }
    if (v1 = "Guilders") {
        v2 = 952;
    }
    if (v1 = "Filari") {
        v2 = 948;
    }
    if (v1 = "Gold Coins") {
        v2 = 644;
    }
    if (v1 = "Nothing") {
        v2 = 644;
    }
    v3 = ~CountItem(_All, _All, v2, _Party);
    if (v1 <> "Nothing") {
        if (v3 <> 0) {
            v4 = ~AskBarInput(0, 1, v3, 0);
            if (v4 >= 1) {
                v5 = ~TakeFromParty_i(false, _All, _All, v2, v4);
                ["Many thanks, <v0>. Perhaps thou wouldst care to hear another song. Or, if thou art tired, I can return later..."];
                TurnOn(<< "song", "bye" >>);
            } else {
                ["Perhaps some other time..."];
                terminate;
            }
        } else {
            ["I am afraid thy purse is empty of <v1>, <v0>."];
        }
    } else {
        ["Very well... then I shall play no more."];
        terminate;
    }
}
