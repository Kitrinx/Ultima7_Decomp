Routine JailEscapeEgg_i accepts a0 #locals(3) #uses(~PartyUtters) {
    if (event = _Trigger) {
        v0 = ~FindNearby_i(0, 20, _SDoor_EW, item);
        if v0 {
            v1 = ~PartyUtters(false, "I am glad to be out of there!", "There hath not been a jail made yet that can hold me!", 1);
            v2 = ~PostAction(<< _aNO_HALT_i, _aUSABLE_i, #SDoor_EW >>, _Avatar);
        }
    }
}
