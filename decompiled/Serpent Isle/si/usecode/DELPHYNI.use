Function ~DelphyniaHaggles_i accepts a0, a1 #locals(14) #uses(~LordOrLady, ~AskList, ~Haggle_i, ~AskYesNo) {
    v2 = ~LordOrLady();
    v3 = v1;
    v4 = ((v0 / 3) * 2);
    v5 = (15 - (~GetNPCID_i(_Delphynia) / 2));
    v6 = 0;
    v7 = 1;
