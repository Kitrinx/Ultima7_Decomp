                v15 = ~GetItemFlag_i(_Poisoned, v13);
                v16 = ~GetStat(_Str, v13);
                v17 = ~GetStat(_Hits, v13);
                v18 = ~GetNPCName_i(v13);
                if (v16 > v17) {
                    v19 = (v16 - v17);
                    v19 = (v19 / 2);
                    SetStat(v19, _Hits, v14);
                    v20 = ~TakeFromParty_i(true, _All, _All, v2, v7);
                    v5 = true;
                    ["I have done all that I can."];
                } else {
                    if (v15 = false) {
                        if (v14 = 65180) {
                            ["Thou art unwounded!"];
                        } else {
                            ["<v18> is not wounded!"];
                        }
                    } else {
                        if (v14 = 65180) {
                            ["Thou art poisoned! I believe that I can cure such a simple venom."];
                        } else {
                            ["<v18> is poisoned! Fortunately, 'tis a simple venom to cure."];
                        }
                    }
                }
                if (v15 = true) {
                    if (v5 = false) {
                        v20 = ~TakeFromParty_i(true, _All, _All, v2, v7);
                    }
                    ClearItemFlag_i(_Poisoned, v13);
                    ["'Tis done, <v0>! The poison hath been removed."];
                }
            } else {
                ["Perhaps another time, <v0>."];
            }
            goto label_41;
        }
        ["Since thou didst agree to take my letter, I will help thee, <v1>. I will perform mine healing for only 10 filari."];
        ["Whom dost thou wish to heal?"];
        v4 = true;
        goto label_14;
    }
    label_41:
}

