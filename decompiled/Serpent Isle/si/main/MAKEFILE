all_dos: $(DOS_OG) $(DOS_ASM)

all_mem: $(MEM_OG) $(MEM_OGP) $(MEM_OGPvi0) $(MEM_ASM)

all_overlay: $(OVERLAY_OGPvi0) $(OVERLAY_ASM)

all_palette: $(PALETTE_OG) $(PALETTE_OGP) $(PALETTE_ASM)

all_schedule: $(SCHEDULE_OG) $(SCHEDULE_OGP)

all_mainsound: $(MAINSOUND_ASM_M_W_ML)

all_video: $(VIDEO_OG) $(VIDEO_OGP) $(VIDEO_ASM)

all_xmm: $(XMM_OG) $(XMM_OGPvi0) $(XMM_OWN_OG) $(XMM_ASM) $(XMM_ASM_M2)

