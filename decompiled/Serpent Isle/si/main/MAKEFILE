#	SI.EXE, Ultima VII Part Two: Serpent Isle (with The Silver Seed)
#
#	Borland C++ 2.0 with its MAKE, and Turbo Assembler 2.51.  Run MAKE in
#	this directory, the build directory:
#
#		make			compiler in C:\BORLANDC
#		make -DBC=C:\BC20	compiler elsewhere
#
#	Each list of objects shares one set of options, which its name spells:
#	MAIN_OGPd is -O -G -P -d in this directory; b0 is -b-, vi0 is -vi-.
#	Written by .agents/tools/si_makefile.py from the sources and the trial link.

.autodepend

!if !$d(BC)
BC = C:\BORLANDC
!endif

CC = $(BC)\bcc +SI.CFG
AS = tasm

all: SI.CFG SUB.CFG SI.EXE

# Options every C module shares, one -I per folder (one long -I hangs BCC); the
# compiler's own headers come last.
SI.CFG: MAKEFILE
	copy &&|
-c -mm -y
-I..\common
-I..\inter
-I..\main
-I..\main\combat
-I..\main\mem
-I..\main\palette
-I..\main\schedule
-I..\main\sound
-I..\main\video
-I..\main\xmm
-I..\sound
-I..\zevent
-I..\include
-I$(BC)\include
| SI.CFG

# The same, for a source compiled inside a folder below main.
SUB.CFG: MAKEFILE
	copy &&|
-c -mm -y
-I..\..\common
-I..\..\inter
-I..\..\main
-I..\..\main\combat
-I..\..\main\mem
-I..\..\main\palette
-I..\..\main\schedule
-I..\..\main\sound
-I..\..\main\video
-I..\..\main\xmm
-I..\..\sound
-I..\..\zevent
-I..\..\include
-I$(BC)\include
| SUB.CFG

