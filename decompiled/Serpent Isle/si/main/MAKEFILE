	$(COMMON_OGPb0) $(COMMON_OGPd) $(COMMON_OGPdZ) $(COMMON_OGZ) \
	$(COMMON_OWN_OGP) $(COMMON_OWN_OGPZ) $(COMMON_OWN_OGPd) $(COMMON_ASM)

all_inter: $(INTER_OG) $(INTER_OGP) $(INTER_OP) $(INTER_OPY) $(INTER_OWN_OGP) \
	$(INTER_OWN_OGPY) $(INTER_OWN_OPY) $(INTER_OWN_OPd)

all_sound: $(SOUND_OGP) $(SOUND_OGPdb0) $(SOUND_OWN_OGP) $(SOUND_OWN_OGPdY) \
	$(SOUND_OWN_OGPdb0)

all_zevent: $(ZEVENT_OG) $(ZEVENT_OGP) $(ZEVENT_OGPY1) $(ZEVENT_OGPd) \
	$(ZEVENT_OWN_OGP) $(ZEVENT_ASM)

# MAKE limits the length of a rule line, so SI.EXE depends on one list per directory.
SI.EXE: all_main all_combat all_dos all_mem all_overlay all_palette \
	all_schedule all_mainsound all_video all_xmm all_common all_inter all_sound \
	all_zevent SI.LNK
	$(BC)\tlink /m /s /c /d /L$(BC)\lib @SI.LNK
