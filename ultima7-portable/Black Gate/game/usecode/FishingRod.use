        }
        if (v4 <> 0) && (~rndRange(10, 1) <= v4) {
            v3 = true;
        }
        if v3 {
            v8 = ~Item_create(_Food_Item);
            if v8 {
                SetFrame(12, v8);
                SetItemFlag_i(_OkayToTake_i, v8);
