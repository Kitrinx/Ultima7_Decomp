Routine ThadAccostsEgg_i accepts a0 #locals(0) #uses(BarkIfNear_i, Thad) {
    if (event = _Trigger) {
        if $JoinFellow {
            SetWorkType(_Combat_0, ~NPCToItem_i(_Thad));
            BarkIfNear_i("@Fellowship scum!@", _Thad);
        } else {
            Thad(~NPCToItem_i(_Thad));
        }
    }
}
