Routine WisSur accepts a0 #locals(2) #uses(WisSurSellsSpells_i, WisSurSellsReagents_i, WisSurSellsPotions_i, ~AskList, WisSurSellsSpells_i) {
    if (event = _Action) {
        SetSpeaker(0, _WisSur);
        TurnOn(<< "name", "job", "bye" >>);
        if $TetraGone {
            if not $MET_WISSUR {
                [You see a winged gargoyle with an authoritative disposition.];
                $MET_WISSUR = true;
            } else {
                ["To offer welcome for you, human," says Wis-Sur.];
            }
        } else {
            if not $MET_WISSUR {
                [The winged gargoyle in front of you has a wild look about him.];
                $MET_WISSUR = true;
            } else {
                ["To go away, human! To have nothing you want!" screams Wis-Sur.];
            }
        }
        if $TetraGone {
            converse {
                key ("name") {
                    ["To be named Wis-Sur, which means `wise sun.'"];
                    TurnOff("name");
                }
                key ("job") {
                    ["To sell magic to others."];
                    TurnOn(<< "others", "magic" >>);
                }
                key ("magic") {
                    ["To be interested in spells, reagents, or potions?"];
                    TurnOn(<< "spells", "reagents", "potions" >>);
                    TurnOff("magic");
                }
                key ("spells") {
                    WisSurSellsSpells_i#0();
                }
                key ("reagents") {
                    WisSurSellsReagents_i();
                }
                key ("potions") {
                    WisSurSellsPotions_i();
                }
                key ("others") {
                    ["To be familiar with only the other gargoyles in Vesper. To tell you to ask Ansikart, who knows all other gargoyles here. To tell you about one of the following?"];
                    TurnOff("others");
                    TurnOn(<< "Aurvidlem", "Lap-Lem", "For-Lem", "Anmanivas" >>);
                }
                key ("Aurvidlem") {
                    ["To be a provisioner in Vesper."];
                    TurnOff("Aurvidlem");
                }
                key ("For-Lem") {
                    ["To perform assorted duties for town. To be a good, strong worker."];
                    TurnOff("For-Lem");
                }
                key ("Lap-Lem") {
                    ["To be a miner for the Britannian Mining Company."];
                    TurnOff("Lap-Lem");
                }
                key ("Anmanivas") {
                    ["To be a miner for the Britannian Mining Company."];
                    TurnOff("Anmanivas");
                }
                key ("bye") {
                    break;
                }
            }
            clear_answers;
            ["To say farewell, human."*];
        } else {
            converse {
                key ("name") {
                    ["To wonder why you want to know."*];
                    terminate;
                }
                key ("job") {
                    ["To sell the few items I possess."];
                    TurnOn("sell");
                }
                key ("sell") {
                    ["To want to buy something?" He looks at you carefully, as if he is unsure whether to sell to you.~~"To be possible," he says, nodding. "To ask what you need?"];
                    v0 = << "nothing", "spells", "reagents", "potions" >>;
                    v1 = ~AskList(v0);
                    if (v1 = "nothing") {
                        ["To suspect you are wasting my time!"];
                    }
                    if (v1 = "spells") {
                        WisSurSellsSpells_i#4();
                    }
                    if (v1 = "reagents") {
                        WisSurSellsReagents_i();
                    }
                    if (v1 = "potions") {
                        WisSurSellsPotions_i();
                    }
                }
                key ("bye") {
                    ["To be good that you leave."*];
                    terminate;
                }
            }
            clear_answers;
        }
    }
    if (event = _Bark) {
        terminate;
    }
}

