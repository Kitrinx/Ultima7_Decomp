Routine Andrew accepts a0 #locals(13) #uses(~LordOrLady, ~AskYesNo, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Andrew);
        v0 = ~LordOrLady();
        v1 = ~GetTime();
        v2 = ~GetWorkType(~NPCToItem_i(_Andrew));
        v3 = false;
        TurnOn(<< "name", "job", "bye" >>);
        if $StolenVenom {
            TurnOn("thief");
        }
        if $VENOM_CASE_SOLVED {
            TurnOff("thief");
            TurnOn("theft solved");
        }
        if not $MetAndrew {
            [You see a cheerful, handsome young man who gives you a friendly wave as you approach.];
            $MetAndrew = true;
        } else {
            ["Greetings, <v0>," says Andrew.];
        }
        converse {
            key ("name") {
                ["My name is Andrew. How art thou, <v0>?"];
                TurnOff("name");
            }
            key ("job") {
                ["I am the owner and proprietor of the dairy here in Paws."];
                TurnOn(<< "dairy", "Paws" >>);
            }
            key ("dairy") {
                ["Yes, I sell milk and cheese. Thou mayest find the dairy between Camille's farm and the slaughterhouse."];
                TurnOff("dairy");
                TurnOn(<< "Camille", "slaughterhouse", "milk", "cheese" >>);
            }
            key ("milk") {
                if (v2 = 7) {
                    ["A gallon will cost thee 3 gold. Art thou interested in buying some?"];
                    if ~AskYesNo() {
                        loop {
                            v4 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, 3);
                        } while v4 {
                            v5 = ~GiveToParty_i(true, 7, _All, _Bottle, 1);
                            if v5 {
                                ["Here it is," he says, handing you the jug. "Wouldst thou like another?"*];
                                v6 = ~AskYesNo();
                                if v6 {
                                    continue;
                                } else {
                                    goto label_70;
                                }
                            } else {
                                ["Thou hast not the room for the jug."];
                                v7 = ~GiveToParty_i(true, _All, _All, _Gold_Coin, 3);
                            }
                            goto label_28;
                        }
                        ["Thou hast not the gold for this, <v0>. Perhaps some other time."];
                        label_28:
                    } else {
                        ["Perhaps next time, <v0>."];
                    }
                } else {
                    ["I would be more than happy to sell thee a jug of milk, but for now the dairy is closed."];
                }
                TurnOff("milk");
            }
            key ("cheese") {
                if (v2 = 7) {
                    ["I sell wedges for 2 gold each. Still interested?"];
                    if ~AskYesNo() {
                        ["How many dost thou want?"];
                        v8 = ~AskBarInput(1, 1, 20, 1);
                        v9 = (v8 * 2);
                        v10 = ~CountItem(_All, _All, _Gold_Coin, _Party);
                        if (v10 >= v9) {
                            v11 = ~GiveToParty_i(true, 27, _All, _Food_Item, v8);
                            if v11 {
                                ["Here it is."];
                                v12 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, v9);
                            } else {
                                ["Thou hast not the room for this cheese."];
                            }
                        } else {
                            ["Thou hast not the gold for this, <v0>. Perhaps something else."];
                        }
                    } else {
                        ["I understand, <v0>. Perhaps when thou dost become more hungry."];
                    }
                } else {
                    ["I would be more than happy to sell thee some cheese, but for now the dairy is closed."];
                }
                TurnOff("cheese");
            }
            key ("Camille") {
                ["Camille is a good woman. She is still an advocate of the old virtues. She runs the farm by herself. Well, with the help of her son, Tobias."];
                TurnOff("Camille");
                TurnOn("Tobias");
            }
            key ("Tobias") {
                ["A rather defensive young lad, I cannot say that I know that much about him."];
                TurnOff("Tobias");
            }
            key ("Paws") {
                ["Of course everyone is up in arms about this business concerning the missing venom."];
                TurnOff("Paws");
            }
            key ("venom") {
                ["It could be hidden anywhere. With all the trade that occurs in this town, it would be easy to hide. I do not know much else about the substance. Perhaps Morfin himself would know what kinds of effects it might produce."];
                TurnOff("venom");
            }
            key ("thief") {
                ["Be wary, for there is a thief in this town! Some silver serpent venom was stolen from Morfin."];
                $StolenVenom = true;
                TurnOff("thief");
                TurnOn("venom");
                if not v3 {
                    TurnOn("Morfin");
                }
            }
            key ("theft solved") {
                ["Thou hast put the people in our town at ease by finding the culprit!"];
                TurnOff("theft solved");
            }
            key ("slaughterhouse") {
                ["The slaughterhouse is run by Morfin, the merchant. He is always busy, coming and going at all hours, sometimes carrying things."];
                TurnOff("slaughterhouse");
                if not v3 {
                    TurnOn("Morfin");
                }
            }
            key ("Morfin") {
                ["He bought the slaughterhouse a few years ago, soon after he joined The Fellowship. I knew the previous owner."];
                TurnOff("Morfin");
                TurnOn("previous owner");
                v3 = true;
            }
            key ("previous owner") {
                ["I was just a lad when I first saw the old slaughterhouse. The old man who owned it even showed me the storeroom in there once. The door to it is locked. I think Morfin has the key somewhere in his house."];
                TurnOff("previous owner");
            }
            key ("bye") {
                break;
            }
        }
        label_70:
        clear_answers;
        ["I hope I was of some assistance to thee, <v0>."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Andrew);
    }
}
