Routine Tolemac accepts a0 #locals(4) #uses(~LordOrLady, ~IsNearEachOther_i, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Tolemac);
        v0 = ~LordOrLady();
        v1 = ~GetTime();
        TurnOn(<< "name", "job", "Fellowship", "bye" >>);
        if flag(469) {
            ["Get thee away! I'll hear no more of thy lies!"*];
            terminate;
        }
        if (v1 = 7) {
            v2 = ~IsNearEachOther_i(_Rankin, _Tolemac);
            if v2 {
                ["I am trying to pay attention!" he says, glaring at you.];
            } else {
                ["Sorry, <v0>, I cannot talk now. I must get to the Fellowship meeting!"];
            }
            terminate;
        }
        if not $MetTolemac {
            [You see a friendly-looking farmer.];
            $MetTolemac = true;
        } else {
            ["Good day, <v0>."];
        }
        if (flag(470) and $MetTolemac) {
            TurnOn("reconvert");
        }
        converse {
            key ("name") {
                ["I am called Tolemac, <v0>."];
                TurnOff("name");
                if flag(470) {
                    TurnOn("reconvert");
                }
            }
            key ("job") {
                ["I help my brother tend our farm here in Moonglow."];
                TurnOn(<< "brother", "Moonglow" >>);
            }
            key ("brother") {
                ["My brother is Cubolt." He frowns for a moment. "He can be a bit overbearing at times, trying to `take care' of me. But," he shrugs, "he means well, perhaps. I know I've caused him a bit of trouble every now and then," he says with a grin, "but he deserves it."];
                TurnOff("brother");
            }
            key ("Moonglow") {
                ["Yes, <v0>. That is the name of the town thou art in. Dost thou have questions about the townspeople?"];
                TurnOn("townspeople");
                TurnOff("Moonglow");
            }
            key ("townspeople") {
                ["I know only a few people here, <v0>. My brother, Cubolt, runs the farm with me. Morz helps us, too -- we've known him for many years. And now that I've joined The Fellowship, I've met a few more people. Rankin is branch head here in Moonglow, and Balayna is his assistant. If thou dost want to know about other people, thou mayest want to ask the bartender. His name is Phearcy."];
                TurnOn(<< "Morz", "Balayna", "Rankin", "Fellowship" >>);
                TurnOff("townspeople");
            }
            key ("Rankin") {
                ["Rankin is very intelligent. He is the one who persuaded me to join The Fellowship. I have much respect for him."];
                TurnOff("Rankin");
            }
            key ("Balayna") {
                ["She is the branch clerk. Most of the time, she is friendly. Sometimes, however, she seems a little cold."];
                TurnOff("Balayna");
            }
            key ("Morz") {
                ["Morz and I grew up together. He is very sensitive about his stutter, though, so I would not bring it up."];
                TurnOn("stutter");
                TurnOff("Morz");
            }
            key ("stutter") {
                ["It is difficult to get him to talk about it. I think it was caused by an accident he had when he was a child. I barely remember the incident. My brother might remember more."];
                TurnOff("stutter");
            }
            key ("Fellowship") {
                ["Rankin or Balayna would be the best ones to ask, <v0>, but I can tell thee our main tenets.~~"We believe strongly in neo-realism, which is a form of optimistic outlook which may be reached through the triad of inner strength.~~"I am hoping that soon I will be able to hear the    voice that comes with meeting one's higher potential.~~"Also, <v0>, The Fellowship sponsors many feasts and festivals. I strongly recommend that thou ask Rankin about joining."];
                TurnOff("Fellowship");
            }
            key ("reconvert") {
                ["Reconvert? Why would I want to do that? Did my brother request this? He has always had a problem with letting me make mine own decisions. Nay, <v0>. I will not abandon my beliefs. The Fellowship has done too much for my life."];
                v3 = ~IsMedallionOn_i();
                if v3 {
                    ["And to think thou art a fellow member. There is no unity in thy speech!"];
                }
                [*];
                flag(469) = true;
                terminate;
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["'Til next time, <v0>."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Tolemac);
    }
}
