Routine Carlyn accepts a0 #locals(5) #uses(~LordOrLady, CarlynSellsFood_i, CarlynSellsDrink_i, ~AskYesNo, CarlynSellsClothes_i, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Carlyn);
        v0 = ~LordOrLady();
        v1 = ~GetTime();
        v2 = false;
        TurnOn(<< "name", "job", "bye" >>);
        if not $MET_CARLYN {
            [At your approach, the woman raises her eyebrows to indicate she is aware of your presence and interested in what you are about to say.];
            $MET_CARLYN = true;
        } else {
            ["And how may I help thee, <v0>?" asks Carlyn.];
        }
        converse {
            key ("name") {
                ["I am Carlyn." She smiles broadly.];
                TurnOff("name");
            }
            key ("job") {
                ["I am the tailor of Moonglow."];
                if (v1 = 7) {
                    ["I also tend the bar for Phearcy in the evenings."];
                    TurnOn("buy refreshment");
                    if not v2 {
                        TurnOn("Phearcy");
                    }
                }
                TurnOn(<< "tailor", "Moonglow" >>);
            }
            key ("buy refreshment") {
                ["Wouldst thou prefer food or drink, <v0>?"];
                PushKeys();
                TurnOn(<< "food", "drink" >>);
                TurnOff("buy refreshment");
            }
            key ("food") {
                CarlynSellsFood_i();
                PopKeys();
                TurnOff("food");
            }
            key ("drink") {
                CarlynSellsDrink_i();
                PopKeys();
                TurnOff("drink");
            }
            key ("Phearcy") {
                if (v1 = 7) {
                    v3 = "here";
                } else {
                    v3 = "at the Friendly Knave";
                }
                ["He is the owner and bartender. Every night at 9, he goes to the Fellowship meetings, so I serve refreshment for him <v3>."];
                v2 = true;
                TurnOff("Phearcy");
                TurnOn("Fellowship");
            }
            key ("Moonglow") {
                ["'Tis a very pleasant town, <v0>. There are so many different types of people here. I wish I knew more of them.~~"If thou hast any questions about them, I highly recommend to thee that thou speakest with Phearcy."];
                if not v2 {
                    TurnOn("Phearcy");
                }
                TurnOff("Moonglow");
            }
            key ("Fellowship") {
                ["I know little about the group. Every night at 9 they have a meeting or some such of all the members. And, if I remember correctly, the leader of that branch doth give a speech -- a sermon is what I believe it is called.~~"There is another member in town, if thou hast questions about The Fellowship."];
                TurnOn(<< "another", "leader" >>);
                TurnOff("Fellowship");
            }
            key ("another") {
                ["I believe his name is Tolemac. He is a farmer, from what I have heard. Phearcy would know more than I. Or thou couldst ask their clerk."];
                TurnOn("clerk");
                TurnOff("another");
            }
            key ("clerk") {
                ["'Tis a woman, I know that, but I do not know her name."];
                TurnOff("clerk");
            }
            key ("leader") {
                ["His name is Rankin. I do not believe he has been here terribly long."];
                TurnOff("leader");
            }
            key ("tailor") {
                if ((v1 = 3) or ((v1 = 4) or ((v1 = 5) or (v1 = 6)))) {
                    ["Yes, I love sewing clothing. Wouldst thou be interested in seeing or purchasing some of my creations?"];
                    v4 = ~AskYesNo();
                    if v4 {
                        CarlynSellsClothes_i();
                    } else {
                        [Shock covers her face.~~"Well," she huffs.];
                    }
                } else {
                    ["Yes, <v0>. 'Tis my job, and my passion. I love sewing clothing. If thou were to come to my shop when it was open, I could show thee many exquisite things."];
                }
                TurnOff("tailor");
            }
            key ("bye") {
                ["Fare thee well, <v0>."*];
                terminate;
            }
        }
        clear_answers;
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Carlyn);
    }
}

