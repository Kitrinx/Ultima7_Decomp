Usable EmpWantsHoney_i #locals(2) #uses(~AskYesNo, GivePartyExp_i) {
    SetSpeaker(0, _MrEd);
    if not flag(340) {
        [The ape-like creature slowly and cautiously walks up to you. He, or she, sniffs for a moment, and then points to the honey you are carrying.];
    }
    TurnOn(<< "Want honey?", "Go away!" >>);
    converse {
        key ("Want honey?") {
            ["Honey will be given by you to me?"];
            v0 = ~AskYesNo();
            if v0 {
                v1 = ~TakeFromParty_i(true, _All, _All, _Honey, 1);
                ["You are thanked."];
                if not flag(340) {
                    GivePartyExp_i(10);
                    flag(340) = true;
                }
            } else {
                if flag(340) {
                    [The Emp appears very disappointed."];
                } else {
                    ["`Goodbye' is said to you."*];
                    terminate;
                }
            }
        }
        key ("Go away!") {
            [It does.*];
            terminate;
        }
        TurnOff(<< "Want honey?", "Go away!" >>);
    }
    clear_answers;
}
