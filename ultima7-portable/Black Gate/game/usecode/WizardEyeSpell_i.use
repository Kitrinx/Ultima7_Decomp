Routine WizardEyeSpell_i accepts a0 #locals(2) #uses(~IsMagicOK_i) {
    if (event = _Action) {
        Item_bark("@Por Ort Wis@", item);
        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aUP_FRAME_i, _aSFX_i, 67, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #WizardEyeSpell_i >>, item);
        } else {
            v0 = ~PostAction(<< _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        v1 = ~GetCoord(item);
        WizardEye_i(200, 45);
    }
}
