Routine Martingo accepts a0 #locals(10) #uses(~AvatarName, ~AskList, ~AskYesNo, ~IsNPCNear, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Martingo);
        v0 = ~AvatarSex();
        v1 = ~AvatarName();
        TurnOn(<< "name", "job", "bye" >>);
        if flag(571) {
            TurnOn(<< "Ethereal Ring" >>);
        }
        if not flag(598) {
            [You see a nobleman, all alone, with a demented gleam in his eye.~~"Who in blazes art thou?" the man asks. His attitude is that of someone who was just interrupted from something terribly important.];
            v2 = ~AskList(<< v1, "I am the Avatar" >>);
            if (v2 = v1) {
                [Martingo shakes your hand but acts thoroughly disinterested. "I'm thrilled."];
                [He turns to his right and speaks to no one.];
                ["What? Oh, really! I do not think <v1> looks particularly brainless. We shall have to see, shall we not?"];
                [He turns back to you and grins.];
            } else {
                ["Of course thou art! And I am the evil spirit of Mondain, come back to wreak havoc over all Britannia. Funny, thou dost not look like an Avatar -- thou dost look like a fool.];
                if v0 {
                    ["What can I do for thee, Miss Fool?"];
                } else {
                    ["What can I do for thee, Mr. Fool?"];
                }
                [He turns to his right and speaks to no one.];
                ["What? Oh, really! Thou dost think this Avatar looks like the real thing? I doubt it, Lucinda. I doubt it very much."];
                [He turns back to you and grins.];
            }
            flag(598) = true;
        } else {
            ["What'chu want?" Martingo asks, belligerently.];
        }
        converse {
            key ("name") {
                [The nobleman looks at you with impatience. "I am Martingo, the Sultan of Spektran. Is that all right with thee?" He rolls his eyes. He turns to his right side and whispers again to an imaginary person, "I believe we have an ignoramus on our hands."];
                TurnOff("name");
            }
            key ("job") {
                ["I am the Sultan of Spektran! What, is thy brain the size of a pea? Do not answer, 'twas a rhetorical question."];
                if v0 {
                    [He turns to his left side and whispers to no one, "Dost thou not think her brain is the size of a pea? I do!" He giggles conspiratorially with his invisible friend.];
                } else {
                    [He turns to his left side and whispers again to an imaginary person, "Dost thou not think his brain is the\x09size of a pea? I do!" He giggles conspiratorially with his invisible friend.];
                }
                [Martingo then pulls out a banana and begins to peel it.];
                TurnOn(<< "Sultan", "Spektran", "banana" >>);
            }
            key ("Sultan") {
                ["Come on, do not insult mine intelligence. Surely thou dost know what a Sultan is! Canst not thou see mine harem?"];
                v3 = ~AskYesNo();
                if v3 {
                    ["Lovely, are they not?];
                } else {
                    [Martingo looks bewildered. "Then thou must have thine eyes examined! I am surrounded by ten..." He looks around quickly. "No, -eleven- beautiful women!];
                }
                ["Each day I enjoy a different one. Thou canst not imagine how much fun being a Sultan really is!" He leans over and kisses an invisible cheek. "Today, I am enjoying Lucinda." He grins broadly.];
                TurnOn("Lucinda");
                if v0 {
                    [Martingo looks you up and down lecherously. "Hmmm. Wouldst thou like to join mine harem?"];
                    v4 = ~AskYesNo();
                    if v4 {
                        [Your answer takes Martingo by surprise. "Thou wouldst?" He looks around nervously. "Oh, uhm, I had better consult mine astrologer about this matter. I shall get back to thee, all right?"];
                    } else {
                        ["Pity."];
                    }
                }
                TurnOff("Sultan");
            }
            key ("Spektran") {
                ["'Tis the island thou dost stand upon!" He turns to the invisible person on his left and whispers, "Thou art correct -- this person really is a fool!" ~~Martingo turns back to you. "As I said, I am the Sultan here. I am the master of all of these subjects." He gestures\x09around the room.];
                v5 = ~IsNPCNear(_Iolo);
                if v5 {
                    SetSpeaker(0, _Iolo);
                    [Iolo whispers to you. "This fellow is quite daft. Be careful."];
                    CloseSpeaker(_Iolo);
                    SetSpeaker(0, _Martingo);
                }
                TurnOff("Spektran");
            }
            key ("Lucinda") {
                ["She is beautiful, is she not?" Martingo leans over and sticks his tongue in an ear that isn't there.];
                TurnOff("Lucinda");
            }
            key ("banana") {
                if not flag(600) {
                    ["Oh, forgive my manners! Wouldst thou like a banana?"];
                    v6 = ~AskYesNo();
                    if v6 {
                        ["Well, it shall cost thee 3 gold coins. Still want one?"];
                        v7 = ~AskYesNo();
                        if v7 {
                            v8 = ~CountItem(_All, _All, _Gold_Coin, _Party);
                            if (v8 >= 3) {
                                v9 = ~GiveToParty_i(true, 17, _All, _Food_Item, 1);
                                if v9 {
                                    ["Here thou art." Martingo hands you a banana and takes your gold. He turns to 'Lucinda' and whispers, "That rotter took my last banana!"];
                                    flag(600) = true;
                                } else {
                                    ["Thou dost have wheat for brains! Thou hast not room for a single banana!"];
                                }
                            } else {
                                ["Broke, art thou? Too bad." Martingo sniffs. "Well, I am very rich, I must say."];
                            }
                        } else {
                            ["That's a relief. I only had one left."];
                        }
                    } else {
                        ["That's a relief. I only had one left."];
                    }
                } else {
                    ["I already sold thee my last banana!"];
                }
                TurnOff("banana");
            }
            key ("Ethereal Ring") {
                [Martingo looks suspicious. "Art thou wanting to steal mine Ethereal Ring?" He turns to his imaginary friend and whispers, "Thou wert right. Our guest looks like a thief." He turns back to you and smiles. "Yes, I do have an Ethereal Ring. I purchased it from the King of the Gargoyles. What was his name?" He leans toward the invisible companion on his right. "What? Oh yes, Draxinusom. I knew it all the time." He turns back to you. "It is in my vault."];
                TurnOff("Ethereal Ring");
                TurnOn("vault");
            }
            key ("vault") {
                [Martingo's eyes light up. "My vault is the most protected vault in all Britannia. No one, and I repeat, -no one- can steal anything from my vault. I have many fine treasures there." He turns to 'Lucinda' and bites an nonexistent ear lobe.];
                TurnOff("vault");
                TurnOn(<< "treasures", "protected" >>);
            }
            key ("treasures") {
                ["I collect magical items. The vault is full of them. Including this ring thou dost mention."];
                TurnOff("treasures");
            }
            key ("protected") {
                ["The vault's security is my secret. Feel free to try and enter it. In fact, I dare thee! If thou canst succeed in getting inside, thou art welcome to take anything!" Martingo laughs. "All thou dost need is the key!" He laughs with his imaginary harem, as if they were all laughing with him. "I'm sure thou wilt find it!" He breaks up, laughing so hard that tears begin to fall down his cheeks.];
                TurnOff("protected");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["Fine. Go away. It shall do thee good!"*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Martingo);
    }
}
