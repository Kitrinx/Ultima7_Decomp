Routine Constance accepts a0 #locals(7) #uses(~LordOrLady, ~IsNPCNear, ~AskYesNo, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Constance);
        v0 = ~LordOrLady();
        v1 = ~IsNPCNear(_Shamino);
        v2 = ~IsNPCNear(_Iolo);
        v3 = ~IsNPCNear(_Dupre);
        v4 = ~IsNPCNear(_Spark);
        v5 = ~IsNPCNear(_Henry);
        TurnOn(<< "name", "job", "bye" >>);
        if flag(384) {
            TurnOn("strangers");
        }
        if flag(388) {
            TurnOn("scoundrels");
        }
        if flag(461) {
            TurnOn("locket found");
        }
        if not $MetConstance {
            [You see an angelic young woman who gives you a smile of complete innocence.];
            $MetConstance = true;
        } else {
            ["<v0>!" says a wide-eyed Constance, "What may I do for thee?"];
        }
        converse {
            key ("name") {
                ["My name, <v0>, is Constance." She shyly lowers her eyes.];
                TurnOff("name");
            }
            key ("job") {
                ["I carry water from the well of humility to all of the homes here in New Magincia."];
                TurnOn(<< "well of humility", "New Magincia" >>);
            }
            key ("well of humility") {
                ["The water from the well is pure and cool. If thou wouldst like I will pour thee some."];
                v6 = ~AskYesNo();
                if v6 {
                    [With a big smile Constance takes a\x09dipper and submerges it in the cool water of her bucket. She draws out the dipper and hands it to you. You drink and find the water delicious and very refreshing.];
                    if v2 {
                        SetSpeaker(0, _Iolo);
                        ["Actually, I feel quite parched myself. Might I have some as well?" Constance nods yes, and hands him a\x09dipper of water. He drinks with loud gulping sounds.*];
                        CloseSpeaker(_Iolo);
                        SetSpeaker(0, _Constance);
                    }
                    if v1 {
                        SetSpeaker(0, _Shamino);
                        ["I, too, am feeling dry. Wouldst thou share thy water with me, milady?" Constance fills the dipper with water for Shamino and he drinks until water runs down his chin.*];
                        CloseSpeaker(_Shamino);
                        SetSpeaker(0, _Constance);
                    }
                    if v3 && v1 {
                        SetSpeaker(0, _Shamino);
                        [You see Shamino nudge Dupre. "Art thou not going to have a drink?"];
                        CloseSpeaker(_Shamino);
                        SetSpeaker(0, _Dupre);
                        ["I shall wait until we find something a bit stronger than water to quench my thirst."*];
                        CloseSpeaker(_Dupre);
                        SetSpeaker(0, _Constance);
                    }
                    if v4 {
                        SetSpeaker(0, _Spark);
                        [Constance hands Spark a dipper full of water. He drinks it down in one long slurp. Upon finishing it, he burps. With an\x09embarrassed grin he bows\x09apologetically to Constance\x09as he hands her back the dipper.];
                        CloseSpeaker(_Spark);
                        SetSpeaker(0, _Constance);
                    }
                } else {
                    ["If thou wouldst ever change thy mind thou needest only let me know."];
                }
                TurnOff("well of humility");
            }
            key ("strangers") {
                ["There are three strangers on the island! They have been shipwrecked here! I have met them. Their leader's name is Robin."];
                TurnOn("Robin");
                TurnOff("strangers");
                flag(384) = true;
            }
            key ("New Magincia") {
                ["I was born in New Magincia and I have lived here mine entire life. But now I wish to leave for mine heart hath been broken."];
                TurnOff("New Magincia");
                TurnOn("heart");
            }
            key ("heart") {
                if not flag(388) {
                    ["Once I was in love with Henry, the peddler, but then I learned he is a liar and a cad. Perhaps soon mine heart shall belong to another."];
                    TurnOn("another");
                } else {
                    [You tell Constance of Robin's plans for her. She gives you a shocked look. "Many thanks. I now know that my rightful place is with Henry."];
                }
                TurnOff("heart");
            }
            key ("locket found") {
                [You tell Constance of how you have returned the locket that has been stolen from Henry. "Oh, how could I ever have doubted my dear darling Henry?" she frowns. "I thank thee for telling me the truth."];
                if v5 {
                    SetSpeaker(0, _Henry);
                    ["Constance, I am sorry that things ran afoul as they did, but if thou wilt, I would like thee to have this locket as a symbol of my love."*];
                    SetSpeaker(0, _Constance);
                    ["My sweet Henry, mine heart belongs to only thee."*];
                    CloseSpeaker(_Henry);
                    SetSpeaker(0, _Constance);
                }
                TurnOff("locket found");
            }
            key ("another") {
                ["There is a charming and mysterious stranger on the island named Robin. He says one day he may show me the world and buy me many fine things." Constance sighs. "He even gave me some lovely flowers."];
                TurnOff("another");
                TurnOn("Robin");
            }
            key ("Robin") {
                ["He is a wealthy man and his two friends are big, strong men. They have been telling me about a very wonderful-sounding place called Buccaneer's Den."];
                TurnOff("Robin");
                TurnOn(<< "friends", "Buccaneer's Den" >>);
            }
            key ("friends") {
                ["Their names were Battles and Leavell. Both of them treated me like proper gentlemen."];
                TurnOff("friends");
                TurnOn(<< "Battles", "Leavell" >>);
            }
            key ("Buccaneer's Den") {
                ["Buccaneer's Den must be a wonderland. There is a spinning wheel that gives thee money! Canst thou imagine! And opulent, luxurious baths."];
                TurnOff("Buccaneer's Den");
                TurnOn(<< "spinning wheel", "baths" >>);
            }
            key ("Battles") {
                ["Battles was quiet at first. I thought he was mean-looking, but he is nice once thou dost get to know him. He told me of the various monsters he fought, and exciting stories of how he raided ships in the south seas."];
                TurnOff("Battles");
            }
            key ("Leavell") {
                ["Leavell was charming and witty. He can always make me laugh."];
                TurnOff("Leavell");
            }
            key ("spinning wheel") {
                ["Well, they certainly have nothing like that in New Magincia. I had never even heard of such a thing before!"];
                TurnOff("spinning wheel");
            }
            key ("baths") {
                ["Doth that not sound nice?"];
                TurnOff("baths");
            }
            key ("scoundrels") {
                [You gently explain to Constance that Robin, Battles and Leavell were scoundrels with intent to do her great harm. She is quite alarmed. Then you explain that they will not be troubling her anymore. She thanks you.];
                TurnOff("scoundrels");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["It was a pleasure speaking with thee, <v0>."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Constance);
    }
}
