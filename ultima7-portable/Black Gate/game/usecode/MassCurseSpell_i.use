Routine MassCurseSpell_i accepts a0 #locals(8) #uses(~IsMagicOK_i, ~EnemyList_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        Item_bark("@Vas Des Sanct@", item);
        if ~IsMagicOK_i() {
            v0 = ~GetCoord(item);
            createSprite(65535, 0, 0, 0, (v0::2 - 2), (v0::1 - 2), 7);
            v1 = ~PostAction(<< _aUP_FRAME_i, _aSFX_i, 65, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i >>, item);
            v2 = 30;
            v3 = ~EnemyList_i(v2);
            v4 = ~GetParty();
            v4 = (v4 & 65180);
            Foreach v7 in v3 {
                if not (v7 in v4) && not (~rndRange(3, 1) = 1) {
                    v2 = ~GetDist(v7, item);
                    v2 = ((v2 / 3) + 5);
                    v1 = ~PostInFuture(v2, << _aNO_HALT_i, _aUSABLE_i, #MassCurseSpell_i >>, v7);
                }
            }
        } else {
            v1 = ~PostAction(<< _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        SetItemFlag_i(_Cursed, item);
    }
}
