Routine DetectTrapSpell_i accepts a0 #locals(13) #uses(~IsMagicOK_i, ~NPCLevel_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        Item_bark("@Wis Jux@", item);
        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aSFX_i, 66, _aRAISE1_FRAME_i, _aTHRUST1_FRAME_i >>, item);
            v1 = ~NPCLevel_i(_Avatar);
            v2 = (21 + v1);
            v3 = ~FindNearby_i(176, v2, _Trap, item);
            Foreach v6 in v3 {
                v0 = ~PostInFuture(5, << _aNO_HALT_i, _aUSABLE_i, #DetectTrapSpell_i >>, v6);
            }
            v7 = ~FindNearby_i(176, v2, _Chest, item);
            v8 = ~FindNearby_i(176, v2, _Locked_Chest, item);
            v9 = (v7 & v8);
            Foreach v6 in v9 {
                if (~GetQuality(v6) = 255) {
                    v0 = ~PostInFuture(5, << _aNO_HALT_i, _aUSABLE_i, #DetectTrapSpell_i >>, v6);
                }
            }
        } else {
            v0 = ~PostAction(<< _aRAISE1_FRAME_i, _aTHRUST1_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        v12 = ~GetCoord(item);
        createSprite(65535, 0, 0, 0, v12::2, v12::1, 16);
