Routine Jakher accepts a0 #locals(5) #uses(~LordOrLady, ~AskYesNo, JakherTrains_i, ~IsNPCNear, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Jakher);
        v0 = ~LordOrLady();
        v1 = ~GetTime();
        v2 = ~GetWorkType(~NPCToItem_i(_Jakher));
        TurnOn(<< "name", "job", "bye" >>);
        if flag(246) {
            TurnOn("cute");
        }
        if not $MetJakher {
            [You see a stern but friendly-looking man, dressed in a military fashion. As you watch him, you get the feeling he is sizing you up as well.];
            $MetJakher = true;
        } else {
            ["How may I be of service to thee?" says Jakher.];
        }
        converse {
            key ("name") {
                ["I am Jakher, named after a great general from the ancient times of Sosaria. Welcome to Minoc."];
                TurnOff("name");
                TurnOn("Minoc");
            }
            key ("job") {
                if $LEARNED_ABOUT_MINOC_MURDER {
                    ["Along with Karenna, I am a trainer in the fighting arts. My specialty is strength and strategy. On the field of battle, if one does not use his head while using one's muscles, he is in danger of losing it."];
                    TurnOn(<< "Karenna", "trainer" >>);
                } else {
                    ["Perhaps that is something of which we should speak in a more appropriate time. Right now our concern should be to discover who could have been responsible for the two murders\x09that have just been discovered in William's sawmill."];
                    $LEARNED_ABOUT_MINOC_MURDER = true;
                    TurnOn("murders");
                }
            }
            key ("trainer") {
                if (v2 = 27) {
                    ["My price is 20 gold for each training session. Art thou still interested?"];
                    if ~AskYesNo() {
                        JakherTrains_i(20, << 2, 0 >>);
                    } else {
                        ["The true value of what I teach is beyond measure. My time is precious to me and therefore valuable. If thou didst pay me a paltry sum and I trained thee anyway, it would be an insult to us both.];
                        ["'Tis a pity few truly comprehend the value of strategy and tactics. Thou mayest hack and slash with thy sword all that thou wilt, but it cannot do thy thinking for thee."];
                    }
                } else {
                    ["I am not in the habit of running training sessions at this particular time."];
                    TurnOff("trainer");
                }
            }
            key ("Minoc") {
                ["Ours is a city of commerce, although lately its primary trade seems to be gossip and envy. Before these murders, the latest local scandal had been the statue to be built of Owen, the shipwright."];
                TurnOff("Minoc");
                TurnOn(<< "murders", "Owen" >>);
            }
            key ("murders") {
                ["I suspect the killer -- or killers -- are from out of town, and probably long gone by now. There has not been a local murder for\x09some time before today. Our fair measure of prosperity has made the people here mostly tolerant of each other. That is why the gypsies settled here. The apparent lack of motive is puzzling."];
                TurnOff("murders");
                TurnOn(<< "gone", "gypsies" >>);
            }
            key ("gone") {
                ["I doubt that anyone in our community is the killer. If the stranger, or strangers, involved were to remain for long after the crime, they would soon be revealed. Therefore,the killers are no longer in town."];
                TurnOff("gone");
            }
            key ("Karenna") {
                ["A skillful and fierce battler, but a bit short-sighted when it comes to tactics, I'm afraid. Still, a woman as attractive as\x09she is diverting enough when encountered. But do not mention to her that I said that. It would just encourage her. It is uncomfortable enough sharing the same roof with her as it is."];
                v3 = ~IsNPCNear(_Karenna);
                if v3 {
                    SetSpeaker(0, _Karenna);
                    ["What art thou whispering about over there?"*];
                    SetSpeaker(0, _Jakher);
                    ["Nothing! Nothing at all!" Jakher winks at you.*];
                    CloseSpeaker(_Karenna);
                    SetSpeaker(0, _Jakher);
                }
                TurnOff("Karenna");
                v4 = true;
                TurnOn(<< "short-sighted", "roof" >>);
            }
            key ("short-sighted") {
                ["She is the sort of person who labors under the belief that all problems can be solved in one of three ways. Hit them harder. Hit them faster. Or, hit them some more."];
                v3 = ~IsNPCNear(_Karenna);
                if v3 {
                    SetSpeaker(0, _Karenna);
                    ["Art thou talking about me? I feel mine ears burning!"*];
                    SetSpeaker(0, _Jakher);
                    ["Thou art dreaming, Karenna. Why would I talk about thee?" He giggles conspiratorially at you.*];
                    CloseSpeaker(_Karenna);
                    SetSpeaker(0, _Jakher);
                }
                TurnOff("short-sighted");
            }
            key ("roof") {
                ["There used to be two training halls in Minoc but one of them burned down after being struck by lightning. Now we are both forced to share this one."];
                TurnOff("roof");
            }
            key ("cute") {
                ["Ah, so Karenna said I was cute, did she? Yes, I have known she has had her sights set on me for years."];
                TurnOff("cute");
            }
            key ("Owen") {
                ["I have known Owen as long as anyone in this town. Several years ago, three ships that he built sank. The brother of Karl, one of our more colorful local residents, was killed. No investigation was ever made into the cause of the sinkings, but Owen once confided to me that he secretly blamed himself. He started drinking heavily, and eventually took up with The Fellowship."];
                TurnOff("Owen");
                flag(248) = true;
            }
            key ("gypsies") {
                ["Thou wouldst do better to ask Karenna. She is a good friend of the gypsies and would know more about them than I."];
                TurnOff("gypsies");
                flag(244) = true;
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["It has been a pleasure speaking with thee."*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Jakher);
    }
}

Routine JakherTrains_i accepts a0, a1 #locals(9) #uses(~GetStudent, ~GetNPCName, ~AvatarName, ~CanTrain, ~GetStat, IntTrain_i, StrTrain) {
    v2 = ~GetStudent();
    v3 = ~GetNPCName(v2);
    v4 = ~AvatarName();
    if (v3 = v4) {
        v3 = "you";
    }
    if (v2 = 0) {
    } else {
        v5 = 2;
        v6 = ~CanTrain(v5, v2, v0, v1);
        if (v6 = 0) {
            [Jakher looks into your eyes, sizing you up intellectually. "Thou dost need to learn more on the field of battle. If we spoke now I would be wasting my breath. Thou wouldst not understand a word I said."];
        } else {
            if (v6 = 1) {
                v7 = ~CountItem(_All, _All, _Gold_Coin, _Party);
                [You gather your gold and count it, finding that you have <v7> gold altogether.];
                if (v7 < v0) {
                    ["Thou dost not seem to have as much gold as I require to train here. Mayhaps at another time, when thy fortunes are more prosperous..."];
                    goto label_15;
                }
            }
            if (v6 = 2) {
                ["Thou art already well-versed in the tactics of the battlefield. I am afraid that I am unable to train thee further in this."];
            } else {
                v8 = ~TakeFromParty_i(true, _All, _All, _Gold_Coin, v0);
                [You pay <v0> gold, and the training session begins.];
                [Jakher's eyes glow bright as he begins to explain some of the strategies used by great military leaders in awesome battles fought in ages past. He whispers to <v3> conspiratorially as he draws maps in the dirt. After some time, <v3> can practically feel some of his shrewdness starting to be absorbed.];
                v9 = ~GetStat(_Int, v2);
                v10 = ~GetStat(_Str, v2);
                if (v9 < 30) {
                    IntTrain_i(1, v2);
                }
                if (v10 < 30) {
                    StrTrain(1, v2);
                }
            }
        }
    }
    label_15:
    ["I look forward to thy return."];
}
