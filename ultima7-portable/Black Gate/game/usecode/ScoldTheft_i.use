Routine ScoldTheft_i accepts a0 #locals(2) #uses(PlaySpeechOrText_i, MemberBarks_i) {
    if (event = _Action) {
        v0 = ~ListSize_i(~GetParty());
        v1 = ~rndRange(4, 1);
        if (v1 = 1) {
            PlaySpeechOrText_i(27);
        }
        if (v0 = 1) {
            return;
        }
        if (v1 = 2) {
            MemberBarks_i("@Must we do this?@");
        }
        if (v1 = 3) {
            MemberBarks_i("@Is that virtuous?@");
        }
        if (v1 = 4) {
            MemberBarks_i("@Avatar?!@");
        }
    }
}
