Routine Dog accepts a0 #locals(1) {
    if (event = _Action) {
        Item_bark("@Good doggy.@", _Avatar);
        SetWorkType(_Hound, item);
    }
    if (event = _Bark) {
        v0 = ~rndRange(2, 1);
        if (v0 = 1) {
            Item_bark("@Arf@", item);
        }
        if (v0 = 2) {
            Item_bark("@Bark@", item);
        }
    }
}
