Routine FireworksSpell_i accepts a0 #locals(2) #uses(~IsMagicOK_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        Item_bark("@Bet Ort@", item);
        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aOUT_FRAME_i, _aUP_FRAME_i, _aSFX_i, 36, _aUSABLE_i, #FireworksSpell_i >>, item);
        } else {
            v0 = ~PostAction(<< _aOUT_FRAME_i, _aUP_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        v1 = ~GetCoord(item);
        createSprite(65535, 0, 0, 0, (v1::2 - 2), (v1::1 - 2), 12);
    }
}
