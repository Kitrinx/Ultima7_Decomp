Routine Nastassia accepts a0 #locals(9) #uses(~AvatarName, ~AskYesNo, GivePartyExp_i) {
    if (event = _Bark) {
        terminate;
    }
    if (event = _Action) {
        v0 = ~PostAction(<< _aNO_HALT_i, _aMUSIC_i, 26, 1, _aCONTINUE_i, _aUSABLE_i, #Nastassia, _aBREAK >>, item);
        return;
    }
    SetSpeaker(0, _Nastassia);
    v1 = false;
    v2 = false;
    v3 = false;
    v4 = ~AvatarSex();
    v5 = ~AvatarName();
    TurnOn(<< "name", "job", "bye" >>);
    if flag(224) && not flag(226) {
        TurnOn(<< "Ariana", "Julius", "Nadia", "Yew" >>);
    }
    if flag(297) {
        TurnOn("News of your father");
    }
    if not v4 && flag(230) {
        TurnOn("kiss");
    }
    if not flag(232) {
        if v4 {
            [This is an attractive young woman who seems sad.];
        } else {
            [Emotion immediately grips your heart to see such a beautiful young woman seem so sad.];
            [She looks up as you introduce yourself.];
        }
        flag(232) = true;
    } else {
        ["Hello again, <v5>!" Nastassia says.];
    }
    converse {
        key ("name") {
            ["I am Nastassia."];
            TurnOff("name");
        }
        key ("job") {
            [She thinks a moment. "I suppose my job is to keep the Shrine of Compassion pristine, though it is not an official position."];
            TurnOn("Shrine");
        }
        key ("Shrine") {
            ["The Shrine of Compassion has been here for many generations, as have all the shrines in Britannia. My great-great-grandmother Ariana made a request in her will that her family line take care of this particular shrine."];
            TurnOn(<< "all shrines", "take care" >>);
            TurnOff("Shrine");
        }
        key ("all shrines") {
            ["Many of the shrines have fallen into disuse or have been overgrown to the point of being lost. It is sad."];
            TurnOff("all shrines");
        }
        key ("take care") {
            ["I am afraid that thou mightest find the other shrines in poor condition. I keep this one... well, nice. And I do it not only to keep alive my great-great-grandmother's tradition, but... for other reasons, too."];
            TurnOff("take care");
            TurnOn(<< "tradition", "reasons" >>);
        }
        key ("tradition") {
            ["Some people may think it odd that a young person would cling to the old ways so. But it is something that gives me great comfort. It gives me the feeling that there is something in this world that I belong to."];
            TurnOff("tradition");
        }
        key ("reasons") {
            if not flag(224) {
                ["I... I'd rather not say. Please do not ask."];
            } else {
                ["Thou dost know the reasons."];
            }
            TurnOff("reasons");
        }
        key ("Ariana") {
            if v4 {
                v6 = "she";
            } else {
                v6 = "he";
            }
            ["Yes, she was my great-great-grandmother. I understand that she actually met the Avatar and <v6> made a profound impact on her life.~~"It is odd, but thou dost resemble the portraits I have seen of the Avatar."];
            TurnOff("Ariana");
            TurnOn("I am the Avatar");
        }
        key ("Julius") {
            ["Thou dost know of my father? I suppose the townsfolk have been talking again. I wish I had known him. There is something within me that yearns for some news of him. Anything at all."];
            TurnOff("Julius");
            flag(225) = true;
        }
        key ("Nadia") {
            ["My mother. She died horribly, and by her own hand. That is the true reason I pay homage to this Shrine. I hope someday to provide her with the means to rest in peace."];
            TurnOff("Nadia");
        }
        key ("Yew") {
            ["My father died in the Great Forest there. Some wild animal or something killed him. Art thou perhaps travelling to Yew?"];
            v7 = ~AskYesNo();
            if v7 {
                ["Oh, <v5>, I do wish thou wouldst try to find out something about my father. How did he die? What happened? Please! Wilt thou search for the truth and come back and tell me?"];
                v8 = ~AskYesNo();
                if v8 {
                    ["Bless thee! I shall be waiting here for thee."];
                    if v4 {
                        ["I know we have a strong kinship now. We shall be like sisters."];
                    } else {
                        [Unexpectedly, Nastassia pulls your head down to hers and kisses you on the mouth.];
                        TurnOn("kiss");
                    }
                    flag(226) = true;
                } else {
                    [Nastassia turns away and looks as if she might cry. "Very well. Please leave me alone."*];
                    v0 = ~PostAction(<< _aNO_HALT_i, _aMUSIC_i, 26, 0 >>, item);
                    terminate;
                }
            } else {
                ["No? Well, let me know if thou art in the future. Perhaps thou couldst help me."];
            }
            TurnOff("Yew");
        }
        key ("kiss") {
            if (flag(230) and v3) {
                [You kiss Nastassia and she moans.];
            }
            if (flag(230) and not v3) {
                [The two of you rush into each other's arms and your mouths meet. You had forgotten how good her lips felt against yours.];
                v3 = true;
            }
            if not (flag(230) and not v1) {
                [You kiss Nastassia's lovely mouth again. She responds.~~"No man hath done that as well as thee."~~ She looks at you with wide eyes.~~"Do it again, milord."];
                v1 = true;
                TurnOff("kiss");
                TurnOn("kiss again");
            }
        }
        key ("kiss again") {
            if not v2 {
                [You kiss Nastassia yet again. This time your bodies press together tightly, and you know this promises to be more than a fleeting fling with some tavern wench.];
                v2 = true;
                flag(230) = true;
            } else {
                [You kiss Nastassia and she moans.];
            }
        }
        key ("I am the Avatar") {
            [Nastassia studies your features.~~"Somehow I knew it. It hath been said that thou wouldst return."];
            TurnOff("I am the Avatar");
        }
        key ("News of your father") {
            [You tell Nastassia what you learned from Trellek. She closes her eyes and it seems a great weight has lifted from her shoulders.~~The woman raises her arms to the sky and cries out, "Didst thou hear that, mother? Thine husband was only trying to provide for his family! And he died... a hero! He was not a vagabond! Dost thou hear? Thou canst rest thy tortured soul now. Please, mother, forgive him. Do so, so that I can now forgive thee."~~She wipes the tears from her face and looks at you.];
            if v4 {
                ["I thank thee, <v5>. Thou hast made me very happy. I shall always remember thee."];
            } else {
                [She kisses you once lightly. "Thank thee, <v5>. Thou hast made me very happy. Shouldst thou become weary of adventuring, I shall be waiting here for thee. Thou art welcome to live and share thy life with me. Go now. Finish the job thou must needs do. But keep me in thy thoughts."];
            }
            GivePartyExp_i(50);
            TurnOff("News of your father");
        }
        key ("bye") {
            v0 = ~PostAction(<< _aNO_HALT_i, _aMUSIC_i, 26, 0 >>, item);
            break;
        }
    }
    clear_answers;
    if not v4 {
        if v2 {
            ["Goodbye." She kisses you again, and then turns so that she will not see you leave.*];
        } else {
            ["Goodbye, <v5>."*];
        }
    } else {
        ["Goodbye, <v5>."*];
    }
}
