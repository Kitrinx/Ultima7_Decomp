        SetSpeaker(1, _Wilbur);
        [Little beads of sweat appear on the elderly mage's furrowed brow. "That was a bit harder than I'd expected." He pauses to mop his forehead with the tip of his sleeve, "I had to redirect a small underground river for the well to tap. Now, then. Thou shalt have need of some few tools to make use of this equipment, shan't thee?" His rhetorical question goes unanswered\x09as he once again prepares to unleash his will upon the world.];
        if v14 {
            v22 = ~GetQuality(v14);
            if (v22 = 100) {
                [He stops himself for a moment and says, "If perchance thou hadst some item or other laying upon the floor here, thou'lt find it within yonder chest." He motions to the chest sitting on the floor, then continues with his spell.*];
            }
        }
        CloseSpeaker(_Wilbur);
        if $TetraGone {
            v13 = ~PostAction(<< _aWAIT_i, 2, _aOUT_FRAME_i, _aWAIT_i, 2, _aSTAND_FRAME_i, _aWAIT_i, 2, _aUSABLE_i, #ConjureForgeTools_i >>, item);
        } else {
