    } else {
        v14 = false;
        v0 = ~FindNearby_i(16, 10, _Egg, item);
        Foreach v7 in v0 {
            v8 = ~GetQuality(v7);
            v9 = ~GetFrame(v7);
            v10 = ~GetCoord(v7);
            if (v9 = 6) && (v8 = 10) {
                v17 = ~FindNearby_i(0, 1, _Chest, v7);
                if v17 {
                    Foreach v20 in v17 {
