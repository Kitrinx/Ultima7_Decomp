            v2 = 25;
            v3 = ~EnemyList_i(v2);
            Foreach v6 in v3 {
                v2 = ~GetDist(v6, item);
                v2 = ((v2 / 4) + 4);
                if not (~rndRange(3, 1) = 1) {
                    v0 = ~PostInFuture(v2, << _aNO_HALT_i, _aUSABLE_i, #MassCharmSpell_i >>, v6);
