        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aSFX_i, 65, _aUP_FRAME_i, _aOUT_FRAME_i, _aUP_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #MassCharmSpell_i >>, item);
            v1 = ~GetCoord(item);
