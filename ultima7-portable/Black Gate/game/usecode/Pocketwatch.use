Routine Pocketwatch accepts a0 #locals(4) {
    if (event = _Action) {
        v0 = ~GetHour();
        v1 = "am";
        if (v0 > 12) {
            v0 = (v0 - 12);
            v1 = "pm";
        }
        if (v0 = 0) {
            v0 = 12;
            v1 = "am";
        }
        v2 = ~GetMinute_i();
