Routine CreateGoldSpell_i accepts a0 #locals(6) #uses(~DirFromAvatar_i, ~IsMagicOK_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        v0 = ~GetTarget();
        v1 = ~DirFromAvatar_i(v0);
        Item_bark("@Rel Ylem@", item);
        if (~IsMagicOK_i() and (~Item_getType(v0) = _Chunks_Of_Lead)) {
            v2 = ~PostAction(<< _aFACE_i, v1, _aSFX_i, 66, _aRAISE1_FRAME_i, _aTHRUST1_FRAME_i >>, item);
            v3 = ~GetCoord(v0);
            createSprite(65535, 0, 0, 0, v3::2, v3::1, 13);
            v4 = ~PostInFuture(5, << _aNO_HALT_i, _aUSABLE_i, #CreateGoldSpell_i >>, v0);
        } else {
            v2 = ~PostAction(<< _aFACE_i, v1, _aRAISE1_FRAME_i, _aTHRUST1_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    } else {
        v5 = ~GetQuantity(1, item);
