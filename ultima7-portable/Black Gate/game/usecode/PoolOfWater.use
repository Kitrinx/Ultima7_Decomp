Routine PoolOfWater accepts a0 #locals(4) #uses(ChangeHits_i) {
    if (event = _Action) {
        v0 = ~GetQuality(item);
        v1 = ~GetTarget();
        playSFX(item, 90);
        if (v0 = 1) {
            SetItemFlag_i(_Asleep, v1);
        }
        if (v0 = 2) {
            v2 = ~rndRange(10, 1);
            v3 = (13 - v2);
            ChangeHits_i(v3, v1);
        }
        if (v0 = 3) {
            ClearItemFlag_i(_Poisoned, v1);
            ClearItemFlag_i(_Paralyzed, v1);
            ClearItemFlag_i(_Asleep, v1);
            ClearItemFlag_i(_Charmed, v1);
            ClearItemFlag_i(_Cursed, v1);
        }
        if (v0 = 4) {
            SetItemFlag_i(_Poisoned, v1);
        }
        if (v0 = 5) {
            ClearItemFlag_i(_Asleep, v1);
        }
        if (v0 = 6) {
            SetItemFlag_i(_Protected, v1);
        }
        if (v0 = 7) {
            StartLight_i(100);
        }
        if (v0 = 8) {
            SetItemFlag_i(_Invisible, v1);
        }
    }
}
