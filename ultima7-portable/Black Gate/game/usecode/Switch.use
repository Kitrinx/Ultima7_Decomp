Routine Switch accepts a0 #locals(12) #uses(PathToItem_i, ~DirFrom_i, ~ToggleDrawbridges_i, SwitchPortcullis_i) {
    if (event = _Action) {
        closeAllGumps();
        v0 = 65535;
        v1 = 65535;
        v2 = 65533;
        PathToItem_i(7, item, #Switch, v2, v1, v0, item);
    }
    if ((event = 7) or (event = _Posted_i)) {
        if (event <> _Posted_i) {
            v3 = ~DirFrom_i(item, _Avatar);
            v4 = ~PostAction(<< _aFACE_i, v3, _aCONTINUE_i, _aTHRUST1_FRAME_i, _aSTAND_FRAME_i >>, _Avatar);
        }
        v5 = ~GetFrame(item);
        if ((v5 modulo 2) = 0) {
            SetFrame((v5 + 1), item);
        } else {
            SetFrame((v5 - 1), item);
        }
        playSFX(item, 28);
        v6 = ~GetQuality(item);
        v7 = ~FindNearby_i(0, 15, _Drawbridge, item);
        v8 = ~FindNearby_i(0, 15, _Closed_Drawbridge, item);
        v7 = (v7 & v8);
        v8 = << >>;
        Foreach v11 in v7 {
            if (~GetQuality(v11) = v6) {
                v8 = (v8 & v11);
            }
        }
        v4 = ~ToggleDrawbridges_i(v8);
        SwitchPortcullis_i(65177, item);
    }
}
