Routine Whistle accepts a0 #locals(4) {
    if (event = _Action) {
        SetMusic(item, 55);
        if (~GetFrame(item) = 1) {
            closeAllGumps();
            v0 = ~GetAllInRegion(_Wisp);
            Foreach v3 in v0 {
                SetWorkType(_Talk, v3);
            }
        }
    }
}
