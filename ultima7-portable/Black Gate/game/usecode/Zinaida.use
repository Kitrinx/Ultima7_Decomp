    v9 = 1;
    ["What wouldst thou like?"];
    While v1 {
        v10 = ~AskOrdList(v2);
        if (v10 = 1) {
            ["Fine."];
            v1 = false;
        } else {
            if (v10 = 6) && flag(299) {
                ["I regret to tell thee that this fine establishment will no longer be able to provide our fine customers with Silverleaf. The person who provides me with the delicate meal is no longer able to procure it. I am dreadfully sorry, <v0>."];
            } else {
                v11 = ~PriceString_i(v8::v10, v5::v10, v7, v2::v10, v6);
                v12 = 0;
                ["^<v11> That is a fair price, is it not?"];
                v13 = ~AskYesNo();
                if v13 {
                    if (v3::v10 = 377) {
                        ["How many wouldst thou like?"];
                        v12 = ~SellItem_i(true, 1, 20, v5::v10, v9, v4::v10, v3::v10);
                    } else {
                        v12 = ~SellItem_i(true, 1, 0, v5::v10, v9, v4::v10, v3::v10);
                    }
                }
                if (v12 = 1) {
                    ["Done!"];
                } else {
                    if (v12 = 2) {
