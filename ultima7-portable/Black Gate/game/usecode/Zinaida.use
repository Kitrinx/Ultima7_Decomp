Routine Zinaida accepts a0 #locals(1) #uses(ZinaidaSellsFood_i, BarkAboutWork_i) {
    if (event = _Action) {
        SetSpeaker(0, _Zinaida);
        TurnOn(<< "name", "job", "bye" >>);
        v0 = ~GetWorkType(~NPCToItem_i(_Zinaida));
        if flag(228) && flag(241) {
            TurnOn("De Maria");
        }
        if not $Metzinaida {
            [This beautiful, earthy woman in her forties gives you a friendly smile.];
            $Metzinaida = true;
        } else {
            ["Hello," Zinaida says.];
        }
        converse {
            key ("name") {
                ["I am Zinaida," she says with a curtsey.];
                TurnOff("name");
                if flag(228) {
                    TurnOn("De Maria");
                }
                flag(241) = true;
            }
            key ("job") {
                ["I am the owner and manager of The Emerald."];
                if (v0 = 23) {
                    ["If I can help thee with food or drink, please say so. I have never had a dissatisfied customer."];
                    TurnOn(<< "drink", "food", "buy" >>);
                } else {
                    ["Please come to the pub when it is open and I shall be happy to serve thee!"];
                }
            }
            key ("food") {
                ["The Emerald is pleased to serve thee the finest cuisine this side of Britain. Thou mightest wish to try the special -- Silverleaf."];
                TurnOn("Silverleaf");
            }
            key ("Silverleaf") {
                [She winks at you. "Some say it is a powerful aphrodisiac... It is delicious, regardless. It comes from the root of an exotic tree growing somewhere in Britannia."];
                TurnOff("Silverleaf");
            }
            key ("drink") {
                ["The Emerald serves only the best wine and ale. I cannot recommend the water, however. Thanks to Lock Lake."];
                TurnOn("Lock Lake");
            }
            key ("buy") {
                ZinaidaSellsFood_i();
            }
            key ("De Maria") {
                ["He is the light of my life. A finer man does not exist." She beams.];
                TurnOff("De Maria");
            }
            key ("Lock Lake") {
                ["The stench has made our water taste terrible. That mining company must cease pouring their sewage into what was once a fine lake!"];
                TurnOff("Lock Lake");
            }
            key ("bye") {
                break;
            }
        }
        clear_answers;
        ["Come again soon!"*];
    }
    if (event = _Bark) {
        BarkAboutWork_i(_Zinaida);
    }
}

Usable ZinaidaSellsFood_i #locals(14) #uses(~LordOrLady, ~AskOrdList, ~PriceString_i, ~AskYesNo, ~SellItem_i) {
    v0 = ~LordOrLady();
    PushKeys();
    v1 = true;
    v2 = << "nothing", "mutton", "bread", "mead", "trout", "Silverleaf", "cake", "wine", "ale" >>;
