                    } else {
                        if (v12 = 3) {
                            ["Thou dost not have enough gold for that!"];
                        } else {
                        }
                    }
                }
            }
            ["Wouldst thou like something else?"];
            v1 = ~AskYesNo();
        }
    }
    PopKeys();
}
