            if (v4 < 6) {
                v6 = ((6 - v4) * 60);
                v6 = (v6 + (60 - v5));
                v6 = (v6 * 25);
            } else {
                v6 = ((23 - v4) * 60);
                v6 = (v6 + (60 - v5));
