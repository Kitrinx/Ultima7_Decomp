        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aSFX_i, 67, _aEXTEND1_FRAME_i, _aRAISE1_FRAME_i, _aTHRUST1_FRAME_i >>, item);
            v1 = ~GetCoord(item);
            v2 = (v1::1 - 2);
