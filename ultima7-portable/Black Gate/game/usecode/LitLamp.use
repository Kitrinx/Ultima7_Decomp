Routine LitLamp accepts a0 #locals(6) {
    if ((event = _Action) or (event = _Posted_i)) {
        v0 = ~FindNearby_i(128, 10, _Light_440, item);
        v1 = ~GetCoord(item);
        v1::1 = (v1::1 + 3);
        v1::2 = (v1::2 + 3);
        Foreach v4 in v0 {
            v5 = ~GetCoord(v4);
