Routine SwarmSpell_i accepts a0 #locals(4) #uses(~IsMagicOK_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        Item_bark("@Kal Bet Xen@", item);
        if ~IsMagicOK_i() {
            v0 = ~PostAction(<< _aUP_FRAME_i, _aOUT_FRAME_i, _aTHRUST2_FRAME_i, _aSFX_i, 65, _aUSABLE_i, #SwarmSpell_i >>, item);
        } else {
            v0 = ~PostAction(<< _aUP_FRAME_i, _aOUT_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        v1 = ~rndRange(10, 7);
        While (v1 > 0) {
            v1 = (v1 - 1);
            v2 = 517;
            v3 = ~Summon_i(false, v2);
        }
    }
}
