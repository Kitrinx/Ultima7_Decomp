Routine EnterTetraEgg_i accepts a0 #locals(1) #uses(MakePartyWait_i) {
    if (event = _Trigger) && (not $TetraGone and (~IsEquipped_i(1, _Ethereal_Ring, 6, _Avatar) or ~IsEquipped_i(1, _Ethereal_Ring, 7, _Avatar))) {
        v0 = << 2663, 845, 0 >>;
        MakePartyWait_i();
        Item_move(v0, _Avatar);
