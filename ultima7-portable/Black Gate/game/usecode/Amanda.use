Routine Amanda accepts a0 #locals(3) #uses(~LordOrLady, ~IsNPCNear) {
    if (event = _Bark) {
        terminate;
    }
    SetSpeaker(0, _Amanda);
    v0 = ~LordOrLady();
    v1 = ~IsNPCNear(_Eiko);
    if not $MET_AMANDA {
        [You see an attractive woman dressed in armour and carrying a small arsenal of weapons with her.];
        $MET_AMANDA = true;
    } else {
        ["How may I help thee?" asks Amanda.];
    }
    if flag(732) && not flag(734) {
        TurnOn("Stay thine hand!");
    }
    TurnOn(<< "name", "job", "bye" >>);
    converse {
        key ("name") {
            ["My name is Amanda."];
            TurnOff("name");
        }
        key ("job") {
            if flag(734) {
                ["Mine half-sister and I have no job at this time. We are journeying to seek inner peace, now that our quest has been aborted."];
                TurnOn("inner peace");
            } else {
                ["Mine half-sister and I have no job but to serve our quest."];
                TurnOn("quest");
            }
            TurnOn("half-sister");
        }
        key ("half-sister") {
            if flag(734) {
                v2 = "would have been";
            } else {
                v2 = "will be";
            }
            ["Mine half-sister is Eiko. She, like myself, is a warrior trained by Karenna in the ways of combat. We studied long and hard together to master the skills that <v2> required to achieve our vengeance."];
            if v1 {
                SetSpeaker(0, _Eiko);
                ["The two of us had not even met before our father's death. But we bonded like sisters in the rigorous disciplines we learned from our trainer, Karenna of Minoc."*];
                CloseSpeaker(_Eiko);
                SetSpeaker(0, _Amanda);
            }
            TurnOff("half-sister");
        }
        key ("inner peace") {
            ["Yes. Our lives have been dedicated to vengeance for so long that we feel adrift, aimless without it. We must find a new reason for living.~~"We are considering joining The Fellowship, as they offer guidance for lost souls. But we must consider this longer. We are still unsure."];
        }
        key ("quest") {
            ["We are on the trail of our father's murderer."];
            TurnOff("quest");
            TurnOn("killer");
        }
        key ("killer") {
            ["Our father was slain in a most violent manner by a vicious and terrible cyclops. He was impaled on a spear. It took several hours for him to die."~~She looks up, eyes glittering. "Hast thou ever watched anyone die from a belly wound, <v0>? The agony cannot be imagined."];
            TurnOff("killer");
            TurnOn(<< "cyclops", "impaled" >>);
        }
        key ("cyclops") {
            ["We have been tracking this creature for years, ever since we completed our training. We have followed him from one end of Britannia to another. Sometimes he was just one step ahead of us. But now we know that we are nearer to him than we have ever been before."];
            if v1 {
                SetSpeaker(0, _Eiko);
                ["When we find him there shall be no escape. We want vengeance and we mean to have it!"*];
                CloseSpeaker(_Eiko);
                SetSpeaker(0, _Amanda);
            }
            TurnOff("cyclops");
        }
        key ("impaled") {
            ["Our father fought bravely for his life. He did not die easily. He died a hero's death. Although we may both die in the effort, we intend to give his murderer a death fit for a true villain."];
            if v1 {
                SetSpeaker(0, _Eiko);
                [Eiko smiles wickedly.*];
                CloseSpeaker(_Eiko);
                SetSpeaker(0, _Amanda);
            }
            TurnOff("impaled");
        }
        key ("Stay thine hand!") {
            [You explain to Amanda what you have learned. Kalideth had gone mad when he fought with Iskander and the source of what is causing the problems with magic and the mage's minds - the thing that really killed Kalideth - has been destroyed.~~"Thou hast robbed me of my rightful vengeance! How dare thee!"];
            if v1 {
                SetSpeaker(0, _Eiko);
                [Eiko sighs, and her shoulders slump. "Come now, sister. With the matter of our father's untimely death now settled we can at last let it go. Now we can devote our lives to ourselves rather than remain trapped in the past. It is for the best, thou must trust me."*];
                SetSpeaker(0, _Amanda);
                [Amanda shakes her head, dazed and confused. "Perhaps thou art correct, Eiko. I must think."*];
                CloseSpeaker(_Eiko);
                SetSpeaker(0, _Amanda);
                flag(734) = true;
            } else {
                [Amanda turns and slams her fist into the wall, then collapses onto it with a sob. After a moment, she straightens, but does not turn to face you.~~"Have no fear that I will continue my vengeance against the cyclops. I am not so far gone that I would kill a creature for acting in self-defense.~"But I must have some time to myself now. Please, go. I must think."];
                flag(734) = true;
            }
            terminate;
            TurnOff("Stay thine hand!");
        }
        key ("bye") {
            break;
        }
    }
    clear_answers;
    ["Good journey to thee, <v0>."*];
}
