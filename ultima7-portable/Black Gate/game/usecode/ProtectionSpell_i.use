Routine ProtectionSpell_i accepts a0 #locals(5) #uses(~DirFromAvatar_i, ~IsMagicOK_i) {
    if (event = _Action) {
        Kernel_resetRef(item);
        v0 = ~GetTarget();
        v1 = ~DirFromAvatar_i(v0);
        Item_bark("@Uus Sanct@", item);
        if (~IsMagicOK_i() and ~Item_isNpc(v0)) {
            v2 = ~PostAction(<< _aFACE_i, v1, _aSFX_i, 109, _aUP_FRAME_i, _aRAISE1_FRAME_i, _aTHRUST2_FRAME_i >>, item);
            v3 = ~PostInFuture(5, << _aNO_HALT_i, _aUSABLE_i, #ProtectionSpell_i >>, v0);
            v4 = ~GetCoord(v0);
            CreateSpriteOn_i(65535, 0, 0, 0, 65534, 65534, 13, item);
        } else {
            v2 = ~PostAction(<< _aFACE_i, v1, _aUP_FRAME_i, _aRAISE1_FRAME_i, _aTHRUST2_FRAME_i, _aUSABLE_i, #FizzleSpell_i >>, item);
        }
    }
    if (event = _Posted_i) {
        SetItemFlag_i(_Protected, item);
    }
}
