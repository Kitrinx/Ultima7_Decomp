Routine Horance accepts a0 #locals(10) #uses(~AvatarName, ~LordOrLady, ~IsNPCNear, HoranceGivesStaff_i, HoranceTaskDone_i, HoranceAsksProgress_i, HoranceAsksHelp_i, LicheIgnoresAvatar_i) {
    if (event = _Action) {
        if not flag(437) {
            SetSpeaker(0, _Horance);
            [You attempt to speak to the undead creature, but it does not, or cannot, respond.*];
            terminate;
        }
        v0 = ~AvatarName();
        v1 = ~LordOrLady();
        v2 = ~IsNPCNear(_Rowena);
        v3 = false;
        if flag(419) {
            if not flag(427) {
                HoranceGivesStaff_i();
            } else {
                HoranceTaskDone_i();
            }
        }
        if flag(408) {
            HoranceAsksProgress_i();
        }
        if flag(426) {
            HoranceAsksHelp_i();
        } else {
            SetSpeaker(0, _Horance);
        }
        v4 = ~GetTime();
        v5 = ~GetWorkType(_Horance);
        if ((v4 = 0) or (v4 = 1)) {
            if (v5 = 14) {
                LicheIgnoresAvatar_i();
            } else {
                v3 = true;
            }
        }
        if not flag(453) {
            if v3 {
                [The Liche practically glows, power coursing visibly through its undead veins.];
            }
            [You step forward to confront this vile-looking creature and he slowly turns to face you. As his intense gaze locks onto your form, you almost wish you hadn't been so bold.~~ "<v0>." A sardonic expression comes to his undead features. "How may I help thee?" You get the distinct impression that help is the last thing you'll get from the Liche.];
            v6 = ~IsNPCNear(_Shamino);
            v7 = ~IsNPCNear(_Iolo);
            if v6 {
                SetSpeaker(0, _Shamino);
                [Shamino steps near you and speaks in a whispered tone.~~"Do not trust this one, <v1>. Methinks he'll cause naught but evil."];
                CloseSpeaker(_Shamino);
                SetSpeaker(0, _Horance);
            } else {
                if v7 {
                    SetSpeaker(0, _Iolo);
                    [Iolo steps near you and speaks in a whispered tone.~~"Do not trust this one, <v1>. Methinks he'll cause naught but evil."];
                    CloseSpeaker(_Iolo);
                    SetSpeaker(0, _Horance);
                }
            }
            v8 = ~IsNPCNear(_Spark);
            if v8 {
                SetSpeaker(0, _Spark);
                ["Uh, <v1>? I am ready to go now," he says to you, cowering from the undead creature.*];
                CloseSpeaker(_Spark);
                SetSpeaker(0, _Horance);
            }
            flag(453) = true;
        } else {
            [The Liche performs something akin to a smile and speaks with a sarcastic flair.~~"Ah, the wondrous Avatar has returned. What have I done to deserve such an honor?" The word "honor" sours on this creature's tongue.];
        }
        TurnOn(<< "name", "job", "bye" >>);
        converse {
            key ("name") {
                [The Liche's dry features take on a haughty appearance. "Thou mayest call me Lord Horance. It would only be prudent, as I shall one day rule all of Britannia.~~ "Surprised, Avatar? Come now. Surely thou dost not think that Lord British will stand in my way. I know how to deal with his ilk."];
                TurnOff("name");
                TurnOn(<< "Lord Horance", "Lord British" >>);
            }
            key ("Lord Horance") {
                ["Ah, it is good to hear such an obeisance from the Avatar. Perhaps thou wilt have a place in my New Order." The Liche looks at you with an expression somewhere between malice and humor.];
                TurnOff("Lord Horance");
                TurnOn(<< "obeisance", "New Order" >>);
            }
            key ("obeisance") {
                ["Why, what else wouldst thou call it? Surely thou art truly humbled by my `majestic' presence."];
                TurnOff("obeisance");
            }
            key ("New Order") {
                [An expression of zeal lights the dead face of the Liche.~~"Yes, <v0>. The dead will rule! I will be their leader and thou canst become an Avatar... to ME!"];
                TurnOff("New Order");
                PushKeys();
                TurnOn(<< "Over my dead body!", "Fine!" >>);
            }
            key ("Over my dead body!") {
                ["Why, <v0>. I thought that was understood. It will be my pleasure to help thee enter the realm of the dead."];
                PopKeys();
            }
            key ("Fine!") {
                ["Yes, I thought thou wouldst see the wisdom of my vision." He looks at you like a cat toying with a mouse.];
                PopKeys();
            }
            key ("Lord British") {
                [`Evil' is a mild word for the sneer that appears on the Liche's cracked lips. "It has recently come to my attention that a certain ore found in the Britannian surface can, if fashioned properly, become the bane of the vaunted Lord British.~~"I know this ore and have used it\x09before for other purposes. I will use it once again to destroy that so-called Lord."];
                TurnOn(<< "ore", "other purposes" >>);
                TurnOff("Lord British");
            }
            key ("other purposes") {
                if not $TetraGone {
                    [He gestures at the walls of the tower. "How else didst thou expect my tower to withstand the ravaging effect the ether is having\x09on my magic?"];
                } else {
                    [He gestures at the walls of the tower. "It served as an effective barrier against the ravaging effects of the disrupted ether."];
                }
                TurnOff("other purposes");
            }
            key ("job") {
                [A harsh cackle escapes his dry throat. "I am the illustrious Lord of the Dead, soon to be Lord of all Britannia. Dost thou have any idea of the number of dead people and creatures there are? I thought not.~~"The dead of the ages are mine to summon and control. The graves of beloved ancestors will spew forth their contents into an army. A special treat for the living, mine undead monsters will be. Imagine a skeletal dragon that cannot be killed. Consider a cabal of everliving mages eternally enthralled to me.~~"And the most beautiful part of my plot is that, as the living die in these battles, and they will die, they will swell the ranks of the undead host. I will rule supreme -- a world of the dead!" A terrifying glimpse of his sick and twisted future causes you to shiver\x09ever so slightly.~~"And I will have a queen, the lovely Rowena."];
                TurnOn("Rowena");
                if v2 {
                    SetSpeaker(0, _Rowena);
                    ["Yes, my Lord. I must be the happiest Lady in all the land." Her gaze never wanders from the horrid face of the Liche.];
                    CloseSpeaker(_Rowena);
                    SetSpeaker(0, _Horance);
                }
            }
            key ("Rowena") {
                if v2 {
                    ["Is she not the most beautiful lady thou hast seen? ~~"She shall have eternal beauty at my side, and we shall rule together."];
                } else {
                    ["She is the most beautiful lady I have been witness to. She shall have eternal beauty at my side, and we shall rule together." After hearing him speak of his plans for the future, you find this a very unlikely statement.];
                }
                TurnOff("Rowena");
            }
            key ("ore") {
                ["Now, now, Avatar, that would be revealing. Then I would have no secret from thee, would I?"];
                TurnOff("ore");
            }
            key ("bye") {
                ["It is truly sad to see thee go." He says with a sardonic smile.*];
                v9 = ~IsNPCNear(_Dupre);
                v7 = ~IsNPCNear(_Iolo);
                if v9 {
                    SetSpeaker(0, _Dupre);
                    ["Yeah, right."*];
                    CloseSpeaker(_Dupre);
                    SetSpeaker(0, _Horance);
                } else {
                    if v7 {
                        SetSpeaker(0, _Iolo);
                        ["Yeah, right."*];
                        CloseSpeaker(_Iolo);
                        SetSpeaker(0, _Horance);
                    }
                }
                ["Feel free to explore mine humble abode. Though, have a care. My guardians are none too intelligent and will most likely assault anything living." He smiles with his death's head grin.*];
                terminate;
            }
        }
        clear_answers;
    }
}

Usable HoranceAsksProgress_i #locals(4) #uses(~AskYesNo, ~IsNPCNear, HoranceGivesStaff_i, HoranceTaskDone_i) {
    SetSpeaker(1, _Horance);
    v0 = ~GetParty();
    if not (~NPCToItem_i(_Forsythe) in v0) {
        ["Is there a problem? Art thou confounded by thy task?"];
        v1 = ~AskYesNo();
        if not v1 {
            ["Well then, I suggest that thou hasten to finish thy task, lest the souls of the well perish before thou art done.*"];
            terminate;
        } else {
            ["Canst thou not find the spirits of the town?"];
            v2 = ~AskYesNo();
            if v2 {
                ["Well then, I suggest that thou make haste, lest the souls of the well perish."*];
                terminate;
            } else {
                ["Ah, then it is good that thou hast returned. The Mayor knows most of the townsfolk and can tell thee of them."*];
                terminate;
            }
        }
    } else {
        if not flag(419) {
            ["Very good, now thou shalt take the Mayor to the well and he must enter it of his own free will. When he does that, the souls of the island and the well will be free to go on to their destiny. Unfortunately, Mayor Forsythe will be lost for all time."];
            v3 = ~IsNPCNear(_Forsythe);
            if v3 {
                [ He looks sadly at the ghostly gentleman.];
            }
            [*];
            terminate;
        } else {
            if not flag(427) {
                HoranceGivesStaff_i();
            } else {
                HoranceTaskDone_i();
            }
        }
    }
}

Usable LicheIgnoresAvatar_i #locals(0) {
    if not flag(453) {
        [Before you is the vile form of a liche. It remains motionless and its eyes stare straight ahead.*];
        terminate;
    } else {
        [The Liche remains motionless and seemingly unaware of your presence.*];
        terminate;
    }
}

Usable HoranceGivesStaff_i #locals(4) #uses(~AvatarName, ~PopToNPCNumber_i) {
    SetSpeaker(1, _Horance);
    v0 = ~AvatarName();
    ["Once again, Avatar, thou hast proven that thou art ever the defender of Britannia and the innocent. I cannot adequately express my gratitude; however, please take this small token of my thanks. I hope it will help thee in thy quest."];
    v1 = ~Item_create(_Firedoom_Staff);
    if v1 {
        v2 = ~SetQuality(100, v1);
        if ~PopToNPCNumber_i(~NPCToItem_i(_Avatar)) {
            [He hands you his personal staff. It appears to be magical.];
        } else {
            v3 = ~PopToMap(~GetCoord(_Avatar));
            [He places his personal staff on the ground. It appears to be magical.~"I have something for thee, Avatar, but I see that thou canst not carry it now. I will set it here upon the floor for thee."];
        }
        flag(427) = true;
    }
    [For a moment Horance looks downcast. "I feel that some of the responsibility for what happened in this town is upon my shoulders. For, in my search to uncover the truths of the universe, I unwittingly released that foul spirit which destroyed this town. I will spend the rest of my days in the attempt to restore this once lovely town.~~"I will make it into a shining example of Spirituality, a shrine where people of good heart may live in peace and harmony. And again, I thank thee for giving me this chance. Goodbye, <v0>."*];
    terminate;
}

Usable HoranceTaskDone_i #locals(1) #uses(~AvatarName) {
    SetSpeaker(1, _Horance);
    v0 = ~AvatarName();
    [Horance looks at you curiously, "Thy task is done here in Skara Brae. Thou hast my respect and lifelong gratitude."];
    if flag(380) {
        [But...," he hesitates here as if unsure how to proceed, "...shouldst thou not return to the quest which brought thee here?"];
        TurnOn("quest");
    }
    TurnOn(<< "Skara Brae", "bye" >>);
    converse {
        key ("quest") {
            if not flag(432) {
                ["Why, yes. I sense that the spirit of Caine has not left the island yet. Is he not waiting for thy return?"];
            } else {
                ["Thou wert brought to Britannia for a reason, I surmise. If thou dost not know what it is, shouldst thou not seek it out?"];
            }
            TurnOff("quest");
        }
        key ("Skara Brae") {
            ["I intend to restore this town and furthermore, make it a place of beauty and renown. I enjoin thee to return in future times to see if my boast doth come to pass."];
            TurnOff("Skara Brae");
        }
        key ("bye") {
            ["Goodbye, <v0>. I hope that thou farest well in thy quest." He turns away.*];
            terminate;
        }
    }
    clear_answers;
    if (event = _Bark) {
        terminate;
    }
}
