Routine ForceItemOnNPC_i accepts a0, a1, a2, a3 #locals(5) {
	v4 = 0;
	v5 = 0;
	/* Try equipped slots in the prescribed order. */
	label_1:
	v6 = ~Npc_getEquip(v5, v3);
	if v6 {
		v7 = ~Item_push(v6);
		if v7 {
			v7 = ~Item_push(v2);
		}
		v4 = (v4 + 1);
		if ~PopToNPC(v3) {
			goto label_37;
		} else {
			if v1 {
				v7 = ~PopToNPC(v0);
			} else {
				v7 = ~PopToMap(v0);
			}
		}
	}
	if (v5 = 0) {
		v5 = 5;
		goto label_1;
	}
	if (v5 = 5) {
		v5 = 16;
		goto label_1;
	}
	if (v5 = 16) {
		v5 = 17;
		goto label_1;
	}
	if (v5 = 17) {
		v5 = 15;
		goto label_1;
	}
	if (v5 = 15) {
		v5 = 11;
		goto label_1;
	}
	if (v5 = 11) {
		v5 = 1;
		goto label_1;
	}
	if (v5 = 1) {
		v5 = 12;
		goto label_1;
	}
	if (v5 = 12) {
		v5 = 4;
		goto label_1;
	}
	if (v5 = 4) {
		v5 = 14;
		goto label_1;
	}
	if (v5 = 14) {
		v5 = 13;
		goto label_1;
	}
	if (v5 = 13) {
		v5 = 2;
		goto label_1;
	}
	if (v5 = 2) {
		v5 = 3;
		goto label_1;
	}
	if (v5 = 3) {
		v7 = ~Item_push(v2);
		if v7 {
			v8 = ~GetCoord(v3);
			v7 = ~PopToMap(v8);
		}
	}
	/* A successful placement or exhausted slots enter cleanup. */
	label_37:
	loop {
		v8 = ~GetCoord(v3);
		v7 = ~PopToMap(v8);
		v4 = (v4 - 1);
		if (v4 = 0) {
			return;
		} else {
			continue;
		}
	}
}

Usable AutoUsable_i #locals(0) #uses(AttackAvatar_i, AutomatonUsable_i) {
    if ((event = _Path_Success) or (event = _Path_Failure)) {
        AttackAvatar_i(item);
    }
    if ~GetItemFlag_i(_Zombie, item) {
        AutomatonUsable_i();
        terminate;
    }
}

Routine FillBackupChest_i accepts a0 #locals(13) #uses(~IsContainer_i) {
	terminate;
	v1 = ~FindNearby_i(0, 100, _Chest, _Shmed);
	v2 = 0;
	Foreach v5 in v1 {
		if (~GetQuality(v5) = 0) {
			v2 = v5;
		}
	}
	if (v2 = 0) {
		v6 = ~Item_create(_Chest);
		if v6 {
			v7 = ~SetQuality(0, v6);
			v7 = ~PopToMap(~GetCoord(_Avatar));
			v2 = v6;
		} else {
			PrintError_i("backup chest creation failed.");
		}
	}
	v8 = 0;
	v9 = ~GetContents(_All, _All, _All, _Avatar);
	While (v8 < 2) {
		Foreach v12 in v9 {
			if (~IsContainer_i(v12) or (v8 = 1)) {
				v13 = ~Item_getType(v12);
				if not ((v13 = _Serp_Bracers) or ((v13 = _Path) or (v13 in v0))) {
					if not ~Item_push(v12) {
						PrintError_i(" failed the push!");
						terminate;
					}
					if not ~Item_popToEnd(v2) {
						PrintError_i(" failed the pop!");
						terminate;
					}
				}
			}
		}
		v8 = (v8 + 1);
		v9 = ~GetContents(_All, _All, _All, _Avatar);
	}
}
