    }
    if (v1 = false) {
        if ~IsNPCNear(_Ducio) {
            ["Oh, we sell all manner of things. Cloaks, swords..."];
            SayIfNear_i("@Shovels, too...@", 65521);
            CloseSpeaker1_i();
