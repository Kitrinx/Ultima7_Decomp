            if (v13 = 10) {
                ["I can sell thee a bolt of dyed cloth for <v14> guilders."];
                ["<v17>"];
                v18 = "bolts of cloth";
            }
            if (v13 = 11) {
                ["The bread baked by the automaton baker is quite filling, <v0>. For <v14> guilders I will sell thee a fresh loaf."];
                ["<v17>"];
                v18 = "loaves of bread";
            }
            if (v13 = 12) {
                ["<v14> guilders will buy thee a delicious roll."];
                ["<v17>"];
                v18 = "rolls";
            }
            if (v13 = 13) {
                ["The baker automaton makes a very sweet cake, <v0>. For <v14> guilders thou canst have one."];
                ["<v17>"];
