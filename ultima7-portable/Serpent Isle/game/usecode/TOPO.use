    v1 = false;
    v2 = ~rndRange(4, 1);
    PushKeys();
    v3 = true;
    v4 = << "nothing", "cloak", "sword", "shovel", "torch", "pick", "bucket", "pitcher", "lamp", "cloth", "bread", "rolls", "cake" >>;
    v5 = << 0, 227, 599, 625, 595, 624, 810, 824, 336, 851, 377, 377, 377 >>;
