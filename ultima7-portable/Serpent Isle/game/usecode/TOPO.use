}

Function ~TopoHaggles_i accepts a0, a1 #locals(16) #uses(~LordOrLady, ~AskList, ~Haggle_i, ~AskYesNo) {
    v2 = ~LordOrLady();
    v3 = ~AvatarSex();
    if ~AvatarSex() {
        v4 = "Milady";
    } else {
