        }
        v1 = true;
    }
    ["So, <v0>, what dost thou wish to buy?"];
    While v3 {
        v13 = ~AskOrdList(v4);
        if (v13 = 1) {
            ["Perhaps another time, <v0>."];
            v3 = false;
        } else {
            v14 = v7::v13;
            v15 = 0;
            v16 = ~rndRange(5, 1);
            if (v16 = 1) {
                v17 = (("Dost thou accept, " + v0) + "?");
            }
            if (v16 = 2) {
                v17 = "What dost thou think?";
            }
            if (v16 = 3) {
                v17 = "Wilt thou pay my master's price?";
            }
            if (v16 = 4) {
                v17 = (v12 + ", dost thou agree?");
            }
            if (v16 = 5) {
                v17 = (v12 + ", is the price acceptable?");
            }
            if (v13 = 2) {
                ["Well, our cloaks are not fancy, but they are warm." *"If thou dost want one, it will cost thee <v14> guilders."];
                [<v17>"];
                v18 = "cloaks";
            }
            if (v13 = 3) {
                ["\["Oh, we sell swords that the blacksmith automaton makes. They are very durable blades..." *"For <v14> guilders I can sell thee one of our fine swords."];
                ["<v17>"];
                v18 = "swords";
            }
            if (v13 = 4) {
                ["Our shovels are very well made. I believe that even Mortegro hath bought a couple of them. I can sell thee one for <v14> guilders."];
                ["<v17>"];
                v18 = "shovels";
            }
            if (v13 = 5) {
                ["The torches we sell are soaked in pitch, so they burn for a very long time." *"I will sell a torch to thee for <v14> guilders."];
                ["<v17>"];
                v18 = "torches";
            }
            if (v13 = 6) {
                ["I believe our picks have been used in the Mountains of Freedom. Only <v14> guilders will buy thee one."];
                ["<v17>"];
                v18 = "picks";
            }
            if (v13 = 7) {
                ["<v14> guilders and one of our finely crafted buckets can be thine, <v0>."];
