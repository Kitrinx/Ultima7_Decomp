                    v15 = ~SellItem_i(false, 1, 0, v19, v9, 1, v6::v13, v5::v13);
                }
            }
            if (v15 = 1) {
                ["Enjoy thy purchase!"];
            } else {
                if (v15 = 2) {
                    ["Thine hands are full!"];
                } else {
                    if (v15 = 3) {
                        v20 = ~PartyUtters(false, 0, (("@But " + v0) + ", we do not have the guilders to purchase this.@"), 1);
                        if (v20 <> 65180) {
