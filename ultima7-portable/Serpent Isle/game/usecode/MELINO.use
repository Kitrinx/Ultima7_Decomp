                }
            } else {
                if (v2 < (v0 + ((v1 - v0) / 3))) {
                    if (v14 = 1) {
                        ["'Tis lower than I expected... but I shall agree to this price."];
                    }
                    if (v14 = 2) {
                        ["Thou art very good at bargaining. I will accept this price."];
                    }
                    if (v14 = 3) {
                        ["I see." *"Very well, I will agree to this price even though 'tis lower than I did wish."];
                    }
                } else {
