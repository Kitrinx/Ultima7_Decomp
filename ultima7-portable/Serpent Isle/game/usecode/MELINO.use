Routine Melino accepts a0 #locals(10) #uses(~AvatarName, ~IsInInv, PartyFaces_i, Bark_i, MelinoSellsSpells_i, MessengerBringsScroll_i) {
    v0 = ~AvatarSex();
    v1 = ~AvatarName();
    v2 = "Mundane";
    v3 = ~IsInInv(0, 65177, _Stockings, 1, _Party);
    if ~IsInInv(16, 65177, _Bottles, 1, _Party) {
        v4 = true;
    }
    if $gotspellbook {
        v2 = "Mage";
    }
    v5 = ~IsInInv(15, 65177, _Reagents, 1, _Party);
    v6 = ~GetTime();
    if ((v6 > 1) or (v6 < 6)) {
        v6 = "day";
    } else {
        v6 = "evening";
    }
    if ((event = _NearDeath) and ~GetItemFlag_i(_Tournament, item)) {
        v7 = ~PostAction(<< _aNO_HALT_i, _aUSABLE_i, #Black_Mage >>, item);
    }
    if (event = _Converse) {
        Item_bark("Hello there.", _Avatar);
        PartyFaces_i(65512);
        Bark_i(2, (("@Greetings, " + v2) + "."), _Melino);
        SetWorkType(_Talk, _Melino);
    }
    if (event = _Talking) {
        Npc_schedule(_Melino);
        ClearBark_i(_Melino);
        SetSpeaker0_i(0, _Melino);
        if not $gotspellbook {
            ["I am sorry, but thou hast mistaken me for someone else. Thou couldst not possibly be speaking to me, as I am a Mage... and thou art merely Mundane."];
            Bark_i(0, "@Such impudence!@", _Melino);
            terminate;
        }
        if ($melinoangry = true) {
            ["I shall never speak to thee again!"];
            Bark_i(0, "@Never!@", _Melino);
            terminate;
        }
        v8 = ~GetItemFlag_i(_Met, _Melino);
        if (v8 = false) {
            SetItemFlag_i(_Met, _Melino);
            ["I do not believe that we have met. 'Tis so nice to make the acquaintance of a new, young Mage."];
            ["I am Melino, husband of the Green Enchantress."];
            TurnOn(<< "new Mage", "Green Enchantress" >>);
        } else {
            ["Welcome, Mage. I am pleased to see thee again."];
        }
        if ($moshsaidcolumna and not $moshfriend) {
            TurnOn("Mosh");
        }
        if (v4 and not $knowmagicwine) {
            TurnOn("wine");
        }
        if ($magesknowapparati and not $knowlabitem) {
            TurnOn("apparatus");
        }
        if v5 {
            TurnOn("Stoneheart");
        }
        if v3 {
            TurnOn("Moonsilk stockings");
        }
        if (~GetWorkType(_Melino) = _Wander) {
            TurnOn("spells");
        }
        TurnOn(<< "bye" >>);
        converse {
            key ("new Mage") {
                TurnOff("new Mage");
                ["Of course thou art new here! I know all other Mages in Moonshade... And I have never seen thee before."];
                ["And thou hast thy spellbook, so thou art not a Mundane. Therefore, thou art a Mage."];
                ["By careful reasoning then, thou art a new Mage!"];
                ["But I cannot recall having seen thee in Fedabiblio's training... But then I do not usually take much note of the novices."];
                TurnOn(<< "other Mages", "Mundane", "Fedabiblio" >>);
            }
            key ("other Mages") {
                TurnOff("other Mages");
                if not flag(226) {
                    ["While I am far too busy to sit on the Council, I am well-connected, nonetheless. Many Mages come to consult me during their research."];
                } else {
                    ["I have always been well-connected -- even before I took a seat on the Council. Many Mages come to consult me during their research."];
                }
                TurnOn(<< "Council", "research" >>);
            }
            key ("Council") {
                TurnOff("Council");
                PushKeys();
                TurnOn("change subject");
                if not flag(226) {
                    ["The Council of Mages is the ruling body of Moonshade. To be asked to take a seat on the Council is a great honor, but I had to turn it down..."];
                    ["The current members are Mortegro, Gustacio, and Filbercio... of course."];
                    TurnOn(<< "Mortegro", "Gustacio", "Filbercio" >>);
                } else {
                    ["The Council of Mages is the ruling body of Moonshade. I did not wish to accept a seat on the Council, but Columna persuaded me..."];
                    ["The other members are Gustacio and Filbercio, of course..."];
                    TurnOn(<< "Gustacio", "Filbercio" >>);
                }
            }
            key ("Mortegro") {
                TurnOff("Mortegro");
                if not flag(226) {
                    ["Mortegro is the local necromancer. He specializes in speaking with the dead, not raising them. Which is just as well, as the Council frowns on such exercises."];
                    ["Why raise the dead for servants when thou hast Mundanes for servants, after all? And we have no need of another Vasculio, that is clear."];
                    TurnOn("Vasculio");
                } else {
                    ["Mortegro was the local necromancer. He specialized in speaking with the dead, not raising them..."];
                    ["Or at least that is what we all thought until he disappeared. Perhaps we have been harboring another Vasculio all this time."];
                    TurnOn(<< "disappeared", "Vasculio" >>);
                }
            }
            key ("Vasculio") {
                TurnOff("Vasculio");
                ["Do not speak his name aloud again! I am not superstitious, mind thee... But there are those that say that calling a spirit three times by name will summon it. I would rather not find out, if thou dost not mind."];
                ["The unnamed one was an Adept who hungered for power at any cost. When he could not gain enough to suit him by normal means... he resorted to foul deeds to obtain more."];
                ["Though he was put to death for his crimes, he broke free from the grave... vowing vengeance upon us all. That is why the Council carefully monitors all research to this day."];
            }
            key ("disappeared") {
                TurnOff("disappeared");
                ["Gone! In a trice! No word to anyone..."];
                ["Gustacio is mightily peeved, I can tell thee. Mortegro was helping him with an experiment, and Gustacio cannot complete his work alone."];
                TurnOn("experiment");
            }
            key ("experiment") {
                TurnOff("experiment");
                ["I believe that the experiment had something to do with the teleport storms. Thou wouldst have to speak to Gustacio for more information, though."];
            }
            key ("Gustacio") {
                TurnOff("Gustacio");
                ["Gustacio's specialty lies in manipulating the weather. He spends most of his days sitting and staring at the sky... I can never tell if he is collecting data or catching a few winks!"];
            }
            key ("Filbercio") {
                TurnOff("Filbercio");
                ["Filbercio is the MageLord, which is probably the safest place to keep him. Thou mayest think that doth sound ridiculous, but 'tis one of the only ways we Mages can be assured of what he is doing. As long as Filbercio thinks he doth have power, he is too busy using it to satisfy his hungers to be causing too much trouble. On the other hand, if Filbercio did not think he had power, he would devote all his being to ruining everyone else to procure power."];
                TurnOn(<< "hungers", "trouble" >>);
            }
            key ("hungers") {
                TurnOff("hungers");
                ["The only polite thing I can think of to say is that Filbercio enjoys the company of women... And that he tires of his pursuits soon after he hath won them."];
            }
            key ("trouble") {
                TurnOff("trouble");
                ["Filbercio's true forte lies in playing all sides against each other. He is very subtle in creating the right illusion in which to trap his prey... It always looks enticing, until it flares in thy face. And usually very publicly, too."];
            }
            key ("research") {
                TurnOff("research");
                PushKeys();
                TurnOn("change subject");
                ["I seem to have a talent for discovering forgotten references within the archives. Such information can prove to be the key to a new spell or new aspect of an existing spell."];
                ["For instance, Torrissio hath been paying me outrageous sums to deliver a list of reagents for a certain set of spells. I will not rest until I can justify his faith in me..."];
                ["Luckily, Columna hath been very understanding of the time I devote to my work."];
                TurnOn("Torrissio");
            }
            key ("Torrissio") {
                TurnOff("Torrissio");
                ["Torrissio is a very talented young Mage. His specialty is the creation of the automatons that serve as servants and guards for our mansions."];
                ["He hath a fine eye for detail, even for such menial creatures as servants. Thou mayest see his best work at the Blue Boar -- where he lets Rocco display Petra for him."];
                TurnOn(<< "Blue Boar", "Rocco", "Petra" >>);
            }
            key ("Blue Boar") {
                TurnOff("Blue Boar");
                ["The Blue Boar is the only eating establishment in Moonshade. Therefore, it caters to both Mage and Mundane, unfortunately. Thou mayest meet many other Mages there, if thou art patient enough."];
            }
            key ("Rocco") {
                TurnOff("Rocco");
                ["Rocco is the Mundane innkeeper of the Blue Boar. He is a bit of a surly lout. But then I do not go there for his conversation... only his food."];
                ["His business hath certainly benefitted from Petra's skills. Petra is one of the finest cooks in the city."];
            }
            key ("Petra") {
                TurnOff("Petra");
                ["Petra is one of Torrissio's creations. She is very pretty, for an automaton, and cooks very well. Sometimes I think that Torrissio is as much an artisan as a Mage."];
                ["I think that Petra's presence at the Blue Boar doth do much for Torrissio's reputation..."];
            }
            key ("Mundane") {
                TurnOff("Mundane");
                ["One who doth not possess magic -- that is a Mundane. Without magic, man is little more than a slightly evolved animal. Suited only to be a beast of burden for those whose powers are clearly superior."];
                ["I know nothing about them, nor do I care to. What use is it to note such furtive little lives that pass so quickly and with so little note?"];
                ["Only from time to time hath one caught mine eye... Like that striking young woman that came through here a while ago."];
                TurnOn("young woman");
            }
            key ("young woman") {
                TurnOff("young woman");
                ["To be fair, Columna noticed her first... But then my wife always hath had a fancy for music. And this young woman was singing some sort of ballad about her beloved husband."];
                ["I found it a bit tedious, but Columna was enchanted... so to speak. However, when we spoke to her, she seemed intelligent enough for a Mundane."];
                ["She was asking all sorts of questions about history and such like. -- Her name? Let me see... I believe it was Gwenno. -- Columna directed her to Fedabiblio."];
            }
            key ("Fedabiblio") {
                TurnOff("Fedabiblio");
                ["Fedabiblio is the instructor of all novice Mages. He provides a solid foundation for the principles of magic. And then he passes the students on to the Adepts for more specialized training."];
                ["Of course, at one time all Mages were taught by the Mad Mage. But not any more... Though the tradition of stealing something from him to prove that thou art indeed worthy of a title above novice remains."];
                ["I doubt that he doth have any Serpent Teeth left to steal, so thou wilt have to make do with something else I suspect."];
                TurnOn(<< "Mad Mage", "Serpent Teeth" >>);
            }
            key ("Mad Mage") {
                TurnOff("Mad Mage");
                ["I suppose that it would be polite to refer to him by his name... Erstam. But I am an Adept, and have long since outstripped anything he had to teach me."];
                ["He dreams of becoming a god, and refuses to see his students as his equal. In truth, the Mad Mage is a doddering old man squatting on his island... Afraid of the students that surpassed him and the long march of time that his spells have cheated."];
            }
            key ("Serpent Teeth") {
                TurnOff("Serpent Teeth");
                ["The Mad Mage had a peculiar collection of Serpent's Teeth. Nearly every Adept in the city doth have one that they stole from the old man. It was a juvenile prank I suppose, like tweaking a dragon's beard. But it hath become a tradition, nonetheless."];
                ["I would show thee one, so that thou wouldst know what to take, but I am afraid that I seem to have lost mine. I cannot recall when I last saw it..."];
                ["Perhaps Columna would show thee her Serpent Tooth. I know that she possesses it."];
            }
            key ("Green Enchantress") {
                TurnOff("Green Enchantress");
                ["Thou dost not know the Green Enchantress? Ah, perhaps thou wouldst recognize her by the spell she is famous for... Columna's Intuition."];
                TurnOn(<< "famous", "Columna's Intuition" >>);
            }
            key ("famous") {
                TurnOff("famous");
                ["No other Mage doth have a spell named after them... Of course she is famous! Why everyone agrees how remarkably useful it is!"];
            }
            key ("Columna's Intuition") {
                TurnOff("Columna's Intuition");
                ["Columna is the Green Enchantress' name. And thou wouldst be amazed by her spell..."];
                ["It tells thee of anything hidden and potentially dangerous in the area. It doth not guarantee that what it finds is dangerous, but it doth warn thee."];
            }
            key ("Mosh") {
                TurnOff("Mosh");
                ["She said terrible things about my wife! Terrible! All lies! Lies!"];
                v9 = true;
            }
            key ("wine") {
                TurnOff("wine");
                ["Why, that is wine from the Rangers' winery! Their magical winepress always leaves a distinctive flavor... Quite a tingle!"];
                $knowmagicwine = true;
            }
            key ("apparatus") {
                TurnOff("apparatus");
                ["Any Mage could tell thee that this is a piece of lab equipment!"];
                ["I am missing nothing... 'tis not mine. Thou wilt have to ask others about it."];
            }
            key ("slippers") {
                TurnOff("slippers");
                ["What dost thou take me for, a Mundane?!"];
                ["One merely has to glance at these pitiful things to know that they would belong to no self-respecting Mage! Ask a Mundane or a shopkeeper, indeed!"];
                flag(277) = true;
            }
            key ("Stoneheart") {
                TurnOff("Stoneheart");
                ["I will tell thee that possession of Stoneheart is forbidden in Moonshade. I have no idea where thou didst come by it, nor do I want to know."];
                ["Thou canst find other spells without resorting to those that are restricted."];
                TurnOn(<< "spells", "restricted" >>);
            }
            key ("spells") {
                ["I could sell thee several spells, Mage..."];
                MelinoSellsSpells_i();
            }
            key ("restricted") {
                TurnOff("restricted");
                ["'Tis true that there are spells that require Stoneheart for a reagent, but they are very dangerous. Only a select few Mages are allowed such knowledge... So that it will not be lost."];
            }
            key ("Moonsilk stockings") {
                TurnOff("Moonsilk stockings");
                ["Those are my wife's stockings! Oh, vile fiend! To think that thou wouldst flaunt Columna's indiscretion in my face! After I trusted thee!"];
                ["Out! OUT! Take thyself from my sight and never return!"];
                $melinoangry = true;
                CloseSpeaker0_i();
                Bark_i(2, "@Never return!@", _Melino);
                break;
            }
            key ("change subject") {
                ["Certainly..."];
                PopKeys();
            }
            key ("bye") {
                CloseSpeaker0_i();
                Bark_i(0, "@I must be leaving...@", _Avatar);
                Bark_i(2, "@Farewell!@", _Melino);
                MessengerBringsScroll_i();
                break;
            }
        }
        clear_answers;
    }
}

