        label_8:
        v14 = ~Random(3);
        if (v11 < 2) {
            if (v2 < (v0 + ((v1 - v0) / 4))) {
                if (v14 = 1) {
                    ["Thou art a shrewd and crafty bargainer, to convince me to accept this price..."];
                }
                if (v14 = 2) {
                    ["Art thou certain thou hast not cast a dweomer upon me? I usually do not lower my prices so."];
                }
                if (v14 = 3) {
