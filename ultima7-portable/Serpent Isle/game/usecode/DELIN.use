        flag(418) = true;
    } else {
        v8 = << 0, 30, 35, 25, 4, 8, 150, 100, 200, 25, 300, 550, 75, 100, 120 >>;
        v9 = << 0, 17, 19, 13, 2, 4, 90, 60, 115, 15, 190, 350, 45, 50, 70 >>;
    }
    While v1 {
        if ((flag(417) = true) and (flag(418) = false)) {
            ["Remember, <v0>, I have lowered all of my prices by half just this one time!"];
        }
        v10 = ~AskOrdList(v2);
        if (v10 = 1) {
            v11 = ~rndRange(3, 1);
            if (v11 = 1) {
                v12 = "Hmmm... ah,";
            }
            if (v11 = 2) {
                v12 = "Ah... er,";
            }
            if (v11 = 3) {
                v12 = "Hmmm... I see,";
            }
            v11 = ~rndRange(3, 1);
            if (v11 = 1) {
                v13 = "perhaps later,";
            }
            if (v11 = 2) {
                v13 = "another time then,";
            }
            if (v11 = 3) {
                v13 = "come again,";
            }
            ["<v12> <v13> <v0>."];
            v1 = false;
        } else {
            v14 = v8::v10;
            v15 = 0;
            v11 = ~rndRange(6, 1);
            if (v11 = 1) {
                v16 = "Dost thou accept?";
            }
            if (v11 = 2) {
                v16 = "Dost thou find this price acceptable?";
            }
            if (v11 = 3) {
                v16 = "Let me see... ah, yes! Dost thou find the price agreeable?";
            }
            if (v11 = 4) {
                v16 = "Dost thou agree?";
            }
            if (v11 = 5) {
                v16 = "Is the price acceptable?";
            }
            if (v11 = 6) {
                v16 = "Ah, hmmm... Is the price acceptable?";
            }
            if (v10 = 2) {
                ["Let me think... ah, that will be 300 filari."];
                if ~IsNPCNear(_Alyssand) {
                    SetSpeaker1_i(0, _Alyssand);
                    ["Father! Leather bags sell for <v14> filari!"];
                    CloseSpeaker1_i();
                    SetSpeakerSlot_i(0);
                    ["Ah, er... thou art right, my dear!"];
                } else {
