Routine RevealWildmenEgg_i accepts a0 #locals(6) {
    v0 = ~GetCoord(item);
    if (event = _Trigger) {
        v1 = ~CreateCreature_i(v0, _Neck_Man);
        if v1 {
            Polymorph_i(_Neck_Man, v1);
            Item_destroy(v1);
        }
        v2 = ~GetAllInRegion(_Neck_Man);
        Foreach v5 in v2 {
            ClearItemFlag_i(_Polymorph_i, v5);
        }
    }
}
