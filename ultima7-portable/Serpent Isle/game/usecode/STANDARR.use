Routine Standarr accepts a0 #locals(8) #uses(~LordOrLady, PartyFaces_i, Bark_i, ~AskList, StandarrSellsWeapons_i, StandarrSellsArmour_i, StandarrBuysArmour_i, ~IsInInv, BarkAboutWork_i) {
    v0 = ~LordOrLady();
    if $AVATAR_IS_KNIGHT {
        v0 = "Knight";
    }
    v1 = ~GetItemFlag_i(_Met, _Standarr);
    if (~GetWorkType(_Standarr) = _Blacksmith) {
        v2 = true;
    }
    if (event = _Converse) {
        Item_bark("@Hail there!@", _Avatar);
        PartyFaces_i(65458);
        Bark_i(3, "@Greetings.@", _Standarr);
        SetWorkType(_Talk, _Standarr);
    }
    if (event = _Talking) {
        Npc_schedule(_Standarr);
        ClearBark_i(_Standarr);
        SetSpeaker0_i(0, _Standarr);
        if v1 {
            ["What dost thou wish of me, <v0>?"];
        } else {
            ["I am Standarr the Armourer. What dost thou wish of me?"];
            SetItemFlag_i(_Met, _Standarr);
        }
        if ($askstandarrarmor and not $knowbreastplate) {
            TurnOn("strange breastplate");
        }
        if $standarrknowsbrunt {
            TurnOn("Brunt");
        }
        if $askstandarrfurnace {
            TurnOn("Quests of Courage");
        }
        if $marstenarrested {
            TurnOn("Marsten");
        }
        if $gothelmofmonitor {
            TurnOn("Helm of Monitor");
        }
        if $simonshedsskin {
            TurnOn("Simon");
        }
        if $POMDIRGUN_IS_DEAD {
            TurnOn("Pomdirgun");
        }
        TurnOn(<< "buy", "bye" >>);
        converse {
            key ("Pomdirgun") {
                TurnOn("Pomdirgun");
                ["I envy thee the chance to kill Pomdirgun. I hope thou didst make him suffer!"];
            }
            key ("Helm of Monitor") {
                TurnOff("Helm of Monitor");
                ["Thanks to thee for liberating the Helm of Monitor from the Goblins. Thou hast truly earned the title of Champion Knight."];
            }
            key ("Simon") {
                TurnOff("Simon");
                ["Simon was a Goblin spy! I would never have suspected..."];
            }
            key ("Marsten") {
                TurnOff("Marsten");
                ["Before he was arrested I worked for Marsten. He was, after all, acting Lord of Monitor. I created a new type of weapon for him. A highly combustible powder that exploded when it came in contact with fire. Thou shouldst keep thine eye open for it. It would be a disaster if it ever fell into the hands of the Goblins."];
            }
            key ("Quests of Courage") {
                TurnOff("Quests of Courage");
                ["We Knights on occasion go on what we call Quests of Courage. Many times they involve going into the woods on Goblin raids. Other times they involve entering the depths of a dungeon called Furnace. That place is filled with a withering heat and many monsters live there. Recently, a Knight and good friend of ours named Pendar went off on a quest to Furnace in search of a treasure of which he had heard rumors. He hath not returned, and we worry about him and wonder if we shall ever see him again. Perhaps, he is spending his\x09treasure! Ha!"];
            }
            key ("Brunt") {
                TurnOff("Brunt");
                ["Let me tell thee, when in the trade of blacksmith, one doth develop his muscles. I am no weakling, I can assure thee. But this fellow Brunt who did accompany the sage Batlin through town could probably hoist me with his weak arm. Not the brightest of fellows, mind thee. But strong as an ox! He bested me in the tournament, but not by skill. By sheer muscle."];
            }
            key ("buy") {
                if (~GetWorkType(_Standarr) = _Blacksmith) {
                    ["Wouldst thou be interested in buying or selling?"];
                    v3 = ~AskList(<< "nothing", "buying", "selling" >>);
                    if (v3 = "buying") {
                        ["Wouldst thou care to buy weapons or armour?"];
                        v4 = ~AskList(<< "weapons", "armour" >>);
                        if (v4 = "weapons") {
                            StandarrSellsWeapons_i();
                            TurnOn("buy weapons");
                        } else {
                            StandarrSellsArmour_i();
                            TurnOn("buy armour");
                        }
                    }
                    if (v3 = "selling") {
                        ["I buy only armour, friend, and I do not haggle on the price."];
                        StandarrBuysArmour_i();
                        TurnOn("sell armour");
                    }
                    if (v3 = "nothing") {
                        ["Another time, perhaps."];
                    }
                } else {
                    ["Return when my shop is open, and we can talk business."];
                }
            }
            key ("buy weapons") {
                StandarrSellsWeapons_i();
            }
            key ("buy armour") {
                StandarrSellsArmour_i();
            }
            key ("sell armour") {
                StandarrBuysArmour_i();
            }
            key ("strange breastplate") {
                TurnOff("strange breastplate");
                v5 = ~IsInInv(0, 65177, _White_Brest, 1, _Party);
                if v5 {
                    ["I recognize this!  This is the ornamental breastplate that I made for Kylista, priestess of Fawn."];
                    $knowbreastplate = true;
                } else {
                    ["I am familiar with the making of many types of weapon and armour. A pity thou dost not have it with thee. Without looking at it, I can tell thee no more."];
                }
            }
            key ("bye") {
                CloseSpeaker0_i();
                CloseSpeaker1_i();
                Bark_i(0, "@Stay well!@", _Avatar);
                Bark_i(3, "@Farewell!@", _Standarr);
                break;
            }
        }
        clear_answers;
    }
    if (event = _Bark) {
        v6 = ~rndRange(4, 1);
        if v2 {
            if (v6 = 1) {
                v7 = "@Armour?@";
            }
            if (v6 = 2) {
                v7 = "@We sell the best armour here!@";
            }
            if (v6 = 3) {
                v7 = "@Finest goods here!@";
            }
            if (v6 = 4) {
                v7 = "@Best weapons in Monitor!@";
            }
            Item_bark(v7, _Standarr);
        } else {
            BarkAboutWork_i(_Standarr);
        }
    }
}

