        Npc_schedule(_Columna);
        ClearBark_i(_Columna);
        Kernel_resetRef(_Columna);
        Kernel_resetRef(_Avatar);
        v5 = ~GetItemFlag_i(_Dead, _Stefano);
        if flag(226) && not v5 {
            TurnOn("Stefano");
        }
        v6 = ~IsInInv(0, 65177, _Stockings, 1, _Party);
        if v6 {
            TurnOn("stockings");
        }
        if flag(253) {
            SetSpeaker0_i(1, _Columna);
        } else {
            SetSpeaker0_i(0, _Columna);
        }
        if not $gotspellbook {
            ["I am sorry, but thou hast mistaken me for someone else. Thou couldst not possibly be speaking to me, as I am a Mage... and thou art merely Mundane."];
            Bark_i(0, "@Honestly!@", _Columna);
            terminate;
        }
        v7 = ~GetItemFlag_i(_Met, _Columna);
        if (v7 = false) {
            SetItemFlag_i(_Met, _Columna);
            ["I do not believe that we've met. It is so nice to make the acquaintance of a new, young Mage."];
            ["I am Columna, the Green Enchantress."];
        } else {
            ["Welcome, Mage. I am pleased to see thee again."];
        }
        if ($moshsaidcolumna and not $moshfriend) {
            TurnOn(<< "Mosh" >>);
        }
        if ($magesknowapparati and not $knowlabitem) {
            TurnOn("apparatus");
        }
        TurnOn(<< "Green Enchantress", "bye" >>);
        converse {
            key ("Green Enchantress") {
                TurnOff("Green Enchantress");
                ["My name is Columna. Sorceress, wife of Melino, and I am also the most desired beauty in Moonshade."];
                if flag(253) {
                    ["Is that not a funny joke?! Me, a decrepit hag?! The most desired beauty in all of Moonshade?! Once, in my time... In my time..."];
                }
                TurnOn(<< "sorceress", "Melino", "beauty" >>);
            }
            key ("sorceress") {
                TurnOff("sorceress");
                ["Perhaps I could interest thee in a spell. Many strange travellers have come from across the Serpent Isle to learn spells from me. But that, of course, was before the Teleport Storms."];
                TurnOn(<< "buy spells", "strange travellers", "teleport storms" >>);
            }
            key ("apparatus") {
                TurnOff("apparatus");
                v8 = ~IsInInv(1, 65177, _Al_App_1, 1, _Party);
                if v8 {
                    ["This laboratory equipment must surely belong to Erstam, the Mad Mage! It bears the unmistakably foul stench of one of his experiments."];
                    $knowlabitem = true;
                } else {
                    ["Without being able to actually look at the item thou hast mentioned, I can tell thee nothing."];
                }
            }
            key ("teleport storms") {
                TurnOff("teleport storms");
                ["Since these vile telport storms began all sea travel has virtually stopped. Even long range travel over land is considered to be extremely dangerous!"];
            }
            key ("buy spells") {
                ColumnaSellsSpells_i();
            }
            key ("strange travellers") {
                TurnOff("strange travellers");
                ["Many weeks ago a woman named Gwenno passed through Moonshade, and more recently a sage named Batlin."];
                TurnOn(<< "Gwenno", "Batlin" >>);
            }
            key ("Gwenno") {
                TurnOff("Gwenno");
                ["The one and only time I saw her she was singing a love song about her husband, Iolo. But she made quite an impression on some people while she was here. If thou dost wish to know more of her, then ask around."];
            }
            key ("Batlin") {
                TurnOff("Batlin");
                ["He came through town with a strange daemon creature as his companion and servant, and he had some sort of artifact in his possession."];
                TurnOn(<< "daemon", "artifact" >>);
            }
            key ("daemon") {
                TurnOff("daemon");
                ["'Twas male, and had bright red skin. But there were no horns on its head -- I swear. I believe its name was Palos."];
            }
            key ("artifact") {
                TurnOff("artifact");
                ["I personally did not see it, but I know that Gustacio did."];
            }
            key ("Melino") {
                TurnOff("Melino");
                ["I shall have thee know that mine husband is most influential with the Council of Mages. And is perfectly capable of satisfying my needs in nearly all other ways."];
                TurnOn(<< "influential", "satisfying needs" >>);
            }
            key ("influential") {
                TurnOff("influential");
                ["He is a close and trusted advisor to Filbercio, the MageLord of Moonshade and senior member of the Council."];
            }
            key ("satisfying needs") {
                TurnOff("satisfying needs");
                ["Oh, worry thyself not. I am not one to allow my needs to go unsatisfied."];
            }
            key ("beauty") {
                TurnOff("beauty");
                if flag(253) {
                    ["Without my precious comb, all of my beauty hath long faded."];
                } else {
                    ["Yes, in truth it hath always been so, and shall always be. My natural good looks must be the result of my good breeding."];
                }
            }
            key ("Stefano") {
                TurnOff("Stefano");
                ["'Twas Stefano who stole my stockings from Torrissio's house in an attempt to blackmail us over our affair."];
                if flag(569) {
                    ["Now that he is returned to Moonshade, we have already seen to it that he shall die for what he tried to do to us."];
                } else {
                    ["My sincerest wish is that he rot slowly in Filbercio's mountain prison."];
                }
            }
            key ("stockings") {
                TurnOff("stockings");
                if v1 {
                    ["Those stockings thou dost have in thy possession are rightfully my property. They can be used by people to humiliate me and destroy my marriage. As one woman to another, I appeal to thee for understanding. If thou dost return them to me I will give to thee a spell from my personal spellbook. Wilt thou please return them to me?"];
                    v9 = ~AskYesNo();
                    if v9 {
                        v10 = ~TakeFromParty_i(true, 0, _All, _Stockings, 1);
                        ["Ha! There was thy spell, foolish woman! Now the stockings are destroyed and they shall trouble me no more!"];
                        Bark_i(0, "@Fool!@", _Columna);
                        SetWorkType(_Wander, _Columna);
                        terminate;
                    } else {
                        ["Please, I beg of thee to reconsider."];
                    }
                } else {
                    ["Thou hast my stockings in thy possession. They are my intimate apparel and they do not belong in thy backpack. They belong on my creamy thighs. I am a woman and thou art a man and thou dost have me at an advantage. If thou wouldst but return them, I shall be happy to wear them for thee, in a night of passion that thou shalt remember all of thy days. May I have them now?"];
                    v11 = ~AskYesNo();
                    if v11 {
                        v12 = ~TakeFromParty_i(true, 0, _All, _Stockings, 1);
                        if $gotspellbook {
                            ["Ha! Dost thou think that because thou art now a Mage, that thou art equal to me? I reject thine advances, mage."];
                        } else {
                            ["Ha! Thou dost think I would squander my lust on the likes of thee?! A Mundane!!! I laugh at thee."];
                        }
                        ["The stockings have now been destroyed by my magics. Thou dost have no hold over me, nor shall anyone else!"];
                    } else {
                        ["Please, I beg of thee to reconsider."];
                    }
                }
            }
            key ("Mosh") {
                TurnOff("Mosh");
                ["So thou hast been spending thy time with beggars and thieves? This does not speak well of thy character, <v2>."];
                ["No doubt she hath defamed me. What tales she tells! Of course, she is merely jealous of my position in society, and of my powers."];
                ["Let me say this plainly. Mosh lies. She hath ruined herself with cruel indulgences, and now she is half mad."];
                ["Why, she sleeps with her rats! I ask thee, is this the action of a respectable mage?"];
                $columnasaidlies = true;
            }
            key ("bye") {
                CloseSpeaker0_i();
                Bark_i(0, "@I must be going...@", _Avatar);
                Bark_i(2, "@Farewell!@", _Columna);
                MessengerBringsScroll_i();
                break;
            }
        }
        clear_answers;
    }
}

