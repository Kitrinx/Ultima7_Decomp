Routine Columna accepts a0 #locals(13) #uses(~AvatarName, PartyFaces_i, Bark_i, ~IsInInv, ColumnaSellsSpells_i, ~AskYesNo, MessengerBringsScroll_i) {
    v0 = "Mundane";
    if $gotspellbook {
        v0 = "Mage";
    }
    v1 = ~AvatarSex();
    v2 = ~AvatarName();
    v3 = ~GetTime();
    if ((v3 > 1) or (v3 < 6)) {
        v3 = "day";
    } else {
        v3 = "evening";
    }
    if (event = _Converse) {
        Item_bark("Hello, there.", _Avatar);
        PartyFaces_i(65522);
        Bark_i(2, (("@Greetings, " + v0) + "."), _Columna);
        SetWorkType(_Talk, _Columna);
    }
    if ((event = _NearDeath) and ~GetItemFlag_i(_Tournament, item)) {
        v4 = ~PostAction(<< _aNO_HALT_i, _aUSABLE_i, #Black_Mage >>, item);
    }
    if (event = _Bark) {
        SetWorkType(_Lab, item);
    }
