Routine FitchEgg_i accepts a0 #locals(1) #uses(Bark_i) {
    if (event = _Trigger) {
        Item_bark("@Help me...@", _Fitch);
        v0 = ~PostInFuture(10, << _aNO_HALT_i, _aUSABLE_i, #FitchEgg_i >>, _Avatar);
    }
    if (event = _Action) {
        SetSpeaker0_i(0, _Ratman2);
        ["Oh, the pain... The end is near..."];
        TurnOn(<< "Who art thou?", "What happened?" >>);
        converse {
            key ("Who art thou?") {
                ["Me name's Fitch. Me and me mates were trappers for Hazard."];
                TurnOff("Who art thou?");
            }
            key ("What happened?") {
                ["Several days ago we were camped in a nearby cave when we were attacked by a terrible sorceress."];
                [Evil she was, striking men dead before we knew what was upon us. We slew her, though she took many men with her even as she fell. Only I survived, though I fear not for long."];
                TurnOff("What happened?");
                TurnOn("Rest easy.");
            }
            key ("Rest easy.") {
                ["I am glad thou didst find me. I'd have hated to have died out here alone..."];
                Bark_i(0, "@The pain!@", _Fitch);
                CloseSpeaker0_i();
                CloseSpeaker1_i();
                v0 = ~PostInFuture(5, << _aNO_HALT_i, _aHIT_i, 50, 0 >>, _Fitch);
                break;
            }
        }
        clear_answers;
    }
}

