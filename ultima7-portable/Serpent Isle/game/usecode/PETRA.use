            key ("tale") {
                TurnOff("tale");
                ["Rocco hath led everyone to believe that he and Torrissio reached an agreement to have me work here to advertise Torrissio's skill."];
                ["In truth, my cooking ability doth do Torrissio no small credit. And I dare say that it wins him many customers as well."];
