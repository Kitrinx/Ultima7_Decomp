Routine ShowSpeechText_i accepts a0 #locals(6) {
    v0 = ~SpeechTrack_i();
    if ((v0 >= 0) and (v0 < 21)) {
        v1 = ~Npc_getEquip(7, _Avatar);
        v1 = (v1 & ~Npc_getEquip(8, _Avatar));
        v2 = 65236;
        Foreach v5 in v1 {
            if ((~Item_getType(v5) = _Ring) and (~GetFrame(v5) = 2)) {
                v2 = 65241;
            }
        }
    }
    if (v0 = 0) {
        SetSpeaker(0, v2);
        ["Hasten! The Imbalance grows stronger..."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 1) {
        SetSpeaker(0, v2);
        ["His mission here is finished. He may now depart for the Void."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 2) {
        SetSpeaker(0, v2);
        ["Look into the Moons' Eye."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 3) {
        SetSpeaker(0, v2);
        ["Thou hast forgotten something."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 4) {
        SetSpeaker(0, v2);
        ["Place the Staff, Armour, and Crown on the Altar."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 5) {
        SetSpeaker(0, v2);
        ["Return when thou hast the Three Artifacts of the Great Hierophant: Staff, Armour, and Crown."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 6) {
        SetSpeaker(0, v2);
        ["The Blackrock Serpents... thou must have the three Serpents of Blackrock."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 7) {
        SetSpeaker(0, v2);
        ["Thou art in Balance, having mastered both Chaos and Order. I declare thee worthy to bear the emblems of the Great Hierophant of Balance."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 8) {
        SetSpeaker(0, v2);
        ["Now place the Eyes of the Serpent before my statue."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 9) {
        SetSpeaker(0, v2);
        ["Slay me! Slay me with the Serpent Sword, and send my soul back into the Void!"];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 10) {
        SetSpeaker(0, v2);
        ["Seek the Temple, and within it, the Eye of the Moon."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 11) {
        SetSpeaker(0, v2);
        ["Free Gwenno... free her from the ice!"];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 12) {
        SetSpeaker(0, v2);
        ["Time is short. Move on."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 13) {
        SetSpeaker(0, v2);
        ["The wizard... the key is the dead wizard... thou must vanquish him."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 14) {
        SetSpeaker(0, v2);
        ["The ashes... place the Ashes on the altar."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 15) {
        SetSpeaker(0, v2);
        ["Bane of Chaos... Chaos Bane... twisted her soul..."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 16) {
        SetSpeaker(0, v2);
        ["A new Hero has entered this world... am I dreaming, or is he real?"];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 17) {
        SetSpeaker(0, v2);
        ["Who art thou, stranger? Why can't I see thee? Curse this Imbalance which veils my mind..."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 18) {
        SetSpeaker(0, v2);
        ["I know that we have met before, Stranger. Dost thou not recall?"];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 19) {
        SetSpeaker(0, v2);
        ["Hero from Another World! Know that it is I, the Great Earth Serpent, whom thou liberated from imprisonment in the days of Exodus the Destroyer. If only thou couldst help me now, Avatar."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 20) {
        SetSpeaker(0, v2);
        ["Seek the Horn... the Gwani Horn... seek it in the depths beneath the Skullcrusher Mountains."];
        CloseSpeaker(v2);
        return;
    }
    if (v0 = 21) {
        SetSpeaker(0, 65240);
        ["Pleasant dreams, Avatar..."];
        ["Ha ha hah hah!"];
        CloseSpeaker(65240);
        return;
    }
    if (v0 = 22) {
        SetSpeaker(0, 65240);
        ["See how I reward those who fail me!"];
        ["Hah hah hah hah!"];
        CloseSpeaker(65240);
        return;
    }
    if (v0 = 23) {
        SetSpeaker(0, _SuperGoblin);
        ["Hah hah hah hah!"];
        CloseSpeaker(_SuperGoblin);
        return;
    }
    if (v0 = 24) {
        SetSpeaker(0, _SuperGoblin);
        ["I have paid my debt to thee, and our bargain is concluded. I shall not aid thee again. Beware the Banes of Chaos, Avatar!"];
        CloseSpeaker(_SuperGoblin);
        return;
    }
    if (v0 = 25) {
        SetSpeaker(0, _DBeyer);
        ["Avatar! It is I, Dupre! My soul has been fused with the Serpent of Chaos. I am keeping it from attacking thee, but I do not know how much longer I can hold out! Quickly! Thou must go to Sunrise Isle!"];
        CloseSpeaker(_DBeyer);
        return;
    }
    if (v0 = 26) {
        SetSpeaker(0, _Vasculio);
        ["Dost thou think that thou canst chain the Serpent of Order within a prison of Balance? Never! Servants of Order, attack!"];
        CloseSpeaker(_Vasculio);
        return;
    }
}
