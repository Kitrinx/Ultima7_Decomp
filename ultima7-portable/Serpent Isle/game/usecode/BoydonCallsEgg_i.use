Routine BoydonCallsEgg_i accepts a0 #locals(4) {
    v0 = ~FindNearby_i(0, 10, _Body_Parts, item);
    Foreach v3 in v0 {
        if (~GetFrame(v3) = 18) {
            v0 = ~PostAction(<< _aNO_HALT_i, _aBARK_i, "@Thou, stop!@", _aWAIT_i, 15, _aBARK_i, "@Wouldst thou talk with me?@", _aWAIT_i, 20, _aBARK_i, "@Please...@" >>, v3);
        }
    }
}
