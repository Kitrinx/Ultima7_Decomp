Routine GauntletsOfQuickness accepts a0 #locals(7) #uses(GivePartyExp_i) {
    if ((event = _Equip) or (event = _Unequip)) {
        v0 = ~Item_getContainer(item);
        While ((v0 <> 0) and not ~Item_isNpc(v0)) {
            v0 = ~Item_getContainer(v0);
        }
        if (v0 = 0) {
            FlashMouse_i(0);
            return;
        }
    }
    if (event = _Equip) && ~Npc_getEquip(5, ~Item_getContainer(item)) {
        if not flag(761) {
            GivePartyExp_i(1000);
            flag(761) = true;
        }
        if not $WEARING_GAUNTLETS_OF_QUICKNESS {
            v1 = ~GetNPCStat_i(_Dex, v0);
            v2 = (30 - v1);
            if (v2 > 10) {
                v2 = 10;
            }
            v3 = ~SetQuality(v2, item);
            v4 = ~ChangeNPCStat_i(v2, _Dex, v0);
            if v4 {
                $WEARING_GAUNTLETS_OF_QUICKNESS = true;
            }
        }
    }
    if (event = _Unequip) && $WEARING_GAUNTLETS_OF_QUICKNESS {
        v5 = ~GetQuality(item);
        v6 = (65535 * v5);
        v4 = ~ChangeNPCStat_i(v6, _Dex, v0);
        if v4 {
            $WEARING_GAUNTLETS_OF_QUICKNESS = false;
        }
    }
}
