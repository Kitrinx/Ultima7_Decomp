Routine Thief1 accepts a0 #locals(8) #uses(Bark_i, AttackAvatar_i) {
    if (event = _Converse) {
        Item_bark("@Water, please!@", _Thief1);
    }
    if (event = _Talking) {
        SetWorkType(_TendShop, _Thief1);
        Item_bark("@Water, please!@", _Thief1);
        v0 = ~PostInFuture(80, << _aNO_HALT_i, _aUSABLE_i, #Thief1 >>, _Thief1);
    }
    if (event = _Talking) {
        v1 = ~rndRange(3, 1);
        v2 = << "Give me some water!", "Water! I'm thirsty!", "I must have water!" >>;
        v3 = v2::v1;
        Item_bark(v3, _Thief1);
    }
    if (event = _Action) {
        v4 = ~FindNearby_i(8, 40, _All, item);
        Foreach v7 in v4 {
            if not ~GetItemFlag_i(_InParty_i, v7) {
                ClearItemFlag_i(_Asleep, v7);
                ClearBark_i(v7);
                Bark_i(0, "@Water!@", v7);
                AttackAvatar_i(v7);
            }
        }
    }
}
