            v2 = ~SetQuality(3, item);
            v2 = ~PostInFuture(10, << _aUSABLE_i, #KnightsTestSummonEgg_i >>, item);
        }
        if (v1 = 2) {
            v3 = ~CreateCreature_i(v0, _Cyclops);
