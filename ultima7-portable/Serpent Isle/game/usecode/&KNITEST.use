        v1 = ~GetQuality(item);
        createSprite(65535, 0, 0, 0, v0::2, v0::1, 13);
        if (v1 = 0) {
            PrintError_i("Egg quality not set.");
        }
        if (v1 = 1) {
            v2 = ~CreateCreature_i(v0, _MgGremlin);
