Routine Harnna accepts a0 #locals(15) #uses(~IsInInv, ~LordOrLady, SetWorkTypeAt_i, PartyFaces_i, Bark_i, ~AskYesNo, ~GiveItemsOrDrop_i, ~PartyUtters, HarnnaHeals_i, HarnnaSellsProduce_i, ~UsePatience_i, ~RemoveFromList_i) {
    v0 = ~GetTime();
    v1 = ~IsInInv(15, 65177, _Reagents, 1, _Party);
    v2 = ~LordOrLady();
    if ((v0 > 1) or (v0 < 6)) {
        v0 = "day";
    } else {
        v0 = "evening";
    }
    v3 = false;
    if (event = _NearDeath) {
        v4 = ~PostAction(<< _aUSABLE_i, #Paladin >>, item);
    }
    if (event = _Action) {
        SetWorkTypeAt_i(_Talk, 65535, 65535, _Harnna);
    }
    if (event = _Converse) {
        Item_bark("@Greetings, milady.@", _Avatar);
        PartyFaces_i(65469);
        Bark_i(2, "@Greetings to thee.@", _Harnna);
        SetWorkType(_Talk, _Harnna);
    }
    if (event = _Talking) {
        ClearBark_i(_Harnna);
        Npc_schedule(_Harnna);
        SetSpeaker0_i(0, _Harnna);
        if ($harnnasaidcrystalball and not $takencantraquest) {
            if $cantravisiondone {
                RevertSchedule_i(_Harnna);
                Npc_schedule(_Harnna);
                ["As thou hast now seen, the peril that faces Cantra doth go beyond merely being taken by the Goblins. Some foul thing doth possess her."];
                ["The worst the Goblins could do would be to kill her and destroy her body. This new uncertain danger is nothing less than a threat to her spirit, the very essence of her being!"];
                ["I implore thee, please find her and rescue her. It is certain to be a perilous undertaking and I cannot blame thee if thou wouldst refuse the pleas of a simple woman."];
                ["But none of the other Knights believe in the visions of the crystal ball. They believe that Cantra hath been taken away by the goblins, and that she is already dead."];
                ["Thou art mine only hope! Wilt thou please find my daughter Cantra and return her to me?"];
                if ~AskYesNo() {
                    $takencantraquest = true;
                    ["Oh, I thank thee from the bottom of mine heart for thy kindness and thy bravery!"];
                    ["To find Cantra, thou wilt need two things. The first of these is Cantra's practice sword. I can give that to thee now."];
                    v4 = ~GiveItemsOrDrop_i(true, 0, 0, 65177, 520, 1, _Avatar);
                    ["This is the very same practice sword that Cantra used every day."];
                    ["Now that thou hast my daughter's sword, thou shouldst find one of the legendary Hounds of Doskar. They will be able to sniff Cantra's essence from the sword, and then track her to anywhere in the Serpent Isle."];
                    ["The only dilemma thou dost face now is to find one of the Hounds of Doskar. I do not know where one may be found, but I foresee that thou must find the Hound before thou canst rescue my daughter."];
                    SetWorkType(_Shy, _Harnna);
                } else {
                    ["Then mine only daughter Cantra shall soon be dead... or worse. Leave thou me now."];
                    SetWorkType(_Shy, _Harnna);
                    Bark_i(0, "@Oh...@", _Harnna);
                    terminate;
                }
            } else {
                ["Thou must find the crystal and gaze into it. Go to mine home. It is there, on the table."];
                ["I beg of thee, for thy sake as well as the sake of my missing child, look into the glass."];
                Bark_i(0, "@The crystal!@", _Harnna);
                terminate;
            }
        } else {
            if $AVATAR_IS_KNIGHT {
                if not $cantrataken {
                    ["My daughter Cantra is missing! I know she would never run away from me, but I feel certain that the Goblins did not take her."];
                    $cantrataken = true;
                    if not ~GetItemFlag_i(_Met, _Harnna) {
                        ["Pray excuse my poor manners, stranger! I am Widow Harnna, the Healer of Monitor. I also sell vegetables from my garden."];
                        TurnOn(<< "widow", "healing", "food", "information" >>);
                        SetItemFlag_i(_Met, _Harnna);
                    } else {
                        ["Pray excuse mine outburst, <v2>! How may I help thee now? Dost thou have need of healing, or dost thou wish to buy my vegetables?"];
                    }
                    TurnOn(<< "healing", "food", "information" >>);
                } else {
                    if not ~GetItemFlag_i(_Met, _Harnna) {
                        ["I am Widow Harnna, the Healer of Monitor. I also sell vegetables from my garden."];
                        TurnOn(<< "widow", "healing", "food", "information" >>);
                        SetItemFlag_i(_Met, _Harnna);
                    } else {
                        ["How may I help thee now? Dost thou have need of healing, or dost thou wish to buy my vegetables?"];
                    }
                    TurnOn(<< "healing", "food", "information" >>);
                }
            } else {
                v4 = ~FindNearby_i(0, 20, _Plaque, _Harnna);
                Foreach v7 in v4 {
                    if (~GetQuality(v7) = 72) {
                        ["Perhaps we may speak at another time. Mine husband is recently dead, and I am in mourning."];
                        terminate;
                    }
                }
                if not ~GetItemFlag_i(_Met, _Harnna) {
                    ["How may I help thee? I am Widow Harnna, the Healer of Monitor. I also grow mine own food."];
                    TurnOn(<< "widow", "healing", "food", "information" >>);
                    SetItemFlag_i(_Met, _Harnna);
                } else {
                    ["How may I help thee now? Dost thou have need of healing, or dost thou wish to buy my vegetables?"];
                }
                TurnOn(<< "healing", "food", "information" >>);
            }
        }
        if ($takencantraquest and not $BATLIN_FLED_SHAMINOS_KEEP) {
            TurnOn("prophecy");
            v3 = true;
        }
        if $cantrataken {
            TurnOn("Cantra");
        }
        if ($FOUND_CANTRAS_FATHER and not $TOLD_HARNNA_FOUND_SCROLL) {
            TurnOn("found scroll");
        }
        if ($KNOWS_ABOUT_VARO_LEAVES and (not flag(421) and ($poisonedbylydia and not $CURED_LYDIA_POISON))) {
            TurnOn(<< "Varo leaves", "pox" >>);
        }
        if $POMDIRGUN_IS_DEAD {
            TurnOn("Pomdirgun");
        }
        if ($KNOWS_ABOUT_VARO_LEAVES and $poisonedbylydia) {
            TurnOn("pox");
        }
        if ($TOLD_MARSTEN_SERVES_LORD_BRITISH and not $RENOUNCED_BRITISH) {
            TurnOn("Marsten");
        }
        v8 = 2;
        if $AVATAR_IS_KNIGHT {
            v8 = 6;
        }
        if $takencantraquest {
            v8 = 12;
        }
        v9 = 0;
        TurnOn("bye");
        converse {
            key ("Marsten") {
                TurnOff("Marsten");
                if $marstenarrested {
                    ["I am glad that miserable traitor is no longer Lord of Monitor!"];
                } else {
                    ["He is the Lord of the Town. Thou shouldst talk to him if thou hast not already."];
                }
            }
            key ("widow") {
                TurnOff("widow");
                ["My beloved husband was slain while doing his duty, so I should have no complaints. Though Goblins have taken his life, they too shall die."];
                ["But it hath been hard on Cantra. A girl at her age needs a father, dost not thou agree?"];
                TurnOn(<< "Cantra", "father" >>);
            }
            key ("Pomdirgun") {
                TurnOff("Pomdirgun");
                ["I truly believe it is wrong to wish harm to any living creature, but the world is far better without that foul creature Pomdirgun alive. Thy deed was fair."];
            }
            key ("Cantra") {
                TurnOff("Cantra");
                if $BATLIN_FLED_SHAMINOS_KEEP {
                    if $TOLD_CANTRA_IS_ALIVE {
                        ["It is a comfort to know that my daughter is among the monks. Yet I have a foreboding..."];
                        ["Something is coming to me... a thought... a premonition..."];
                        ["Go! The monks have need of thee. My daughter hath need of thee!"];
                        Bark_i(0, "@Go to Monk Isle!@", _Harnna);
                        terminate;
                    } else {
                        ["I know that mine only daughter Cantra is now dead. Her spirit hath been haunting me. She is suffering and tormented."];
                        v10 = ~PartyUtters(false, "@The monks have taken Cantra to their island.@", "@The monks have taken Cantra to their island.@", 65534);
                        SetSpeakerSlot_i(0);
                        ["I thank thee! Perhaps now there is hope that my daughter shall return home to me."];
                        $TOLD_CANTRA_IS_ALIVE = true;
                    }
                } else {
                    if not $cantrataken {
                        ["Cantra misses her father terribly. He hath been gone for many weeks..."];
                        ["She is nearly ready to become a Knight herself now. Her father would be so proud of her!"];
                        ["She is so serious about becoming a Knight. All she ever does is practice with her wooden sword."];
                        TurnOn("father");
                    } else {
                        if not $harnnasaidcrystalball {
                            ["Dost thou believe in magic?"];
                            if ~AskYesNo() {
                                ["That is good, for what I have to show thee would befuddle the minds of most of this town's inhabitants."];
                            } else {
                                ["I would wager that there is some tiny bit of belief in thine heart, but if not, then it is time that thou wert properly enlightened."];
                                ["What I have to show thee should quell any doubts thou mayest yet have."];
                            }
                            $harnnasaidcrystalball = true;
                            if (~GetWorkType(_Harnna) <> _Patrol) {
                                ["Go to mine home. There thou shalt find a crystal ball. Gaze into it, and let thy mind be clear."];
                            } else {
                                ["Look into my crystal ball. Thou shalt find it on the table within mine home. Let thy mind be clear."];
                            }
                            Bark_i(0, "@The crystal!@", _Harnna);
                            terminate;
                        } else {
                            if not $cantraresurrected {
                                ["I am so grateful that thou hast taken on the quest of saving my daughter. If I can help thee, ask."];
                            } else {
                                if ~GetItemFlag_i(_Zombie, _Cantra) {
                                    ["I am glad that my daughter is alive, but I have a strange foreboding that all is not as it should be with her. A small private part of her is still awash in madness and death."];
                                } else {
                                    ["I am so happy my daughter hath been found, resurrected by the monks, and that thou hast restored her mind."];
                                }
                            }
                        }
                    }
                }
            }
            key ("father") {
                TurnOff("father");
                ["The Knights say that there is glory in the way that Cantra's father died, but they do not see the truth. He did his duty, not to earn their respect, but out of love for his family."];
                ["This type of courage, and the source of it, is something the Knights of Monitor do not understand. And until they gain that understanding, there will be no winning this war with the Goblins."];
            }
            key ("healing") {
                ["I am not a magical healer. Monitorians are quite suspicious of magic. I use a natural healing method, which uses herbs. Art thou in need of a healer?"];
                if ($poisonedbylydia and (flag(194) and not $CURED_LYDIA_POISON)) {
                    v10 = ~PartyUtters(false, "@Oh... yes... mine head...@", "@The Avatar is burning with fever!@", 65533);
                    SetSpeakerSlot_i(0);
                    if ($KNOWS_ABOUT_VARO_LEAVES = false) {
                        ["I can temporarily restore thy body, but thou art suffering from an affliction that cannot easily be cured."];
                        ["Such a pox may wear off in time if thou art extremely lucky, but thou canst only be permanently cured by a special ointment made from Varo leaves."];
                        TurnOn("pox");
                        if (flag(421) = true) {
                            ["Ah, thou hast spoken with Delphynia already! Dost thou have the Varo leaves?"];
                            if ~AskYesNo() {
                                goto label_102;
                            } else {
                                ["Go thou quickly to Fawn and see if she doth have more of the leaves!"];
                            }
                        } else {
                            TurnOn("Varo leaves");
                        }
                        $KNOWS_ABOUT_VARO_LEAVES = true;
                        HarnnaHeals_i();
                        goto label_107;
                    }
                    label_102:
                    if ~TakeFromParty_i(false, 3, _All, _Magic_Plants, 5) {
                        ["Now that I have the proper ingredients, it is a simple matter to cure thee."];
                        ["Hold thou still while I apply these directly upon thy tattoo..."];
                        ["There, 'tis done. Thine infection hath been healed."];
                        $CURED_LYDIA_POISON = true;
                        ClearItemFlag_i(_Poisoned, _Avatar);
                    } else {
                        if ~GetItemFlag_i(_Poisoned, _Avatar) {
                            ["My cure can have only a temporary effect, for thou art enthralled by a powerful disease."];
                        }
                        ["In order for me to provide a permanent cure to thine affliction, thou must bring me five leaves of the Varo plant."];
                        HarnnaHeals_i();
                        Bark_i(0, "@Quickly...@", _Harnna);
                        terminate;
                    }
                    label_107:
                } else {
                    if ~AskYesNo() {
                        HarnnaHeals_i();
                    } else {
                        ["If thou art ever in need of a healer, I shall be ready to assist thee."];
                    }
                }
            }
            key ("Varo leaves") {
                TurnOff("Varo leaves");
                ["These leaves are now scarce, as the Varo grows only with abundant sunlight, and we have had clouded skies for many months."];
                ["Go thou and see Delphynia, the horticulturist in Fawn. Perhaps she will have a supply of leaves."];
            }
            key ("pox") {
                TurnOff("pox");
                if ($LYDIA_CONFESSES = true) {
                    ["Didst thou speak with Lydia?"];
                    SetSpeaker1_i(0, _Avatar);
                    ["Indeed, the wench hath confessed to her crime!"];
                    if ~GetItemFlag_i(_Dead, _Lydia) {
                        ["Moreover, she hath paid for her treachery in blood. She is slain."];
                    }
                    CloseSpeaker1_i();
                    SetSpeakerSlot_i(0);
                    ["I see. Thou dost appear to have many enemies in my land, <v2>. Be thou careful whom thou dost trust!"];
                } else {
                    ["Thy suffering came from no accidental affliction -- the venom which mixes with thy blood is not common."];
                    v10 = ~PartyUtters(false, 0, "@Who did this to the Avatar?@", 65535);
                    if (v10 <> 65180) {
                        SetSpeakerSlot_i(0);
                    }
                    ["I strongly suspect that the source of thine infection is the tattoo thou hast been given."];
                    ["I know that Lydia must have given thee this tattoo, yet I find it difficult to believe she would poison a stranger."];
                    ["Thou shouldst have words with her, I think."];
                    $CAN_ASK_LYDIA_ABOUT_POISON = true;
                    Npc_setAlignment(_Chaotic, _Lydia);
                    SetItemFlag_i(_Tournament, _Lydia);
                }
                flag(203) = true;
            }
            key ("food") {
                ["I grow vegetables to feed the town, and sometimes to trade. What dost thou wish to purchase?"];
                HarnnaSellsProduce_i();
            }
            key ("prophecy") {
                TurnOff("prophecy");
                if $hasserpentnecklace {
                    ["I sense that thou hast completed the Quest of the Three Artifacts."];
                } else {
                    ["Thou shalt need three ancient and powerful artifacts to complete thy tasks. One of these is a helm. It seems very familiar to me..."];
                    if $gothelmofmonitor {
                        ["But of course! It is the Helm of Monitor, which thou didst recover from the Goblins!"];
                        ["Thou shalt yet need that artifact in thy journeys."];
                    }
                }
                ["Thy quest shall be long and difficult. Many are the adventures that thou must undertake. Seemingly unconnected events shall prosper thee in thy seeking of my lost daughter."];
                if $AUDIENCE_WITH_YELINDA {
                    ["Thou mayest find this hard to believe, but my dreams tell me that thy sojourn in Fawn hath been of benefit to thy quest."];
                }
                ["Thy travels shall take thee north. Far north through caves that lie to the west... I can feel the cold wind blowing upon thee."];
                if ($AUDIENCE_WITH_YELINDA and $gothelmofmonitor) {
                    ["I sense that now is the time to go north. All is ready for thy success."];
                }
                ["I see no more."];
            }
            key ("information") {
                if (not $startharnnagossip or (~GetClock(2) > 4)) {
                    ["What dost thou desire to know?"];
                    PushKeys();
                    v9 = 1;
                    TurnOn(<< "people", "places", "strange objects", "nothing more" >>);
                } else {
                    ["I must be about my duties. We must discuss this another time."];
                }
            }
            key ("people") {
                if not $knowcommands {
                    ["The citizens of Monitor are all Knights, and they belong to one of three Commands: the Bears, Wolves, or Leopards."];
                }
                ["About which Command dost thou desire to inquire?"];
                PushKeys();
                v9 = 2;
                TurnOn(<< "Bears", "Wolves", "Leopards", "visitors", "nothing more" >>);
            }
            key ("Bears") {
                TurnOff("Bears");
                ["The Bears are strong and brave, and known for their triumphs in the arena. About whom dost thou wish to inquire?"];
                PushKeys();
                v9 = 3;
                TurnOn(<< "Caladin", "Luther", "Simon", "Flicken", "Templar", "Lydia", "nothing more" >>);
            }
            key ("Caladin") {
                TurnOff("Caladin");
                ["He is the leader of the Bear Command, and the commander of the Pikemen. A good, decent man and a hardened veteran of many a tough battle. He doth hate Goblins with a passion."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Luther") {
                TurnOff("Luther");
                ["Luther is one of the Bear Command. He is a proven and respected fighter on the battlefield, but off the field he is somewhat of a bully. Best to stay clear of him, I say."];
                ["'Tis said that he doth have a terrible temper. Luther loses control and simply begins swinging."];
                v8 = ~UsePatience_i(v8);
            }
            key ("found scroll") {
                TurnOff("found scroll");
                ["A scroll? What dost thou mean?"];
                SetSpeaker1_i(0, _Avatar);
                ["I found a scroll, obviously written by Cantra, upon the body of a slain Pikeman. 'Twas thine husband I fear. He was betrayed..."];
                CloseSpeaker1_i();
                SetSpeakerSlot_i(0);
                ["I thank thee, <v2>, for solving the mystery of mine husband's disappearance. 'Tis better to know what truly happened than to be left knowing nothing. I have grieved for mine husband, and I shed tears not for him, but for myself and the waste that all hath become."];
                $TOLD_HARNNA_FOUND_SCROLL = true;
            }
            key ("Simon") {
                TurnOff("Simon");
                if not $simonshedsskin {
                    ["He is the innkeeper of The Sleeping Soldier. He is a quiet man, and the oldest person in Monitor. He enjoys his drink -- especially an unusual type of ale from Fawn."];
                    ["I have told him to cease drinking that swill, but he insists. From a healer's point of view, that ale should be banned!"];
                } else {
                    ["That foul imposter! I spit upon all goblins!"];
                }
                v8 = ~UsePatience_i(v8);
            }
            key ("Flicken") {
                TurnOff("Flicken");
                ["He is the guard at the south gate of Monitor. He hath a keen eye, despite his getting along in years."];
                ["Flicken is one of the Bear Command. He may seem argumentative, but he is simply a good fellow, doing his job."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Templar") {
                TurnOff("Templar");
                ["Templar is a virtuous knight of the Bear Command and oftimes a winner of our local tournaments. He also is our local expert on the Goblins."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Lydia") {
                TurnOff("Lydia");
                if not $LYDIA_CONFESSES {
                    ["She provides the Knights of Monitor with their tattoos, which they receive upon completing Knight's Test or carrying out some difficult quest."];
                } else {
                    ["'Tis simply beyond belief that she would have poisoned thee... yet thou dost say she confessed to her crime."];
                    ["It must have had something to do with that older sister of hers. Selene was taken by the Mages of Moonshade when a mere child."];
                    ["Lydia was so happy when her sister visited last month, after all these years. The two were inseparable."];
                    ["Selene must have ensorcelled her! How else could one explain how Lydia would commit the dishonorable crime of poisoning a stranger?"];
                }
                v8 = ~UsePatience_i(v8);
            }
            key ("Wolves") {
                TurnOff("Wolves");
                ["The Wolves are known for their cunning and stealth, preferring dexterity over brute strength. Brendann is their leader."];
                ["About whom dost thou wish to inquire?"];
                PushKeys();
                v9 = 3;
                TurnOn(<< "Brendann", "Lucilla", "Renfry", "Krayg", "Cellia", "Shmed", "nothing more" >>);
            }
            key ("Brendann") {
                TurnOff("Brendann");
                ["Brendann is the leader of the Wolf Command. He is a cunning fighter, a clever strategist and a bit of a rogue. He considers himself to be a ladies' man, and not without justification."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Lucilla") {
                TurnOff("Lucilla");
                ["Lucilla is the barmaid and the owner of the local pub. To tell thee the truth, she is also the town flirt. I do not mean to be catty. She doth have a good heart."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Renfry") {
                TurnOff("Renfry");
                ["He is a most unusual person. Renfry operates the Crematorium and is the undertaker of the town. He is a pleasant enough fellow, but he doth enjoy his work too much."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Krayg") {
                TurnOff("Krayg");
                ["Krayg was a fighter, but his arm was mangled in battle a while ago. He is now the Provisioner of the town. He is still haunted by his fighting days. He doth go for long walks alone."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Cellia") {
                TurnOff("Cellia");
                ["Cellia is the furrier, tanner and tailor of the city of Monitor. She buys her fur from a trapper who passes through town on occasion. Cellia is a hard-working, earthy woman."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Shmed") {
                TurnOff("Shmed");
                if ~GetItemFlag_i(_Dead, _Shmed) {
                    ["They say that Shmed was the traitor who sold our secrets to the Goblins."];
                    ["Mine heart tells me that they were wrong. Shmed was a coward, a fool, and a reprobate -- but not a traitor."];
                } else {
                    ["Shmed hath retired early from his career as a soldier and now operates the Knight's Test -- "];
                    ["The dungeon where would-be knights test themselves. He is a good man for that job."];
                }
                v8 = ~UsePatience_i(v8);
            }
            key ("Leopards") {
                TurnOff("Leopards");
                ["The Leopards are the glue which holds this community together. We keep the Bears and Wolves from tearing each other apart."];
                ["About whom dost thou wish to know?"];
                PushKeys();
                v9 = 3;
                TurnOn(<< "Lord Marsten", "Spektor", "Standarr", "Andral", "Shazzana", "nothing more" >>);
            }
            key ("Lord Marsten") {
                TurnOff("Lord Marsten");
                if $marstenarrested {
                    ["I am ashamed that he is a Leopard! I hope that he doth rot in jail for a very long time!"];
                } else {
                    ["Marsten is the commander of the Leopard Command. He may be a bit small, but a more tenacious fighter thou shalt not find in the Serpent Isle. He is rough and tough, but gregarious."];
                }
                v8 = ~UsePatience_i(v8);
            }
            key ("Spektor") {
                TurnOff("Spektor");
                if not $spektorarrested {
                    ["A very intelligent man who is part of the Leopard Command. He is the town's treasurer and I understand he doth have quite a collection of books at his house."];
                    ["He suffers from insomnia a great deal, and doth have a nervous digestion. When he cannot sleep, he comes to me and I make him a special elixir."];
                    ["I think he is worried about the thief. After all, Spektor is the town treasurer, so when money starts disappearing, everyone suspects him."];
                } else {
                    ["I am glad that traitor Spektor hath been arrested!"];
                }
                $heardaboutthief = true;
                v8 = ~UsePatience_i(v8);
            }
            key ("Standarr") {
                TurnOff("Standarr");
                ["Standarr is the armourer and blacksmith of our town. He is an honorable fighter and skilled craftsman. He also sells weapons and armour."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Andral") {
                TurnOff("Andral");
                ["Andral is not a fighter, which is a good thing since as I hear that he was miserable at it. Instead, he is an artist. Many of the knights hire him to create statues of them."];
                v8 = ~UsePatience_i(v8);
            }
            key ("Shazzana") {
                TurnOff("Shazzana");
                ["Shazzana is a trainer in the fighting arts and also a knight of the Leopard Command. It is said that one day she may very well become a Champion Knight of Monitor, which would suit her fine!"];
                v8 = ~UsePatience_i(v8);
            }
            key ("visitors") {
                TurnOff("visitors");
                if $simonshedsskin {
                    ["I doubt that we shall have as many visitors as memorable as thou art come through town for quite a while!"];
                } else {
                    ["I cannot keep track of all who come and go in this place. Thou shouldst talk to Simon, he is the innkeeper here."];
                    if not $IOLO_MADE_EQUIPMENT_LIST {
                        ["Visitors who do not reside in our inn can usually be found in our prison. For instance, a mad enchanter who was captured in the crematorium recently. Marsten will know more than I about him."];
                    }
                    v8 = ~UsePatience_i(v8);
                }
            }
            key ("places") {
                ["Of which type of place wouldst thou have me tell?"];
                PushKeys();
                v9 = 2;
                TurnOn(<< "cities", "wilderness" >>);
            }
            key ("cities") {
                TurnOff("cities");
                ["There are three cities in the Serpent Isles, and a small hamlet. Of which can I tell thee?"];
                PushKeys();
                v9 = 3;
                TurnOn(<< "Moonshade", "Fawn", "Sleeping Bull", "Monitor", "nothing more" >>);
            }
            key ("Moonshade") {
                TurnOff("Moonshade");
                ["Moonshade is a city filled with mages who look down on any who are inexperienced in the ways of magic. Moonshade is ruled by a MageLord and a council of sorcerors. It is an excellent place to learn magic, however."];
                v8 = ~UsePatience_i(v8);
            }
