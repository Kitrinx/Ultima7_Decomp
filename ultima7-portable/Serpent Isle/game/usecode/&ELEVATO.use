Routine MoveElevator_i accepts a0 #locals(1) #uses(LowerElevator_i, RaiseElevator_i) {
    if (event = _Action) {
        if ~InGumpMode_i() {
            closeAllGumps();
        }
        v0 = ~GetBarge_i(_Avatar);
        v0 = ~GetCoord(v0);
        if (v0::3 > 1) {
            LowerElevator_i();
        } else {
            RaiseElevator_i();
        }
    }
}

Usable RaiseElevator_i #locals(2) #uses(MemberSays_i) {
    v0 = ~GetBarge_i(_Avatar);
    if ~IsOnBarge_i() {
        v1 = ~GetCoord(v0);
        v1 = v1::3;
        v1 = ~PostAction(<< _aGO_UP_i, _aBREAK, _aLOOP_i, 65534, (4 - v1) >>, v0);
    } else {
        MemberSays_i("@I think that the floor is trying to rise. I suggest that everyone board.@");
    }
}

Usable LowerElevator_i #locals(2) #uses(MemberSays_i) {
    v0 = ~GetBarge_i(_Avatar);
    if not ~IsOnBarge_i() {
        MemberSays_i("@I think that the floor is trying to lower. I suggest that everyone board.@");
        return;
    }
    if ~GetItemFlag_i(_OkayToLand_i, v0) {
        v1 = ~GetCoord(v0);
        v1 = v1::3;
        v1 = ~PostAction(<< _aGO_DOWN_i, _aBREAK, _aLOOP_i, 65534, (v1 - 1) >>, v0);
    } else {
        MemberSays_i("@I think that something is blocking the elevator.@");
    }
}
