Routine Devra accepts a0 #locals(18) #uses(~LordOrLady, ~AvatarName, ~IsNPCNear, PartyFaces_i, Bark_i, ~AskYesNo, ~PartyUtters, ~IsInInv, ~GiveItemsOrDrop_i, DevraSellsFood_i, DevraSellsDrink_i, DevraChangesMoney_i) {
    v0 = ~LordOrLady();
    v1 = ~AvatarSex();
    v2 = ~AvatarName();
    v3 = ~IsNPCNear(_Argus);
    v4 = false;
    v5 = false;
    v6 = ~GetTime();
    if ((v6 > 1) or (v6 < 6)) {
        v6 = "day";
    } else {
        v6 = "evening";
    }
    if (event = _Converse) {
        Item_bark("@Pardon me...@", _Avatar);
        PartyFaces_i(65495);
        Bark_i(2, (((("Good " + v6) + ", ") + v0) + "."), _Devra);
        SetWorkType(_Talk, _Devra);
    }
    if (event = _Bark) {
        v7 = ~Random(6);
        if (v7 = 1) {
            Item_bark("@Wouldst thou like another?@", _Devra);
        }
        if (v7 = 2) {
            Item_bark("@Refill?@", _Devra);
        }
        if (v7 = 3) {
            Item_bark("@Lodgings available!@", _Devra);
        }
        if (v7 = 4) {
            Item_bark("@Good, clean rooms!@", _Devra);
        }
        if (v7 = 5) {
            if ~IsNPCNear(_Argus) {
                Item_bark("@We need more clean mugs, son!@", _Devra);
                Bark_i(2, "@Aye, mother!@", _Argus);
            } else {
                Item_bark("@Mine aching back!@", _Devra);
            }
        }
        if (v7 = 6) {
            Item_bark("@Sigh...@", _Devra);
        }
    }
    if (event = _Talking) {
        Npc_schedule(_Devra);
        ClearBark_i(_Devra);
        SetSpeaker0_i(0, _Devra);
        v8 = ~GetItemFlag_i(_Met, _Devra);
        if (v8 = false) {
            ["Welcome to the Sleeping Bull, <v0>! Enter before we suffer another storm." *"I am Devra... My son, Argus, and I are running the inn since Angus disappeared."];
            SetItemFlag_i(_Met, _Devra);
            TurnOn(<< "storm", "Argus", "disappeared" >>);
        } else {
            ["Welcome back, <v2>. 'Tis so good to see thee again, after all these storms. Argus will be glad to see thee."];
            TurnOn(<< "storm", "Argus", "disappeared" >>);
        }
        TurnOn(<< "food", "drink", "room", "exchange money", "bye" >>);
        converse {
            key ("storm") {
                ["I have lived here since before I was married, and I've never seen anything like these mage-born storms. Why, one caught old man Jothum in his field and changed his plow horse into a goat, in front of his eyes." *"But Jothum was lucky, 'twas only his horse. We never did find what happened to Theron."];
                TurnOff("storm");
                TurnOn(<< "mage-born", "Theron" >>);
            }
            key ("mage-born") {
                ["If thou shouldst be hit with lightning -- normal lightning, mind thee -- thou art dead. Plain and simple. They bury thy charred body the next day." *"But storms that change things, or make them disappear, or exchange them for something else, well now, it seems to me that 'tis magic, right enough. I don't have to be from Moonshade to conjure that answer!"];
                TurnOff("mage-born");
                TurnOn("Moonshade");
            }
            key ("Moonshade") {
                ["Fine city, though 'tis plagued by wizards and mages. The place reeks of sorcery." *"Hast thou heard anything more of what might be causing these storms? I wonder if anyone has done anything to stop them."];
                if (~AskYesNo() = true) {
                    ["Is it the work of magic? Do they know who is responsible?"];
                    if (~AskYesNo() = true) {
                        ["Wonderful! I hope that this means that the storms will end soon..."];
                    } else {
                        ["I had hoped that the storms would end soon, before they cause us to close..."];
                    }
                } else {
                    ["Well, I still think 'tis the work of them mages! No good comes of controlling that type of power, I'll tell thee..."];
                    if (v3 = true) {
                        SetSpeaker1_i(0, _Argus);
                        ["Aye, mother. And thou wilt tell all who will listen! Do not harass what few customers we do have..."];
                        CloseSpeaker1_i();
                        SetSpeakerSlot_i(0);
                        ["Hast thou ever heard a boy so rude as to talk to his mother that way?"];
                        SetSpeaker1_i(0, _Argus);
                        ["I am no boy, mother. For now, I'm the innkeeper here and I'll thank thee to remember that we have a mage staying here now."];
                        CloseSpeaker1_i();
                        SetSpeakerSlot_i(0);
                    }
                }
                TurnOff("Moonshade");
            }
            key ("Theron") {
                ["Theron was a simple man, not quite right in the head, if thou knowest what I mean. He worked for Angus and me for nigh on three years as a wood chopper... Until one of those storms."];
                ["Angus pulled Theron inside when the storm hit, but Theron ran back out to bring in his favorite axe... Next thing there was a blinding flash, and Theron was gone!"];
                TurnOff("Theron");
            }
            key ("Argus") {
                ["Argus is mine oldest boy. He's a captain in the Pikemen... Or he was until he came home to take over his father's place." *"Mine husband always thought that Wilfred, our youngest, would be the one to take the inn. But he hath become too high and mighty to be an honest innkeeper!"];
                TurnOff("Argus");
                TurnOn("Wilfred");
            }
            key ("Wilfred") {
                ["Wilfred is a Monitorian knight, <v0>. He always was headstrong... And I think his father harried him overmuch." *"He ran away to be like his brother... Only better, he said."];
                TurnOff("Wilfred");
            }
            key ("disappeared") {
                ["Thou dost seem like an honest, hard-working person. Perhaps thou canst help me discover what happened to Angus." *"'Tis a right mystery. He disappeared and then my slippers disappeared..."];
                if not flag(489) {
                    ["Now I've got no husband and a pair of old, smelly boots."];
                } else {
                    ["Now I've got no husband, but I do have my slippers..."];
                }
                TurnOff("disappeared");
                TurnOn(<< "mystery", "slippers" >>);
            }
            key ("slippers") {
                if not flag(489) {
                    ["They were hanging on the line to dry when one of those storms hit. When I went out to gather the wash later, there were these huge boots hanging where my slippers had been." *"I'd gladly give these things away, if only I had my slippers back!"];
                    v9 = ~PartyUtters(false, "@Those look like my swamp boots!@", "@Avatar, those look like thy swamp boots!@", 1);
                    SetSpeakerSlot_i(0);
                    ["If thou hast my slippers, <v0>, I would gladly trade thee these boots for them. I have no great fondness for them other than to keep my feet dry."];
                    v10 = ~IsInInv(5, 65177, _Leath_Boots, 1, _Party);
                    if (v10 = true) {
                        ["Here are thy boots then... And I thank thee for my slippers."];
                        v11 = ~GiveItemsOrDrop_i(true, false, 6, 65177, 587, 1, _Avatar);
                        v12 = ~TakeFromParty_i(false, 5, _All, _Leath_Boots, 1);
                        flag(489) = true;
                    } else {
                        ["Then I hope that thou dost not mind if I keep these... I have no way to buy new slippers, what with the storms and all." *"If thou shouldst find my slippers again, I will give these back."];
                    }
                    $knowslippers = true;
                } else {
                    ["Thank thee again, <v2>, for returning my favorite slippers."];
                }
                TurnOff("slippers");
            }
            key ("mystery") {
                ["On the night Angus disappeared, I'd gone to bed and Angus had remained to sweep. If thou dost ask me though, he stayed up to keep an eye on that strange mage that was staying here." *"I was stirred from a sound sleep by the sound of voices downstairs in the cellar. After I heard a crash, I went down to look, but I did not see anyone. I thought the mage's companion might have tried to slip down to have another drink for free, and thought no more of it until the morning."];
                flag(484) = true;
                TurnOff("mystery");
                TurnOn(<< "strange mage", "cellar", "mage's companion" >>);
            }
            key ("strange mage") {
                ["He was a rather portly man, if I remember rightly. He had been here once before..."];
                ["I cannot seem to recall what his name was. He was not the talkative sort, least not to me."];
                ["Thou couldst ask Ensorcio, they talked quite a bit. Or... I know... Thou canst look in the registry! 'Tis on the bar."];
                TurnOff("strange mage");
                TurnOn("Ensorcio");
            }
            key ("Ensorcio") {
                ["Thou hast not met the great Ensorcio yet? Count thy blessings!"];
                ["Ensorcio is the smoldering black cloud that sits here day after day, drinking himself into a fit. All he does is glower about how those fools in Moonshade threw him out, and how he'll avenge himself."];
                TurnOff("Ensorcio");
                TurnOn("fools in Moonshade");
            }
            key ("fools in Moonshade") {
                ["Ensorcio is an exiled mage. Who doth know what he did? I am too afraid to ask..."];
                ["If he was thrown out by that lot, thou canst wager that it could not have been good. Although Angus did not trust mages, he allowed Ensorcio to stay... Angus said that a mage had to have a clear head to cast spells, and we should worry if Ensorcio ever sobered."];
                TurnOff("fools in Moonshade");
            }
            key ("cellar") {
                ["Aye, the cellar. We've had a lout or two think that they could slip down and take a bottle or two on the sly." *"But Angus always seemed to know when they tried it... Threw them out with a few bruises for their trouble."];
                ["'Tis why I didn't worry 'til morn... When I found everything in disarray and Angus gone."];
                TurnOff("cellar");
                TurnOn("disarray");
            }
            key ("disarray") {
                ["The casks and barrels were scattered all over the floor down there. It looked like there may have been a fight, but I did not see any blood." *"It took the rest of the day to put all back in order down there. And make sure that nothing was missing."];
                ["I waited a week or so before I sent word to Wilfred and Argus about their father not returning."];
                TurnOff("disarray");
            }
            key ("mage's companion") {
                ["I do not know his name either... He never spoke to anyone other than the mage that I know of." *"He always walked about with his hood raised, as if he were cold or something. He always gave me the shivers."];
                TurnOff("mage's companion");
                TurnOn("shivers");
            }
            key ("shivers") {
                ["Hast thou ever been in a sickroom, <v0>? A sickroom where someone is about to die?" *"There is a tension in the air, a stillness... And that always seemed to hover about the mage's large companion." *"He was probably the one that stole whatever it was from Ensorcio that night, too."];
                TurnOff("shivers");
                TurnOn("stole");
            }
            key ("stole") {
                ["I remember that Ensorcio came storming in that morning, much earlier than usual, ranting about something being missing. I'll admit that I was a bit short with him, <v0>." *"After all, I had to put all those barrels back myself, what with Angus gone and all. And that high and mighty mage never offered to lift a finger for anything more than another mug of ale!"];
                v13 = true;
                TurnOff("stole");
            }
            key ("food") {
                if ((~GetWorkType(_Devra) = _TendShop) or (~GetWorkType(_Devra) = _Waiter)) {
                    ["Thou wilt not find our cooking fancy as in Moonshade. But 'tis hardy fare and thou wilt find the portions ample."];
                    if not v4 {
                        ["I've done all the cooking here since Donal hired me, before I married Angus. I've had my share of compliments, if I do say so myself."];
                        v4 = true;
                        TurnOn(<< "Donal", "Angus" >>);
                    }
                    DevraSellsFood_i();
                } else {
                    ["I will sell thee some food when we are open!"];
                    TurnOff("food");
                }
            }
            key ("Donal") {
                ["Donal was Angus' father, the son of Silverpate the pirate. Donal hired me as cook when I was merely a strip of a lass... 'Tis when I caught Angus' eye." *"Donal never showed any tendency to leave of a sudden, like his no-account father. That's why I told Angus I'd wed him... I thought that maybe that adventuring blood died with the old pirate."];
                TurnOff("Donal");
                TurnOn("Silverpate");
            }
            key ("Silverpate") {
                ["Thou hast not yet heard of Silverpate? I was beginnin' to think the walls shouted it, as fast as the guests hear about it around here!" *"According to stories... and 'twere only stories, mind thee... Silverpate was a pirate who took his treasure and started this here inn. He was supposed to have hid his treasure somewhere around here before he disappeared."];
                TurnOff("Silverpate");
                TurnOn("treasure");
            }
            key ("treasure") {
                ["What a lot of nonsense! Why we've had two whole generations of kin and neighbors lookin' everywhere imaginable for it." *"I even looked a bit... at first. But if it hasn't been found after all this time, <v0>, with all those looking for it... I'd tell thee not to waste thy time looking!"];
                TurnOff("treasure");
            }
            key ("Angus") {
                ["Angus is mine husband. He was the innkeeper here after Donal died." *"We raised two fine sons and he hoped to pass the inn to one of them when he were too old to run things. Only he disappeared... same as old Silverpate."];
                TurnOff("Angus");
            }
            key ("drink") {
                if ((~GetWorkType(_Devra) = _TendShop) or (~GetWorkType(_Devra) = _Waiter)) {
                    ["Thou wilt like our selection, I'm certain."];
                    DevraSellsDrink_i();
                } else {
                    ["Please return when we are open!"];
                    TurnOff("drink");
                }
            }
            key ("room") {
                ["The cost is 8 gold coins per person. Wouldst thou like a room for the night?"];
                if ~AskYesNo() {
                    v14 = (~ListSize_i(~GetParty()) * 8);
                    v15 = ~CountItem(_All, _All, _Gold_Coins, _Party);
                    if (v15 >= v14) {
                        ["Room number 3 is available. I am sure thou wilt like it. Here is the key."];
                        v16 = ~GiveItemsOrDrop_i(true, 0, 9, 3, 641, 1, _Avatar);
                        v17 = ~TakeFromParty_i(0, _All, _All, _Gold_Coins, v14);
                        ["The rooms are upstairs. If thou dost need anything, thou shouldst call."];
                    } else {
                        v9 = ~PartyUtters(false, 0, "@But we do not have enough money...@", 1);
                        if (v9 <> 65180) {
                            SetSpeaker0_i(0, _Devra);
                            ["I have no heart to turn any of thee out in these storms. With all of our help run away, I'm in sore need of help." *"But I cannot allow thee to stay for free. Thou wilt have to take thy chances outside."];
                        } else {
                            ["I'm afraid that thou cannot afford my rooms." *"With the help all run away, I'd allow thee to stay for free, but I'd soon be out of business."];
                            ["Thou wilt have to take thy chances outside."];
                        }
                    }
                } else {
                    ["Some other time, then."];
                }
            }
            key ("exchange money") {
                DevraChangesMoney_i();
            }
            key ("bye") {
                CloseSpeaker0_i();
                Bark_i(0, "@Be seeing thee!@", _Avatar);
                Bark_i(2, "@Come again soon!@", _Devra);
                break;
            }
        }
        clear_answers;
    }
}

