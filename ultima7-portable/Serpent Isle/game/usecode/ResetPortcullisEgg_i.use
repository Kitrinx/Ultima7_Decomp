Routine ResetPortcullisEgg_i accepts a0 #locals(6) {
    if $BANES_RELEASED {
        Item_destroy(item);
        terminate;
    }
    v0 = ~FindNearby_i(0, 20, _EW_Portcullis, item);
    Foreach v3 in v0 {
        v4 = ~SetQuality(75, v3);
        v5 = ~GetCoord(v3);
        if (v5::3 > 0) {
            v4 = ~Item_push(v3);
            if v4 {
                v5::3 = 0;
                v4 = ~PopToMap(v5);
                v4 = ~SetQuality(75, v3);
            }
        }
    }
}
