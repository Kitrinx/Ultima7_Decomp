                v4 = 3;
                TurnOn(<< "the sailors", "the shopkeepers", "the healers", "the Priestess", "town leaders", "nothing more" >>);
            }
            key ("the sailors") {
                TurnOff("the sailors");
                ["These cursed wizard-storms have destroyed all of our ships. Olon is the only sailor left alive in the city."];
                ["Used to be a mate on one of the fishin' ships..."];
                ["'til it sank."];
                ["Could say he's lucky... though he doth not think so. He doth spend most of his time here drinking... I fear that he is a lost soul. He even refuses ta go ta the Temple!"];
                v3 = ~UsePatience_i(v3);
            }
            key ("the shopkeepers") {
                TurnOff("the shopkeepers");
                ["Aside from me, there be only old Delin the Provisioner, and he be half-crazy."];
                ["Delin hath not been quite right since his wife died, and the Magister came to take away his infant child."];
                ["His daughter, Alyssand, looks after him these days. She doth make certain that he doth not wander away."];
                TurnOn("Magister");
                v3 = ~UsePatience_i(v3);
            }
            key ("Magister") {
                TurnOff("Magister");
                ["Thou dost not know of the Magister? The Mage who comes in the night and steals our children away?"];
                ["The Mages of Moonshade claim that it would be dangerous for magically-gifted children to grow up without proper training."];
                ["I do not like it, but there is not much mortals can do against a City of Mages..."];
                v3 = ~UsePatience_i(v3);
            }
            key ("the healers") {
                TurnOff("the healers");
                ["Last one we had was killed by the Goblins a few months ago. Closest thing we have now is the herbalist, Delphynia."];
                ["Little slip of a woman. She's usually at her greenhouse or at the healer's hall."];
                if ~AvatarSex() {
                    ["Some of the townsfolk are a bit shy of having a female healer -- it doth go against tradition, if thou dost see? But it doth not bother me!"];
                } else {
                    ["But I say that 'tis no duty for a woman. I know thou wouldst agree with me, mate."];
                }
            }
            key ("the Priestess") {
                TurnOff("the Priestess");
                if ($AUDIENCE_WITH_YELINDA and ($FAWN_TRIAL_DONE and not $oraclesaysinnocent)) {
                    ["Kylista hath been imprisoned since the trial, <v1>. I think the experience hath been a boon to her."];
                    ["She is a changed woman, I think. Hast thou visited her in her cell?"];
                } else {
                    ["Kylista is the Priestess of Beauty. Ta her falls the duty of keeping Fawn on the path of Beauty through these dark days."];
                    ["An' that be a large job for such slender shoulders, make no mistake!"];
                }
                v3 = ~UsePatience_i(v3);
            }
            key ("town leaders") {
                TurnOff("town leaders");
