Routine Jendon accepts a0 #locals(18) #uses(~LordOrLady, PartyFaces_i, Bark_i, ~AskYesNo, ~IsNPCNear, ~GiveItemsOrDrop_i, ~UsePatience_i, JendonSellsFood_i, JendonSellsDrink_i, ~PartyUtters, ~RemoveFromList_i, ~IsInInv, AlyssandSeeksAvatar_i, SendAssassin_i, JorvinBringsInvitation_i) {
    v0 = ~GetHour();
