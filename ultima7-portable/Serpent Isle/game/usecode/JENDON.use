        }
        if not ~GetItemFlag_i(_Met, _Jendon) {
            if ~AvatarSex() {
                ["I am Jendon, <v1>, proprietor of the Broken Oar. Hast thou need of something here?"];
                if (~AskYesNo() = true) {
                    ["How may I help thee this <v2>?"];
                } else {
                    ["Then thou shouldst be on thy way. 'Tis not a fit place for such a beautiful lady as thyself."];
                }
            } else {
                ["The name's Jendon, <v1>, proprietor of the Broken Oar. What can I do for thee this <v2>?"];
            }
            SetItemFlag_i(_Met, _Jendon);
