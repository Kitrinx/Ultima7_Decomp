            }
            key ("Lady Yelinda") {
                TurnOff("Lady Yelinda");
                ["Lady Yelinda be the ruler here in Fawn. She be Fawn's living symbol of Beauty."];
                ["She be a wise lady. Always concerned with what the people think -- Always listens ta any advice offered."];
                v3 = ~UsePatience_i(v3);
