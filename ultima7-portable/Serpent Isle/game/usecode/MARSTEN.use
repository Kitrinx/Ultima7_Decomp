}

Usable MarstenGrantsTest_i #locals(0) #uses(~AskYesNo) {
    ["None can take the Test of Knighthood without the permission of the Lord of Monitor. Dost thou seek my permission?"];
    $needspermission = true;
    if ~AskYesNo() {
        ["Very well. Shmed will ask thee the password. Tell him this --"];
        ["'Courage is the Soul of Life.'"];
        $permissionfortest = true;
    } else {
        ["Do not take the Test before thou art ready, strange warrior. But do not let fear shake thy resolve."];
    }
}
