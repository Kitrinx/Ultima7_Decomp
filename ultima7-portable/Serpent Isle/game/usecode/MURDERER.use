                    ["All I remember is that I was with Number 1 when last we saw Number 7. I wonder where he hath gone?"];
                }
                key ("accuse") {
                    ["I must warn thee, <v0>, we are each sworn to protect the other. If thou dost accuse me falsely, we shall attack thee."];
                    ["If thou hast spoken to each of us and hast determined that one of us is guilty, accuse accordingly. But be not hasty in thy judgment."];
                    ["Dost thou accuse me?"];
                    if ~AskYesNo() {
                        ["Thou art wrong! Number 1 can tell thee where I was when Number 7 disappeared!"];
                        SayIfNear_i("@Number 2 was with me, as was Number 6!@", 65442);
                        SetSpeakerSlot_i(0);
                        ["Thou shalt pay!"];
                        v2 = << 65442, 65441, 65440, 65439, 65438, 65437 >>;
                        Foreach v5 in v2 {
                            Npc_setAlignment(_Chaotic, v5);
                            SetWorkType(_Combat_0, v5);
                            SetAttacker_i(v5, _Avatar);
                        }
                        terminate;
                    } else {
                        ["I hope that thou dost find what hath happened to Number 7, <v0>. We cannot fulfill our duty without the key."];
                    }
                }
                key ("bye") {
                    CloseSpeaker0_i();
                    Bark_i(0, "@Goodbye!@", _Avatar);
                    Bark_i(2, "@Use thy Logic!@", _Murder2);
                    SetWorkType(_Loiter, _Murder2);
