Routine Murder4 accepts a0 #locals(3) #uses(AutomatonUsable_i, ~LordOrLady, ~AvatarName, PartyFaces_i, Bark_i, ~AskYesNo, SayIfNear_i, ~GiveItemsOrDrop_i) {
