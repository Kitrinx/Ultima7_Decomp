            ["Number 7 hath abandoned his post! The key is gone!"];
            ["None shall seek the fountain to meditate again!"];
            TurnOn(<< "abandoned", "fountain", "accuse", "name", "bye" >>);
            converse {
                key ("abandoned") {
                    TurnOff("abandoned");
                    ["Why else would Number 7 not be here, unless someone hath destroyed him? If Number 7 were fulfilling his duties, we would have the key to allow thee to meditate... as is our sworn duty."];
                    ["The last time any of us saw Number 7, I was with Number 2... And that was some time ago."];
                }
                key ("fountain") {
                    TurnOff("fountain");
                    ["The fountain contains the precious waters of Logic, pure and sweet and crystal clear. It is our duty to protect it from all who would muddy its waters."];
                }
                key ("name") {
                    TurnOff("name");
                    ["Thou mayest call me Number 4, <v0>."];
                }
                key ("accuse") {
                    ["I must warn thee, <v0>, we are each sworn to protect the other. If thou dost accuse me falsely, we shall attack thee."];
                    ["If thou hast spoken to each of us and hast determined that one of us is guilty, accuse accordingly. But be not hasty in thy judgment."];
                    ["Dost thou accuse me?"];
                    if ~AskYesNo() {
                        ["What art thou saying?! I was with Number 2 when Number 7 disappeared!"];
                        SayIfNear_i("@That is a lie! I was with Number 1 and Number 6, not Number 4!@", 65441);
                        SetSpeakerSlot_i(0);
                        ["Thou hast caught me! Very well... the key is thine."];
                        v2 = ~GiveItemsOrDrop_i(true, false, 5, 70, 641, 1, _Avatar);
                        ["I confess. It was I that destroyed Number 7... as I shall destroy thee! I should have been the keeper of the key all along! Number 7 was wrong not to give it to me!"];
                        Npc_setAlignment(_Chaotic, _Murder4);
                        SetWorkType(_Combat_0, _Murder4);
                        SetAttacker_i(_Murder4, _Avatar);
                        flag(563) = true;
                        terminate;
                    } else {
                        ["I hope that thou dost find what hath happened to Number 7, <v0>. We cannot fulfill our duty without the key."];
                    }
                }
                key ("bye") {
                    CloseSpeaker0_i();
                    Bark_i(0, "@Until later...@", _Avatar);
                    Bark_i(2, "@Use thy Logic!@", _Murder4);
                    SetWorkType(_Loiter, _Murder4);
