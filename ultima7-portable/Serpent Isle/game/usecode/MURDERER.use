Routine Murder1 accepts a0 #locals(6) #uses(AutomatonUsable_i, ~LordOrLady, ~AvatarName, PartyFaces_i, Bark_i, ~AskYesNo, SayIfNear_i) {
    if ~GetItemFlag_i(_Zombie, item) {
        AutomatonUsable_i();
        terminate;
    }
    v0 = ~LordOrLady();
    v1 = ~AvatarName();
    if (event = _Converse) {
        Item_bark("@May we speak?@", _Avatar);
        PartyFaces_i(65442);
        Bark_i(2, (("@Yes, " + v0) + "?@"), _Murder1);
        SetWorkType(_Talk, _Murder1);
    }
    if (event = _Talking) {
        Npc_schedule(_Murder1);
        ClearBark_i(_Murder1);
        SetSpeaker0_i(0, _Murder1);
        if flag(563) {
            ["That hath made good use of thy Logic, <v0>. I would not have believed that one of our fellowship could have done such a thing. I thank thee for finding the traitor in our midst."];
            ["Use the key to obtain the waters of Logic. Thou hast well earned that honor."];
            terminate;
        } else {
            ["I am Number 1, <v0>. And I am sorry. Thou must postpone thy meditations, for the key to the fountain room cannot be found."];
            ["I fear that someone hath destroyed Number 7, the keeper of the key!"];
            TurnOn(<< "meditations", "destroyed", "accuse", "bye" >>);
            converse {
                key ("meditations") {
                    TurnOff("meditations");
                    ["Thy search for Logic can go no further until thou canst drink of the waters of Logic. And until the key to the fountain room is found, no one may taste the pure waters of Logic."];
                }
                key ("destroyed") {
                    TurnOff("destroyed");
                    ["I cannot make any accusations, but we are incapable of leaving our post. Something dire must have happened to Number 7."];
                    ["I am restricted from taking action against any of my fellows, so it is up to thee to determine what hath befallen the keeper of the key."];
                    ["For my part, I can say that I was with Number 2 and Number 6 when last we saw Number 7."];
                }
                key ("accuse") {
                    ["I must warn thee, <v0>, we are each sworn to protect the other. If thou dost accuse me falsely, we shall attack thee."];
                    ["If thou hast spoken to each of us and hast determined that one of us is guilty, accuse accordingly. But be not hasty in thy judgment."];
                    ["Dost thou accuse me?"];
                    if ~AskYesNo() {
                        ["Thou hast no proof! Both Number 2 and Number 6 can attest that I was with them when Number 7 disappeared!"];
                        SayIfNear_i("@Number 1 was with me!@", 65441);
                        SayIfNear_i("@It cannot be! I was with Number 1!@", 65437);
                        SetSpeakerSlot_i(0);
                        ["Thou hast wronged me!"];
                        v2 = << 65442, 65441, 65440, 65439, 65438, 65437 >>;
                        Foreach v5 in v2 {
                            Npc_setAlignment(_Chaotic, v5);
                            SetWorkType(_Combat_0, v5);
                            SetAttacker_i(v5, _Avatar);
                        }
                        terminate;
                    } else {
                        ["I hope that thou dost find what hath happened to Number 7, <v0>. We cannot fulfill our duty without the key."];
                    }
                }
                key ("bye") {
                    CloseSpeaker0_i();
                    Bark_i(0, "@Many thanks!@", _Avatar);
                    Bark_i(2, "@Use thy Logic!@", _Murder1);
                    SetWorkType(_Loiter, _Murder1);
                    break;
                }
            }
            clear_answers;
        }
    }
}

Routine Murder2 accepts a0 #locals(6) #uses(AutomatonUsable_i, ~LordOrLady, ~AvatarName, PartyFaces_i, Bark_i, ~AskYesNo, SayIfNear_i) {
