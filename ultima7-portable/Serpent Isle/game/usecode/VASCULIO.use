                                CloseSpeaker1_i();
                            }
                            if v2 {
                                SetSpeaker1_i(0, _Dupre);
                                ["This is not funny in the least, Avatar."];
                            }
                            SetSpeaker0_i(0, _AntiSham);
                            ["A pity! Then what I do not receive willingly, I will have to take by force!"];
                            AttackAvatar_i(_Vasculio);
                            Bark_i(0, "@Enjoy thy death!@", _Vasculio);
