                    SetSpeaker0_i(0, _AntiSham);
                    ["Avatar, ignore the whimperings of thy companions! I will trade thee thy sword for a scroll that can let thee strike men dead! What sayest thou to the bargain?"];
                    v8 = ~AskYesNo();
                    if v8 {
                        SetSpeaker0_i(0, _AntiSham);
                        ["I knew thou couldst not resist a chance at such power!" *"Take this scroll. It will vanquish any foe who threatens thee."];
                        v9 = ~GiveItemsOrDrop_i(true, 0, 65177, 65, 715, 1, _Avatar);
                        SetSpeaker0_i(0, _AntiSham);
                        ["Fool! Now I have the weapon that thou couldst have slain me with! Thou hast sealed thy fate for no mere mortal can defeat me! Prepare to die, foolish mortal!"];
                        v9 = ~TakeFromParty_i(0, _All, _All, _Magebane, 1);
