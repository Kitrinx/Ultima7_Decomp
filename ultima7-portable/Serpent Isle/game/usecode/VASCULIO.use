        SetItemFlag_i(_DontMove_i, _Avatar);
        Bark_i(0, "@Ahhh, a victim...@", _Vasculio);
        v0 = ~PostAction(<< _aNO_HALT_i, _aWAIT_i, 10, _aUSABLE_i, #Vasculio >>, item);
        terminate;
    }
}

Routine Vasculio accepts a0 #locals(15) #uses(UnfreezeAvatar_i, ~IsInInv, AttackAvatar_i, Bark_i, ~AskYesNo, ~GiveItemsOrDrop_i) {
    if (event = _Converse) {
