                        ["So, Avatar, wilt thou listen to the whimperings of thy companions, or trade their life for thine own?"];
                        ["True, they do not compare to thee, but I am not too selective in my tastes. One flesh is as good as another when one hungers."];
                        v10 = ~AskYesNo();
                        if v10 {
                            if v0 {
